%requires qore >= 2.0
%modern

%requires(reexport) ssh
%requires(reexport) Logger
%requires(reexport) ConnectionProvider >= 1.4
%requires(reexport) DataProvider
%requires SshServerAuthProvider

module SshServerConnections {
    version = "0.2";
    desc = "generic ConnectionProvider helpers for managed local SSH and SFTP server instances";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("sshsrv", SshCommandServerConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sshserver", SshCommandServerConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sftpsrv", SftpServerConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sftpserver", SftpServerConnection::ConnectionScheme);
    };
}

/** @mainpage SshServerConnections Module

    @tableofcontents

    @section sshserverconnectionsintro SshServerConnections Module Introduction

    The %SshServerConnections module provides generic
    @c ConnectionProvider classes for managed local
    @ref Qore::Ssh::SshServer "Qore::Ssh::SshServer" instances.

    The scope is intentionally generic:
    - local listener/server configuration projected from a connection URL plus
      typed options
    - grouped operational listener limits through
      @c SshServerConnectionLimits
    - grouped listener service controls through
      @c SshServerConnectionServices
    - managed SSH command and SFTP server connection classes
    - strong typed projection to
      @ref Qore::Ssh::SshServerConfig "Qore::Ssh::SshServerConfig" and
      @ref Qore::Ssh::SshListenerConfig "Qore::Ssh::SshListenerConfig"
    - connection-owned @c DataProvider bridging for generic SFTP exchange
      backends

    @section sshserverconnectionsschemes Registered Connection Schemes

    The module registers the following connection schemes on load:

    |!Scheme|!Alias|!Connection Class|!Description
    |<tt>sshsrv</tt>|<tt>sshserver</tt>|@ref SshServerConnections::SshCommandServerConnection|Managed local SSH command server
    |<tt>sftpsrv</tt>|<tt>sftpserver</tt>|@ref SshServerConnections::SftpServerConnection|Managed local SFTP server with optional DataProvider bridging

    @section sshserverconnectionsoptions Typed Option Groups

    Connection options are organized into three typed hashdecl groups that map
    directly to @ref Qore::Ssh::SshListenerConfig fields.

    @anchor sshserverconnections-sshserverconnectionlimits
    @subsection sshserverconnectionslimits SshServerConnectionLimits

    Operational listener caps passed through the @c limits option:
    - @c max_sessions (@c *int) -- maximum number of concurrently accepted
      sessions per listener; when unset, no cap is enforced

    @anchor sshserverconnections-sshserverconnectionservices
    @subsection sshserverconnectionsservices SshServerConnectionServices

    Authentication and service controls passed through the @c services option:
    - @c enabled_auth_methods (@c *list&lt;string&gt;) -- list of permitted SSH
      authentication methods (e.g. @c "password", @c "publickey")
    - @c allow_command_service (@c *bool) -- enable or disable the SSH command
      (exec) service on the listener
    - @c allow_sftp_service (@c *bool) -- enable or disable the SFTP subsystem
      on the listener

    @anchor sshserverconnections-sshserverconnectionsecurity
    @subsection sshserverconnectionssecurity SshServerConnectionSecurity

    Cipher, key-exchange, MAC, host-key algorithm, and IP address filtering
    options passed through the @c security option:
    - @c allowed_ciphers (@c *string) -- comma-separated list of permitted ciphers
    - @c allowed_kex (@c *string) -- comma-separated list of permitted key-exchange algorithms
    - @c allowed_macs (@c *string) -- comma-separated list of permitted MAC algorithms
    - @c allowed_hostkey_algorithms (@c *string) -- comma-separated list of permitted host-key algorithms
    - @c allowed_addresses (@c *list&lt;string&gt;) -- CIDR or bare IP allow list
    - @c denied_addresses (@c *list&lt;string&gt;) -- CIDR or bare IP deny list

    @section sshserverconnectionsexample Minimal Working Example

    @code{.py}
    %requires ssh
    %requires SshServerConnections

    SftpServerConnection conn({
        "name": "my-sftp",
        "desc": "test SFTP server",
        "url": "sftpsrv://127.0.0.1:2222",
        "opts": {"host_keys": ("/path/to/ssh_host_rsa_key",)},
    });
    Qore::Ssh::SshServer server = conn.get(True);
    # server is now listening on 127.0.0.1:2222
    server.stop();
    @endcode

    @section sshserverconnectionsseemore See Also

    - @ref sshauthguide for authentication configuration details
    - @ref sshcookbook for additional usage examples

    The following classes are currently provided:
    - @ref SshServerConnections::AbstractSshServerConnection
    - @ref SshServerConnections::SshCommandServerConnection
    - @ref SshServerConnections::SftpServerConnection
*/
