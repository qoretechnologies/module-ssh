%requires qore >= 2.3
%modern

%requires(reexport) ssh
%requires(reexport) Logger

module SshServerAuthProvider {
    version = "0.1";
    desc = "typed auth-provider abstractions and built-in config-driven SSH auth implementations";
    author = "Qore Technologies, s.r.o.";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage SshServerAuthProvider Module

    @tableofcontents

    @section sshserverauthproviderintro SshServerAuthProvider Module Introduction

    The %SshServerAuthProvider module provides typed object-driven
    authentication helpers for the @ref sshintro "ssh module".

    It exposes:
    - @ref SshServerAuthProvider::AbstractSshAuthProvider for user-defined
      provider implementations
    - @ref SshServerAuthProvider::VirtualSshAuthProvider for built-in
      config-driven authentication

    @subsection sshauthproviderauthflow Authentication Flow

    When a client attempts to authenticate, the SSH listener first filters the
    request against its @c enabled_auth_methods list; only methods present in
    that list are forwarded to the auth provider.  The provider's
    @ref SshServerAuthProvider::AbstractSshAuthProvider::authenticate()
    "authenticate(hash<SshAuthContextInfo>)" method is then called with a typed
    context describing the attempt (username, method, credentials, and session
    metadata).  The provider evaluates the request and returns a
    @ref Qore::Ssh::SshAuthDecision "hash<SshAuthDecision>" indicating
    acceptance or rejection, along with optional session policy (command and
    SFTP restrictions) and audit data.  On success the decision's policy fields
    are attached to the session for the lifetime of the connection.

    @subsection sshauthprovidermethods Supported Authentication Methods

    The built-in @ref SshServerAuthProvider::VirtualSshAuthProvider supports
    the following SSH authentication methods:
    - @c none -- unconditional accept (useful for anonymous access with
      restricted session policies)
    - @c password -- static credential matching via
      @ref SshServerAuthProvider::VirtualSshPasswordAuthOptions "VirtualSshPasswordAuthOptions"
    - @c publickey -- authorized-key matching via
      @ref SshServerAuthProvider::VirtualSshPublicKeyAuthOptions "VirtualSshPublicKeyAuthOptions"
    - @c interactive -- keyboard-interactive challenge-response
    - @c hostbased -- host-based authentication
    - @c gssapi-mic -- GSS-API authentication with MIC

    Each method can be configured with username allow/deny lists, per-method
    decision templates, and optional custom @c validator callbacks for
    application-specific logic.

    @subsection sshauthprovidermfa Multi-Factor Authentication

    Multi-factor authentication is configured by setting the
    @ref SshServerAuthProvider::VirtualSshAuthProviderOptions "required_methods"
    field in @ref SshServerAuthProvider::VirtualSshAuthProviderOptions to an
    ordered list of methods that must all succeed before full access is granted.
    When a single method succeeds but other required methods remain, the
    provider returns a partial decision with @c partial set to @c True and
    @c allowed_auth_methods listing the remaining methods.  Completed methods
    are tracked across rounds in @c session_data under the
    @c SessionDataCompletedMethodsKey key so that each
    subsequent authentication attempt can build on prior successes.

    @subsection sshauthproviderexample Minimal Configuration Example

    The following example creates a password-only auth provider with a single
    user:

    @code{.py}
    VirtualSshAuthProvider provider(<VirtualSshAuthProviderOptions>{
        "methods": ("password",),
        "password": <VirtualSshPasswordAuthOptions>{
            "users": (<VirtualSshPasswordUserInfo>{"username": "admin", "password": "secret"},),
        },
    });
    @endcode

    Connection helpers can also synthesize
    @ref SshServerAuthProvider::VirtualSshAuthProvider automatically from
    grouped @c auth options, while low-level binary-module server configs can
    attach provider objects directly through
    @ref Qore::Ssh::SshServerConfig "Qore::Ssh::SshServerConfig".

    For the full authentication guide including advanced multi-factor
    scenarios, custom validators, and session policy configuration, see
    @ref sshauthguide.
*/

public namespace SshServerAuthProvider {
    #! typed authentication decision template for config-driven auth providers
    public hashdecl VirtualSshAuthDecisionTemplate {
        *bool partial;
        *string principal;
        *string message;
        *list<string> allowed_auth_methods;
        *hash<auto> command_policy;
        *hash<auto> sftp_policy;
        *hash<auto> session_data;
        *hash<auto> audit_data;
    }

    #! common options for static auth methods including username filters, decision templates, and custom validators
    public hashdecl VirtualSshStaticAuthMethodOptions {
        *list<string> allowed_usernames;
        *list<string> denied_usernames;
        *hash<VirtualSshAuthDecisionTemplate> success_decision;
        *hash<VirtualSshAuthDecisionTemplate> failure_decision;
        *code<hash<Qore::Ssh::SshAuthDecision>(hash<Qore::Ssh::SshAuthContextInfo>)> validator;
    }

    #! per-user password credential entry with an optional custom auth decision override
    public hashdecl VirtualSshPasswordUserInfo {
        string username;
        string password;
        *hash<VirtualSshAuthDecisionTemplate> decision;
    }

    #! password auth method options with an optional list of static user credentials
    public hashdecl VirtualSshPasswordAuthOptions inherits VirtualSshStaticAuthMethodOptions {
        *list<hash<VirtualSshPasswordUserInfo>> users;
    }

    #! per-user authorized public key entry with an optional key type filter and custom auth decision override
    public hashdecl VirtualSshAuthorizedKeyInfo {
        string username;
        binary public_key;
        *string public_key_type;
        *hash<VirtualSshAuthDecisionTemplate> decision;
    }

    #! public-key auth method options with an optional list of authorized keys
    public hashdecl VirtualSshPublicKeyAuthOptions inherits VirtualSshStaticAuthMethodOptions {
        *list<hash<VirtualSshAuthorizedKeyInfo>> authorized_keys;
    }

    #! top-level configuration for VirtualSshAuthProvider including per-method options and multi-factor settings
    public hashdecl VirtualSshAuthProviderOptions {
        *list<string> methods;
        #! ordered list of methods that must ALL succeed for multi-factor auth
        *list<string> required_methods;
        *hash<VirtualSshStaticAuthMethodOptions> none;
        *hash<VirtualSshPasswordAuthOptions> password;
        *hash<VirtualSshPublicKeyAuthOptions> publickey;
        *hash<VirtualSshStaticAuthMethodOptions> interactive;
        *hash<VirtualSshStaticAuthMethodOptions> hostbased;
        *hash<VirtualSshStaticAuthMethodOptions> gssapi_mic;
        *hash<VirtualSshAuthDecisionTemplate> default_failure_decision;
        *LoggerInterface logger;
    }

    #! session_data key used to track completed auth methods across partial auth rounds
    public const SessionDataCompletedMethodsKey = "__completed_auth_methods";

    #! session_data key holding the HMAC over the completed-methods list (integrity protection)
    /** The completed-methods list is round-tripped through client-influenced @c session_data.
        It is signed with a per-provider-instance secret so a client cannot forge it to skip
        required factors (H-6); an entry whose signature does not verify is treated as if no
        methods had been completed (fail-closed). */
    public const SessionDataCompletedMethodsSigKey = "__completed_auth_methods_sig";

    /** Base auth-provider abstraction for object-driven SSH authentication.

        User-defined auth providers should implement @c authenticate() and
        return a typed @ref Qore::Ssh::SshAuthDecision "Qore::Ssh::SshAuthDecision".
    */
    public class AbstractSshAuthProvider {
        /** Authenticates a single SSH authentication attempt.

            @param ctx the typed authentication context
            @return a typed authentication decision
        */
        hash<Qore::Ssh::SshAuthDecision> authenticate(hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            throw "SSH-AUTH-PROVIDER-ERROR",
                sprintf("%y must implement authenticate(hash<SshAuthContextInfo>)", self.className());
        }
    }

    /** Built-in config-driven auth provider supporting:
        - `none`
        - `password`
        - `publickey`
        - `interactive`
        - `hostbased`
        - `gssapi-mic`

        Static validation and on-demand app validation use the same provider
        object API.
    */
    public class VirtualSshAuthProvider inherits AbstractSshAuthProvider {
        private {
            hash<VirtualSshAuthProviderOptions> options = <VirtualSshAuthProviderOptions>{};
            *LoggerInterface logger;
            #! per-instance secret used to HMAC the round-tripped MFA completed-methods state
            binary mfa_secret = get_random_bytes(32);
        }

        constructor(*hash<VirtualSshAuthProviderOptions> opts) {
            if (opts) {
                options = opts;
                logger = opts.logger;
            }
            # "none" requires no credential; allowing it as a multi-factor requirement would let
            # an unauthenticated client satisfy a factor for free (H-6)
            if (options.required_methods && inlist("none", options.required_methods)) {
                throw "SSH-AUTH-PROVIDER-ERROR",
                    "the \"none\" auth method must not appear in required_methods: it requires no "
                    "credential and would weaken multi-factor enforcement";
            }
        }

        #! Constant-time equality over two secrets/credentials.
        /** Both sides are reduced to fixed-length keyed digests so the comparison leaks neither
            length nor content through early-out/timing behaviour (H-7). */
        private bool constantTimeEquals(auto a, auto b) {
            string da = SHA256_hmac(exists a ? a : "", mfa_secret);
            string db = SHA256_hmac(exists b ? b : "", mfa_secret);
            # digests are equal-length hex strings; OR-accumulate all byte differences
            int diff = da.size() ^ db.size();
            int n = da.size() < db.size() ? da.size() : db.size();
            for (int i = 0; i < n; ++i) {
                diff = diff | (ord(da[i]) ^ ord(db[i]));
            }
            return diff == 0;
        }

        #! Returns the integrity signature for an ordered completed-methods list.
        private string signCompleted(list<string> methods) {
            return SHA256_hmac(methods.join("\n"), mfa_secret);
        }

        #! Normalizes any validator return value into a fail-closed typed decision.
        /** A validator that returns a non-hash, a hash without a boolean @c accepted, or that
            throws (handled by the caller) must never be treated as an acceptance (H-5). */
        private hash<Qore::Ssh::SshAuthDecision> normalizeValidatorDecision(auto result, *string username) {
            if (result.typeCode() != NT_HASH || result.accepted.typeCode() != NT_BOOLEAN) {
                logWarn("auth validator returned a malformed decision; rejecting (fail-closed)");
                return makeRejectedDecision("validator returned a malformed decision", NOTHING, username);
            }
            return cast<hash<Qore::Ssh::SshAuthDecision>>(result);
        }

        hash<VirtualSshAuthProviderOptions> getOptions() {
            return options;
        }

        nothing setLogger(*LoggerInterface logger) {
            self.logger = logger;
        }

        *LoggerInterface getLogger() {
            return logger;
        }

        hash<Qore::Ssh::SshAuthDecision> authenticate(hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            logDetail(sprintf("ssh auth attempt method=%s username=%s", ctx.auth_method, ctx.username));

            # H-5: the entire decision must fail closed.  Any exception escaping the method
            # logic (including from a user-supplied validator) is converted into an explicit
            # rejection rather than propagating as an undefined auth outcome.
            hash<Qore::Ssh::SshAuthDecision> decision;
            try {
                switch (ctx.auth_method) {
                    case "none":
                        decision = authenticateStaticMethod(ctx, options.none, "none");
                        break;
                    case "password":
                        decision = authenticatePassword(ctx);
                        break;
                    case "publickey":
                        decision = authenticatePublicKey(ctx);
                        break;
                    case "interactive":
                        decision = authenticateStaticMethod(ctx, options.interactive, "interactive");
                        break;
                    case "hostbased":
                        decision = authenticateStaticMethod(ctx, options.hostbased, "hostbased");
                        break;
                    case "gssapi-mic":
                        decision = authenticateStaticMethod(ctx, options.gssapi_mic, "gssapi-mic");
                        break;
                    default:
                        decision = makeRejectedDecision(
                            sprintf("unsupported auth method %y", ctx.auth_method), NOTHING, ctx.username);
                        break;
                }

                # Multi-factor: if required_methods is set and this single method succeeded,
                # check whether all required methods are now satisfied
                if (decision.accepted && options.required_methods) {
                    decision = evaluateMultiFactor(decision, ctx);
                }
            } catch (hash<ExceptionInfo> ex) {
                logWarn(sprintf("ssh auth error method=%s username=%s: %s: %s (rejecting, fail-closed)",
                    ctx.auth_method, ctx.username, ex.err, ex.desc));
                return makeRejectedDecision(
                    sprintf("authentication failed: %s", ex.err), NOTHING, ctx.username);
            }

            if (decision.accepted) {
                logInfo(sprintf("ssh auth accepted method=%s username=%s principal=%s partial=%s",
                    ctx.auth_method, ctx.username, decision.principal ?? ctx.username,
                    decision.partial ? "true" : "false"));
            } else {
                logWarn(sprintf("ssh auth rejected method=%s username=%s: %s",
                    ctx.auth_method, ctx.username, decision.message ?? "authentication rejected"));
            }
            return decision;
        }

        private hash<Qore::Ssh::SshAuthDecision> authenticatePassword(hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            *hash<VirtualSshPasswordAuthOptions> method = options.password;
            if (!method) {
                return makeRejectedDecision(
                    sprintf("password authentication is not configured for %y", ctx.username), NOTHING, ctx.username);
            }
            if (*list<string> denied_usernames = method.denied_usernames) {
                if (inlist(ctx.username, denied_usernames)) {
                    return makeRejectedDecision(
                        sprintf("password authentication is denied for %y", ctx.username), method.failure_decision,
                        ctx.username);
                }
            }
            if (*list<string> allowed_usernames = method.allowed_usernames) {
                if (!inlist(ctx.username, allowed_usernames)) {
                    return makeRejectedDecision(
                        sprintf("password authentication is not allowed for %y", ctx.username), method.failure_decision,
                        ctx.username);
                }
            }
            if (*code<hash<Qore::Ssh::SshAuthDecision>(hash<Qore::Ssh::SshAuthContextInfo>)> validator
                    = method.validator) {
                return normalizeValidatorDecision(validator(ctx), ctx.username);
            }
            if (ctx.password == NOTHING) {
                return makeRejectedDecision(
                    sprintf("password authentication request for %y has no password payload", ctx.username),
                    method.failure_decision, ctx.username);
            }
            if (*list<hash<VirtualSshPasswordUserInfo>> users = method.users) {
                foreach hash<VirtualSshPasswordUserInfo> user in (users) {
                    # H-7: compare the password in constant time; evaluate both predicates before
                    # branching so the secret comparison is not short-circuited away
                    bool username_match = user.username == ctx.username;
                    bool password_match = constantTimeEquals(user.password, ctx.password);
                    if (username_match && password_match) {
                        return makeAcceptedDecision(user.decision ?? method.success_decision, ctx.username);
                    }
                }
            }
            return makeRejectedDecision(
                sprintf("password authentication failed for %y", ctx.username), method.failure_decision, ctx.username);
        }

        private hash<Qore::Ssh::SshAuthDecision> authenticatePublicKey(hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            *hash<VirtualSshPublicKeyAuthOptions> method = options.publickey;
            if (!method) {
                return makeRejectedDecision(
                    sprintf("public-key authentication is not configured for %y", ctx.username), NOTHING, ctx.username);
            }
            if (*list<string> denied_usernames = method.denied_usernames) {
                if (inlist(ctx.username, denied_usernames)) {
                    return makeRejectedDecision(
                        sprintf("public-key authentication is denied for %y", ctx.username), method.failure_decision,
                        ctx.username);
                }
            }
            if (*list<string> allowed_usernames = method.allowed_usernames) {
                if (!inlist(ctx.username, allowed_usernames)) {
                    return makeRejectedDecision(
                        sprintf("public-key authentication is not allowed for %y", ctx.username),
                        method.failure_decision, ctx.username);
                }
            }
            if (*code<hash<Qore::Ssh::SshAuthDecision>(hash<Qore::Ssh::SshAuthContextInfo>)> validator
                    = method.validator) {
                return normalizeValidatorDecision(validator(ctx), ctx.username);
            }
            if (ctx.public_key == NOTHING) {
                return makeRejectedDecision(
                    sprintf("public-key authentication request for %y has no public key payload", ctx.username),
                    method.failure_decision, ctx.username);
            }
            if (*list<hash<VirtualSshAuthorizedKeyInfo>> authorized_keys = method.authorized_keys) {
                foreach hash<VirtualSshAuthorizedKeyInfo> key_info in (authorized_keys) {
                    if (key_info.username != ctx.username) {
                        continue;
                    }
                    # H-7: constant-time comparison of the presented public key
                    if (!constantTimeEquals(key_info.public_key, ctx.public_key)) {
                        continue;
                    }
                    if (key_info.public_key_type != NOTHING && key_info.public_key_type != ctx.public_key_type) {
                        continue;
                    }
                    return makeAcceptedDecision(key_info.decision ?? method.success_decision, ctx.username);
                }
            }
            return makeRejectedDecision(
                sprintf("public-key authentication failed for %y", ctx.username), method.failure_decision, ctx.username);
        }

        private hash<Qore::Ssh::SshAuthDecision> authenticateStaticMethod(hash<Qore::Ssh::SshAuthContextInfo> ctx,
                *hash<VirtualSshStaticAuthMethodOptions> method, string method_name) {
            if (!method) {
                return makeRejectedDecision(
                    sprintf("%s authentication is not configured for %y", method_name, ctx.username), NOTHING,
                    ctx.username);
            }
            if (*list<string> denied_usernames = method.denied_usernames) {
                if (inlist(ctx.username, denied_usernames)) {
                    return makeRejectedDecision(
                        sprintf("%s authentication is denied for %y", method_name, ctx.username),
                        method.failure_decision, ctx.username);
                }
            }
            if (*list<string> allowed_usernames = method.allowed_usernames) {
                if (!inlist(ctx.username, allowed_usernames)) {
                    return makeRejectedDecision(
                        sprintf("%s authentication is not allowed for %y", method_name, ctx.username),
                        method.failure_decision, ctx.username);
                }
            }
            if (*code<hash<Qore::Ssh::SshAuthDecision>(hash<Qore::Ssh::SshAuthContextInfo>)> validator
                    = method.validator) {
                return normalizeValidatorDecision(validator(ctx), ctx.username);
            }
            return makeAcceptedDecision(method.success_decision, ctx.username);
        }

        private hash<Qore::Ssh::SshAuthDecision> evaluateMultiFactor(
                hash<Qore::Ssh::SshAuthDecision> single_decision,
                hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            # Get previously completed methods from session_data (passed back from prior partial
            # decisions).  This state is client-influenced, so it is only trusted when its
            # integrity signature verifies; otherwise it is discarded and treated as empty so a
            # client cannot forge completion of required factors (H-6, fail-closed).
            list<string> completed = ();
            auto raw_completed = ctx.metadata.session_data{SessionDataCompletedMethodsKey};
            if (raw_completed) {
                list<string> candidate = cast<list<string>>(raw_completed);
                auto sig = ctx.metadata.session_data{SessionDataCompletedMethodsSigKey};
                if (sig.typeCode() == NT_STRING && constantTimeEquals(sig, signCompleted(candidate))) {
                    completed = candidate;
                } else {
                    logWarn(sprintf("ignoring unsigned/forged MFA completed-methods state for "
                        "username=%s (fail-closed)", ctx.username));
                }
            }

            # Add the current method if not already present
            if (!inlist(ctx.auth_method, completed)) {
                completed += (ctx.auth_method,);
            }

            # Check if all required methods are satisfied
            list<string> remaining = ();
            foreach string required in (options.required_methods) {
                if (!inlist(required, completed)) {
                    remaining += (required,);
                }
            }

            if (remaining.empty()) {
                # All methods satisfied — return full acceptance
                single_decision.partial = False;
                return single_decision;
            }

            # Still need more methods — return partial success
            single_decision.partial = True;
            single_decision.allowed_auth_methods = remaining;
            if (!single_decision.session_data) {
                single_decision.session_data = {};
            }
            single_decision.session_data{SessionDataCompletedMethodsKey} = completed;
            single_decision.session_data{SessionDataCompletedMethodsSigKey} = signCompleted(completed);
            single_decision.message = sprintf("partial auth success, remaining: %y", remaining);
            return single_decision;
        }

        private hash<Qore::Ssh::SshAuthDecision> makeAcceptedDecision(
                *hash<VirtualSshAuthDecisionTemplate> tmpl, *string username) {
            return makeDecision(True, tmpl, username, "authentication accepted");
        }

        private hash<Qore::Ssh::SshAuthDecision> makeRejectedDecision(string message,
                *hash<VirtualSshAuthDecisionTemplate> tmpl, *string username) {
            return makeDecision(False, tmpl ?? options.default_failure_decision, username, message);
        }

        private hash<Qore::Ssh::SshAuthDecision> makeDecision(bool accepted,
                *hash<VirtualSshAuthDecisionTemplate> tmpl, *string username, string default_message) {
            hash<Qore::Ssh::SshAuthDecision> rv = <Qore::Ssh::SshAuthDecision>{
                "accepted": accepted,
            };
            if (tmpl) {
                if (exists tmpl.partial) {
                    rv.partial = tmpl.partial;
                }
                if (tmpl.principal != NOTHING) {
                    rv.principal = tmpl.principal;
                }
                if (tmpl.message != NOTHING) {
                    rv.message = tmpl.message;
                }
                if (tmpl.allowed_auth_methods != NOTHING) {
                    rv.allowed_auth_methods = tmpl.allowed_auth_methods;
                }
                if (tmpl.command_policy != NOTHING) {
                    rv.command_policy = tmpl.command_policy;
                }
                if (tmpl.sftp_policy != NOTHING) {
                    rv.sftp_policy = tmpl.sftp_policy;
                }
                if (tmpl.session_data != NOTHING) {
                    rv.session_data = tmpl.session_data;
                }
                if (tmpl.audit_data != NOTHING) {
                    rv.audit_data = tmpl.audit_data;
                }
            }
            if (rv.message == NOTHING) {
                rv.message = default_message;
            }
            if (accepted && rv.principal == NOTHING && username != NOTHING) {
                rv.principal = username;
            }
            if (!accepted && rv.allowed_auth_methods == NOTHING && options.methods != NOTHING) {
                rv.allowed_auth_methods = options.methods;
            }
            return rv;
        }

        private nothing logDetail(string message) {
            if (logger) {
                try {
                    logger.detail("%s", message);
                } catch (auto e) {
                }
            }
        }

        private nothing logInfo(string message) {
            if (logger) {
                try {
                    logger.info("%s", message);
                } catch (auto e) {
                }
            }
        }

        private nothing logWarn(string message) {
            if (logger) {
                try {
                    logger.warn("%s", message);
                } catch (auto e) {
                }
            }
        }
    }
}
