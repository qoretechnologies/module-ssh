static QoreHashNode* ssh_make_exception_info(const char* err, const std::string& desc) {
    ExceptionSink xs;
    xs.raiseException(err, "%s", desc.c_str());
    return xs.getExceptionInfo();
}

// Enforces the active program's filesystem sandbox policy (if any) before a host key file
// is read.  Returns 0 when permitted (or no sandbox active), -1 with FILESYSTEM-ACCESS-DENIED
// raised when denied (fail closed).  checkFilesystemAccess() does not re-enter SshServerPriv,
// so this is safe to call while the server mutex is held (e.g. from startListener()).
// C3: upper bound (seconds) for the blocking SSH handshake so a stalled/slowloris client
// cannot pin a worker thread indefinitely.  The per-wait timeout set later by SshSession
// overrides this once the session is handed off.
static const long SSH_HANDSHAKE_TIMEOUT_SECONDS = 60;

static int ssh_server_check_fs_access(const char* path, int mode, ExceptionSink* xsink) {
    if (!path || !*path) {
        return 0;
    }
    if (getProgram() && (getProgram()->getParseOptions() & PO_NO_FILESYSTEM)) {
        xsink->raiseException("ILLEGAL-FILESYSTEM-ACCESS",
            "reading SSH server host key file '%s' is not allowed when PO_NO_FILESYSTEM is set", path);
        return -1;
    }
    QoreSandboxManagerHelper smh;
    if (smh && !smh->checkFilesystemAccess(path, mode, xsink)) {
        return -1;
    }
    return 0;
}

// S6: defense-in-depth — enforce the active program's network sandbox policy on the
// configured listener bind address/port before libssh opens the listening socket.  The
// actual bind() happens inside libssh (ssh_bind_listen), so this is a pre-bind policy
// gate on the configured endpoint.  Returns 0 when permitted (or no sandbox active),
// -1 with NETWORK-ACCESS-DENIED (or a resolution error) raised when denied/unresolvable
// (fail closed).  SSH listeners are always TCP.
static int ssh_server_check_bind_access(const std::string& bind_address, int port,
        ExceptionSink* xsink) {
    QoreSandboxManagerHelper smh;
    if (!smh) {
        return 0;
    }
    struct addrinfo hints;
    memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_protocol = IPPROTO_TCP;
    hints.ai_flags = AI_PASSIVE;
    const char* node = bind_address.empty() ? nullptr : bind_address.c_str();
    std::string port_str = std::to_string(port);
    struct addrinfo* res = nullptr;
    int gai = getaddrinfo(node, port_str.c_str(), &hints, &res);
    if (gai != 0 || !res) {
        xsink->raiseException("SSHLISTENER-START-ERROR",
            "cannot resolve listener bind address \"%s:%d\" for the sandbox network policy "
            "check: %s", bind_address.c_str(), port, gai_strerror(gai));
        return -1;
    }
    ON_BLOCK_EXIT(freeaddrinfo, res);
    for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
        if (!smh->network().checkBind(ai->ai_addr, ai->ai_addrlen, QSEC_NET_TCP, xsink)) {
            return -1;
        }
    }
    return 0;
}

static std::string ssh_get_libssh_error(void* ptr) {
    const char* err = ssh_get_error(ptr);
    return err ? std::string(err) : std::string("unknown libssh error");
}

static int64 ssh_get_bound_port(ssh_bind bind) {
    socket_t fd = ssh_bind_get_fd(bind);
    if (fd == SSH_INVALID_SOCKET) {
        return -1;
    }

    sockaddr_storage addr;
    memset(&addr, 0, sizeof(addr));
    socklen_t addr_len = sizeof(addr);
    if (getsockname(fd, reinterpret_cast<sockaddr*>(&addr), &addr_len) != 0) {
        return -1;
    }

    switch (addr.ss_family) {
        case AF_INET:
            return ntohs(reinterpret_cast<const sockaddr_in*>(&addr)->sin_port);
        case AF_INET6:
            return ntohs(reinterpret_cast<const sockaddr_in6*>(&addr)->sin6_port);
        default:
            return -1;
    }
}

static std::string ssh_socket_address_to_string(const sockaddr_storage& addr) {
    char buf[INET6_ADDRSTRLEN];
    memset(buf, 0, sizeof(buf));

    switch (addr.ss_family) {
        case AF_INET:
            if (!inet_ntop(AF_INET, &(reinterpret_cast<const sockaddr_in*>(&addr)->sin_addr), buf, sizeof(buf))) {
                return std::string();
            }
            return std::string(buf);
        case AF_INET6:
            if (!inet_ntop(AF_INET6, &(reinterpret_cast<const sockaddr_in6*>(&addr)->sin6_addr), buf, sizeof(buf))) {
                return std::string();
            }
            return std::string(buf);
        default:
            return std::string();
    }
}

static int64 ssh_socket_address_port(const sockaddr_storage& addr) {
    switch (addr.ss_family) {
        case AF_INET:
            return ntohs(reinterpret_cast<const sockaddr_in*>(&addr)->sin_port);
        case AF_INET6:
            return ntohs(reinterpret_cast<const sockaddr_in6*>(&addr)->sin6_port);
        default:
            return -1;
    }
}

static int ssh_get_socket_endpoint(socket_t fd, bool peer, std::string& address, int64& port) {
    sockaddr_storage addr;
    memset(&addr, 0, sizeof(addr));
    socklen_t addr_len = sizeof(addr);
    int rc = peer ? getpeername(fd, reinterpret_cast<sockaddr*>(&addr), &addr_len)
                  : getsockname(fd, reinterpret_cast<sockaddr*>(&addr), &addr_len);
    if (rc != 0) {
        address.clear();
        port = -1;
        return -1;
    }

    address = ssh_socket_address_to_string(addr);
    port = ssh_socket_address_port(addr);
    return address.empty() || port < 0 ? -1 : 0;
}

static void ssh_validate_non_empty_string(const QoreHashNode* h, const char* key, const char* err,
        ExceptionSink* xsink) {
    QoreValue value = h->getKeyValue(key);
    if (value.getType() != NT_STRING) {
        xsink->raiseException(err, "the \"%s\" configuration key must be a non-empty string", key);
        return;
    }
    QoreStringValueHelper str(value);
    if (!str->strlen()) {
        xsink->raiseException(err, "the \"%s\" configuration key must be a non-empty string", key);
    }
}

static void ssh_validate_logger(const QoreObject* logger, const char* err, ExceptionSink* xsink) {
    if (!logger) {
        return;
    }

    const QoreClass* cls = logger->getClass();
    if (!cls || !cls->findMethod("logArgs") || !cls->findMethod("isEnabledFor")) {
        xsink->raiseException(err,
            "logger objects must implement logArgs() and isEnabledFor() methods");
    }
}

static void ssh_validate_auth_provider(const QoreObject* auth_provider, const char* err, ExceptionSink* xsink) {
    if (!auth_provider) {
        return;
    }

    const QoreClass* cls = auth_provider->getClass();
    if (!cls || !cls->findMethod("authenticate")) {
        xsink->raiseException(err,
            "auth provider objects must implement authenticate(hash<SshAuthContextInfo>)");
    }
}

static bool ssh_get_hash_string(const QoreHashNode* h, const char* key, std::string& str, ExceptionSink* xsink) {
    QoreValue v = h->getKeyValue(key);
    if (v.isNothing()) {
        return false;
    }
    QoreStringValueHelper sv(v, QCS_UTF8, xsink);
    if (*xsink) {
        return false;
    }
    str = sv->c_str();
    return true;
}

static void ssh_log_message(QoreObject* logger, int level, const std::string& msg) {
    if (!logger) {
        return;
    }

    ExceptionSink xsink;
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
    args->push(level, &xsink);
    args->push(new QoreStringNode(msg.c_str()), &xsink);
    if (xsink) {
        return;
    }

    ValueHolder rv(logger->evalMethod("logArgs", *args, &xsink), &xsink);
}

static bool ssh_string_in_list(const QoreListNode* l, const char* value) {
    if (!l || !value || !*value) {
        return false;
    }

    for (size_t i = 0, e = l->size(); i < e; ++i) {
        QoreValue entry = l->retrieveEntry(i);
        if (entry.getType() == NT_STRING) {
            QoreStringValueHelper str(entry);
            if (!strcmp(str->c_str(), value)) {
                return true;
            }
        }
    }

    return false;
}

static bool ssh_is_public_key_probe(const QoreHashNode* auth_info) {
    if (!auth_info) {
        return false;
    }

    QoreValue auth_method = auth_info->getKeyValue("auth_method");
    if (auth_method.getType() != NT_STRING) {
        return false;
    }
    QoreStringValueHelper auth_method_str(auth_method);
    if (strcmp(auth_method_str->c_str(), "publickey")) {
        return false;
    }

    const QoreHashNode* metadata = auth_info->getKeyValue("metadata").get<QoreHashNode>();
    if (!metadata) {
        return false;
    }

    QoreValue public_key_state = metadata->getKeyValue("public_key_state");
    if (public_key_state.getType() != NT_STRING) {
        return false;
    }
    QoreStringValueHelper public_key_state_str(public_key_state);
    return !strcmp(public_key_state_str->c_str(), "none");
}

static bool ssh_sftp_operation_is_write(const std::string& operation) {
    return operation == "upload" || operation == "put" || operation == "write" || operation == "append"
        || operation == "rename" || operation == "move" || operation == "delete" || operation == "remove"
        || operation == "mkdir" || operation == "rmdir" || operation == "symlink" || operation == "link"
        || operation == "chmod" || operation == "chown" || operation == "chgrp" || operation == "setstat"
        || operation == "lsetstat" || operation == "fsetstat" || operation == "truncate";
}

static bool ssh_sftp_normalize_virtual_path(const std::string& raw_path, std::string& normalized_path) {
    if (raw_path.empty()) {
        return false;
    }

    std::vector<std::string> components;
    size_t pos = 0;
    while (pos <= raw_path.size()) {
        size_t slash = raw_path.find('/', pos);
        std::string part = slash == std::string::npos ? raw_path.substr(pos) : raw_path.substr(pos, slash - pos);
        if (!part.empty() && part != ".") {
            if (part == "..") {
                if (components.empty()) {
                    return false;
                }
                components.pop_back();
            } else {
                components.push_back(part);
            }
        }

        if (slash == std::string::npos) {
            break;
        }
        pos = slash + 1;
    }

    normalized_path = "/";
    for (size_t i = 0; i < components.size(); ++i) {
        if (i) {
            normalized_path += "/";
        }
        normalized_path += components[i];
    }

    return true;
}

static std::string ssh_sftp_join_root_path(const std::string& root_dir, const std::string& normalized_path) {
    if (root_dir.empty()) {
        return normalized_path;
    }

    std::string result = root_dir;
    while (result.size() > 1 && result.back() == '/') {
        result.pop_back();
    }

    if (normalized_path == "/") {
        return result;
    }

    if (normalized_path.empty()) {
        return result;
    }

    if (result == "/") {
        return normalized_path;
    }

    return result + normalized_path;
}

static bool ssh_get_optional_bool(const QoreHashNode* h, const char* key, bool default_value, bool& value,
        const char* err, ExceptionSink* xsink) {
    if (!h || h->getKeyValue(key).getType() == NT_NOTHING) {
        value = default_value;
        return true;
    }

    value = h->getKeyValue(key).getAsBool();
    if (*xsink) {
        xsink->raiseException(err, "the \"%s\" configuration key must be a boolean when present", key);
        return false;
    }

    return true;
}

static int ssh_listener_auth_methods_from_list(const QoreListNode* methods, ExceptionSink* xsink) {
    if (!methods) {
        return SSH_AUTH_METHOD_NONE | SSH_AUTH_METHOD_PASSWORD | SSH_AUTH_METHOD_PUBLICKEY
            | SSH_AUTH_METHOD_INTERACTIVE;
    }

    int rv = 0;
    for (size_t i = 0, e = methods->size(); i < e; ++i) {
        QoreValue method = methods->retrieveEntry(i);
        if (method.getType() != NT_STRING) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "enabled auth method entry %zu must be a non-empty string", i);
            return 0;
        }
        QoreStringValueHelper method_str(method);
        if (!method_str->strlen()) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "enabled auth method entry %zu must be a non-empty string", i);
            return 0;
        }

        std::string m = method_str->c_str();
        if (m == "none") {
            rv |= SSH_AUTH_METHOD_NONE;
        } else if (m == "password") {
            rv |= SSH_AUTH_METHOD_PASSWORD;
        } else if (m == "publickey") {
            rv |= SSH_AUTH_METHOD_PUBLICKEY;
        } else if (m == "interactive") {
            rv |= SSH_AUTH_METHOD_INTERACTIVE;
        } else if (m == "hostbased") {
            rv |= SSH_AUTH_METHOD_HOSTBASED;
        } else if (m == "gssapi-mic") {
            rv |= SSH_AUTH_METHOD_GSSAPI_MIC;
        } else {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "unsupported enabled auth method \"%s\"", m.c_str());
            return 0;
        }
    }

    return rv;
}

static int64 ssh_get_required_int(const QoreHashNode* h, const char* key, const char* err, ExceptionSink* xsink) {
    int64 value = h->getKeyValue(key).getAsBigInt();
    if (*xsink) {
        xsink->raiseException(err, "the \"%s\" configuration key must be an integer", key);
        return 0;
    }
    return value;
}

static void ssh_validate_listener_config(const QoreHashNode* listener, std::set<std::string>& listener_names,
        ExceptionSink* xsink) {
    if (!listener) {
        xsink->raiseException("SSHLISTENER-CONFIG-ERROR", "listener configuration entries must be hashes");
        return;
    }

    ssh_validate_non_empty_string(listener, "name", "SSHLISTENER-CONFIG-ERROR", xsink);
    if (*xsink) {
        return;
    }
    QoreStringValueHelper name(listener->getKeyValue("name"));
    std::string listener_name = name->c_str();
    if (!listener_names.insert(listener_name).second) {
        xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
            "duplicate listener name \"%s\" in server configuration", listener_name.c_str());
        return;
    }

    ssh_validate_non_empty_string(listener, "bind_address", "SSHLISTENER-CONFIG-ERROR", xsink);
    if (*xsink) {
        return;
    }

    int64 port = ssh_get_required_int(listener, "port", "SSHLISTENER-CONFIG-ERROR", xsink);
    if (*xsink) {
        return;
    }
    if (port < 0 || port > 65535) {
        xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
            "the \"port\" configuration key must be between 0 and 65535 inclusive; got %lld", port);
        return;
    }

    QoreValue max_sessions = listener->getKeyValue("max_sessions");
    if (!max_sessions.isNothing()) {
        int64 value = max_sessions.getAsBigInt();
        if (*xsink) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "the \"max_sessions\" configuration key must be an integer when present");
            return;
        }
        if (value < 0) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "the \"max_sessions\" configuration key must be >= 0; got %lld", value);
            return;
        }
    }

    QoreValue host_key_provider_value = listener->getKeyValue("server_host_key_provider");
    const QoreObject* host_key_provider = nullptr;
    if (host_key_provider_value.getType() != NT_NOTHING) {
        if (host_key_provider_value.getType() != NT_OBJECT) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "the \"server_host_key_provider\" configuration key must be an object");
            return;
        }
        host_key_provider = host_key_provider_value.get<QoreObject>();
    }
    if (host_key_provider_value.getType() != NT_NOTHING && !host_key_provider) {
        xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
            "the \"server_host_key_provider\" configuration key must be an object");
        return;
    }
    QoreValue host_keys_value = listener->getKeyValue("host_keys");
    const QoreListNode* host_keys = nullptr;
    if (host_keys_value.getType() != NT_NOTHING) {
        if (host_keys_value.getType() != NT_LIST) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "the \"host_keys\" configuration key must be a list when present");
            return;
        }
        host_keys = host_keys_value.get<QoreListNode>();
    }
    if ((!host_keys || !host_keys->size()) && !host_key_provider) {
        xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
            "listener configuration must provide a non-empty \"host_keys\" list or a server_host_key_provider");
        return;
    }

    if (host_keys) {
        for (size_t i = 0, e = host_keys->size(); i < e; ++i) {
            if (!(i % 100) && qore_check_cancel(xsink, "validating SSH listener host keys")) {
                return;
            }
            QoreValue host_key = host_keys->retrieveEntry(i);
            if (host_key.getType() != NT_STRING) {
                xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                    "the \"host_keys\" list entry at index %zu must be a non-empty string", i);
                return;
            }
            QoreStringValueHelper host_key_str(host_key);
            if (!host_key_str->strlen()) {
                xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                    "the \"host_keys\" list entry at index %zu must be a non-empty string", i);
                return;
            }
        }
    }

    (void)ssh_listener_auth_methods_from_list(listener->getKeyValue("enabled_auth_methods").get<QoreListNode>(), xsink);
}

static void ssh_validate_server_config(const QoreHashNode* config, ExceptionSink* xsink) {
    if (!config) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR", "server configuration must be a hash");
        return;
    }

    ssh_validate_non_empty_string(config, "name", "SSHSERVER-CONFIG-ERROR", xsink);
    if (*xsink) {
        return;
    }

    const QoreListNode* listeners = config->getKeyValue("listeners").get<QoreListNode>();
    if (!listeners || !listeners->size()) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"listeners\" configuration key must be a non-empty list");
        return;
    }

    std::set<std::string> listener_names;
    for (size_t i = 0, e = listeners->size(); i < e; ++i) {
        const QoreHashNode* listener = listeners->retrieveEntry(i).get<QoreHashNode>();
        ssh_validate_listener_config(listener, listener_names, xsink);
        if (*xsink) {
            return;
        }
    }

    const QoreObject* auth_provider = config->getKeyValue("auth_provider").get<QoreObject>();
    if (config->getKeyValue("auth_provider").getType() != NT_NOTHING && !auth_provider) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"auth_provider\" configuration key must be an object");
        return;
    }
    ssh_validate_auth_provider(auth_provider, "SSHSERVER-CONFIG-ERROR", xsink);
    if (*xsink) {
        return;
    }

    const ResolvedCallReferenceNode* auth_callback = config->getKeyValue("auth_callback").get<const ResolvedCallReferenceNode>();
    if (config->getKeyValue("auth_callback").getType() != NT_NOTHING && !auth_callback) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"auth_callback\" configuration key must be a closure or call reference");
        return;
    }
    if (auth_provider && auth_callback) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"auth_provider\" and \"auth_callback\" configuration keys cannot be used together");
        return;
    }

    const ResolvedCallReferenceNode* command_callback
        = config->getKeyValue("command_callback").get<const ResolvedCallReferenceNode>();
    if (config->getKeyValue("command_callback").getType() != NT_NOTHING && !command_callback) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"command_callback\" configuration key must be a closure or call reference");
        return;
    }

    const ResolvedCallReferenceNode* sftp_factory_callback
        = config->getKeyValue("sftp_factory_callback").get<const ResolvedCallReferenceNode>();
    if (config->getKeyValue("sftp_factory_callback").getType() != NT_NOTHING && !sftp_factory_callback) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"sftp_factory_callback\" configuration key must be a closure or call reference");
        return;
    }

    const QoreHashNode* sftp_config = config->getKeyValue("sftp_config").get<QoreHashNode>();
    if (config->getKeyValue("sftp_config").getType() != NT_NOTHING && !sftp_config) {
        xsink->raiseException("SSHSERVER-CONFIG-ERROR",
            "the \"sftp_config\" configuration key must be a hash when present");
        return;
    }
    if (sftp_config) {
        QoreValue root_dir = sftp_config->getKeyValue("root_dir");
        if (root_dir.getType() != NT_NOTHING && root_dir.getType() != NT_STRING) {
            xsink->raiseException("SSHSERVER-CONFIG-ERROR",
                "the \"sftp_config.root_dir\" configuration key must be a string when present");
            return;
        }

        bool read_only = false;
        if (!ssh_get_optional_bool(sftp_config, "read_only", false, read_only, "SSHSERVER-CONFIG-ERROR", xsink)) {
            return;
        }

        const ResolvedCallReferenceNode* path_policy_callback
            = sftp_config->getKeyValue("path_policy_callback").get<const ResolvedCallReferenceNode>();
        if (sftp_config->getKeyValue("path_policy_callback").getType() != NT_NOTHING && !path_policy_callback) {
            xsink->raiseException("SSHSERVER-CONFIG-ERROR",
                "the \"sftp_config.path_policy_callback\" configuration key must be a closure or call reference");
            return;
        }

        const QoreHashNode* atomic_publish_policy = sftp_config->getKeyValue("atomic_publish_policy").get<QoreHashNode>();
        if (sftp_config->getKeyValue("atomic_publish_policy").getType() != NT_NOTHING && !atomic_publish_policy) {
            xsink->raiseException("SSHSERVER-CONFIG-ERROR",
                "the \"sftp_config.atomic_publish_policy\" configuration key must be a hash when present");
            return;
        }
        if (atomic_publish_policy) {
            bool enabled = false;
            if (!ssh_get_optional_bool(atomic_publish_policy, "enabled", false, enabled, "SSHSERVER-CONFIG-ERROR",
                    xsink)) {
                return;
            }

            QoreValue temporary_suffix = atomic_publish_policy->getKeyValue("temporary_suffix");
            if (temporary_suffix.getType() != NT_NOTHING) {
                if (temporary_suffix.getType() != NT_STRING) {
                    xsink->raiseException("SSHSERVER-CONFIG-ERROR",
                        "the \"sftp_config.atomic_publish_policy.temporary_suffix\" configuration key must be a "
                        "non-empty string when present");
                    return;
                }
                QoreStringValueHelper temporary_suffix_str(temporary_suffix);
                if (!temporary_suffix_str->strlen()) {
                    xsink->raiseException("SSHSERVER-CONFIG-ERROR",
                        "the \"sftp_config.atomic_publish_policy.temporary_suffix\" configuration key must be a "
                        "non-empty string when present");
                    return;
                }
            }

            bool publish_by_rename = true;
            if (!ssh_get_optional_bool(atomic_publish_policy, "publish_by_rename", true, publish_by_rename,
                    "SSHSERVER-CONFIG-ERROR", xsink)) {
                return;
            }

            bool overwrite = false;
            if (!ssh_get_optional_bool(atomic_publish_policy, "overwrite", false, overwrite, "SSHSERVER-CONFIG-ERROR",
                    xsink)) {
                return;
            }

            bool fsync_before_publish = false;
            if (!ssh_get_optional_bool(atomic_publish_policy, "fsync_before_publish", false, fsync_before_publish,
                    "SSHSERVER-CONFIG-ERROR", xsink)) {
                return;
            }

            bool preserve_partial_on_error = false;
            if (!ssh_get_optional_bool(atomic_publish_policy, "preserve_partial_on_error", false,
                    preserve_partial_on_error, "SSHSERVER-CONFIG-ERROR", xsink)) {
                return;
            }
        }
    }

    ssh_validate_logger(config->getKeyValue("logger").get<QoreObject>(), "SSHSERVER-CONFIG-ERROR", xsink);
}

struct SshCidrEntry {
    uint32_t addr;
    uint32_t mask;
};

static bool ssh_parse_ipv4(const std::string& ip_str, uint32_t& addr) {
    struct in_addr in;
    if (inet_pton(AF_INET, ip_str.c_str(), &in) != 1) {
        return false;
    }
    addr = ntohl(in.s_addr);
    return true;
}

static bool ssh_parse_cidr(const std::string& cidr, SshCidrEntry& entry) {
    size_t slash = cidr.find('/');
    if (slash == std::string::npos) {
        // Bare IP address — /32 mask
        if (!ssh_parse_ipv4(cidr, entry.addr)) {
            return false;
        }
        entry.mask = 0xffffffff;
        return true;
    }
    std::string ip_part = cidr.substr(0, slash);
    std::string mask_part = cidr.substr(slash + 1);
    if (!ssh_parse_ipv4(ip_part, entry.addr)) {
        return false;
    }
    int prefix_len = atoi(mask_part.c_str());
    if (prefix_len < 0 || prefix_len > 32) {
        return false;
    }
    entry.mask = prefix_len == 0 ? 0 : ~((1u << (32 - prefix_len)) - 1);
    entry.addr &= entry.mask;
    return true;
}

static bool ssh_ip_matches_cidr_list(const std::string& ip, const std::vector<SshCidrEntry>& list) {
    uint32_t addr = 0;
    if (!ssh_parse_ipv4(ip, addr)) {
        return false;
    }
    for (const auto& entry : list) {
        if ((addr & entry.mask) == entry.addr) {
            return true;
        }
    }
    return false;
}

static std::vector<SshCidrEntry> ssh_parse_cidr_list(const QoreListNode* list, const char* field_name,
        ExceptionSink* xsink) {
    std::vector<SshCidrEntry> result;
    if (!list) {
        return result;
    }
    for (size_t i = 0, e = list->size(); i < e; ++i) {
        QoreValue entry_val = list->retrieveEntry(i);
        if (entry_val.getType() != NT_STRING) {
            continue;
        }
        QoreStringValueHelper entry_str(entry_val);
        SshCidrEntry entry;
        if (!ssh_parse_cidr(entry_str->c_str(), entry)) {
            xsink->raiseException("SSHLISTENER-CONFIG-ERROR",
                "invalid CIDR entry \"%s\" in \"%s\" at index %zu", entry_str->c_str(), field_name, i);
            return {};
        }
        result.push_back(entry);
    }
    return result;
}

static std::string ssh_get_optional_string(const QoreHashNode* config, const char* key) {
    QoreValue val = config->getKeyValue(key);
    if (val.getType() != NT_STRING) {
        return std::string();
    }
    QoreStringValueHelper str(val);
    return str->c_str();
}

struct SshListenerState {
    SshListenerState() : port(0), bound_port(0), active_session_counter(new std::atomic<int64>(0)), bind(nullptr),
            last_error(nullptr), server_host_key_provider(nullptr), running(false), accept_waiters(0),
            max_sessions(-1), allow_command_service(true), allow_sftp_service(false),
            enabled_auth_methods_mask(SSH_AUTH_METHOD_NONE | SSH_AUTH_METHOD_PASSWORD
                | SSH_AUTH_METHOD_PUBLICKEY | SSH_AUTH_METHOD_INTERACTIVE),
            keepalive_interval_seconds(60), idle_timeout_seconds(-1) {
    }

    explicit SshListenerState(const QoreHashNode* listener)
            : port(0), bound_port(0), active_session_counter(new std::atomic<int64>(0)), bind(nullptr),
            last_error(nullptr), server_host_key_provider(nullptr), running(false), accept_waiters(0),
            max_sessions(-1), allow_command_service(true), allow_sftp_service(false),
            enabled_auth_methods_mask(SSH_AUTH_METHOD_NONE | SSH_AUTH_METHOD_PASSWORD
                | SSH_AUTH_METHOD_PUBLICKEY | SSH_AUTH_METHOD_INTERACTIVE),
            keepalive_interval_seconds(60), idle_timeout_seconds(-1) {
        QoreValue q_name = listener->getKeyValue("name");
        if (q_name.getType() == NT_STRING) {
            QoreStringValueHelper str(q_name);
            name = str->c_str();
        }
        QoreValue q_bind_address = listener->getKeyValue("bind_address");
        if (q_bind_address.getType() == NT_STRING) {
            QoreStringValueHelper str(q_bind_address);
            bind_address = str->c_str();
        }
        port = listener->getKeyValue("port").getAsBigInt();
        if (!listener->getKeyValue("max_sessions").isNothing()) {
            max_sessions = listener->getKeyValue("max_sessions").getAsBigInt();
        }

        QoreValue q_banner = listener->getKeyValue("banner");
        if (q_banner.getType() == NT_STRING) {
            QoreStringValueHelper str(q_banner);
            banner = str->c_str();
        }
        QoreValue allow_command = listener->getKeyValue("allow_command_service");
        if (!allow_command.isNothing()) {
            allow_command_service = allow_command.getAsBool();
        }
        QoreValue allow_sftp = listener->getKeyValue("allow_sftp_service");
        if (!allow_sftp.isNothing()) {
            allow_sftp_service = allow_sftp.getAsBool();
        }
        ExceptionSink xsink;
        int methods = ssh_listener_auth_methods_from_list(
            listener->getKeyValue("enabled_auth_methods").get<QoreListNode>(), &xsink);
        if (!xsink) {
            enabled_auth_methods_mask = methods;
        }

        const QoreListNode* q_host_keys = listener->getKeyValue("host_keys").get<QoreListNode>();
        if (q_host_keys) {
            for (size_t i = 0, e = q_host_keys->size(); i < e; ++i) {
                QoreValue q_host_key = q_host_keys->retrieveEntry(i);
                if (q_host_key.getType() == NT_STRING) {
                    QoreStringValueHelper str(q_host_key);
                    host_keys.push_back(str->c_str());
                }
            }
        }
        QoreObject* q_provider = listener->getKeyValue("server_host_key_provider").get<QoreObject>();
        server_host_key_provider = q_provider ? q_provider->objectRefSelf() : nullptr;

        allowed_ciphers = ssh_get_optional_string(listener, "allowed_ciphers");
        allowed_kex = ssh_get_optional_string(listener, "allowed_kex");
        allowed_macs = ssh_get_optional_string(listener, "allowed_macs");
        allowed_hostkey_algorithms = ssh_get_optional_string(listener, "allowed_hostkey_algorithms");

        ExceptionSink cidr_xsink;
        allowed_addresses = ssh_parse_cidr_list(
            listener->getKeyValue("allowed_addresses").get<QoreListNode>(), "allowed_addresses", &cidr_xsink);
        denied_addresses = ssh_parse_cidr_list(
            listener->getKeyValue("denied_addresses").get<QoreListNode>(), "denied_addresses", &cidr_xsink);

        auth_banner = ssh_get_optional_string(listener, "auth_banner");

        if (!listener->getKeyValue("keepalive_interval_seconds").isNothing()) {
            keepalive_interval_seconds = listener->getKeyValue("keepalive_interval_seconds").getAsBigInt();
        }
        if (!listener->getKeyValue("idle_timeout_seconds").isNothing()) {
            idle_timeout_seconds = listener->getKeyValue("idle_timeout_seconds").getAsBigInt();
        }
    }

    SshListenerState(SshListenerState&& other) noexcept : name(std::move(other.name)),
            bind_address(std::move(other.bind_address)), banner(std::move(other.banner)),
            host_keys(std::move(other.host_keys)), port(other.port), bound_port(other.bound_port),
            active_session_counter(std::move(other.active_session_counter)), bind(other.bind),
            last_error(other.last_error), server_host_key_provider(other.server_host_key_provider),
            running(other.running), accept_waiters(other.accept_waiters), max_sessions(other.max_sessions),
            allow_command_service(other.allow_command_service), allow_sftp_service(other.allow_sftp_service),
            enabled_auth_methods_mask(other.enabled_auth_methods_mask),
            allowed_ciphers(std::move(other.allowed_ciphers)), allowed_kex(std::move(other.allowed_kex)),
            allowed_macs(std::move(other.allowed_macs)),
            allowed_hostkey_algorithms(std::move(other.allowed_hostkey_algorithms)),
            allowed_addresses(std::move(other.allowed_addresses)),
            denied_addresses(std::move(other.denied_addresses)),
            auth_banner(std::move(other.auth_banner)),
            keepalive_interval_seconds(other.keepalive_interval_seconds),
            idle_timeout_seconds(other.idle_timeout_seconds) {
        other.bind = nullptr;
        other.last_error = nullptr;
        other.server_host_key_provider = nullptr;
        other.bound_port = 0;
        other.running = false;
        other.accept_waiters = 0;
    }

    SshListenerState& operator=(SshListenerState&& other) noexcept {
        if (this != &other) {
            clear();
            name = std::move(other.name);
            bind_address = std::move(other.bind_address);
            banner = std::move(other.banner);
            host_keys = std::move(other.host_keys);
            port = other.port;
            bound_port = other.bound_port;
            active_session_counter = std::move(other.active_session_counter);
            bind = other.bind;
            last_error = other.last_error;
            server_host_key_provider = other.server_host_key_provider;
            running = other.running;
            accept_waiters = other.accept_waiters;
            max_sessions = other.max_sessions;
            allow_command_service = other.allow_command_service;
            allow_sftp_service = other.allow_sftp_service;
            enabled_auth_methods_mask = other.enabled_auth_methods_mask;
            allowed_ciphers = std::move(other.allowed_ciphers);
            allowed_kex = std::move(other.allowed_kex);
            allowed_macs = std::move(other.allowed_macs);
            allowed_hostkey_algorithms = std::move(other.allowed_hostkey_algorithms);
            allowed_addresses = std::move(other.allowed_addresses);
            denied_addresses = std::move(other.denied_addresses);
            auth_banner = std::move(other.auth_banner);
            keepalive_interval_seconds = other.keepalive_interval_seconds;
            idle_timeout_seconds = other.idle_timeout_seconds;

            other.bind = nullptr;
            other.last_error = nullptr;
            other.server_host_key_provider = nullptr;
            other.bound_port = 0;
            other.running = false;
            other.accept_waiters = 0;
        }
        return *this;
    }

    ~SshListenerState() {
        clear();
    }

    void clear() {
        resetRuntimeState();
        clearLastError();
        if (server_host_key_provider) {
            server_host_key_provider->deref(nullptr);
            server_host_key_provider = nullptr;
        }
    }

    void resetRuntimeState() {
        if (bind) {
            ssh_bind_free(bind);
            bind = nullptr;
        }
        bound_port = 0;
        if (active_session_counter) {
            active_session_counter->store(0);
        }
        running = false;
    }

    void clearLastError() {
        if (last_error) {
            last_error->deref(nullptr);
            last_error = nullptr;
        }
    }

    void setLastError(QoreHashNode* error) {
        clearLastError();
        last_error = error;
    }

    std::string name;
    std::string bind_address;
    std::string banner;
    std::vector<std::string> host_keys;
    int64 port;
    int64 bound_port;
    std::shared_ptr<std::atomic<int64>> active_session_counter;
    ssh_bind bind;
    QoreHashNode* last_error;
    QoreObject* server_host_key_provider;
    bool running;
    int accept_waiters;
    int64 max_sessions;
    bool allow_command_service;
    bool allow_sftp_service;
    int enabled_auth_methods_mask;
    std::string allowed_ciphers;
    std::string allowed_kex;
    std::string allowed_macs;
    std::string allowed_hostkey_algorithms;
    std::vector<SshCidrEntry> allowed_addresses;
    std::vector<SshCidrEntry> denied_addresses;
    std::string auth_banner;
    int64 keepalive_interval_seconds;
    int64 idle_timeout_seconds;
};

class SshUniqueLockUnlocker {
public:
    explicit SshUniqueLockUnlocker(std::unique_lock<std::mutex>& lock) : lock(lock) {
        assert(lock.owns_lock());
        lock.unlock();
    }

    ~SshUniqueLockUnlocker() {
        lock.lock();
    }

private:
    std::unique_lock<std::mutex>& lock;
};

class SshKeyHolder {
public:
    explicit SshKeyHolder(ssh_key key = nullptr) : key(key) {
    }

    SshKeyHolder(SshKeyHolder&& other) noexcept : key(other.key) {
        other.key = nullptr;
    }

    SshKeyHolder& operator=(SshKeyHolder&& other) noexcept {
        if (this != &other) {
            clear();
            key = other.key;
            other.key = nullptr;
        }
        return *this;
    }

    ~SshKeyHolder() {
        clear();
    }

    ssh_key& ref() {
        return key;
    }

    void clear() {
        if (key) {
            ssh_key_free(key);
            key = nullptr;
        }
    }

private:
    ssh_key key;

    SshKeyHolder(const SshKeyHolder&) = delete;
    SshKeyHolder& operator=(const SshKeyHolder&) = delete;
};

class SshServerPriv : public AbstractPrivateData {
public:
    explicit SshServerPriv(const QoreHashNode* config) : config(config ? config->copy() : nullptr), running(false),
            started(nullptr), logger(nullptr),
            active_session_registry(std::make_shared<SshActiveSessionRegistry>()) {
        if (config) {
            QoreObject* q_logger = config->getKeyValue("logger").get<QoreObject>();
            logger = q_logger ? q_logger->objectRefSelf() : nullptr;
        }
        initListenerStates();
    }

    ~SshServerPriv() {
        clearRuntimeState();
        if (config) {
            config->deref(nullptr);
        }
        if (started) {
            started->deref(nullptr);
        }
        if (logger) {
            logger->deref(nullptr);
        }
    }

    void setLogger(const QoreObject* q_logger, ExceptionSink* xsink) {
        ssh_validate_logger(q_logger, "SSHSERVER-LOGGER-ERROR", xsink);
        if (*xsink) {
            return;
        }

        QoreObject* old_logger = nullptr;
        {
            std::lock_guard<std::mutex> lock(logger_mutex);
            old_logger = logger;
            logger = q_logger ? q_logger->objectRefSelf() : nullptr;
        }
        if (old_logger) {
            old_logger->deref(xsink);
        }
    }

    QoreObject* getLogger() const {
        std::lock_guard<std::mutex> lock(logger_mutex);
        return logger ? logger->objectRefSelf() : nullptr;
    }

    void logDetail(const std::string& msg) const {
        ReferenceHolder<QoreObject> logger_holder(getLogger(), nullptr);
        if (!logger_holder) {
            return;
        }
        ssh_log_message(*logger_holder, QORE_LOG_LEVEL_DETAIL, msg);
    }

    void logInfo(const std::string& msg) const {
        ReferenceHolder<QoreObject> logger_holder(getLogger(), nullptr);
        if (!logger_holder) {
            return;
        }
        ssh_log_message(*logger_holder, QORE_LOG_LEVEL_INFO, msg);
    }

    void logWarn(const std::string& msg) const {
        ReferenceHolder<QoreObject> logger_holder(getLogger(), nullptr);
        if (!logger_holder) {
            return;
        }
        ssh_log_message(*logger_holder, QORE_LOG_LEVEL_WARN, msg);
    }

    void logDebug(const std::string& msg) const {
        ReferenceHolder<QoreObject> logger_holder(getLogger(), nullptr);
        if (!logger_holder) {
            return;
        }
        ssh_log_message(*logger_holder, QORE_LOG_LEVEL_DEBUG, msg);
    }

    QoreHashNode* getStatus(ExceptionSink* xsink) const {
        std::lock_guard<std::mutex> lock(mutex);
        ReferenceHolder<QoreHashNode> status(new QoreHashNode(hashdeclSshServerStatus, xsink), xsink);
        status->setKeyValue("name", config ? config->getKeyValue("name").refSelf() : QoreValue(), xsink);
        status->setKeyValue("running", running.load(), xsink);
        status->setKeyValue("listener_count", listenerCount(), xsink);
        status->setKeyValue("active_session_count", activeSessionCount(), xsink);
        status->setKeyValue("started", started ? started->refSelf() : QoreValue(), xsink);
        ReferenceHolder<QoreListNode> listeners(new QoreListNode(hashdeclSshListenerStatus->getTypeInfo(false)), xsink);
        appendListenerStatuses(listeners.operator->(), xsink);
        status->setKeyValue("listeners", listeners.release(), xsink);
        return status.release();
    }

    void initListenerStates() {
        listener_states.clear();
        if (!config) {
            return;
        }

        const QoreListNode* configured_listeners = config->getKeyValue("listeners").get<QoreListNode>();
        if (!configured_listeners) {
            return;
        }

        for (size_t i = 0, e = configured_listeners->size(); i < e; ++i) {
            const QoreHashNode* listener = configured_listeners->retrieveEntry(i).get<QoreHashNode>();
            if (listener) {
                listener_states.emplace_back(listener);
            }
        }
    }

    void appendListenerStatuses(QoreListNode* listeners, ExceptionSink* xsink) const {
        for (const auto& listener : listener_states) {
            ReferenceHolder<QoreHashNode> status(new QoreHashNode(hashdeclSshListenerStatus, xsink), xsink);
            status->setKeyValue("name", new QoreStringNode(listener.name.c_str()), xsink);
            status->setKeyValue("bind_address", new QoreStringNode(listener.bind_address.c_str()), xsink);
            status->setKeyValue("port", listener.port, xsink);
            if (listener.bound_port) {
                status->setKeyValue("bound_port", listener.bound_port, xsink);
            } else {
                status->setKeyValue("bound_port", QoreValue(), xsink);
            }
            status->setKeyValue("running", listener.running, xsink);
            status->setKeyValue("active_session_count",
                listener.active_session_counter ? listener.active_session_counter->load() : 0, xsink);
            status->setKeyValue("last_error", listener.last_error ? listener.last_error->refSelf() : QoreValue(), xsink);
            listeners->push(status.release(), xsink);
            if (*xsink) {
                return;
            }
        }
    }

    int listenerCount() const {
        if (!config) {
            return 0;
        }
        const QoreListNode* listeners = config->getKeyValue("listeners").get<QoreListNode>();
        return listeners ? listeners->size() : 0;
    }

    int64 activeSessionCount() const {
        int64 count = 0;
        for (const auto& listener : listener_states) {
            count += listener.active_session_counter ? listener.active_session_counter->load() : 0;
        }
        return count;
    }

    void clearRuntimeState() {
        std::lock_guard<std::mutex> lock(mutex);
        for (auto& listener : listener_states) {
            listener.resetRuntimeState();
        }
        running.store(false);
        if (started) {
            started->deref(nullptr);
            started = nullptr;
        }
        {
            std::lock_guard<std::mutex> reg_lock(active_session_registry->mutex);
            for (auto& pair : active_session_registry->sessions) {
                if (pair.second) {
                    pair.second->deref(nullptr);
                }
            }
            active_session_registry->sessions.clear();
        }
    }

    int checkHostKeyPathReadable(SshListenerState& listener, const std::string& host_key_path,
            ExceptionSink* xsink) const {
        if (ssh_server_check_fs_access(host_key_path.c_str(), QSEC_READ, xsink)) {
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR",
                "host key file access denied by sandbox policy: \"" + host_key_path + "\""));
            return -1;
        }
        if (access(host_key_path.c_str(), R_OK) != 0) {
            std::string msg = "cannot read host key file \"" + host_key_path + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseErrnoException("SSHLISTENER-START-ERROR", errno, "%s", msg.c_str());
            return -1;
        }
        // Low/Info: warn (do not hard-fail, for deployment compatibility) when the private
        // host key file is accessible by group or other; such a key should be mode 0600.
        struct stat hk_st;
        if (stat(host_key_path.c_str(), &hk_st) == 0 && (hk_st.st_mode & (S_IRWXG | S_IRWXO))) {
            logWarn("host key file \"" + host_key_path + "\" for listener \"" + listener.name
                + "\" is accessible by group/other (mode "
                + std::to_string(hk_st.st_mode & 0777) + " octal-ish); private host keys "
                "should be readable only by the owner (chmod 600)");
        }
        return 0;
    }

    QoreHashNode* makeServerHostKeyProviderContext(const SshListenerState& listener, ExceptionSink* xsink) const {
        ReferenceHolder<QoreHashNode> ctxt(new QoreHashNode(autoTypeInfo), xsink);
        ctxt->setKeyValue("purpose", new QoreStringNode("server-host-key"), xsink);
        ctxt->setKeyValue("listener_name", new QoreStringNode(listener.name.c_str()), xsink);
        ctxt->setKeyValue("original_host", new QoreStringNode(listener.bind_address.c_str()), xsink);
        ctxt->setKeyValue("normalized_host", new QoreStringNode(listener.bind_address.c_str()), xsink);
        ctxt->setKeyValue("port", listener.port, xsink);
        ctxt->setKeyValue("deadline_ns", (int64)0, xsink);
        ctxt->setKeyValue("remaining_ns", (int64)0, xsink);
        if (*xsink) {
            return nullptr;
        }
        return ctxt.release();
    }

    bool getMaterialString(const QoreHashNode* material, const char* key, const char* kind, size_t index,
            std::string& value, ExceptionSink* xsink) const {
        QoreValue v = material->getKeyValue(key);
        if (v.getType() != NT_STRING) {
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider %s material at index %zu has no %s string",
                kind, index, key);
            return false;
        }
        QoreStringValueHelper str(v);
        if (!str->strlen()) {
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider %s material at index %zu has an empty %s string",
                kind, index, key);
            return false;
        }
        value = str->c_str();
        return true;
    }

    bool getOptionalMaterialPassphrase(const QoreHashNode* material, size_t index, std::string& passphrase,
            ExceptionSink* xsink) const {
        QoreValue v = material->getKeyValue("passphrase");
        if (v.isNothing()) {
            return true;
        }
        if (v.getType() != NT_STRING) {
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider material at index %zu has a non-string passphrase", index);
            return false;
        }
        QoreStringValueHelper str(v);
        passphrase = str->c_str();
        return true;
    }

    int importHostKeyFile(SshListenerState& listener, const std::string& host_key_path, const char* passphrase,
            ssh_key& key, ExceptionSink* xsink) const {
        if (ssh_pki_import_privkey_file(host_key_path.c_str(), passphrase, nullptr, nullptr, &key) != SSH_OK) {
            std::string msg = "could not import host key file \"" + host_key_path + "\" for listener \""
                + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }
        return 0;
    }

    int importProviderHostKeyMaterial(SshListenerState& listener, const QoreHashNode* material, size_t index,
            ssh_key& key, ExceptionSink* xsink) const {
        if (!material) {
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider material at index %zu is not a hash", index);
            return -1;
        }

        std::string kind;
        if (!ssh_get_hash_string(material, "kind", kind, xsink)) {
            if (!*xsink) {
                xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                    "server host-key provider material at index %zu has no kind string", index);
            }
            return -1;
        }

        std::string passphrase;
        if (!getOptionalMaterialPassphrase(material, index, passphrase, xsink)) {
            return -1;
        }
        const char* passphrase_ptr = passphrase.empty() ? nullptr : passphrase.c_str();

        if (kind == "file") {
            std::string path;
            if (!getMaterialString(material, "path", "file", index, path, xsink)) {
                return -1;
            }
            if (checkHostKeyPathReadable(listener, path, xsink)) {
                return -1;
            }
            return importHostKeyFile(listener, path, passphrase_ptr, key, xsink);
        }

        std::string private_key_text;
        if (kind == "text") {
            if (!getMaterialString(material, "private_key_text", "text", index, private_key_text, xsink)) {
                return -1;
            }
        } else if (kind == "data") {
            QoreValue private_key_value = material->getKeyValue("private_key_data");
            if (private_key_value.getType() != NT_BINARY) {
                xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                    "server host-key provider data material at index %zu has no private_key_data binary", index);
                return -1;
            }
            const BinaryNode* private_key = private_key_value.get<const BinaryNode>();
            if (!private_key->size()) {
                xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                    "server host-key provider data material at index %zu has no private_key_data binary", index);
                return -1;
            }
            private_key_text.assign(static_cast<const char*>(private_key->getPtr()), private_key->size());
        } else {
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider material at index %zu has unsupported kind \"%s\"",
                index, kind.c_str());
            return -1;
        }

        if (ssh_pki_import_privkey_base64(private_key_text.c_str(), passphrase_ptr, nullptr, nullptr, &key)
                != SSH_OK) {
            std::string msg = "could not import server host-key provider material at index "
                + std::to_string(index) + " for listener \"" + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        return 0;
    }

    int applyImportedHostKey(SshListenerState& listener, ssh_key& key, const std::string& source_desc,
            int& host_key_count, ExceptionSink* xsink) const {
        if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_IMPORT_KEY, key) != SSH_OK) {
            std::string msg = "could not apply " + source_desc + " for listener \""
                + listener.name + "\": " + ssh_get_libssh_error(listener.bind);
            ssh_key_free(key);
            key = nullptr;
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }
        key = nullptr;
        ++host_key_count;
        return 0;
    }

    int loadProviderHostKeys(SshListenerState& listener, std::unique_lock<std::mutex>& lock,
            std::vector<SshKeyHolder>& provider_host_keys, ExceptionSink* xsink) const {
        ReferenceHolder<QoreObject> provider(listener.server_host_key_provider
            ? listener.server_host_key_provider->objectRefSelf() : nullptr, xsink);
        if (!provider) {
            return 0;
        }

        ReferenceHolder<QoreHashNode> ctxt(makeServerHostKeyProviderContext(listener, xsink), xsink);
        if (*xsink) {
            return -1;
        }

        ExceptionSink bxsink;
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &bxsink);
        args->push(ctxt->refSelf(), &bxsink);
        if (bxsink) {
            bxsink.clear();
            xsink->raiseException("SSH-HOSTKEY-PROVIDER-ERROR",
                "could not build arguments for server host-key provider");
            return -1;
        }

        ValueHolder rv(&bxsink);
        {
            SshUniqueLockUnlocker unlocker(lock);
            rv = (*provider)->evalMethod("getServerHostKeyMaterial", *args, &bxsink);
        }
        if (bxsink) {
            bxsink.clear();
            std::string msg = "server host-key provider failed for listener \"" + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSH-HOSTKEY-PROVIDER-ERROR", "%s", msg.c_str());
            return -1;
        }

        if (rv->getType() != NT_LIST) {
            std::string msg = "server host-key provider returned invalid material for listener \""
                + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSH-HOSTKEY-INVALID-RESPONSE",
                "server host-key provider returned %s instead of list", rv->getTypeName());
            return -1;
        }
        const QoreListNode* materials = rv->get<const QoreListNode>();
        if (!materials->size()) {
            std::string msg = "server host-key provider returned no host keys for listener \"" + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        for (size_t i = 0, e = materials->size(); i < e; ++i) {
            if (!(i % 100) && qore_check_cancel(xsink, "loading SSH server host keys from provider")) {
                return -1;
            }
            QoreValue material_value = materials->retrieveEntry(i);
            const QoreHashNode* material = nullptr;
            if (material_value.getType() == NT_HASH) {
                material = material_value.get<const QoreHashNode>();
            }
            SshKeyHolder key;
            if (importProviderHostKeyMaterial(listener, material, i, key.ref(), xsink)) {
                if (!listener.last_error) {
                    std::string msg = "server host-key provider returned invalid material for listener \""
                        + listener.name + "\"";
                    listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
                }
                return -1;
            }
            provider_host_keys.push_back(std::move(key));
        }
        return 0;
    }

    int startListener(SshListenerState& listener, std::unique_lock<std::mutex>& lock, ExceptionSink* xsink) {
        listener.resetRuntimeState();
        listener.clearLastError();

        for (size_t i = 0, e = listener.host_keys.size(); i < e; ++i) {
            if (!(i % 100) && qore_check_cancel(xsink, "checking SSH listener host key files")) {
                return -1;
            }
            const std::string& host_key_path = listener.host_keys[i];
            if (checkHostKeyPathReadable(listener, host_key_path, xsink)) {
                return -1;
            }
        }

        std::vector<SshKeyHolder> provider_host_keys;
        if (loadProviderHostKeys(listener, lock, provider_host_keys, xsink)) {
            return -1;
        }

        listener.bind = ssh_bind_new();
        if (!listener.bind) {
            std::string msg = "could not allocate libssh bind object for listener \"" + listener.name + "\"";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_BINDADDR, listener.bind_address.c_str()) != SSH_OK) {
            std::string msg = "could not set bind address for listener \"" + listener.name + "\": "
                + ssh_get_libssh_error(listener.bind);
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        int port = static_cast<int>(listener.port);
        if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_BINDPORT, &port) != SSH_OK) {
            std::string msg = "could not set bind port for listener \"" + listener.name + "\": "
                + ssh_get_libssh_error(listener.bind);
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        if (!listener.banner.empty()
                && ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_BANNER, listener.banner.c_str()) != SSH_OK) {
            std::string msg = "could not set banner for listener \"" + listener.name + "\": "
                + ssh_get_libssh_error(listener.bind);
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        if (!listener.allowed_ciphers.empty()) {
            if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_CIPHERS_C_S,
                    listener.allowed_ciphers.c_str()) != SSH_OK
                    || ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_CIPHERS_S_C,
                        listener.allowed_ciphers.c_str()) != SSH_OK) {
                std::string msg = "could not set allowed ciphers for listener \"" + listener.name + "\": "
                    + ssh_get_libssh_error(listener.bind);
                listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
                xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
                return -1;
            }
        }

        if (!listener.allowed_macs.empty()) {
            if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_HMAC_C_S,
                    listener.allowed_macs.c_str()) != SSH_OK
                    || ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_HMAC_S_C,
                        listener.allowed_macs.c_str()) != SSH_OK) {
                std::string msg = "could not set allowed MACs for listener \"" + listener.name + "\": "
                    + ssh_get_libssh_error(listener.bind);
                listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
                xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
                return -1;
            }
        }

        if (!listener.allowed_kex.empty()) {
            if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_KEY_EXCHANGE,
                    listener.allowed_kex.c_str()) != SSH_OK) {
                std::string msg = "could not set allowed KEX algorithms for listener \"" + listener.name + "\": "
                    + ssh_get_libssh_error(listener.bind);
                listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
                xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
                return -1;
            }
        }

        if (!listener.allowed_hostkey_algorithms.empty()) {
            if (ssh_bind_options_set(listener.bind, SSH_BIND_OPTIONS_HOSTKEY_ALGORITHMS,
                    listener.allowed_hostkey_algorithms.c_str()) != SSH_OK) {
                std::string msg = "could not set allowed host key algorithms for listener \"" + listener.name + "\": "
                    + ssh_get_libssh_error(listener.bind);
                listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
                xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
                return -1;
            }
        }

        int host_key_count = 0;
        for (size_t i = 0, e = listener.host_keys.size(); i < e; ++i) {
            if (!(i % 100) && qore_check_cancel(xsink, "importing SSH listener host key files")) {
                return -1;
            }
            const std::string& host_key_path = listener.host_keys[i];
            ssh_key key = nullptr;
            if (importHostKeyFile(listener, host_key_path, nullptr, key, xsink)) {
                return -1;
            }
            if (applyImportedHostKey(listener, key, "host key file \"" + host_key_path + "\"",
                    host_key_count, xsink)) {
                return -1;
            }
        }
        for (size_t i = 0, e = provider_host_keys.size(); i < e; ++i) {
            if (!(i % 100) && qore_check_cancel(xsink, "applying SSH server host keys from provider")) {
                return -1;
            }
            if (applyImportedHostKey(listener, provider_host_keys[i].ref(),
                    "server host-key provider material at index " + std::to_string(i), host_key_count, xsink)) {
                return -1;
            }
        }
        if (!host_key_count) {
            std::string msg = "listener \"" + listener.name + "\" has no usable host keys";
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        if (ssh_server_check_bind_access(listener.bind_address, port, xsink)) {
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR",
                "listener bind denied by sandbox network policy: \"" + listener.bind_address
                + ":" + std::to_string(listener.port) + "\""));
            return -1;
        }

        if (ssh_bind_listen(listener.bind) != SSH_OK) {
            std::string msg = "could not listen on \"" + listener.bind_address + ":" + std::to_string(listener.port)
                + "\" for listener \"" + listener.name + "\": " + ssh_get_libssh_error(listener.bind);
            listener.setLastError(ssh_make_exception_info("SSHLISTENER-START-ERROR", msg));
            xsink->raiseException("SSHLISTENER-START-ERROR", "%s", msg.c_str());
            return -1;
        }

        int64 bound_port = ssh_get_bound_port(listener.bind);
        listener.bound_port = bound_port > 0 ? bound_port : listener.port;
        listener.running = true;
        return 0;
    }

    int start(ExceptionSink* xsink) {
        std::unique_lock<std::mutex> lock(mutex);
        if (running.load()) {
            return 0;
        }

        for (auto& listener : listener_states) {
            if (startListener(listener, lock, xsink)) {
                for (auto& started_listener : listener_states) {
                    if (&started_listener != &listener) {
                        started_listener.resetRuntimeState();
                    }
                }
                running.store(false);
                if (started) {
                    started->deref(nullptr);
                    started = nullptr;
                }
                return -1;
            }
        }

        if (started) {
            started->deref(nullptr);
        }
        started = new DateTimeNode(static_cast<int64>(time(nullptr)));
        running.store(true);
        return 0;
    }

    int acceptSessionIntern(int timeout_ms, ssh_session& accepted_session, QoreHashNode*& accepted_info,
            std::shared_ptr<std::atomic<int64>>& active_session_counter, ExceptionSink* xsink) {
        accepted_session = nullptr;
        accepted_info = nullptr;
        active_session_counter.reset();
        if (timeout_ms < 0) {
            xsink->raiseException("SSHSERVER-ACCEPT-ERROR", "timeout_ms must be >= 0; got %d", timeout_ms);
            return -1;
        }
        if (qore_check_cancel(xsink, "waiting for SSH session")) {
            return -1;
        }

        // poll() over all listener fds instead of select()/FD_SET: a listener socket fd can
        // exceed FD_SETSIZE in a busy server, making FD_SET()/select() write out of bounds
        // (UB) — this completes the H-2 select()->poll() conversion (the session wait loops
        // were already converted).  The per-iteration qore_check_cancel() and the
        // QORE_IO_POLL_INTERVAL_MS-capped wait make a long accept timeout interruptible.
        std::set<socket_t> ready_fds;
        int remaining_ms = timeout_ms;
        while (true) {
            if (qore_check_cancel(xsink, "waiting for SSH session")) {
                return -1;
            }

            // phase 1: collect listener fds under the lock
            std::vector<struct pollfd> pfds;
            {
                std::lock_guard<std::mutex> lock(mutex);
                if (!running.load()) {
                    xsink->raiseException("SSHSERVER-STATE-ERROR",
                        "cannot accept a session when the server is not running");
                    return -1;
                }

                for (auto& listener : listener_states) {
                    if (!listener.running || !listener.bind) {
                        continue;
                    }

                    socket_t fd = ssh_bind_get_fd(listener.bind);
                    if (fd == SSH_INVALID_SOCKET) {
                        continue;
                    }

                    struct pollfd pfd;
                    pfd.fd = fd;
                    pfd.events = POLLIN;
                    pfd.revents = 0;
                    pfds.push_back(pfd);
                }

                if (pfds.empty()) {
                    xsink->raiseException("SSHSERVER-STATE-ERROR",
                        "server has no active listeners to accept sessions");
                    return -1;
                }
            }

            // phase 2: poll() without the lock so stop()/getStatus() are not blocked.  The
            // wait is capped at QORE_IO_POLL_INTERVAL_MS and the full timeout_ms is preserved
            // across iterations; timeout_ms == 0 means a single non-blocking poll.
            int chunk = (timeout_ms == 0)
                ? 0
                : (remaining_ms < QORE_IO_POLL_INTERVAL_MS ? remaining_ms : QORE_IO_POLL_INTERVAL_MS);
            int poll_rc = poll(pfds.data(), pfds.size(), chunk);
            if (poll_rc < 0) {
                if (errno == EINTR) {
                    continue;
                }
                xsink->raiseErrnoException("SSHSERVER-ACCEPT-ERROR", errno,
                    "poll() failed while waiting for an incoming SSH session");
                return -1;
            }
            if (poll_rc == 0) {
                if (timeout_ms == 0) {
                    return 0;
                }
                remaining_ms -= chunk;
                if (remaining_ms <= 0) {
                    return 0;
                }
                continue;
            }
            for (const auto& pfd : pfds) {
                if (pfd.revents & (POLLIN | POLLERR | POLLHUP)) {
                    ready_fds.insert(pfd.fd);
                }
            }
            break;
        }

        ssh_bind selected_bind = nullptr;
        std::string selected_listener_name;
        std::shared_ptr<std::atomic<int64>> selected_active_session_counter;
        ssize_t selected_listener_index = -1;
        {
            std::lock_guard<std::mutex> lock(mutex);
            if (!running.load()) {
                return 0;
            }

            for (size_t i = 0, e = listener_states.size(); i < e; ++i) {
                auto& listener = listener_states[i];
                if (!listener.running || !listener.bind) {
                    continue;
                }

                socket_t fd = ssh_bind_get_fd(listener.bind);
                if (fd != SSH_INVALID_SOCKET && ready_fds.count(fd)) {
                    listener.accept_waiters++;
                    selected_listener_index = static_cast<ssize_t>(i);
                    selected_bind = listener.bind;
                    selected_listener_name = listener.name;
                    selected_active_session_counter = listener.active_session_counter;
                    break;
                }
            }
        }

        ON_BLOCK_EXIT([this, selected_listener_index]() {
            if (selected_listener_index < 0) {
                return;
            }

            std::lock_guard<std::mutex> lock(mutex);
            auto& listener = listener_states[static_cast<size_t>(selected_listener_index)];
            --listener.accept_waiters;
            cv.notify_all();
        });

        if (selected_listener_index < 0) {
            return 0;
        }
        if (qore_check_cancel(xsink, "accepting SSH session")) {
            return -1;
        }

        ssh_session session = ssh_new();
        if (!session) {
            xsink->raiseException("SSHSERVER-ACCEPT-ERROR", "could not allocate libssh session");
            return -1;
        }

        if (ssh_bind_accept(selected_bind, session) != SSH_OK) {
            std::string msg = "could not accept incoming SSH session for listener \"" + selected_listener_name
                + "\": " + ssh_get_libssh_error(selected_bind);
            {
                std::lock_guard<std::mutex> lock(mutex);
                listener_states[static_cast<size_t>(selected_listener_index)]
                    .setLastError(ssh_make_exception_info("SSHSERVER-ACCEPT-ERROR", msg));
            }
            xsink->raiseException("SSHSERVER-ACCEPT-ERROR", "%s", msg.c_str());
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        bool reject_for_max_sessions = false;
        int64 max_sessions = -1;
        {
            std::lock_guard<std::mutex> lock(mutex);
            const auto& listener = listener_states[static_cast<size_t>(selected_listener_index)];
            max_sessions = listener.max_sessions;
            if (max_sessions >= 0 && listener.active_session_counter
                    && listener.active_session_counter->load() + listener.accept_waiters > max_sessions) {
                reject_for_max_sessions = true;
            }
        }
        if (reject_for_max_sessions) {
            std::string msg = "listener \"" + selected_listener_name + "\" rejected an incoming SSH session "
                "because max_sessions=" + std::to_string(static_cast<long long>(max_sessions))
                + " was reached";
            logWarn(msg);
            ssh_disconnect(session);
            ssh_free(session);
            return 0;
        }

        // Extract remote address before key exchange for IP filtering
        socket_t session_fd = ssh_get_fd(session);
        if (session_fd == SSH_INVALID_SOCKET) {
            xsink->raiseException("SSHSERVER-ACCEPT-ERROR",
                "could not get the accepted socket for listener \"%s\"", selected_listener_name.c_str());
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        std::string remote_address;
        std::string local_address;
        int64 remote_port = -1;
        int64 local_port = -1;
        if (ssh_get_socket_endpoint(session_fd, true, remote_address, remote_port) != 0) {
            xsink->raiseErrnoException("SSHSERVER-ACCEPT-ERROR", errno,
                "could not get the remote socket address for listener \"%s\"", selected_listener_name.c_str());
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }
        if (ssh_get_socket_endpoint(session_fd, false, local_address, local_port) != 0) {
            xsink->raiseErrnoException("SSHSERVER-ACCEPT-ERROR", errno,
                "could not get the local socket address for listener \"%s\"", selected_listener_name.c_str());
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        // IP allow/deny filtering — before key exchange to minimize resource consumption
        {
            std::lock_guard<std::mutex> lock(mutex);
            const auto& listener = listener_states[static_cast<size_t>(selected_listener_index)];
            if (!listener.denied_addresses.empty()
                    && ssh_ip_matches_cidr_list(remote_address, listener.denied_addresses)) {
                logWarn("listener \"" + selected_listener_name + "\" rejected connection from denied address "
                    + remote_address);
                ssh_disconnect(session);
                ssh_free(session);
                return 0;
            }
            if (!listener.allowed_addresses.empty()
                    && !ssh_ip_matches_cidr_list(remote_address, listener.allowed_addresses)) {
                logWarn("listener \"" + selected_listener_name + "\" rejected connection from non-allowed address "
                    + remote_address);
                ssh_disconnect(session);
                ssh_free(session);
                return 0;
            }
        }

        if (qore_check_cancel(xsink, "performing SSH key exchange")) {
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        // C3: bound the blocking handshake (libssh applies SSH_OPTIONS_TIMEOUT to the
        // handshake socket operations) so a slow/malicious client cannot hang this thread.
        {
            long handshake_timeout = SSH_HANDSHAKE_TIMEOUT_SECONDS;
            ssh_options_set(session, SSH_OPTIONS_TIMEOUT, &handshake_timeout);
        }
        if (ssh_handle_key_exchange(session) != SSH_OK) {
            std::string msg = "SSH key exchange failed for listener \"" + selected_listener_name + "\": "
                + ssh_get_libssh_error(session);
            {
                std::lock_guard<std::mutex> lock(mutex);
                listener_states[static_cast<size_t>(selected_listener_index)]
                    .setLastError(ssh_make_exception_info("SSHSERVER-ACCEPT-ERROR", msg));
            }
            xsink->raiseException("SSHSERVER-ACCEPT-ERROR", "%s", msg.c_str());
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        logDetail("listener \"" + selected_listener_name + "\": key exchange completed for "
            + remote_address + ":" + std::to_string(remote_port));

        int64 now = static_cast<int64>(time(nullptr));
        std::string session_id = selected_listener_name + ":" + std::to_string(static_cast<long long>(now)) + ":"
            + std::to_string(static_cast<long long>(session_fd));
        ReferenceHolder<QoreHashNode> info(new QoreHashNode(hashdeclSshSessionInfo, xsink), xsink);
        info->setKeyValue("session_id", new QoreStringNode(session_id.c_str()), xsink);
        info->setKeyValue("server_name", config ? config->getKeyValue("name").refSelf() : QoreValue(), xsink);
        info->setKeyValue("listener_name", new QoreStringNode(selected_listener_name.c_str()), xsink);
        info->setKeyValue("remote_address", new QoreStringNode(remote_address.c_str()), xsink);
        info->setKeyValue("remote_port", remote_port, xsink);
        info->setKeyValue("local_address", new QoreStringNode(local_address.c_str()), xsink);
        info->setKeyValue("local_port", local_port, xsink);
        info->setKeyValue("username", QoreValue(), xsink);
        info->setKeyValue("authenticated", false, xsink);
        info->setKeyValue("auth_method", QoreValue(), xsink);
        info->setKeyValue("started", new DateTimeNode(now), xsink);
        info->setKeyValue("last_activity", new DateTimeNode(now), xsink);
        if (*xsink) {
            ssh_disconnect(session);
            ssh_free(session);
            return -1;
        }

        accepted_session = session;
        accepted_info = info.release();
        active_session_counter = selected_active_session_counter;
        registerActiveSession(session_id, accepted_info, xsink);
        logInfo("listener \"" + selected_listener_name + "\": accepted session from "
            + remote_address + ":" + std::to_string(remote_port) + " session_id=" + session_id);
        return 1;
    }

    QoreHashNode* callAuthProviderOrCallback(const QoreHashNode* auth_context_info, ExceptionSink* xsink) const {
        ReferenceHolder<QoreListNode> call_args(new QoreListNode(autoTypeInfo), xsink);
        call_args->push(auth_context_info->refSelf(), xsink);
        if (*xsink) {
            return nullptr;
        }

        QoreValue rv;
        if (const QoreObject* auth_provider
                = config ? config->getKeyValue("auth_provider").get<QoreObject>() : nullptr) {
            rv = const_cast<QoreObject*>(auth_provider)->evalMethod("authenticate", *call_args, xsink);
        } else if (const ResolvedCallReferenceNode* auth_callback = config
                ? config->getKeyValue("auth_callback").get<const ResolvedCallReferenceNode>() : nullptr) {
            rv = const_cast<ResolvedCallReferenceNode*>(auth_callback)->execValue(*call_args, xsink);
        } else {
            std::string server_name("<unknown>");
            if (config) {
                QoreValue name_value = config->getKeyValue("name");
                if (name_value.getType() == NT_STRING) {
                    QoreStringValueHelper name(name_value);
                    server_name = name->c_str();
                }
            }
            xsink->raiseException("SSHSERVER-AUTH-ERROR",
                "server \"%s\" has no configured auth provider or auth callback",
                server_name.c_str());
            return nullptr;
        }

        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* decision = rv.get<QoreHashNode>();
        if (!decision) {
            rv.discard(xsink);
            xsink->raiseException("SSHSERVER-AUTH-ERROR",
                "the auth callback must return a hash<SshAuthDecision>");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_decision(
            reinterpret_cast<QoreHashNode*>(hashdeclSshAuthDecision->doRuntimeCast(decision, xsink)), xsink);
        rv.discard(xsink);
        return *xsink ? nullptr : typed_decision.release();
    }

    QoreHashNode* callCommandCallback(const QoreHashNode* command_request, ExceptionSink* xsink) const {
        assert(command_request);
        const ResolvedCallReferenceNode* command_callback
            = config ? config->getKeyValue("command_callback").get<const ResolvedCallReferenceNode>() : nullptr;
        if (!command_callback) {
            return makeDeniedCommandResult("no command callback configured", xsink);
        }

        ReferenceHolder<QoreListNode> call_args(new QoreListNode(autoTypeInfo), xsink);
        call_args->push(command_request->refSelf(), xsink);
        if (*xsink) {
            return nullptr;
        }

        QoreValue rv = const_cast<ResolvedCallReferenceNode*>(command_callback)->execValue(*call_args, xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* result = rv.get<QoreHashNode>();
        if (!result) {
            rv.discard(xsink);
            xsink->raiseException("SSHSERVER-COMMAND-ERROR",
                "the command callback must return a hash<SshCommandResult>");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_result(
            reinterpret_cast<QoreHashNode*>(hashdeclSshCommandResult->doRuntimeCast(result, xsink)), xsink);
        rv.discard(xsink);
        return *xsink ? nullptr : typed_result.release();
    }

    QoreHashNode* callSftpFactoryCallback(const QoreHashNode* sftp_session_info, ExceptionSink* xsink) const {
        assert(sftp_session_info);
        const ResolvedCallReferenceNode* sftp_factory_callback
            = config ? config->getKeyValue("sftp_factory_callback").get<const ResolvedCallReferenceNode>() : nullptr;
        if (!sftp_factory_callback) {
            return nullptr;
        }

        ReferenceHolder<QoreListNode> call_args(new QoreListNode(autoTypeInfo), xsink);
        call_args->push(sftp_session_info->refSelf(), xsink);
        if (*xsink) {
            return nullptr;
        }

        QoreValue rv = const_cast<ResolvedCallReferenceNode*>(sftp_factory_callback)->execValue(*call_args, xsink);
        if (*xsink) {
            return nullptr;
        }
        if (rv.isNothing()) {
            return nullptr;
        }

        const QoreHashNode* result = rv.get<QoreHashNode>();
        if (!result) {
            rv.discard(xsink);
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "the sftp factory callback must return a hash or NOTHING");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> copied_result(reinterpret_cast<QoreHashNode*>(result->copy()), xsink);
        rv.discard(xsink);
        return *xsink ? nullptr : copied_result.release();
    }

    QoreHashNode* callSftpPathPolicyCallback(const QoreHashNode* transfer_request, ExceptionSink* xsink) const {
        assert(transfer_request);
        const QoreHashNode* sftp_config = config ? config->getKeyValue("sftp_config").get<QoreHashNode>() : nullptr;
        const ResolvedCallReferenceNode* path_policy_callback
            = sftp_config ? sftp_config->getKeyValue("path_policy_callback").get<const ResolvedCallReferenceNode>()
                          : nullptr;
        if (!path_policy_callback) {
            return nullptr;
        }

        ReferenceHolder<QoreListNode> call_args(new QoreListNode(autoTypeInfo), xsink);
        call_args->push(transfer_request->refSelf(), xsink);
        if (*xsink) {
            return nullptr;
        }

        QoreValue rv = const_cast<ResolvedCallReferenceNode*>(path_policy_callback)->execValue(*call_args, xsink);
        if (*xsink) {
            return nullptr;
        }
        if (rv.isNothing()) {
            return nullptr;
        }

        const QoreHashNode* result = rv.get<QoreHashNode>();
        if (!result) {
            rv.discard(xsink);
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "the path policy callback must return a hash<SftpTransferDecision> or NOTHING");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_result(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpTransferDecision->doRuntimeCast(result, xsink)), xsink);
        rv.discard(xsink);
        return *xsink ? nullptr : typed_result.release();
    }

    QoreHashNode* makeDeniedCommandResult(const char* message, ExceptionSink* xsink) const {
        ReferenceHolder<QoreHashNode> result(new QoreHashNode(hashdeclSshCommandResult, xsink), xsink);
        result->setKeyValue("accepted", false, xsink);
        result->setKeyValue("exit_status", QoreValue(), xsink);
        result->setKeyValue("message", message ? new QoreStringNode(message) : QoreValue(), xsink);
        result->setKeyValue("stdout", QoreValue(), xsink);
        result->setKeyValue("stderr", QoreValue(), xsink);
        result->setKeyValue("result_data", QoreValue(), xsink);
        return *xsink ? nullptr : result.release();
    }

    QoreHashNode* makeDefaultSftpTransferDecision(const QoreHashNode* transfer_request, ExceptionSink* xsink) const {
        assert(transfer_request);
        const QoreHashNode* session_info = transfer_request->getKeyValue("session_info").get<QoreHashNode>();
        if (!session_info) {
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "transfer requests must include typed session_info metadata");
            return nullptr;
        }

        QoreValue operation_value = transfer_request->getKeyValue("operation");
        QoreValue path_value = transfer_request->getKeyValue("path");
        if (operation_value.getType() != NT_STRING || path_value.getType() != NT_STRING) {
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "transfer requests must include non-empty operation and path values");
            return nullptr;
        }
        QoreStringValueHelper operation_node(operation_value);
        QoreStringValueHelper path_node(path_value);
        if (!path_node->strlen()) {
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "transfer requests must include non-empty operation and path values");
            return nullptr;
        }

        std::string operation = operation_node->c_str();
        std::string path = path_node->c_str();
        bool write_operation = ssh_sftp_operation_is_write(operation);
        bool read_only = session_info->getKeyValue("read_only").getAsBool();
        if (*xsink) {
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "transfer session_info.read_only must be a boolean");
            return nullptr;
        }

        std::string normalized_path;
        if (!ssh_sftp_normalize_virtual_path(path, normalized_path)) {
            ReferenceHolder<QoreHashNode> denied(new QoreHashNode(hashdeclSftpTransferDecision, xsink), xsink);
            ReferenceHolder<QoreHashNode> transfer_info(new QoreHashNode(hashdeclSftpTransferInfo, xsink), xsink);
            transfer_info->setKeyValue("operation", transfer_request->getKeyValue("operation").refSelf(), xsink);
            transfer_info->setKeyValue("path", transfer_request->getKeyValue("path").refSelf(), xsink);
            transfer_info->setKeyValue("temporary_path", QoreValue(), xsink);
            transfer_info->setKeyValue("final_path", QoreValue(), xsink);
            transfer_info->setKeyValue("size", transfer_request->getKeyValue("size").refSelf(), xsink);
            transfer_info->setKeyValue("checksum", QoreValue(), xsink);
            transfer_info->setKeyValue("atomic_publish", false, xsink);
            transfer_info->setKeyValue("completed", false, xsink);
            denied->setKeyValue("allowed", false, xsink);
            denied->setKeyValue("message", new QoreStringNode("path escapes the configured SFTP root"), xsink);
            denied->setKeyValue("transfer_info", transfer_info.release(), xsink);
            return *xsink ? nullptr : denied.release();
        }

        std::string normalized_target_path;
        QoreValue target_path_value = transfer_request->getKeyValue("target_path");
        if (target_path_value.getType() == NT_STRING) {
            QoreStringValueHelper target_path_node(target_path_value);
            if (target_path_node->strlen()
                    && !ssh_sftp_normalize_virtual_path(target_path_node->c_str(), normalized_target_path)) {
                ReferenceHolder<QoreHashNode> denied(new QoreHashNode(hashdeclSftpTransferDecision, xsink), xsink);
                ReferenceHolder<QoreHashNode> transfer_info(new QoreHashNode(hashdeclSftpTransferInfo, xsink), xsink);
                transfer_info->setKeyValue("operation", transfer_request->getKeyValue("operation").refSelf(), xsink);
                transfer_info->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
                transfer_info->setKeyValue("temporary_path", QoreValue(), xsink);
                transfer_info->setKeyValue("final_path", QoreValue(), xsink);
                transfer_info->setKeyValue("size", transfer_request->getKeyValue("size").refSelf(), xsink);
                transfer_info->setKeyValue("checksum", QoreValue(), xsink);
                transfer_info->setKeyValue("atomic_publish", false, xsink);
                transfer_info->setKeyValue("completed", false, xsink);
                denied->setKeyValue("allowed", false, xsink);
                denied->setKeyValue("message",
                    new QoreStringNode("target path escapes the configured SFTP root"), xsink);
                denied->setKeyValue("transfer_info", transfer_info.release(), xsink);
                return *xsink ? nullptr : denied.release();
            }
            if (!target_path_node->strlen()) {
                normalized_target_path = normalized_path;
            }
        } else {
            normalized_target_path = normalized_path;
        }

        const QoreHashNode* sftp_config = config ? config->getKeyValue("sftp_config").get<QoreHashNode>() : nullptr;
        const QoreHashNode* atomic_publish_policy
            = sftp_config ? sftp_config->getKeyValue("atomic_publish_policy").get<QoreHashNode>() : nullptr;
        bool atomic_publish_enabled = false;
        if (atomic_publish_policy && atomic_publish_policy->getKeyValue("enabled").getType() != NT_NOTHING) {
            atomic_publish_enabled = atomic_publish_policy->getKeyValue("enabled").getAsBool();
            if (*xsink) {
                xsink->raiseException("SSHSERVER-SFTP-ERROR",
                    "the atomic publish policy \"enabled\" key must be a boolean");
                return nullptr;
            }
        }
        atomic_publish_enabled = atomic_publish_enabled && write_operation;

        std::string temporary_suffix(".part");
        if (atomic_publish_policy) {
            QoreValue temporary_suffix_value = atomic_publish_policy->getKeyValue("temporary_suffix");
            if (temporary_suffix_value.getType() == NT_STRING) {
                QoreStringValueHelper temporary_suffix_node(temporary_suffix_value);
                if (temporary_suffix_node->strlen()) {
                    temporary_suffix = temporary_suffix_node->c_str();
                }
            }
        }

        std::string normalized_temporary_path;
        bool has_temporary_path = false;
        QoreValue temporary_path_value = transfer_request->getKeyValue("temporary_path");
        if (temporary_path_value.getType() == NT_STRING) {
            QoreStringValueHelper temporary_path_node(temporary_path_value);
            has_temporary_path = temporary_path_node->strlen();
            if (has_temporary_path) {
                if (!ssh_sftp_normalize_virtual_path(temporary_path_node->c_str(), normalized_temporary_path)) {
                    ReferenceHolder<QoreHashNode> denied(new QoreHashNode(hashdeclSftpTransferDecision, xsink), xsink);
                    ReferenceHolder<QoreHashNode> transfer_info(new QoreHashNode(hashdeclSftpTransferInfo, xsink), xsink);
                    transfer_info->setKeyValue("operation", transfer_request->getKeyValue("operation").refSelf(), xsink);
                    transfer_info->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
                    transfer_info->setKeyValue("temporary_path", QoreValue(), xsink);
                    transfer_info->setKeyValue("final_path", QoreValue(), xsink);
                    transfer_info->setKeyValue("size", transfer_request->getKeyValue("size").refSelf(), xsink);
                    transfer_info->setKeyValue("checksum", QoreValue(), xsink);
                    transfer_info->setKeyValue("atomic_publish", false, xsink);
                    transfer_info->setKeyValue("completed", false, xsink);
                    denied->setKeyValue("allowed", false, xsink);
                    denied->setKeyValue("message",
                        new QoreStringNode("temporary path escapes the configured SFTP root"), xsink);
                    denied->setKeyValue("transfer_info", transfer_info.release(), xsink);
                    return *xsink ? nullptr : denied.release();
                }
            }
        }
        if (!has_temporary_path && atomic_publish_enabled) {
            normalized_temporary_path = normalized_target_path + temporary_suffix;
        }

        std::string root_dir;
        QoreValue root_dir_value = session_info->getKeyValue("root_dir");
        if (root_dir_value.getType() == NT_STRING) {
            QoreStringValueHelper root_dir_node(root_dir_value);
            root_dir = root_dir_node->c_str();
        }

        ReferenceHolder<QoreHashNode> transfer_info(new QoreHashNode(hashdeclSftpTransferInfo, xsink), xsink);
        transfer_info->setKeyValue("operation", new QoreStringNode(operation.c_str()), xsink);
        transfer_info->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        transfer_info->setKeyValue("temporary_path",
            normalized_temporary_path.empty() ? QoreValue() : QoreValue(new QoreStringNode(
                ssh_sftp_join_root_path(root_dir, normalized_temporary_path).c_str())), xsink);
        transfer_info->setKeyValue("final_path",
            new QoreStringNode(ssh_sftp_join_root_path(root_dir, normalized_target_path).c_str()), xsink);
        transfer_info->setKeyValue("size", transfer_request->getKeyValue("size").refSelf(), xsink);
        transfer_info->setKeyValue("checksum", QoreValue(), xsink);
        transfer_info->setKeyValue("atomic_publish", atomic_publish_enabled, xsink);
        transfer_info->setKeyValue("completed", false, xsink);
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> decision(new QoreHashNode(hashdeclSftpTransferDecision, xsink), xsink);
        if (read_only && write_operation) {
            decision->setKeyValue("allowed", false, xsink);
            decision->setKeyValue("message", new QoreStringNode("write operation denied for read-only SFTP session"),
                xsink);
        } else {
            decision->setKeyValue("allowed", true, xsink);
            decision->setKeyValue("message", QoreValue(), xsink);
        }
        decision->setKeyValue("transfer_info", transfer_info.release(), xsink);
        return *xsink ? nullptr : decision.release();
    }

    QoreHashNode* mergeSftpTransferDecision(const QoreHashNode* base_decision, const QoreHashNode* override_decision,
            ExceptionSink* xsink) const {
        assert(base_decision);
        if (!override_decision) {
            return reinterpret_cast<QoreHashNode*>(base_decision->copy());
        }

        ReferenceHolder<QoreHashNode> merged(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpTransferDecision->doRuntimeCast(base_decision, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        if (override_decision->existsKey("allowed")) {
            bool allowed = override_decision->getKeyValue("allowed").getAsBool();
            if (*xsink) {
                xsink->raiseException("SSHSERVER-SFTP-ERROR",
                    "the transfer decision \"allowed\" key must be a boolean when present");
                return nullptr;
            }
            merged->setKeyValue("allowed", allowed, xsink);
        }
        if (override_decision->existsKey("message")) {
            merged->setKeyValue("message", override_decision->getKeyValue("message").refSelf(), xsink);
        }
        if (override_decision->existsKey("transfer_info")) {
            const QoreHashNode* transfer_info = override_decision->getKeyValue("transfer_info").get<QoreHashNode>();
            if (!transfer_info) {
                xsink->raiseException("SSHSERVER-SFTP-ERROR",
                    "the transfer decision \"transfer_info\" key must be a hash<SftpTransferInfo> when present");
                return nullptr;
            }
            ReferenceHolder<QoreHashNode> typed_transfer_info(reinterpret_cast<QoreHashNode*>(
                hashdeclSftpTransferInfo->doRuntimeCast(transfer_info, xsink)), xsink);
            if (*xsink) {
                return nullptr;
            }
            merged->setKeyValue("transfer_info", typed_transfer_info.release(), xsink);
        }

        return *xsink ? nullptr : merged.release();
    }

    const SshListenerState* findListenerState(const char* listener_name) const {
        if (!listener_name) {
            return nullptr;
        }

        for (const auto& listener : listener_states) {
            if (listener.name == listener_name) {
                return &listener;
            }
        }

        return nullptr;
    }

    QoreHashNode* authorizeCommandRequest(const QoreHashNode* session_info, const QoreHashNode* command_request,
            ExceptionSink* xsink) const {
        assert(session_info);
        assert(command_request);

        if (!session_info->getKeyValue("authenticated").getAsBool()) {
            return makeDeniedCommandResult("the session is not authenticated", xsink);
        }
        if (*xsink) {
            xsink->raiseException("SSHSERVER-COMMAND-ERROR",
                "the session \"authenticated\" key must be a boolean");
            return nullptr;
        }

        const QoreHashNode* policy = session_info->getKeyValue("command_policy").get<QoreHashNode>();
        if (!policy) {
            return makeDeniedCommandResult("command access is denied by default", xsink);
        }

        const QoreHashNode* metadata = command_request->getKeyValue("metadata").get<QoreHashNode>();
        std::string request_type_str("exec");
        if (metadata) {
            QoreValue request_type = metadata->getKeyValue("request_type");
            if (request_type.getType() == NT_STRING) {
                QoreStringValueHelper str(request_type);
                request_type_str = str->c_str();
            }
        }
        std::string listener_name_str;
        QoreValue listener_name = session_info->getKeyValue("listener_name");
        if (listener_name.getType() == NT_STRING) {
            QoreStringValueHelper str(listener_name);
            listener_name_str = str->c_str();
        }
        const SshListenerState* listener = findListenerState(listener_name_str.empty() ? nullptr : listener_name_str.c_str());
        std::string policy_mode_str;
        QoreValue policy_mode = policy->getKeyValue("mode");
        if (policy_mode.getType() == NT_STRING) {
            QoreStringValueHelper str(policy_mode);
            policy_mode_str = str->c_str();
        }

        if (request_type_str == "exec") {
            if (listener && !listener->allow_command_service) {
                return makeDeniedCommandResult("the listener does not allow command execution", xsink);
            }
            if (policy_mode_str != "command-only" && policy_mode_str != "command-and-subsystem") {
                return makeDeniedCommandResult(
                    "the session command policy does not allow command execution", xsink);
            }
            return callCommandCallback(command_request, xsink);
        }

        if (request_type_str != "subsystem") {
            return makeDeniedCommandResult("unsupported channel request type", xsink);
        }

        if (policy_mode_str != "subsystem-only" && policy_mode_str != "command-and-subsystem") {
            return makeDeniedCommandResult(
                "the session command policy does not allow subsystem execution", xsink);
        }

        std::string subsystem;
        if (metadata) {
            QoreValue subsystem_value = metadata->getKeyValue("subsystem");
            if (subsystem_value.getType() == NT_STRING) {
                QoreStringValueHelper str(subsystem_value);
                subsystem = str->c_str();
            }
        }
        if (subsystem.empty()) {
            return makeDeniedCommandResult("the subsystem request is missing a subsystem name", xsink);
        }

        if (listener) {
            if (subsystem == "sftp") {
                if (!listener->allow_sftp_service) {
                    return makeDeniedCommandResult("the listener does not allow the sftp service", xsink);
                }
            } else if (!listener->allow_command_service) {
                return makeDeniedCommandResult("the listener does not allow subsystem execution", xsink);
            }
        }

        bool allow_all_subsystems = policy->getKeyValue("allow_all_subsystems").getAsBool();
        if (*xsink) {
            xsink->raiseException("SSHSERVER-COMMAND-ERROR",
                "the session command policy key \"allow_all_subsystems\" must be a boolean when present");
            return nullptr;
        }

        const QoreListNode* allowed_subsystems = policy->getKeyValue("allowed_subsystems").get<QoreListNode>();
        if (!allow_all_subsystems && !ssh_string_in_list(allowed_subsystems, subsystem.c_str())) {
            return makeDeniedCommandResult("the requested subsystem is not allowed", xsink);
        }

        return callCommandCallback(command_request, xsink);
    }

    QoreHashNode* acceptSessionInfo(int timeout_ms, ExceptionSink* xsink) {
        ssh_session session = nullptr;
        QoreHashNode* info = nullptr;
        std::shared_ptr<std::atomic<int64>> active_session_counter;
        int rc = acceptSessionIntern(timeout_ms, session, info, active_session_counter, xsink);
        if (rc <= 0) {
            return nullptr;
        }

        ON_BLOCK_EXIT([session]() {
            ssh_disconnect(session);
            ssh_free(session);
        });
        // this transient path returns only the info hash and never creates a live SshSession,
        // so nothing else would ever remove its registry entry: unregister it now (H-4)
        if (info) {
            QoreValue sid = info->getKeyValue("session_id");
            if (sid.getType() == NT_STRING) {
                QoreStringValueHelper str(sid);
                unregisterActiveSession(str->c_str());
            }
        }
        return info;
    }

    void stop() {
        {
            std::unique_lock<std::mutex> lock(mutex);
            running.store(false);
            cv.wait(lock, [this]() {
                for (const auto& listener : listener_states) {
                    if (listener.accept_waiters) {
                        return false;
                    }
                }
                return true;
            });
            for (auto& listener : listener_states) {
                listener.resetRuntimeState();
                listener.clearLastError();
            }
            if (started) {
                started->deref(nullptr);
                started = nullptr;
            }
        }
        logInfo("SshServer stopped");
    }

    void registerActiveSession(const std::string& session_id, QoreHashNode* session_info, ExceptionSink* xsink) {
        ReferenceHolder<QoreHashNode> snapshot(session_info ? session_info->copy() : nullptr, xsink);
        std::lock_guard<std::mutex> lock(active_session_registry->mutex);
        if (active_session_registry->sessions.find(session_id) != active_session_registry->sessions.end()) {
            return;
        }
        active_session_registry->sessions[session_id] = snapshot.release();
    }

    void unregisterActiveSession(const std::string& session_id) {
        QoreHashNode* old_info = nullptr;
        {
            std::lock_guard<std::mutex> lock(active_session_registry->mutex);
            auto it = active_session_registry->sessions.find(session_id);
            if (it != active_session_registry->sessions.end()) {
                old_info = it->second;
                active_session_registry->sessions.erase(it);
            }
        }
        if (old_info) {
            old_info->deref(nullptr);
        }
    }

    QoreListNode* listActiveSessions(ExceptionSink* xsink) {
        std::lock_guard<std::mutex> lock(active_session_registry->mutex);
        ReferenceHolder<QoreListNode> result(
            new QoreListNode(hashdeclSshActiveSessionInfo->getTypeInfo(false)), xsink);
        for (const auto& pair : active_session_registry->sessions) {
            if (!pair.second) {
                continue;
            }
            ReferenceHolder<QoreHashNode> entry(new QoreHashNode(hashdeclSshActiveSessionInfo, xsink), xsink);
            entry->setKeyValue("session_id", pair.second->getKeyValue("session_id").refSelf(), xsink);
            entry->setKeyValue("remote_address", pair.second->getKeyValue("remote_address").refSelf(), xsink);
            entry->setKeyValue("remote_port", pair.second->getKeyValue("remote_port").refSelf(), xsink);
            entry->setKeyValue("username", pair.second->getKeyValue("username").refSelf(), xsink);
            entry->setKeyValue("principal", pair.second->getKeyValue("principal").refSelf(), xsink);
            entry->setKeyValue("auth_method", pair.second->getKeyValue("auth_method").refSelf(), xsink);
            entry->setKeyValue("started", pair.second->getKeyValue("started").refSelf(), xsink);
            entry->setKeyValue("last_activity", pair.second->getKeyValue("last_activity").refSelf(), xsink);
            entry->setKeyValue("bytes_read", (int64)0, xsink);
            entry->setKeyValue("bytes_written", (int64)0, xsink);
            entry->setKeyValue("sftp_operations", (int64)0, xsink);
            if (*xsink) {
                return nullptr;
            }
            result->push(entry.release(), xsink);
        }
        return result.release();
    }

    QoreHashNode* config;
    std::vector<SshListenerState> listener_states;
    mutable std::mutex mutex;
    mutable std::condition_variable cv;
    // dedicated leaf lock for the logger member: getLogger()/logWarn()/logInfo()/... are
    // called from contexts that already hold `mutex` (e.g. start()->startListener()), so the
    // logger must NOT be guarded by `mutex` or those log calls would self-deadlock on the
    // non-recursive mutex
    mutable std::mutex logger_mutex;
    std::atomic<bool> running;
    DateTimeNode* started;
    QoreObject* logger;
    //! shared so each live SshSession can hold a weak_ptr and unregister itself on disconnect
    std::shared_ptr<SshActiveSessionRegistry> active_session_registry;
};

//! Server-side SSH listener manager
/** This class provides listener configuration validation, libssh bind/listen
    bootstrap, and status reporting for one or more SSH listeners.

    @since ssh 0.1
*/
qclass SshServer [arg=SshServerPriv* priv; ns=Qore::Ssh; dom=NETWORK; flags=final];

//! Creates the SshServer object from a configuration hash
/** @param config the server configuration hash

    @par Example:
    @code{.py}
hash<SshServerConfig> config = <SshServerConfig>{
    "name": "my-ssh-server",
    "listeners": (<SshListenerConfig>{
        "name": "main",
        "bind_address": "0.0.0.0",
        "port": 2222,
        "host_keys": ("/etc/ssh/ssh_host_rsa_key",),
    },),
};
SshServer server(config);
    @endcode
 */
SshServer::constructor(hash<SshServerConfig> config) [flags=NAMED_ARGS] {
    ssh_validate_server_config(config, xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_SSHSERVER, new SshServerPriv(config));
}

//! Throws an exception; SshServer objects cannot be copied
/** @throw SSHSERVER-COPY-ERROR copying SshServer objects is not supported
 */
SshServer::copy() {
    xsink->raiseException("SSHSERVER-COPY-ERROR", "copying SshServer objects is not supported");
}

//! Destroys the SshServer object
/** Releases private resources held by the server object.
 */
SshServer::destructor() {
    priv->deref();
}

//! Starts the SSH server
/** Starts configured listeners using libssh and marks the server as running.

    @par Example:
    @code{.py}
SshServer server(config);
server.start();
assertTrue(server.running());
    @endcode

 */
nothing SshServer::start() {
    priv->start(xsink);
    if (!*xsink && priv->running.load()) {
        priv->logInfo("SshServer started");
    }
}

//! Stops the SSH server
/** Stops the server and releases all active listener binds.

    @par Example:
    @code{.py}
server.stop();
assertFalse(server.running());
    @endcode

 */
nothing SshServer::stop() {
    priv->stop();
}

//! Accepts a single inbound SSH transport and returns typed session metadata
/** Waits up to `timeout_ms` milliseconds for an incoming connection on any
    active listener, performs `ssh_bind_accept()` and the initial SSH key
    exchange, then returns a `SshSessionInfo` snapshot for the accepted
    transport. The transient libssh session is then disconnected and freed.

    @return a `SshSessionInfo` typed hash when a connection is accepted, or
    `NOTHING` on timeout

    @par Example:
    @code{.py}
hash<SshSessionInfo> info = server.acceptSessionInfo(5000);
printf("accepted %y:%d on %y\n", info.remote_address, info.remote_port, info.listener_name);
    @endcode
 */
*hash<SshSessionInfo> SshServer::acceptSessionInfo(int timeout_ms = 0) [flags=NAMED_ARGS] {
    return priv->acceptSessionInfo(timeout_ms, xsink);
}

//! Accepts a single inbound SSH transport and returns a live SshSession object
/** Waits up to `timeout_ms` milliseconds for an incoming connection on any
    active listener, performs `ssh_bind_accept()` and the initial SSH key
    exchange, then returns a live `SshSession` wrapper for the accepted
    transport. Returns `NOTHING` on timeout.

    @return a live `SshSession` object or `NOTHING` on timeout
 */
*SshSession SshServer::acceptSession(int timeout_ms = 0) [flags=NAMED_ARGS] {
    ssh_session session = nullptr;
    QoreHashNode* info = nullptr;
    std::shared_ptr<std::atomic<int64>> active_session_counter;
    int rc = priv->acceptSessionIntern(timeout_ms, session, info, active_session_counter, xsink);
    if (rc <= 0) {
        return QoreValue();
    }

    if (active_session_counter) {
        active_session_counter->fetch_add(1);
    }
    int enabled_auth_methods_mask = SSH_AUTH_METHOD_NONE | SSH_AUTH_METHOD_PASSWORD | SSH_AUTH_METHOD_PUBLICKEY
        | SSH_AUTH_METHOD_INTERACTIVE;
    int64 keepalive_interval = -1;
    int64 idle_timeout = -1;
    std::string listener_name;
    if (info) {
        QoreValue listener_name_value = info->getKeyValue("listener_name");
        if (listener_name_value.getType() == NT_STRING) {
            QoreStringValueHelper str(listener_name_value);
            listener_name = str->c_str();
        }
    }
    if (!listener_name.empty()) {
        const SshListenerState* listener = priv->findListenerState(listener_name.c_str());
        if (listener) {
            enabled_auth_methods_mask = listener->enabled_auth_methods_mask;
            keepalive_interval = listener->keepalive_interval_seconds;
            idle_timeout = listener->idle_timeout_seconds;
        }
    }
    // capture the session id before info ownership transfers into the session object
    std::string registry_session_id;
    if (info) {
        QoreValue sid = info->getKeyValue("session_id");
        if (sid.getType() == NT_STRING) {
            QoreStringValueHelper str(sid);
            registry_session_id = str->c_str();
        }
    }
    ReferenceHolder<QoreObject> logger(priv->getLogger(), xsink);
    QoreObject* obj = ssh_new_session_object(getProgram(), info, nullptr, logger.release(), session,
        active_session_counter, enabled_auth_methods_mask, keepalive_interval, idle_timeout, xsink);
    if (*xsink && active_session_counter) {
        active_session_counter->fetch_sub(1);
    }
    if (obj && !*xsink && !registry_session_id.empty()) {
        // bind the live session to the registry so it unregisters itself deterministically on
        // disconnect; without this the active_sessions map would grow without bound (H-4)
        ssh_session_set_registry(obj, priv->active_session_registry, registry_session_id);
    }
    return obj;
}

//! Authenticates a live session using the configured auth provider or callback
/** Waits for an authentication request on the session, invokes the configured
    `auth_provider` or `auth_callback`, applies the returned `SshAuthDecision`
    to the live auth request, and updates the session's public authentication
    state.

    @param session the live session to authenticate
    @param timeout_ms the maximum time in milliseconds to wait for the next
    authentication request; 0 means wait indefinitely
    @return the typed authentication decision applied to the session or
    `NOTHING` on timeout
 */
*hash<SshAuthDecision> SshServer::authenticateSession(SshSession session, int timeout_ms = 0) [flags=NAMED_ARGS] {
    // Send auth banner if configured for the session's listener
    {
        ReferenceHolder<QoreHashNode> session_info(ssh_session_get_info(session, xsink), xsink);
        if (!*xsink && session_info) {
            QoreValue listener_name_value = session_info->getKeyValue("listener_name");
            if (listener_name_value.getType() == NT_STRING) {
                QoreStringValueHelper listener_name(listener_name_value);
                const SshListenerState* listener = priv->findListenerState(listener_name->c_str());
                if (listener && !listener->auth_banner.empty()) {
                    ssh_session_send_banner(session, listener->auth_banner, xsink);
                    if (*xsink) {
                        return QoreValue();
                    }
                    std::string session_id("<unknown>");
                    QoreValue session_id_value = session_info->getKeyValue("session_id");
                    if (session_id_value.getType() == NT_STRING) {
                        QoreStringValueHelper str(session_id_value);
                        session_id = str->c_str();
                    }
                    priv->logDetail("session "
                        + session_id
                        + ": auth banner sent");
                }
            }
        }
        if (*xsink) {
            return QoreValue();
        }
    }
    while (true) {
        QoreObject* auth = ssh_session_wait_auth_context(session, getProgram(), timeout_ms, xsink);
        ReferenceHolder<QoreObject> auth_holder(auth, xsink);
        if (*xsink || !auth) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> auth_info(ssh_auth_context_get_info(auth, xsink), xsink);
        if (*xsink) {
            return QoreValue();
        }

        ReferenceHolder<QoreHashNode> decision(priv->callAuthProviderOrCallback(*auth_info, xsink), xsink);
        if (*xsink) {
            return QoreValue();
        }

        bool accepted = decision->getKeyValue("accepted").getAsBool();
        if (*xsink) {
            return QoreValue();
        }

        if (accepted && ssh_is_public_key_probe(*auth_info)) {
            if (ssh_auth_context_reply_public_key_ok(auth, xsink)) {
                return QoreValue();
            }

            QoreStringValueHelper session_id(auth_info->getKeyValue("session_id"));
            std::ostringstream msg;
            msg << "SshServer authenticateSession session_id="
                << session_id->c_str()
                << " accepted public-key probe";
            priv->logInfo(msg.str());
            continue;
        }

        bool partial = decision->getKeyValue("partial").getAsBool();

        if (ssh_auth_context_apply_decision(auth, *decision, xsink)) {
            return QoreValue();
        }

        // For partial auth success, continue the loop to collect the next auth method
        if (accepted && partial) {
            if (ssh_session_apply_auth_decision(session, *auth_info, *decision, xsink)) {
                return QoreValue();
            }
            QoreStringValueHelper session_id(auth_info->getKeyValue("session_id"));
            std::ostringstream msg;
            msg << "SshServer authenticateSession session_id="
                << session_id->c_str()
                << " partial auth success, continuing";
            priv->logInfo(msg.str());
            continue;
        }

        if (ssh_session_apply_auth_decision(session, *auth_info, *decision, xsink)) {
            return QoreValue();
        }
        QoreStringValueHelper session_id(auth_info->getKeyValue("session_id"));
        std::ostringstream msg;
        msg << "SshServer authenticateSession session_id="
            << session_id->c_str()
            << " accepted=" << (accepted ? "true" : "false");
        priv->logInfo(msg.str());
        return decision.release();
    }
}

//! Dispatches the next command request on the session
/** Waits for the next command-style request on the session, enforces the
    current session command policy, invokes `command_callback` when allowed,
    applies the resulting `SshCommandResult` to the live channel, and
    returns the typed result.

    @param session the live authenticated session
    @param timeout_ms the maximum time in milliseconds to wait for the request;
    0 means no timeout
    @return the typed command result applied to the live request or
    `NOTHING` on timeout
 */
*hash<SshCommandResult> SshServer::dispatchCommandSession(SshSession session, int timeout_ms = 0) [flags=NAMED_ARGS] {
    QoreObject* command = ssh_session_wait_command_session(session, getProgram(), timeout_ms, xsink);
    ReferenceHolder<QoreObject> command_holder(command, xsink);
    if (*xsink || !command) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> session_info(ssh_session_get_info(session, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> request(ssh_command_session_get_request(command, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> result(priv->authorizeCommandRequest(*session_info, *request, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    if (ssh_command_session_apply_result(command, *result, xsink)) {
        return QoreValue();
    }
    QoreStringValueHelper session_id(request->getKeyValue("session_id"));
    QoreStringValueHelper command_name(request->getKeyValue("command"));
    std::ostringstream msg;
    msg << "SshServer dispatchCommandSession session_id="
        << session_id->c_str()
        << " command=" << command_name->c_str()
        << " accepted=" << (result->getKeyValue("accepted").getAsBool() ? "true" : "false");
    priv->logInfo(msg.str());
    return result.release();
}

//! Accepts and initializes the next SFTP subsystem session
/** Waits for the next `sftp` subsystem request on the session, enforces the
    current session SFTP policy via `SshSession::waitSftpSession()`, invokes
    the optional `sftp_factory_callback`, applies any returned metadata
    overrides to the live `SftpSession`, and returns the live session.

    @param session the live authenticated session
    @param timeout_ms the maximum time in milliseconds to wait for the request;
    0 means no timeout
    @return the live `SftpSession` object or `NOTHING` on
    timeout
 */
*SftpSession SshServer::dispatchSftpSession(SshSession session, int timeout_ms = 0) [flags=NAMED_ARGS] {
    QoreObject* sftp = ssh_session_wait_sftp_session(session, getProgram(), timeout_ms, xsink);
    ReferenceHolder<QoreObject> sftp_holder(sftp, xsink);
    if (*xsink || !sftp) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> sftp_info(ssh_sftp_session_get_info(sftp, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> factory_result(priv->callSftpFactoryCallback(*sftp_info, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    if (factory_result && ssh_sftp_session_apply_factory_result(sftp, *factory_result, xsink)) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> updated_info(ssh_sftp_session_get_info(sftp, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    std::ostringstream msg;
    QoreStringValueHelper session_id(
        updated_info->getKeyValue("session_info").get<QoreHashNode>()->getKeyValue("session_id"));
    QoreStringValueHelper principal(updated_info->getKeyValue("principal"));
    msg << "SshServer dispatchSftpSession session_id="
        << session_id->c_str()
        << " principal=" << principal->c_str();
    priv->logInfo(msg.str());
    return sftp_holder.release();
}

//! Evaluates a typed SFTP transfer request against the configured path policy
/** Builds a default typed transfer decision from the request, invokes the
    optional `sftp_config.path_policy_callback`, applies the resulting transfer
    info to the live `SftpSession` when allowed, and returns the final typed
    decision.

    @param sftp the live authenticated SFTP session
    @param request the typed transfer request to evaluate
    @return the final typed `SftpTransferDecision`
 */
hash<SftpTransferDecision> SshServer::evaluateSftpTransferRequest(SftpSession sftp,
        hash<SftpTransferRequest> request) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreHashNode> default_decision(priv->makeDefaultSftpTransferDecision(request, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> override_decision(priv->callSftpPathPolicyCallback(request, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> final_decision(
        priv->mergeSftpTransferDecision(*default_decision, *override_decision, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    bool allowed = final_decision->getKeyValue("allowed").getAsBool();
    if (*xsink) {
        return QoreValue();
    }

    if (allowed) {
        const QoreHashNode* transfer_info = final_decision->getKeyValue("transfer_info").get<QoreHashNode>();
        if (!transfer_info) {
            xsink->raiseException("SSHSERVER-SFTP-ERROR",
                "the final transfer decision must contain transfer_info when allowed");
            return QoreValue();
        }
        if (ssh_sftp_session_apply_transfer_info(sftp, transfer_info, xsink)) {
            return QoreValue();
        }
    } else {
        if (ssh_sftp_session_clear_transfer_info(sftp, xsink)) {
            return QoreValue();
        }
    }

    std::ostringstream msg;
    QoreStringValueHelper path(request->getKeyValue("path"));
    msg << "SshServer evaluateSftpTransferRequest path="
        << path->c_str()
        << " allowed=" << (allowed ? "true" : "false");
    priv->logInfo(msg.str());
    return final_decision.release();
}

//! Sets the logger used by the server
/** @param logger an optional logger object
 */
nothing SshServer::setLogger(*LoggerInterfaceBase logger) [flags=NAMED_ARGS] {
    priv->setLogger(logger, xsink);
}

//! Returns the configured logger object
/** @return the configured logger object or `NOTHING`
 */
*LoggerInterfaceBase SshServer::getLogger() [flags=RET_VALUE_ONLY] {
    return priv->getLogger();
}

//! Returns whether the server is running
/** @return `True` when the server has been started and not yet stopped

    @par Example:
    @code{.py}
if (server.running()) {
    printf("server is active\n");
}
    @endcode
 */
bool SshServer::running() [flags=CONSTANT] {
    return priv->running.load();
}

//! Returns a typed status hash for the current server object
/** @return a status hash matching `SshServerStatus` with current server state

    @par Example:
    @code{.py}
hash<SshServerStatus> status = server.getStatus();
printf("server %y: running=%y, listeners=%d\n", status.name, status.running, status.listener_count);
    @endcode

    @note The status hash includes current listener runtime state and active
    session counters.
 */
hash<SshServerStatus> SshServer::getStatus() [flags=RET_VALUE_ONLY] {
    return priv->getStatus(xsink);
}

//! Returns a list of all currently active sessions
/** @return a list of @ref SshActiveSessionInfo typed hashes, one per active session
 */
list<hash<SshActiveSessionInfo>> SshServer::listActiveSessions() [flags=RET_VALUE_ONLY] {
    return priv->listActiveSessions(xsink);
}
