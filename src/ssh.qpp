DLLLOCAL QoreClass* initSshKeyClass(QoreNamespace& ns);
DLLLOCAL QoreClass* initSshServerClass(QoreNamespace& ns);
DLLLOCAL QoreClass* initSshSessionClass(QoreNamespace& ns);
DLLLOCAL QoreClass* initSshAuthContextClass(QoreNamespace& ns);
DLLLOCAL QoreClass* initSshCommandSessionClass(QoreNamespace& ns);
DLLLOCAL QoreClass* initSftpSessionClass(QoreNamespace& ns);

//! typed SSH listener configuration hash
/** Passed as elements of @ref SshServerConfig "SshServerConfig::listeners".
    Controls bind address, port, host keys, authentication filtering, service
    gates, security options, and keepalive/idle settings for a single listener.
*/
hashdecl Qore::Ssh::SshListenerConfig {
    //! listener name
    string name;
    //! bind address for the listener
    string bind_address;
    //! TCP port for the listener
    int port;
    //! optional host key file paths; either this list or server_host_key_provider must provide at least one key
    *list<string> host_keys;
    //! optional object implementing getServerHostKeyMaterial(hash<auto>) for provider-backed host keys
    *object server_host_key_provider;
    //! optional session cap for the listener
    *int max_sessions;
    //! optional SSH banner string
    *string banner;
    //! optional allowed authentication methods
    *list<string> enabled_auth_methods;
    //! optional flag enabling command-service requests
    *bool allow_command_service;
    //! optional flag enabling SFTP subsystem requests
    *bool allow_sftp_service;
    //! optional low-level listener server options
    *hash<auto> server_options;
    //! optional keepalive probe interval in seconds; defaults to 60 if not set; set to 0 or a negative value to disable
    *int keepalive_interval_seconds;
    //! optional idle session timeout in seconds
    *int idle_timeout_seconds;
    //! optional comma-separated list of allowed ciphers
    *string allowed_ciphers;
    //! optional comma-separated list of allowed key exchange algorithms
    *string allowed_kex;
    //! optional comma-separated list of allowed MAC algorithms
    *string allowed_macs;
    //! optional comma-separated list of allowed host key algorithms
    *string allowed_hostkey_algorithms;
    //! optional list of allowed client addresses in CIDR notation
    *list<string> allowed_addresses;
    //! optional list of denied client addresses in CIDR notation
    *list<string> denied_addresses;
    //! optional pre-authentication banner message
    *string auth_banner;
}

//! typed SSH server configuration hash
/** Top-level configuration for @ref Qore::Ssh::SshServer "SshServer". Contains
    listener definitions, authentication providers, command/SFTP callbacks, and
    optional logger and audit configuration.
*/
hashdecl Qore::Ssh::SshServerConfig {
    //! server name
    string name;
    //! listener configuration list
    list<hash<SshListenerConfig>> listeners;
    //! optional logger object implementing Qore::Logger::LoggerInterface
    *LoggerInterfaceBase logger;
    //! optional object-driven authentication provider implementing authenticate()
    *object auth_provider;
    //! optional authentication callback
    *code auth_callback;
    //! optional command callback
    *code command_callback;
    //! optional audit callback
    *code audit_callback;
    //! optional SFTP session factory callback
    *code sftp_factory_callback;
    //! optional authentication configuration hash
    *hash<auto> auth_config;
    //! optional command configuration hash
    *hash<auto> command_config;
    //! optional audit configuration hash
    *hash<auto> audit_config;
    //! optional SFTP configuration hash
    *hash<auto> sftp_config;
    //! optional default command timeout in milliseconds
    *int default_command_timeout_ms;
    //! optional flag enabling authenticated-session logging
    *bool log_authenticated_sessions;
    //! optional flag enabling file-transfer logging
    *bool log_file_transfers;
}

//! typed SSH listener runtime status hash
/** Returned as elements of @ref SshServerStatus "SshServerStatus::listeners"
    from @ref Qore::Ssh::SshServer::getStatus() "SshServer::getStatus()".
*/
hashdecl Qore::Ssh::SshListenerStatus {
    //! listener name
    string name;
    //! configured bind address
    string bind_address;
    //! configured port
    int port;
    //! actual bound port, if available
    *int bound_port;
    //! @c True when the listener is running
    bool running;
    //! current active session count on this listener
    int active_session_count;
    //! optional last listener error
    *hash<ExceptionInfo> last_error;
}

//! typed SSH server runtime status hash
/** Returned by @ref Qore::Ssh::SshServer::getStatus() "SshServer::getStatus()".
    Includes per-listener status entries and aggregate session counts.
*/
hashdecl Qore::Ssh::SshServerStatus {
    //! server name
    string name;
    //! @c True when the server is running
    bool running;
    //! number of configured listeners
    int listener_count;
    //! total active session count
    int active_session_count;
    //! optional server start time
    *date started;
    //! per-listener runtime status entries
    list<hash<SshListenerStatus>> listeners;
}

//! typed SSH session metadata hash
/** Carries identity, address, authentication state, and policy data for a live
    SSH session. Populated by the server during accept and auth, and passed to
    callbacks and SFTP session factories.
*/
hashdecl Qore::Ssh::SshSessionInfo {
    //! stable session identifier
    string session_id;
    //! server name
    string server_name;
    //! listener name
    string listener_name;
    //! remote peer address
    string remote_address;
    //! remote peer port
    int remote_port;
    //! local bound address
    string local_address;
    //! local bound port
    int local_port;
    //! optional authenticated username
    *string username;
    //! @c True when the session is authenticated
    bool authenticated;
    //! optional authentication method name
    *string auth_method;
    //! optional authenticated principal
    *string principal;
    //! optional arbitrary session data
    *hash<auto> session_data;
    //! optional session command policy data
    *hash<auto> command_policy;
    //! optional session SFTP policy data
    *hash<auto> sftp_policy;
    //! session start time
    date started;
    //! last activity timestamp
    date last_activity;
}

//! typed SSH authentication context hash
/** Passed to authentication providers and callbacks with the client's
    credentials and method details. See @ref sshauthguide for the full
    authentication flow.
*/
hashdecl Qore::Ssh::SshAuthContextInfo {
    //! stable session identifier
    string session_id;
    //! server name
    string server_name;
    //! listener name
    string listener_name;
    //! remote peer address
    string remote_address;
    //! remote peer port
    int remote_port;
    //! username supplied by the client
    string username;
    //! authentication method name
    string auth_method;
    //! optional password payload
    *string password;
    //! optional public key blob
    *binary public_key;
    //! optional public key type
    *string public_key_type;
    //! optional requested service name
    *string service;
    //! optional authentication metadata
    *hash<auto> metadata;
}

//! typed SSH authentication decision hash
/** Returned by authentication providers and callbacks. Controls session
    acceptance, principal assignment, policy attachment, and partial-auth
    continuation for multi-factor flows.
*/
hashdecl Qore::Ssh::SshAuthDecision {
    //! @c True when authentication is accepted
    bool accepted;
    //! optional partial-authentication flag for multi-factor auth
    *bool partial;
    //! optional resulting principal name
    *string principal;
    //! optional message for the client or audit trail
    *string message;
    //! optional list of allowed authentication methods to advertise
    *list<string> allowed_auth_methods;
    //! optional command policy attached to the session
    *hash<auto> command_policy;
    //! optional SFTP policy attached to the session
    *hash<auto> sftp_policy;
    //! optional arbitrary session data
    *hash<auto> session_data;
    //! optional audit payload
    *hash<auto> audit_data;
}

//! typed SSH command request hash
/** Passed to the @c command_callback or virtual command service when the
    client issues an exec or subsystem request.
*/
hashdecl Qore::Ssh::SshCommandRequest {
    //! stable session identifier
    string session_id;
    //! server name
    string server_name;
    //! listener name
    string listener_name;
    //! optional authenticated username
    *string username;
    //! optional authenticated principal
    *string principal;
    //! command or subsystem name
    string command;
    //! optional command arguments
    *list<string> arguments;
    //! optional environment map
    *hash<auto> environment;
    //! optional routing and request metadata
    *hash<auto> metadata;
}

//! typed SSH command result hash
/** Returned by the @c command_callback or virtual command service.
    Carries acceptance status, exit code, stdout/stderr payloads, and
    structured result metadata.
*/
hashdecl Qore::Ssh::SshCommandResult {
    //! @c True when the request was accepted by the virtual command layer
    bool accepted;
    //! optional exit status
    *int exit_status;
    //! optional human-readable message
    *string message;
    //! optional stdout payload
    *binary stdout;
    //! optional stderr payload
    *binary stderr;
    //! optional structured result metadata
    *hash<auto> result_data;
}

//! typed SFTP session metadata hash
/** Wraps @ref SshSessionInfo with SFTP-specific fields. Passed to the SFTP
    backend and factory callback after SFTP subsystem negotiation.
*/
hashdecl Qore::Ssh::SftpSessionInfo {
    //! wrapped SSH session metadata
    hash<SshSessionInfo> session_info;
    //! authenticated principal for the SFTP session
    string principal;
    //! optional effective root directory
    *string root_dir;
    //! @c True when the session is read-only
    bool read_only;
    //! optional hard cap (in bytes) on a non-streamed (buffered) SFTP upload
    /** When set to a positive value, an in-memory buffered upload that would exceed this many
        bytes is rejected with @c SSH_FX_FAILURE instead of being buffered, bounding server
        memory use against a malicious client sending a huge write offset.  When absent or
        not positive, a built-in default (256 MiB) is used.  Streamed backend writes are not
        buffered and are not subject to this limit. */
    *int max_buffered_upload_bytes;
    //! optional session-specific backend data
    *hash<auto> session_data;
}

//! typed SFTP protocol message hash
/** Raw SFTP protocol message envelope returned by
    @ref Qore::Ssh::SftpSession::waitProtocolMessage() "SftpSession::waitProtocolMessage()".
*/
hashdecl Qore::Ssh::SftpProtocolMessage {
    //! numeric SFTP message type
    int type;
    //! human-readable SFTP message name
    string name;
    //! optional request identifier
    *int request_id;
    //! optional protocol version
    *int version;
    //! optional raw payload bytes
    *binary payload;
    //! raw payload size in bytes
    int payload_size;
}

//! typed SFTP transfer request hash
/** Used by publish/retrieve transfer workflows to request file transfer
    decisions from the server-side transfer policy.
*/
hashdecl Qore::Ssh::SftpTransferRequest {
    //! live SFTP session metadata
    hash<SftpSessionInfo> session_info;
    //! transfer operation name
    string operation;
    //! virtual source path
    string path;
    //! optional target path
    *string target_path;
    //! optional temporary path for atomic publish workflows
    *string temporary_path;
    //! optional transfer size in bytes
    *int size;
    //! optional backend or policy metadata
    *hash<auto> metadata;
}

//! typed SFTP transfer info hash
/** Tracks the state of an active publish or retrieve transfer workflow
    including atomic-publish paths and completion status.
*/
hashdecl Qore::Ssh::SftpTransferInfo {
    //! transfer operation name
    string operation;
    //! virtual source path
    string path;
    //! optional temporary path
    *string temporary_path;
    //! optional final published path
    *string final_path;
    //! optional transfer size in bytes
    *int size;
    //! optional checksum string
    *string checksum;
    //! @c True when atomic publish behavior is active
    bool atomic_publish;
    //! @c True when the transfer workflow is completed
    bool completed;
}

//! typed SFTP transfer decision hash
/** Returned by transfer policy callbacks to allow or deny a file transfer.
*/
hashdecl Qore::Ssh::SftpTransferDecision {
    //! @c True when the transfer is allowed
    bool allowed;
    //! optional rejection or audit message
    *string message;
    //! resulting transfer metadata
    hash<SftpTransferInfo> transfer_info;
}

//! typed SFTP path request hash
/** Used by backend @c stat(), @c list(), @c removePath(), @c mkdir(), and
    @c rmdir() operations. See @ref sshsftpbackendguide for the backend contract.
*/
hashdecl Qore::Ssh::SftpPathRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! requested virtual path
    string path;
    //! optional symlink-following flag
    *bool follow_symlinks;
    //! optional logical operation name
    *string operation;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP path info / stat result hash
/** Returned by backend @c stat() to describe a file, directory, or symlink.
    Used by the SFTP session to build SSH_FXP_ATTRS responses.
*/
hashdecl Qore::Ssh::SftpPathInfo {
    //! optional resolved path
    *string path;
    //! optional existence flag
    *bool exists;
    //! optional directory flag
    *bool directory;
    //! optional symlink flag
    *bool symlink;
    //! optional symlink target path
    *string target_path;
    //! optional size in bytes
    *int size;
    //! optional permission bits
    *int permissions;
    //! optional access time (Unix epoch seconds)
    *int atime;
    //! optional modification time (Unix epoch seconds)
    *int mtime;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP directory listing result hash
/** Returned by backend @c list() to provide directory entries for
    SSH_FXP_READDIR responses.
*/
hashdecl Qore::Ssh::SftpListResult {
    //! optional listed path
    *string path;
    //! optional entry list
    *list<hash<auto>> entries;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP open request hash
/** Used by backend @c openRead() and @c openWrite() to open a file handle.
*/
hashdecl Qore::Ssh::SftpOpenRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! requested virtual path
    string path;
    //! optional logical operation name
    *string operation;
    //! optional SFTP open flags
    *int pflags;
    //! optional backend metadata
    *hash<auto> metadata;
    //! optional byte offset
    *int offset;
    //! optional byte length
    *int length;
}

//! typed SFTP open result hash
/** Returned by backend @c openRead()/@c openWrite(). If @c data is set, the
    content is sent immediately (buffered mode). If @c backend_handle is set,
    the session uses streamed @c read()/@c write()/@c close*() calls instead.
*/
hashdecl Qore::Ssh::SftpOpenResult {
    //! optional opened path
    *string path;
    //! optional existence flag
    *bool exists;
    //! optional eager-read payload
    *binary data;
    //! backend handle for streamed operations
    auto backend_handle;
    //! optional size in bytes
    *int size;
    //! optional permission bits
    *int permissions;
    //! optional backend metadata
    *hash<auto> metadata;
    //! optional transfer metadata
    *hash<SftpTransferInfo> transfer_info;
}

//! typed SFTP operation result hash
/** Returned by backend mutation operations (@c rename, @c removePath,
    @c mkdir, @c rmdir, @c closeRead, @c closeWrite) and completion helpers.
*/
hashdecl Qore::Ssh::SftpOperationResult {
    //! optional resulting path
    *string path;
    //! optional existence flag
    *bool exists;
    //! optional completion flag
    *bool completed;
    //! optional message
    *string message;
    //! optional backend metadata
    *hash<auto> metadata;
    //! optional transfer metadata
    *hash<SftpTransferInfo> transfer_info;
}

//! typed SFTP rename request hash
/** Used by backend @c rename() for SSH_FXP_RENAME operations.
*/
hashdecl Qore::Ssh::SftpRenameRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! source path
    string path;
    //! destination path
    string target_path;
    //! optional logical operation name
    *string operation;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP submission request hash
/** Used by @ref Qore::Ssh::SftpSession "SftpSession" convenience helpers and
    virtual backends for file submission with optional inline data or source path.
*/
hashdecl Qore::Ssh::SftpSubmissionRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! destination virtual path
    string path;
    //! optional local source path
    *string source_path;
    //! optional inline data payload
    *binary data;
    //! optional backend metadata
    *hash<auto> metadata;
    //! optional checksum string
    *string checksum;
    //! optional move-instead-of-copy flag
    *bool move;
    //! optional create-parent-directories flag
    *bool create_parents;
    //! optional logical operation name
    *string operation;
}

//! typed SFTP operation request hash for completion and mutation operations
/** Used by @ref Qore::Ssh::SftpSession "SftpSession" convenience helpers for
    archive, claim, delete, and rename completion flows. The @c completion_mode
    field selects the operation type.
*/
hashdecl Qore::Ssh::SftpOperationRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! source or record path
    string path;
    //! optional target path
    *string target_path;
    //! optional logical operation name
    *string operation;
    //! optional explicit completion mode
    *string completion_mode;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP streamed read request hash
/** Used by backend @c read() when the session is in streamed read mode
    (i.e. @ref SftpOpenResult "SftpOpenResult::backend_handle" was set).
*/
hashdecl Qore::Ssh::SftpReadRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! opened virtual path
    string path;
    //! optional logical operation name
    *string operation;
    //! backend handle for the open stream
    auto backend_handle;
    //! optional original open result
    *hash<SftpOpenResult> open_result;
    //! read offset
    int offset;
    //! requested byte length
    int length;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP streamed read result hash
/** Returned by backend @c read(). Set @c eof to @c True on the last chunk.
*/
hashdecl Qore::Ssh::SftpReadResult {
    //! optional data payload
    *binary data;
    //! optional EOF flag
    *bool eof;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP streamed write request hash
/** Used by backend @c write() when the session is in streamed write mode.
*/
hashdecl Qore::Ssh::SftpWriteRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! opened virtual path
    string path;
    //! optional logical operation name
    *string operation;
    //! backend handle for the open stream
    auto backend_handle;
    //! optional original open result
    *hash<SftpOpenResult> open_result;
    //! write offset
    int offset;
    //! data payload to write
    binary data;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP streamed close request hash
/** Used by backend @c closeRead() and @c closeWrite() to finalize a streamed
    handle. May carry a final buffered data payload for write operations.
*/
hashdecl Qore::Ssh::SftpCloseRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! opened virtual path
    string path;
    //! optional logical operation name
    *string operation;
    //! backend handle for the open stream
    auto backend_handle;
    //! optional original open result
    *hash<SftpOpenResult> open_result;
    //! optional final buffered data payload
    *binary data;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed active session info hash
/** Returned by @ref Qore::Ssh::SshServer::listActiveSessions() "SshServer::listActiveSessions()"
    with identity, timing, and I/O counters for each connected session.
*/
hashdecl Qore::Ssh::SshActiveSessionInfo {
    //! stable session identifier
    string session_id;
    //! remote peer address
    string remote_address;
    //! remote peer port
    int remote_port;
    //! optional authenticated username
    *string username;
    //! optional authenticated principal
    *string principal;
    //! optional authentication method name
    *string auth_method;
    //! session start time
    date started;
    //! last activity timestamp
    date last_activity;
    //! total bytes read from the client
    int bytes_read;
    //! total bytes written to the client
    int bytes_written;
    //! total SFTP operations processed
    int sftp_operations;
}

//! typed SFTP symlink request hash
/** Used by backend @c symlink() for SSH_FXP_SYMLINK operations.
*/
hashdecl Qore::Ssh::SftpSymlinkRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! symlink path to create
    string link_path;
    //! target path the symlink points to
    string target_path;
    //! optional logical operation name
    *string operation;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP setstat/fsetstat request hash
/** Used by backend @c setstat() for SSH_FXP_SETSTAT and SSH_FXP_FSETSTAT
    operations. The @c attr_flags bitmask indicates which attribute fields
    are present.
*/
hashdecl Qore::Ssh::SftpSetstatRequest {
    //! optional live SFTP session metadata
    *hash<SftpSessionInfo> session_info;
    //! path to modify
    string path;
    //! optional file handle for fsetstat operations
    *string handle;
    //! operation name (@c "setstat" or @c "fsetstat")
    string operation;
    //! optional file size
    *int size;
    //! optional user ID
    *int uid;
    //! optional group ID
    *int gid;
    //! optional permission bits
    *int permissions;
    //! optional access time (Unix epoch seconds)
    *int atime;
    //! optional modification time (Unix epoch seconds)
    *int mtime;
    //! bitmask of which attributes are present in the request
    int attr_flags;
    //! optional backend metadata
    *hash<auto> metadata;
}

//! typed SFTP statvfs result hash for the @c statvfs\@openssh.com extension
/** Returned by backend @c statvfs() for SSH_FXP_EXTENDED statvfs requests.
    Fields follow the POSIX @c statvfs layout.
*/
hashdecl Qore::Ssh::SftpStatvfsResult {
    //! filesystem block size
    int f_bsize;
    //! fragment size
    int f_frsize;
    //! total data blocks in the filesystem
    int f_blocks;
    //! free blocks in the filesystem
    int f_bfree;
    //! available blocks for unprivileged users
    int f_bavail;
    //! total file nodes in the filesystem
    int f_files;
    //! free file nodes in the filesystem
    int f_ffree;
    //! available file nodes for unprivileged users
    int f_favail;
    //! filesystem ID
    int f_fsid;
    //! mount flags
    int f_flag;
    //! maximum filename length
    int f_namemax;
}

//! typed SSH key metadata hash
/** Returned by @ref Qore::Ssh::SshKey::getInfo() "SshKey::getInfo()".
    Describes the key type, public/private state, fingerprint, and base64
    representation of the public component.
*/
hashdecl Qore::Ssh::SshKeyInfo {
    //! key type name (e.g. @c "ssh-rsa", @c "ssh-ed25519", @c "ecdsa-sha2-nistp256")
    string type_name;
    //! numeric key type constant (one of the @c SSH_KEYTYPE_* constants)
    int type;
    //! @c True when the key contains private key material
    bool is_private;
    //! @c True when the key contains public key material
    bool is_public;
    //! OpenSSH-style SHA-256 fingerprint string (e.g. @c "SHA256:<base64>"), or @c NOTHING if unavailable
    *string fingerprint_sha256;
    //! base64-encoded public key, or @c NOTHING if unavailable
    *string public_key_base64;
}

static void ssh_module_init(QoreModuleInitContext& ctx, ExceptionSink& xsink) {
    hashdeclSshListenerConfig = init_hashdecl_SshListenerConfig(SshNS);
    hashdeclSshServerConfig = init_hashdecl_SshServerConfig(SshNS);
    hashdeclSshListenerStatus = init_hashdecl_SshListenerStatus(SshNS);
    hashdeclSshServerStatus = init_hashdecl_SshServerStatus(SshNS);
    hashdeclSshSessionInfo = init_hashdecl_SshSessionInfo(SshNS);
    hashdeclSshAuthContextInfo = init_hashdecl_SshAuthContextInfo(SshNS);
    hashdeclSshAuthDecision = init_hashdecl_SshAuthDecision(SshNS);
    hashdeclSshCommandRequest = init_hashdecl_SshCommandRequest(SshNS);
    hashdeclSshCommandResult = init_hashdecl_SshCommandResult(SshNS);
    hashdeclSftpSessionInfo = init_hashdecl_SftpSessionInfo(SshNS);
    hashdeclSftpProtocolMessage = init_hashdecl_SftpProtocolMessage(SshNS);
    hashdeclSftpTransferRequest = init_hashdecl_SftpTransferRequest(SshNS);
    hashdeclSftpTransferInfo = init_hashdecl_SftpTransferInfo(SshNS);
    hashdeclSftpTransferDecision = init_hashdecl_SftpTransferDecision(SshNS);
    hashdeclSftpPathRequest = init_hashdecl_SftpPathRequest(SshNS);
    hashdeclSftpPathInfo = init_hashdecl_SftpPathInfo(SshNS);
    hashdeclSftpListResult = init_hashdecl_SftpListResult(SshNS);
    hashdeclSftpOpenRequest = init_hashdecl_SftpOpenRequest(SshNS);
    hashdeclSftpOpenResult = init_hashdecl_SftpOpenResult(SshNS);
    hashdeclSftpOperationResult = init_hashdecl_SftpOperationResult(SshNS);
    hashdeclSftpRenameRequest = init_hashdecl_SftpRenameRequest(SshNS);
    hashdeclSftpSubmissionRequest = init_hashdecl_SftpSubmissionRequest(SshNS);
    hashdeclSftpOperationRequest = init_hashdecl_SftpOperationRequest(SshNS);
    hashdeclSftpReadRequest = init_hashdecl_SftpReadRequest(SshNS);
    hashdeclSftpReadResult = init_hashdecl_SftpReadResult(SshNS);
    hashdeclSftpWriteRequest = init_hashdecl_SftpWriteRequest(SshNS);
    hashdeclSftpCloseRequest = init_hashdecl_SftpCloseRequest(SshNS);
    hashdeclSshActiveSessionInfo = init_hashdecl_SshActiveSessionInfo(SshNS);
    hashdeclSftpSymlinkRequest = init_hashdecl_SftpSymlinkRequest(SshNS);
    hashdeclSftpSetstatRequest = init_hashdecl_SftpSetstatRequest(SshNS);
    hashdeclSftpStatvfsResult = init_hashdecl_SftpStatvfsResult(SshNS);
    hashdeclSshKeyInfo = init_hashdecl_SshKeyInfo(SshNS);

    // SSH key type constants
    SshNS.addConstant("SSH_KEYTYPE_RSA", (int64)SSH_KEYTYPE_RSA);
    SshNS.addConstant("SSH_KEYTYPE_ED25519", (int64)SSH_KEYTYPE_ED25519);
    SshNS.addConstant("SSH_KEYTYPE_ECDSA_P256", (int64)SSH_KEYTYPE_ECDSA_P256);
    SshNS.addConstant("SSH_KEYTYPE_ECDSA_P384", (int64)SSH_KEYTYPE_ECDSA_P384);
    SshNS.addConstant("SSH_KEYTYPE_ECDSA_P521", (int64)SSH_KEYTYPE_ECDSA_P521);

    // SSH key file format constants.  libssh < 0.11.0 does not define the
    // ssh_file_format_e enumerators; fall back to sentinel values matching the
    // libssh >= 0.11.0 enum so the constants are always exported.  Attempting a
    // non-default format on an unsupported library yields a clear runtime error
    // from the export methods that consume the value (see QC_SshKey.qpp).
#ifndef SSH_FILE_FORMAT_DEFAULT
#define SSH_FILE_FORMAT_DEFAULT 0
#endif
#ifndef SSH_FILE_FORMAT_OPENSSH
#define SSH_FILE_FORMAT_OPENSSH 1
#endif
#ifndef SSH_FILE_FORMAT_PEM
#define SSH_FILE_FORMAT_PEM 2
#endif
    SshNS.addConstant("SSH_FILE_FORMAT_DEFAULT", (int64)SSH_FILE_FORMAT_DEFAULT);
    SshNS.addConstant("SSH_FILE_FORMAT_OPENSSH", (int64)SSH_FILE_FORMAT_OPENSSH);
    SshNS.addConstant("SSH_FILE_FORMAT_PEM", (int64)SSH_FILE_FORMAT_PEM);

    // SSH public key hash type constants
    SshNS.addConstant("SSH_PUBLICKEY_HASH_SHA1", (int64)SSH_PUBLICKEY_HASH_SHA1);
    SshNS.addConstant("SSH_PUBLICKEY_HASH_MD5", (int64)SSH_PUBLICKEY_HASH_MD5);
    SshNS.addConstant("SSH_PUBLICKEY_HASH_SHA256", (int64)SSH_PUBLICKEY_HASH_SHA256);

    SshNS.addSystemClass(initSshKeyClass(SshNS));
    SshNS.addSystemClass(initSshAuthContextClass(SshNS));
    SshNS.addSystemClass(initSshCommandSessionClass(SshNS));
    SshNS.addSystemClass(initSftpSessionClass(SshNS));
    SshNS.addSystemClass(initSshSessionClass(SshNS));
    SshNS.addSystemClass(initSshServerClass(SshNS));
}

static void ssh_module_ns_init(QoreNamespace* rns, QoreNamespace* qns, ExceptionSink& xsink) {
    qns->addNamespace(SshNS.copy());
}

static void ssh_module_delete() {
}

extern "C" DLLEXPORT void ssh_qore_module_desc(QoreModuleInfo& mod_info) {
    mod_info.name = "ssh";
    mod_info.version = PACKAGE_VERSION;
    mod_info.desc = "SSH server module";
    mod_info.author = "Qore Technologies, s.r.o.";
    mod_info.url = "http://qore.org";
    mod_info.api_major = QORE_MODULE_API_MAJOR;
    mod_info.api_minor = QORE_MODULE_API_MINOR;
    mod_info.init = ssh_module_init;
    mod_info.ns_init = ssh_module_ns_init;
    mod_info.del = ssh_module_delete;
    mod_info.license = QL_LGPL;
    mod_info.license_str = "LGPL 2.1";
}
