//! Retrieves backend-managed content to a local file
/** Retrieves immediate binary content through the backend atomic-exchange
    helper, writes it to a local target file, and optionally calls
    `completeRetrieve(hash<SftpOperationRequest>)` to finalize the retrieval
    with a completion mode such as `delete`, `claim`, or `archive`.

    @param path the virtual source path
    @param target_path the local destination file
    @param completion_mode optional backend completion mode
    @param metadata optional backend metadata
    @param create_parents if set to `True`, creates target parent directories
    @return the typed `SftpOperationResult` describing the final retrieval state
 */
hash<SftpOperationResult> SftpSession::retrieveToLocalFile(string path, string target_path,
        *string completion_mode, *hash<auto> metadata, bool create_parents = True) {
    ReferenceHolder<QoreHashNode> req(new QoreHashNode(autoTypeInfo), xsink);
    req->setKeyValue("path", path->refSelf(), xsink);
    if (metadata) {
        req->setKeyValue("metadata", metadata->refSelf(), xsink);
    }

    ReferenceHolder<QoreHashNode> result(priv->retrieve(req.operator->(), xsink), xsink);
    const BinaryNode* data_bin = result ? result->getKeyValue("data").get<BinaryNode>() : nullptr;
    if (!data_bin) {
        xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
            "retrieveToLocalFile() requires backend retrieve() to return immediate binary data for path '%s'",
            path->c_str());
        return QoreValue();
    }

    if (ssh_sftp_write_binary_file(target_path->c_str(), *data_bin, create_parents, xsink)) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> final_result(new QoreHashNode(autoTypeInfo), xsink);
    final_result->setKeyValue("path", path->refSelf(), xsink);
    final_result->setKeyValue("exists", true, xsink);
    final_result->setKeyValue("completed", false, xsink);

    if (!completion_mode) {
        const QoreHashNode* transfer_info = result->getKeyValue("transfer_info").get<QoreHashNode>();
        if (transfer_info) {
            final_result->setKeyValue("transfer_info", transfer_info->refSelf(), xsink);
        }
        return final_result.release();
    }

    ReferenceHolder<QoreHashNode> complete_metadata(metadata ? metadata->copy() : new QoreHashNode(autoTypeInfo),
        xsink);

    ReferenceHolder<QoreHashNode> complete_req(new QoreHashNode(autoTypeInfo), xsink);
    complete_req->setKeyValue("path", path->refSelf(), xsink);
    complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    complete_req->setKeyValue("completion_mode", completion_mode->refSelf(), xsink);
    complete_req->setKeyValue("target_path", target_path->refSelf(), xsink);
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

//! Retrieves backend-managed content to a local file
/** Convenience overload for typed callers that already have a complete
    `SftpOpenRequest` prepared.

    @param req the typed `SftpOpenRequest`
    @param target_path the local destination file
    @param completion_mode optional backend completion mode
    @param create_parents if set to `True`, creates target parent directories
    @return the typed `SftpOperationResult` describing the final retrieval state
 */
hash<SftpOperationResult> SftpSession::retrieveToLocalFile(hash<SftpOpenRequest> req, string target_path,
        *string completion_mode, bool create_parents = True) {
    ReferenceHolder<QoreHashNode> result(priv->retrieve(req, xsink), xsink);
    const BinaryNode* data_bin = result ? result->getKeyValue("data").get<BinaryNode>() : nullptr;
    std::string path;
    ssh_sftp_get_hash_string(req, "path", path);
    if (!data_bin) {
        xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
            "retrieveToLocalFile() requires backend retrieve() to return immediate binary data for path '%s'",
            path.empty() ? "<unknown>" : path.c_str());
        return QoreValue();
    }

    if (ssh_sftp_write_binary_file(target_path->c_str(), *data_bin, create_parents, xsink)) {
        return QoreValue();
    }

    ReferenceHolder<QoreHashNode> final_result(new QoreHashNode(autoTypeInfo), xsink);
    final_result->setKeyValue("path", new QoreStringNode(path.c_str()), xsink);
    final_result->setKeyValue("exists", true, xsink);
    final_result->setKeyValue("completed", false, xsink);

    if (!completion_mode) {
        const QoreHashNode* transfer_info = result->getKeyValue("transfer_info").get<QoreHashNode>();
        if (transfer_info) {
            final_result->setKeyValue("transfer_info", transfer_info->refSelf(), xsink);
        }
        return final_result.release();
    }

    ReferenceHolder<QoreHashNode> complete_metadata(
        req->existsKey("metadata") && req->getKeyValue("metadata").getType() != NT_NOTHING
            ? req->getKeyValue("metadata").get<QoreHashNode>()->copy()
            : new QoreHashNode(autoTypeInfo), xsink);

    ReferenceHolder<QoreHashNode> complete_req(new QoreHashNode(autoTypeInfo), xsink);
    complete_req->setKeyValue("path", new QoreStringNode(path.c_str()), xsink);
    complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    complete_req->setKeyValue("completion_mode", completion_mode->refSelf(), xsink);
    complete_req->setKeyValue("target_path", target_path->refSelf(), xsink);
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

//! Publishes a local staged file through the active transfer plan
/** Uses the current `SftpTransferInfo` to copy or rename a local file into
    the planned final destination. When @c atomic_publish is set and a
    temporary path is present, the file is first staged to the temporary path
    and then renamed into place.

    @param source_path the local staged file to publish
    @param move if set to `True`, renames the source instead of copying it
    @param create_parents if set to `True`, creates parent directories as needed
    @return the updated `SftpTransferInfo` with @c completed set to `True`

    @par Example:
    @code{.qore}
    hash<SftpTransferInfo> info = sftp.publishLocalFile("/tmp/payload.dat", False, True);
    @endcode
 */
hash<SftpTransferInfo> SftpSession::publishLocalFile(string source_path, bool move = False,
        bool create_parents = True) {
    return priv->publishLocalFile(source_path->c_str(), move, create_parents, xsink);
}

//! Retrieves a planned file to a local destination
/** Uses the current `SftpTransferInfo` to copy or rename a planned server
    file to a local destination path. This is intended for controlled outbound
    retrieval or claim-style handoff workflows.

    @param target_path the local destination path
    @param move if set to `True`, renames the source into place instead of copying it
    @param create_parents if set to `True`, creates parent directories as needed
    @return the updated `SftpTransferInfo` with @c completed set to `True`

    @par Example:
    @code{.qore}
    hash<SftpTransferInfo> info = sftp.retrieveLocalFile("/tmp/outbound/payload.dat", False, True);
    @endcode
 */
hash<SftpTransferInfo> SftpSession::retrieveLocalFile(string target_path, bool move = False,
        bool create_parents = True) {
    return priv->retrieveLocalFile(target_path->c_str(), move, create_parents, xsink);
}

//! Returns the configured logger object
/** @return the configured logger object or `NOTHING`
 */
*LoggerInterfaceBase SftpSession::getLogger() [flags=RET_VALUE_ONLY] {
    return priv->getLogger();
}

//! Returns the configured backend object
/** @return the configured backend object or `NOTHING`
 */
*object SftpSession::getBackend() [flags=RET_VALUE_ONLY] {
    return priv->getBackend();
}

//! Returns whether the accepted SFTP channel is still connected
/** @return `True` when the SFTP channel is still open
 */
bool SftpSession::connected() [flags=CONSTANT] {
    return priv->isConnected();
}

//! Closes the accepted SFTP channel
/** Closes the accepted SFTP subsystem channel and releases the libssh
    resources held by this object.
 */
nothing SftpSession::close() {
    priv->closeIntern();
}

DLLLOCAL QoreObject* ssh_new_sftp_session_object(QoreProgram* pgm, QoreHashNode* info, QoreHashNode* transfer_info,
        const QoreObject* logger, QoreObject* backend, ssh_channel channel, ExceptionSink* xsink) {
    ReferenceHolder<QoreHashNode> info_holder(info, xsink);
    ReferenceHolder<QoreHashNode> transfer_info_holder(transfer_info, xsink);
    ReferenceHolder<QoreObject> logger_holder(logger ? logger->objectRefSelf() : nullptr, xsink);
    ReferenceHolder<QoreObject> backend_holder(backend, xsink);
    bool keep_resources = false;
    ON_BLOCK_EXIT([&keep_resources, channel]() {
        if (!keep_resources && channel) {
            ssh_channel_send_eof(channel);
            ssh_channel_close(channel);
            ssh_channel_free(channel);
        }
    });
    ReferenceHolder<QoreObject> obj(new QoreObject(QC_SFTPSESSION, pgm), xsink);
    obj->setPrivate(CID_SFTPSESSION,
        new SftpSessionPriv(info_holder.release(), transfer_info_holder.release(), logger_holder.release(),
            backend_holder.release(), channel));
    keep_resources = true;
    return obj.release();
}

DLLLOCAL QoreHashNode* ssh_sftp_session_get_info(const QoreObject* sftp_obj, ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR", "cannot get info from a null SFTP session object");
        return nullptr;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
    return *xsink ? nullptr : priv->getInfo(xsink);
}

DLLLOCAL QoreHashNode* ssh_sftp_session_get_transfer_info(const QoreObject* sftp_obj, ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR",
            "cannot get transfer info from a null SFTP session object");
        return nullptr;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
    return *xsink ? nullptr : priv->getTransferInfo(xsink);
}

DLLLOCAL int ssh_sftp_session_set_logger(const QoreObject* sftp_obj, const QoreObject* logger, ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR", "cannot set logger on a null SFTP session object");
        return -1;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
    if (*xsink) {
        return -1;
    }
    priv->setLogger(logger, xsink);
    return *xsink ? -1 : 0;
}

DLLLOCAL int ssh_sftp_session_set_backend(const QoreObject* sftp_obj, QoreObject* backend, ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR", "cannot set backend on a null SFTP session object");
        return -1;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
    if (*xsink) {
        return -1;
    }
    priv->setBackend(backend, xsink);
    return *xsink ? -1 : 0;
}

DLLLOCAL int ssh_sftp_session_apply_factory_result(const QoreObject* sftp_obj, const QoreHashNode* result,
        ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR",
            "cannot apply a factory result to a null SFTP session object");
        return -1;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
    return *xsink ? -1 : priv->applyFactoryResult(result, xsink);
}

DLLLOCAL int ssh_sftp_session_apply_transfer_info(const QoreObject* sftp_obj, const QoreHashNode* transfer_info,
        ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR",
            "cannot apply transfer info to a null SFTP session object");
        return -1;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
