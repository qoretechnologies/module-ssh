static void ssh_sftp_validate_logger(const QoreObject* logger, const char* err, ExceptionSink* xsink) {
    if (!logger) {
        return;
    }

    const QoreClass* cls = logger->getClass();
    if (!cls || !cls->findMethod("logArgs") || !cls->findMethod("isEnabledFor")) {
        xsink->raiseException(err,
            "logger objects must implement logArgs() and isEnabledFor() (LoggerInterfaceBase)");
    }
}

static void ssh_sftp_validate_backend(const QoreObject* backend, const char* err, ExceptionSink* xsink) {
    if (!backend) {
        return;
    }

    const QoreClass* cls = backend->getClass();
    if (!cls) {
        xsink->raiseException(err, "backend objects must expose a runtime class");
        return;
    }

    if (!cls->findMethod("stat") || !cls->findMethod("list")) {
        xsink->raiseException(err,
            "backend objects must implement at least stat() and list() methods");
    }

    bool has_open_write = cls->findMethod("openWrite");
    bool has_close_write = cls->findMethod("closeWrite");
    if (has_open_write != has_close_write) {
        xsink->raiseException(err,
            "backend objects implementing openWrite() must also implement closeWrite(), and vice versa");
    }

    bool has_read = cls->findMethod("read");
    bool has_close_read = cls->findMethod("closeRead");
    if (has_read != has_close_read) {
        xsink->raiseException(err,
            "backend objects implementing read() must also implement closeRead(), and vice versa");
    }

    bool has_write = cls->findMethod("write");
    if (has_write && (!has_open_write || !has_close_write)) {
        xsink->raiseException(err,
            "backend objects implementing write() must also implement openWrite() and closeWrite()");
    }
}

static void ssh_sftp_log_message(QoreObject* logger, int level, const std::string& msg) {
    if (!logger) {
        return;
    }

    ExceptionSink xsink;
    const QoreMethod* m = logger->getClass()->findMethod("logArgs");
    if (!m) {
        return;
    }
    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
    args->push(level, &xsink);
    args->push(new QoreStringNode(msg.c_str()), &xsink);
    if (xsink) {
        return;
    }
    ValueHolder rv(logger->evalMethod(*m, *args, &xsink), &xsink);
}

static int ssh_sftp_check_fs_access(const std::string& path, int mode, ExceptionSink* xsink) {
    if (path.empty()) {
        return 0;
    }

    QoreSandboxManagerHelper smh;
    if (smh && !smh->checkFilesystemAccess(path.c_str(), mode, xsink)) {
        return -1;
    }

    return 0;
}

static int ssh_sftp_ensure_parent_dirs(const std::string& path, ExceptionSink* xsink) {
    std::string::size_type pos = path.rfind('/');
    if (pos == std::string::npos || !pos) {
        return 0;
    }
    std::string parent = path.substr(0, pos);
    if (parent.empty()) {
        return 0;
    }

    if (ssh_sftp_check_fs_access(parent, QSEC_WRITE, xsink)) {
        return -1;
    }

    struct stat st;
    if (!::stat(parent.c_str(), &st)) {
        return 0;
    }
    if (errno != ENOENT) {
        xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno, "cannot stat parent directory '%s'",
            parent.c_str());
        return -1;
    }

    std::string current;
    if (parent[0] == '/') {
        current = "/";
    }
    size_t start = parent[0] == '/' ? 1 : 0;
    while (start <= parent.size()) {
        size_t slash = parent.find('/', start);
        std::string part = slash == std::string::npos ? parent.substr(start) : parent.substr(start, slash - start);
        if (!part.empty()) {
            if (current.size() > 1 && current[current.size() - 1] != '/') {
                current += "/";
            }
            current += part;
            // sandbox-check each ancestor directory we actually create, not only the
            // top-level parent (filesystem-completeness hardening)
            if (ssh_sftp_check_fs_access(current, QSEC_CREATE, xsink)) {
                return -1;
            }
            if (::mkdir(current.c_str(), 0700) && errno != EEXIST) {
                xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno,
                    "cannot create parent directory '%s'", current.c_str());
                return -1;
            }
        }
        if (slash == std::string::npos) {
            break;
        }
        start = slash + 1;
    }

    return 0;
}

static int ssh_sftp_copy_file(const std::string& source_path, const std::string& target_path, ExceptionSink* xsink) {
    if (ssh_sftp_check_fs_access(source_path, QSEC_READ, xsink)
            || ssh_sftp_check_fs_access(target_path, QSEC_WRITE, xsink)) {
        return -1;
    }

    int in_fd = ::open(source_path.c_str(), O_RDONLY);
    if (in_fd < 0) {
        xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno, "cannot open source file '%s' for read",
            source_path.c_str());
        return -1;
    }
    ON_BLOCK_EXIT([in_fd]() {
        if (in_fd >= 0) {
            ::close(in_fd);
        }
    });

    int out_fd = ::open(target_path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (out_fd < 0) {
        xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno, "cannot open target file '%s' for write",
            target_path.c_str());
        return -1;
    }
    ON_BLOCK_EXIT([out_fd]() {
        if (out_fd >= 0) {
            ::close(out_fd);
        }
    });

    char buf[65536];
    while (true) {
        if (qore_check_cancel(xsink, "sftp file copy")) {
            return -1;
        }

        ssize_t rc = ::read(in_fd, buf, sizeof(buf));
        if (rc < 0) {
            if (errno == EINTR) {
                continue;
            }
            xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno,
                "cannot read source file '%s'", source_path.c_str());
            return -1;
        }
        if (!rc) {
            break;
        }

        ssize_t offset = 0;
        while (offset < rc) {
            if (qore_check_cancel(xsink, "sftp file copy")) {
                return -1;
            }

            ssize_t wc = ::write(out_fd, buf + offset, rc - offset);
            if (wc < 0) {
                if (errno == EINTR) {
                    continue;
                }
                xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno,
                    "cannot write target file '%s'", target_path.c_str());
                return -1;
            }
            offset += wc;
        }
    }

    if (::fsync(out_fd)) {
        xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno, "cannot fsync target file '%s'",
            target_path.c_str());
        return -1;
    }

    return 0;
}

static BinaryNode* ssh_sftp_read_binary_file(const std::string& source_path, ExceptionSink* xsink) {
    int fd = ::open(source_path.c_str(), O_RDONLY);
    if (fd < 0) {
        xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno, "cannot open local file '%s' for reading",
            source_path.c_str());
        return nullptr;
    }

    SimpleRefHolder<BinaryNode> data(new BinaryNode());
    ON_BLOCK_EXIT([fd]() {
        if (fd >= 0) {
            ::close(fd);
        }
    });

    char buf[8192];
    while (true) {
        if (qore_check_cancel(xsink, "reading local submission file")) {
            return nullptr;
        }

        ssize_t rc = ::read(fd, buf, sizeof(buf));
        if (rc < 0) {
            if (errno == EINTR) {
                continue;
            }
            xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno,
                "cannot read local file '%s'", source_path.c_str());
            return nullptr;
        }
        if (!rc) {
            break;
        }

        data->append(buf, static_cast<size_t>(rc));
    }

    return data.release();
}

static int ssh_sftp_write_binary_file(const std::string& target_path, const BinaryNode& data, bool create_parents,
        ExceptionSink* xsink) {
    if (ssh_sftp_check_fs_access(target_path, QSEC_WRITE, xsink)) {
        return -1;
    }

    if (create_parents && ssh_sftp_ensure_parent_dirs(target_path, xsink)) {
        return -1;
    }

    int fd = ::open(target_path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
    if (fd < 0) {
        xsink->raiseException("SFTPSESSION-FILESYSTEM-ERROR", "cannot open local target file '%s' for writing",
            target_path.c_str());
        return -1;
    }

    int rc = 0;
    ON_BLOCK_EXIT([&fd, &rc]() {
        if (fd >= 0) {
            int close_rc = ::close(fd);
            if (!rc && close_rc) {
                rc = -1;
            }
            fd = -1;
        }
    });

    const char* ptr = reinterpret_cast<const char*>(data.getPtr());
    size_t remaining = data.size();
    while (remaining) {
        if (qore_check_cancel(xsink, "sftp file write")) {
            return -1;
        }
        ssize_t wrote = ::write(fd, ptr, remaining);
        if (wrote < 0) {
            if (errno == EINTR) {
                continue;
            }
            xsink->raiseException("SFTPSESSION-FILESYSTEM-ERROR", "cannot write local target file '%s'",
                target_path.c_str());
            return -1;
        }
        ptr += wrote;
        remaining -= wrote;
    }

    return rc;
}


static uint32_t ssh_sftp_read_u32_be(const unsigned char* ptr) {
    return (static_cast<uint32_t>(ptr[0]) << 24) | (static_cast<uint32_t>(ptr[1]) << 16)
        | (static_cast<uint32_t>(ptr[2]) << 8) | static_cast<uint32_t>(ptr[3]);
}

static uint64_t ssh_sftp_read_u64_be(const unsigned char* ptr) {
    return (static_cast<uint64_t>(ssh_sftp_read_u32_be(ptr)) << 32)
        | static_cast<uint64_t>(ssh_sftp_read_u32_be(ptr + 4));
}

static void ssh_sftp_write_u32_be(std::string& out, uint32_t value) {
    out.push_back(static_cast<char>((value >> 24) & 0xff));
    out.push_back(static_cast<char>((value >> 16) & 0xff));
    out.push_back(static_cast<char>((value >> 8) & 0xff));
    out.push_back(static_cast<char>(value & 0xff));
}

static void ssh_sftp_write_u64_be(std::string& out, uint64_t value) {
    ssh_sftp_write_u32_be(out, static_cast<uint32_t>(value >> 32));
    ssh_sftp_write_u32_be(out, static_cast<uint32_t>(value & 0xffffffff));
}

// SFTP attrs flags (RFC 4251 / draft-ietf-secsh-filexfer)
#define SSH_FILEXFER_ATTR_SIZE        0x00000001
#define SSH_FILEXFER_ATTR_UIDGID      0x00000002
#define SSH_FILEXFER_ATTR_PERMISSIONS 0x00000004
#define SSH_FILEXFER_ATTR_ACMODTIME   0x00000008

// Hard cap on the total in-memory size of a non-streamed (buffered) SFTP upload.  The write
// offset and length come straight off the wire from the client; without this bound a single
// SSH_FXP_WRITE with a huge offset would force a multi-terabyte std::string::resize() and
// OOM-kill the server (remote DoS).  Streamed backend writes are not buffered and are not
// subject to this limit.  256 MiB is well above any reasonable buffered upload.
static const uint64_t SSH_SFTP_MAX_BUFFERED_FILE_BYTES = 256ULL * 1024 * 1024;

// M-3: bounds for virtual path validation.  Embedded NUL/control bytes are rejected (a NUL
// truncates the path at c_str() and desyncs audit logs from the real access; newlines enable
// audit-log injection via crafted file names) and overall/component lengths are capped.
static const size_t SSH_SFTP_MAX_PATH_BYTES = 4096;
static const size_t SSH_SFTP_MAX_NAME_BYTES = 255;

// Parse SFTP attrs block from raw payload bytes
// Returns true on success, false if the payload is too short
static bool ssh_sftp_parse_attrs(const unsigned char* ptr, size_t size, size_t& offset,
        uint32_t& flags, int64_t& file_size, uint32_t& uid, uint32_t& gid,
        uint32_t& permissions, uint32_t& atime, uint32_t& mtime) {
    flags = 0;
    file_size = -1;
    uid = 0;
    gid = 0;
    permissions = 0;
    atime = 0;
    mtime = 0;

    if (offset + 4 > size) {
        return false;
    }
    flags = ssh_sftp_read_u32_be(ptr + offset);
    offset += 4;

    if (flags & SSH_FILEXFER_ATTR_SIZE) {
        if (offset + 8 > size) {
            return false;
        }
        file_size = static_cast<int64_t>(ssh_sftp_read_u64_be(ptr + offset));
        offset += 8;
    }

    if (flags & SSH_FILEXFER_ATTR_UIDGID) {
        if (offset + 8 > size) {
            return false;
        }
        uid = ssh_sftp_read_u32_be(ptr + offset);
        offset += 4;
        gid = ssh_sftp_read_u32_be(ptr + offset);
        offset += 4;
    }

    if (flags & SSH_FILEXFER_ATTR_PERMISSIONS) {
        if (offset + 4 > size) {
            return false;
        }
        permissions = ssh_sftp_read_u32_be(ptr + offset);
        offset += 4;
    }

    if (flags & SSH_FILEXFER_ATTR_ACMODTIME) {
        if (offset + 8 > size) {
            return false;
        }
        atime = ssh_sftp_read_u32_be(ptr + offset);
        offset += 4;
        mtime = ssh_sftp_read_u32_be(ptr + offset);
        offset += 4;
    }

    return true;
}

static const char* ssh_sftp_packet_type_name(uint8_t type) {
    switch (type) {
        case SSH_FXP_INIT:
            return "init";
        case SSH_FXP_VERSION:
            return "version";
        case SSH_FXP_OPEN:
            return "open";
        case SSH_FXP_CLOSE:
            return "close";
        case SSH_FXP_READ:
            return "read";
        case SSH_FXP_WRITE:
            return "write";
        case SSH_FXP_LSTAT:
            return "lstat";
        case SSH_FXP_FSTAT:
            return "fstat";
        case SSH_FXP_SETSTAT:
            return "setstat";
        case SSH_FXP_FSETSTAT:
            return "fsetstat";
        case SSH_FXP_OPENDIR:
            return "opendir";
        case SSH_FXP_READDIR:
            return "readdir";
        case SSH_FXP_REMOVE:
            return "remove";
        case SSH_FXP_MKDIR:
            return "mkdir";
        case SSH_FXP_RMDIR:
            return "rmdir";
        case SSH_FXP_REALPATH:
            return "realpath";
        case SSH_FXP_STAT:
            return "stat";
        case SSH_FXP_RENAME:
            return "rename";
        case SSH_FXP_READLINK:
            return "readlink";
        case SSH_FXP_SYMLINK:
            return "symlink";
        case SSH_FXP_STATUS:
            return "status";
        case SSH_FXP_HANDLE:
            return "handle";
        case SSH_FXP_DATA:
            return "data";
        case SSH_FXP_NAME:
            return "name";
        case SSH_FXP_ATTRS:
            return "attrs";
        case SSH_FXP_EXTENDED:
            return "extended";
        case SSH_FXP_EXTENDED_REPLY:
            return "extended-reply";
        default:
            return "unknown";
    }
}

static bool ssh_sftp_normalize_virtual_path(const std::string& raw_path, std::string& normalized_path) {
    if (raw_path.empty() || raw_path.size() > SSH_SFTP_MAX_PATH_BYTES) {
        return false;
    }

    // M-3: reject embedded NUL and other control characters (incl. DEL) before any parsing so
    // the validated path cannot differ from what the kernel/backend later sees.
    for (unsigned char c : raw_path) {
        if (c < 0x20 || c == 0x7f) {
            return false;
        }
    }

    std::vector<std::string> components;
    size_t pos = 0;
    while (pos <= raw_path.size()) {
        size_t slash = raw_path.find('/', pos);
        std::string part = slash == std::string::npos ? raw_path.substr(pos) : raw_path.substr(pos, slash - pos);
        if (!part.empty() && part != ".") {
            if (part.size() > SSH_SFTP_MAX_NAME_BYTES) {
                return false;
            }
            if (part == "..") {
                if (components.empty()) {
                    return false;
                }
                components.pop_back();
            } else {
                components.push_back(part);
            }
        }

        if (slash == std::string::npos) {
            break;
        }
        pos = slash + 1;
    }

    normalized_path = "/";
    for (size_t i = 0; i < components.size(); ++i) {
        if (i) {
            normalized_path += "/";
        }
        normalized_path += components[i];
    }

    return true;
}

static bool ssh_sftp_read_string_field(const char* ptr, size_t size, size_t& offset, std::string& value) {
    if (offset + 4 > size) {
        return false;
    }

    uint32_t len = ssh_sftp_read_u32_be(reinterpret_cast<const unsigned char*>(ptr + offset));
    offset += 4;
    if (offset + len > size) {
        return false;
    }

    value.assign(ptr + offset, len);
    offset += len;
    return true;
}

static bool ssh_sftp_get_real_path(const QoreHashNode* info, const std::string& raw_path, std::string& normalized_path,
        std::string& real_path, std::string& root_dir_out) {
    if (!info) {
        return false;
    }

    if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
        return false;
    }

    QoreValue root_dir_value = info->getKeyValue("root_dir");
    if (root_dir_value.getType() != NT_STRING) {
        return false;
    }
    QoreStringValueHelper root_dir_node(root_dir_value);
    if (!root_dir_node->strlen()) {
        return false;
    }
    real_path = root_dir_node->c_str();
    if (real_path.empty()) {
        return false;
    }
    root_dir_out = real_path;

    if (normalized_path != "/") {
        if (real_path.size() > 1 && real_path[real_path.size() - 1] == '/') {
            real_path.pop_back();
        }
        real_path += normalized_path;
    }

    return true;
}

// M-4: verify that real_path, after resolving symlinks, is still confined within the canonical
// SFTP root.  The lexical real_path is already root_dir + a normalized ("/"-rooted, no "..")
// virtual path, so the only escape vector is a symlink in an existing path component.
// follow_final=true models SSH_FXP_STAT (the final symlink is followed); follow_final=false
// models SSH_FXP_LSTAT (the final component is not followed, so only the parent is resolved).
// A residual realpath()->stat() TOCTOU window remains and is documented; it requires the
// ability to swap an in-root component between the two syscalls.
static bool ssh_sftp_path_within_root(const std::string& root_dir, const std::string& real_path,
        bool follow_final) {
    char canon_root[PATH_MAX];
    if (!realpath(root_dir.c_str(), canon_root)) {
        return false;
    }

    std::string check = real_path;
    if (!follow_final) {
        size_t slash = check.find_last_of('/');
        if (slash == std::string::npos) {
            return false;
        }
        check = slash == 0 ? std::string("/") : check.substr(0, slash);
    }

    char canon[PATH_MAX];
    if (!realpath(check.c_str(), canon)) {
        // a non-existent path/parent cannot have resolved any symlink, and the lexical path is
        // already root + normalized (no ".."), so it is contained by construction
        return errno == ENOENT || errno == ENOTDIR;
    }

    std::string resolved(canon);
    std::string root(canon_root);
    if (resolved == root) {
        return true;
    }
    return resolved.size() > root.size()
        && resolved.compare(0, root.size(), root) == 0
        && resolved[root.size()] == '/';
}

static bool ssh_sftp_get_hash_string(const QoreHashNode* h, const char* key, std::string& value) {
    value.clear();
    if (!h) {
        return false;
    }
    QoreValue v = h->getKeyValue(key);
    if (v.getType() != NT_STRING) {
        return false;
    }
    QoreStringValueHelper str(v);
    value = str->c_str();
    return true;
}

static int64_t ssh_sftp_get_hash_bigint(const QoreHashNode* h, const char* key, int64_t default_value, ExceptionSink* xsink) {
    const QoreValue v = h->getKeyValue(key);
    if (v.getType() == NT_NOTHING) {
        return default_value;
    }

    int64_t rv = v.getAsBigInt();
    if (*xsink) {
        return default_value;
    }
    return rv;
}

static bool ssh_sftp_get_hash_bool(const QoreHashNode* h, const char* key, bool default_value, ExceptionSink* xsink) {
    const QoreValue v = h->getKeyValue(key);
    if (v.getType() == NT_NOTHING) {
        return default_value;
    }

    bool rv = v.getAsBool();
    if (*xsink) {
        return default_value;
    }
    return rv;
}

class SftpSessionPriv : public AbstractPrivateData {
public:
    struct DirectoryHandleState {
        QoreListNode* entries;
        size_t offset;

        explicit DirectoryHandleState(QoreListNode* n_entries = nullptr) : entries(n_entries), offset(0) {
        }

        ~DirectoryHandleState() {
            if (entries) {
                entries->deref(nullptr);
            }
        }
    };

    struct FileHandleState {
        std::string data;
        QoreHashNode* metadata;
        std::string path;
        bool write_mode;
        bool stream_read;
        bool stream_write;

        explicit FileHandleState(const std::string& n_data = std::string(), QoreHashNode* n_metadata = nullptr,
                const std::string& n_path = std::string(), bool n_write_mode = false, bool n_stream_read = false,
                bool n_stream_write = false)
                : data(n_data), metadata(n_metadata), path(n_path), write_mode(n_write_mode), stream_read(n_stream_read),
                  stream_write(n_stream_write) {
        }

        ~FileHandleState() {
            if (metadata) {
                metadata->deref(nullptr);
            }
        }
    };

    explicit SftpSessionPriv(const QoreHashNode* info)
            : info(info ? info->copy() : nullptr), transfer_info(nullptr), logger(nullptr), backend(nullptr),
              channel(nullptr), next_dir_handle_id(1), next_file_handle_id(1) {
    }

    SftpSessionPriv(QoreHashNode* info, QoreHashNode* transfer_info, QoreObject* logger, QoreObject* backend,
            ssh_channel channel) : info(info), transfer_info(transfer_info), logger(logger), backend(backend),
            channel(channel), next_dir_handle_id(1), next_file_handle_id(1) {
    }

    ~SftpSessionPriv() {
        closeIntern();
        if (info) {
            info->deref(nullptr);
        }
        if (transfer_info) {
            transfer_info->deref(nullptr);
        }
        if (logger) {
            logger->deref(nullptr);
        }
        if (backend) {
            backend->deref(nullptr);
        }
    }

    QoreHashNode* getInfo(ExceptionSink* xsink) const {
        // M-9: info is mutated under m by applyFactoryResult(); read it under the same lock so a
        // concurrent factory-result application cannot race the doRuntimeCast() copy.  Consistent
        // with the other m-locked accessors (isReadOnly/getMaxBufferedUploadBytes); the mutators
        // never call back into this accessor, so no re-entrant lock is possible.
        std::lock_guard<std::mutex> lock(m);
        return info ? reinterpret_cast<QoreHashNode*>(hashdeclSftpSessionInfo->doRuntimeCast(info, xsink))
                    : new QoreHashNode(hashdeclSftpSessionInfo, xsink);
    }

    QoreHashNode* getTransferInfo(ExceptionSink* xsink) const {
        // M-9: transfer_info is swapped under m by applyFactoryResult()/applyTransferInfo()/
        // clearTransferInfo(); read it under the same lock.
        std::lock_guard<std::mutex> lock(m);
        return transfer_info ? reinterpret_cast<QoreHashNode*>(hashdeclSftpTransferInfo->doRuntimeCast(transfer_info, xsink))
                             : nullptr;
    }

    // returns true if this session has been configured read-only; "read_only" is opt-in (absent/false => writable)
    bool isReadOnly() const {
        std::lock_guard<std::mutex> lock(m);
        return info ? info->getKeyValue("read_only").getAsBool() : false;
    }

    // effective hard cap for non-streamed (buffered) uploads; honors a positive session-configured
    // "max_buffered_upload_bytes" override, otherwise the built-in default
    uint64_t getMaxBufferedUploadBytes() const {
        std::lock_guard<std::mutex> lock(m);
        if (info) {
            const QoreValue cap_v = info->getKeyValue("max_buffered_upload_bytes");
            if (cap_v.getType() == NT_INT) {
                int64 cap = cap_v.getAsBigInt();
                if (cap > 0) {
                    return static_cast<uint64_t>(cap);
                }
            }
        }
        return SSH_SFTP_MAX_BUFFERED_FILE_BYTES;
    }

    void setLogger(const QoreObject* q_logger, ExceptionSink* xsink) {
        ssh_sftp_validate_logger(q_logger, "SFTPSESSION-LOGGER-ERROR", xsink);
        if (*xsink) {
            return;
        }

        QoreObject* old_logger = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            old_logger = logger;
            logger = q_logger ? q_logger->objectRefSelf() : nullptr;
        }
        if (old_logger) {
            old_logger->deref(xsink);
        }
    }

    QoreObject* getLogger() const {
        std::lock_guard<std::mutex> lock(m);
        return logger ? logger->objectRefSelf() : nullptr;
    }

    void setBackend(QoreObject* q_backend, ExceptionSink* xsink) {
        ssh_sftp_validate_backend(q_backend, "SFTPSESSION-BACKEND-ERROR", xsink);
        if (*xsink) {
            return;
        }

        QoreObject* old_backend = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            old_backend = backend;
            backend = q_backend ? q_backend->objectRefSelf() : nullptr;
        }
        if (old_backend) {
            old_backend->deref(xsink);
        }
    }

    QoreObject* getBackend() const {
        std::lock_guard<std::mutex> lock(m);
        return backend ? backend->objectRefSelf() : nullptr;
    }

    bool isConnected() const {
        std::lock_guard<std::mutex> lock(m);
        return channel != nullptr;
    }

    QoreHashNode* waitProtocolMessage(int timeout_ms, ExceptionSink* xsink) {
        ssh_channel current_channel = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            current_channel = channel;
        }
        if (!current_channel) {
            xsink->raiseException("SFTPSESSION-STATE-ERROR", "cannot read protocol messages from a closed SFTP session");
            return nullptr;
        }

        unsigned char header[4];
        if (readChannelExact(current_channel, header, sizeof(header), timeout_ms, xsink, "SFTP packet header")) {
            return nullptr;
        }

        uint32_t packet_size = ssh_sftp_read_u32_be(header);
        if (!packet_size) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "received an empty SFTP packet");
            return nullptr;
        }
        if (packet_size > 16 * 1024 * 1024) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "received an oversized SFTP packet of %u bytes",
                packet_size);
            return nullptr;
        }

        std::string payload(packet_size, '\0');
        if (readChannelExact(current_channel, &payload[0], packet_size, timeout_ms, xsink, "SFTP packet payload")) {
            return nullptr;
        }

        uint8_t type = static_cast<uint8_t>(payload[0]);
        const char* type_name = ssh_sftp_packet_type_name(type);
        ReferenceHolder<QoreHashNode> msg(new QoreHashNode(hashdeclSftpProtocolMessage, xsink), xsink);
        msg->setKeyValue("type", static_cast<int64>(type), xsink);
        msg->setKeyValue("name", new QoreStringNode(type_name), xsink);
        msg->setKeyValue("payload_size", static_cast<int64>(packet_size - 1), xsink);
        if (*xsink) {
            return nullptr;
        }

        if (packet_size > 1) {
            SimpleRefHolder<BinaryNode> payload_bin(new BinaryNode());
            payload_bin->append(payload.data() + 1, packet_size - 1);
            msg->setKeyValue("payload", payload_bin.release(), xsink);
            if (*xsink) {
                return nullptr;
            }
        }

        if (type == SSH_FXP_INIT) {
            if (packet_size < 5) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a truncated SSH_FXP_INIT packet");
                return nullptr;
            }
            msg->setKeyValue("version", static_cast<int64>(ssh_sftp_read_u32_be(
                reinterpret_cast<const unsigned char*>(payload.data() + 1))), xsink);
        } else if (type != SSH_FXP_VERSION) {
            if (packet_size < 5) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a truncated SFTP request packet of type %d", static_cast<int>(type));
                return nullptr;
            }
            msg->setKeyValue("request_id", static_cast<int64>(ssh_sftp_read_u32_be(
                reinterpret_cast<const unsigned char*>(payload.data() + 1))), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        std::ostringstream os;
        os << "SftpSession received protocol message type=" << static_cast<int>(type)
           << " name=" << type_name;
        logDebug(os.str());
        return msg.release();
    }

    int sendVersion(int version, ExceptionSink* xsink) {
        if (version < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP version must be >= 0");
            return -1;
        }

        // Build SSH_FXP_VERSION body: type(1) + version(4) + extension pairs
        std::string body;
        body.reserve(64);
        body.push_back(static_cast<char>(SSH_FXP_VERSION));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(version));

        // Advertise statvfs@openssh.com extension
        const std::string ext_name = "statvfs@openssh.com";
        const std::string ext_version = "2";
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(ext_name.size()));
        body.append(ext_name);
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(ext_version.size()));
        body.append(ext_version);

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        if (writeChannelAll(packet, xsink, "SSH_FXP_VERSION")) {
            return -1;
        }

        logInfo("SFTP session initialized version=" + std::to_string(version));
        return 0;
    }

    int sendStatus(int request_id, int status_code, const std::string& message, const std::string& language,
            ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }
        if (status_code < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP status code must be >= 0");
            return -1;
        }
        if (message.size() > UINT32_MAX || language.size() > UINT32_MAX) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP status message is too large");
            return -1;
        }

        std::string body;
        body.reserve(1 + 4 + 4 + 4 + message.size() + 4 + language.size());
        body.push_back(static_cast<char>(SSH_FXP_STATUS));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(status_code));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(message.size()));
        body.append(message);
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(language.size()));
        body.append(language);

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        if (writeChannelAll(packet, xsink, "SSH_FXP_STATUS")) {
            return -1;
        }

        std::ostringstream os;
        os << "SftpSession sent status request_id=" << request_id << " code=" << status_code;
        logInfo(os.str());
        return 0;
    }

    int sendName(int request_id, const std::string& name, const std::string& long_name, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }
        if (name.size() > UINT32_MAX || long_name.size() > UINT32_MAX) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP name payload is too large");
            return -1;
        }

        std::string body;
        body.reserve(1 + 4 + 4 + 4 + name.size() + 4 + long_name.size() + 4);
        body.push_back(static_cast<char>(SSH_FXP_NAME));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, 1);
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(name.size()));
        body.append(name);
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(long_name.size()));
        body.append(long_name);
        ssh_sftp_write_u32_be(body, 0);

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        if (writeChannelAll(packet, xsink, "SSH_FXP_NAME")) {
            return -1;
        }

        std::ostringstream os;
        os << "SftpSession sent name request_id=" << request_id << " path=" << name;
        logInfo(os.str());
        return 0;
    }

    int sendHandle(int request_id, const std::string& handle, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }
        if (handle.size() > UINT32_MAX) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP handle payload is too large");
            return -1;
        }

        std::string body;
        body.reserve(1 + 4 + 4 + handle.size());
        body.push_back(static_cast<char>(SSH_FXP_HANDLE));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(handle.size()));
        body.append(handle);

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        return writeChannelAll(packet, xsink, "SSH_FXP_HANDLE");
    }

    int sendData(int request_id, const void* ptr, size_t size, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }
        if (size > UINT32_MAX) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP data payload is too large");
            return -1;
        }

        std::string body;
        body.reserve(1 + 4 + 4 + size);
        body.push_back(static_cast<char>(SSH_FXP_DATA));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(size));
        if (size) {
            body.append(reinterpret_cast<const char*>(ptr), size);
        }

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        return writeChannelAll(packet, xsink, "SSH_FXP_DATA");
    }

    int sendNames(int request_id, const QoreListNode* entries, size_t offset, size_t max_entries, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }
        if (!entries) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "directory entries are missing");
            return -1;
        }
        if (offset >= entries->size()) {
            return sendStatus(request_id, SSH_FX_EOF, "end of directory", "en", xsink);
        }

        size_t end = std::min(entries->size(), offset + max_entries);
        std::string body;
        body.push_back(static_cast<char>(SSH_FXP_NAME));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(end - offset));
        for (size_t i = offset; i < end; ++i) {
            const QoreHashNode* entry = entries->retrieveEntry(i).get<QoreHashNode>();
            if (!entry) {
                xsink->raiseException("SFTPSESSION-BACKEND-ERROR", "directory entry %zu is not a hash", i);
                return -1;
            }

            QoreValue filename = entry->getKeyValue("filename");
            if (filename.getType() != NT_STRING) {
                xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                    "directory entry %zu must contain a non-empty filename", i);
                return -1;
            }
            QoreStringValueHelper filename_str(filename);
            if (!filename_str->strlen()) {
                xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                    "directory entry %zu must contain a non-empty filename", i);
                return -1;
            }
            QoreValue long_name = entry->getKeyValue("long_name");

            bool is_directory = ssh_sftp_get_hash_bool(entry, "directory", false, xsink);
            int64_t size = ssh_sftp_get_hash_bigint(entry, "size", 0, xsink);
            int64_t permissions = ssh_sftp_get_hash_bigint(entry, "permissions",
                is_directory ? (S_IFDIR | 0755) : (S_IFREG | 0644), xsink);
            int64_t atime = ssh_sftp_get_hash_bigint(entry, "atime", 0, xsink);
            int64_t mtime = ssh_sftp_get_hash_bigint(entry, "mtime", 0, xsink);
            if (*xsink) {
                return -1;
            }

            std::string name_value = filename_str->c_str();
            std::string long_name_value = name_value;
            if (long_name.getType() == NT_STRING) {
                QoreStringValueHelper long_name_str(long_name);
                if (long_name_str->strlen()) {
                    long_name_value = long_name_str->c_str();
                }
            }
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(name_value.size()));
            body.append(name_value);
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(long_name_value.size()));
            body.append(long_name_value);
            uint32_t flags = SSH_FILEXFER_ATTR_SIZE | SSH_FILEXFER_ATTR_PERMISSIONS | SSH_FILEXFER_ATTR_ACMODTIME;
            ssh_sftp_write_u32_be(body, flags);
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>((static_cast<uint64_t>(size) >> 32) & 0xffffffff));
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(static_cast<uint64_t>(size) & 0xffffffff));
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(permissions));
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(atime));
            ssh_sftp_write_u32_be(body, static_cast<uint32_t>(mtime));
        }

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        return writeChannelAll(packet, xsink, "SSH_FXP_NAME");
    }

    int sendAttrs(int request_id, const struct stat& st, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }

        uint32_t flags = SSH_FILEXFER_ATTR_SIZE | SSH_FILEXFER_ATTR_PERMISSIONS | SSH_FILEXFER_ATTR_ACMODTIME;

        std::string body;
        body.reserve(1 + 4 + 4 + 8 + 4 + 4 + 4);
        body.push_back(static_cast<char>(SSH_FXP_ATTRS));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        ssh_sftp_write_u32_be(body, flags);
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>((static_cast<uint64_t>(st.st_size) >> 32) & 0xffffffff));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(static_cast<uint64_t>(st.st_size) & 0xffffffff));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(st.st_mode));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(st.st_atime));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(st.st_mtime));

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        if (writeChannelAll(packet, xsink, "SSH_FXP_ATTRS")) {
            return -1;
        }

        std::ostringstream os;
        os << "SftpSession sent attrs request_id=" << request_id << " mode=" << st.st_mode
           << " size=" << static_cast<long long>(st.st_size);
        logInfo(os.str());
        return 0;
    }

    QoreHashNode* buildBackendPathRequest(const std::string& normalized_path, bool follow_symlinks, const char* operation,
            ExceptionSink* xsink) const {
        ReferenceHolder<QoreHashNode> req(new QoreHashNode(autoTypeInfo), xsink);
        ReferenceHolder<QoreHashNode> current_info(getInfo(xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        req->setKeyValue("follow_symlinks", follow_symlinks, xsink);
        req->setKeyValue("operation", operation ? new QoreStringNode(operation) : QoreValue(), xsink);
        req->setKeyValue("session_info", current_info.release(), xsink);
        if (*xsink) {
            return nullptr;
        }
        return req.release();
    }

    QoreHashNode* buildBackendRenameRequest(const std::string& normalized_path, const std::string& target_path,
            const char* operation, ExceptionSink* xsink) const {
        ReferenceHolder<QoreHashNode> req(buildBackendPathRequest(normalized_path, true, operation, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        req->setKeyValue("target_path", new QoreStringNode(target_path.c_str()), xsink);
        if (*xsink) {
            return nullptr;
        }
        return req.release();
    }

    QoreHashNode* callBackendMethod(const char* method, const QoreHashNode* req, int request_id, ExceptionSink* xsink) {
        ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
        if (*xsink || !backend_holder) {
            return nullptr;
        }

        ExceptionSink bxsink;
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &bxsink);
        args->push(req ? req->refSelf() : QoreValue(), &bxsink);
        if (bxsink) {
            bxsink.clear();
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR", "cannot build backend arguments for %s()", method);
            return nullptr;
        }

        ValueHolder rv((*backend_holder)->evalMethod(method, *args, &bxsink), &bxsink);
        if (bxsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            bxsink.clear();
            return nullptr;
        }

        const QoreHashNode* result = rv->get<QoreHashNode>();
        if (!result) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation returned an invalid result", "en", xsink);
            return nullptr;
        }

        return result->copy();
    }

    QoreHashNode* callBackendMethodDirect(const char* method, const QoreHashNode* req, ExceptionSink* xsink) {
        ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
        if (*xsink || !backend_holder) {
            return nullptr;
        }

        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
        args->push(req ? req->refSelf() : QoreValue(), xsink);
        if (*xsink) {
            return nullptr;
        }

        ValueHolder rv((*backend_holder)->evalMethod(method, *args, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* result = rv->get<QoreHashNode>();
        if (!result) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend method %s() returned an invalid result", method);
            return nullptr;
        }

        return result->copy();
    }

    QoreHashNode* callBackendMethodDirectTyped(const char* method, const QoreHashNode* req, ExceptionSink* xsink) {
        ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
        if (*xsink || !backend_holder) {
            return nullptr;
        }

        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), xsink);
        args->push(req ? req->refSelf() : QoreValue(), xsink);
        if (*xsink) {
            return nullptr;
        }

        ValueHolder rv((*backend_holder)->evalMethod(method, *args, xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* result = rv->get<QoreHashNode>();
        if (!result) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend method %s() returned an invalid result", method);
            return nullptr;
        }

        return result->copy();
    }

    int sendBackendAttrs(int request_id, const QoreHashNode* backend_result, ExceptionSink* xsink) {
        struct stat st;
        memset(&st, 0, sizeof(st));

        bool is_directory = ssh_sftp_get_hash_bool(backend_result, "directory", false, xsink);
        if (*xsink) {
            xsink->clear();
            sendStatus(request_id, SSH_FX_FAILURE, "backend metadata is invalid", "en", xsink);
            return -1;
        }

        int64_t size = ssh_sftp_get_hash_bigint(backend_result, "size", 0, xsink);
        int64_t permissions = ssh_sftp_get_hash_bigint(backend_result, "permissions",
            is_directory ? (S_IFDIR | 0755) : (S_IFREG | 0644), xsink);
        int64_t atime = ssh_sftp_get_hash_bigint(backend_result, "atime", 0, xsink);
        int64_t mtime = ssh_sftp_get_hash_bigint(backend_result, "mtime", 0, xsink);
        if (*xsink) {
            xsink->clear();
            sendStatus(request_id, SSH_FX_FAILURE, "backend metadata is invalid", "en", xsink);
            return -1;
        }

        st.st_size = static_cast<off_t>(size);
        st.st_mode = static_cast<mode_t>(permissions);
        st.st_atime = static_cast<time_t>(atime);
        st.st_mtime = static_cast<time_t>(mtime);
        return sendAttrs(request_id, st, xsink);
    }

    int sendBackendOperationStatus(int request_id, const QoreHashNode* backend_result, const char* success_message,
            bool path_not_found, ExceptionSink* xsink) {
        bool exists = ssh_sftp_get_hash_bool(backend_result, "exists", true, xsink);
        bool completed = ssh_sftp_get_hash_bool(backend_result, "completed", true, xsink);
        if (*xsink) {
            xsink->clear();
            return sendStatus(request_id, SSH_FX_FAILURE, "backend operation result is invalid", "en", xsink);
        }

        if (!exists) {
            return sendStatus(request_id, path_not_found ? SSH_FX_NO_SUCH_PATH : SSH_FX_NO_SUCH_FILE, "not found", "en",
                xsink);
        }

        if (!completed) {
            return sendStatus(request_id, SSH_FX_FAILURE, "backend operation did not complete", "en", xsink);
        }

        return sendStatus(request_id, SSH_FX_OK, success_message, "en", xsink);
    }

    bool backendHasMethod(const char* method) const {
        if (!method) {
            return false;
        }

        std::lock_guard<std::mutex> lock(m);
        const QoreClass* cls = backend ? backend->getClass() : nullptr;
        return cls && cls->findMethod(method);
    }

    int handleBackendOpenDir(int request_id, const std::string& normalized_path, ExceptionSink* xsink) {
        logDetail("SFTP opendir path=" + normalized_path);
        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("follow_symlinks", true, xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("opendir"), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("list", *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        const QoreListNode* entries = backend_result->getKeyValue("entries").get<QoreListNode>();
        if (!entries) {
            return sendStatus(request_id, SSH_FX_FAILURE, "backend list result is missing entries", "en", xsink);
        }

        std::string handle;
        {
            std::lock_guard<std::mutex> lock(m);
            handle = "dir-" + std::to_string(next_dir_handle_id++);
            dir_handles.emplace(handle, std::unique_ptr<DirectoryHandleState>(new DirectoryHandleState(entries->copy())));
        }

        return sendHandle(request_id, handle, xsink);
    }

    int handleBackendReadDir(int request_id, const std::string& handle, ExceptionSink* xsink) {
        logDebug("SFTP readdir handle=" + handle);
        QoreListNode* copied_entries = nullptr;
        size_t offset = 0;
        {
            std::lock_guard<std::mutex> lock(m);
            auto i = dir_handles.find(handle);
            if (i == dir_handles.end()) {
                offset = static_cast<size_t>(-1);
            } else if (!i->second || !i->second->entries) {
                offset = static_cast<size_t>(-1);
            } else {
                copied_entries = i->second->entries->copy();
                offset = i->second->offset;
                i->second->offset = i->second->entries->size();
            }
        }
        ReferenceHolder<QoreListNode> entries(copied_entries, xsink);

        if (offset == static_cast<size_t>(-1) || !entries) {
            return sendStatus(request_id, SSH_FX_INVALID_HANDLE, "invalid directory handle", "en", xsink);
        }

        if (sendNames(request_id, *entries, offset, 64, xsink)) {
            return -1;
        }
        return 0;
    }

    int handleBackendOpenRead(int request_id, const std::string& normalized_path, uint32_t pflags, ExceptionSink* xsink) {
        logDetail("SFTP open-read path=" + normalized_path);
        if (!(pflags & SSH_FXF_READ) || (pflags & (SSH_FXF_WRITE | SSH_FXF_APPEND | SSH_FXF_CREAT | SSH_FXF_TRUNC
                | SSH_FXF_EXCL))) {
            return sendStatus(request_id, SSH_FX_PERMISSION_DENIED, "write access is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpOpenRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("open-read"), xsink);
        typed_backend_req->setKeyValue("pflags", static_cast<int64>(pflags), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("openRead", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        if (!ssh_sftp_get_hash_bool(*backend_result, "exists", true, xsink)) {
            if (*xsink) {
                xsink->clear();
                return sendStatus(request_id, SSH_FX_FAILURE, "backend result is invalid", "en", xsink);
            }
            return sendStatus(request_id, SSH_FX_NO_SUCH_FILE, "not found", "en", xsink);
        }

        const QoreValue data_v = backend_result->getKeyValue("data");
        std::string data;
        bool stream_read = false;
        if (const BinaryNode* binary = data_v.get<BinaryNode>()) {
            if (binary->size()) {
                data.assign(reinterpret_cast<const char*>(binary->getPtr()), binary->size());
            }
        } else if (data_v.getType() == NT_STRING) {
            QoreStringValueHelper str(data_v);
            if (str->strlen()) {
                data.assign(str->c_str(), str->size());
            }
        } else if (data_v.getType() == NT_NOTHING) {
            if (!backendHasMethod("read") || !backendHasMethod("closeRead")) {
                return sendStatus(request_id, SSH_FX_FAILURE,
                    "backend openRead result is missing binary data and no read()/closeRead() stream contract is available",
                    "en", xsink);
            }
            if (backend_result->getKeyValue("backend_handle").getType() == NT_NOTHING) {
                return sendStatus(request_id, SSH_FX_FAILURE,
                    "backend openRead stream result is missing backend_handle", "en", xsink);
            }
            stream_read = true;
        }

        if (data_v.getType() != NT_BINARY && data_v.getType() != NT_STRING && !stream_read) {
            return sendStatus(request_id, SSH_FX_FAILURE, "backend openRead result is missing binary data", "en", xsink);
        }

        std::string handle;
        {
            std::lock_guard<std::mutex> lock(m);
            handle = "file-" + std::to_string(next_file_handle_id++);
            file_handles.emplace(handle,
                std::unique_ptr<FileHandleState>(new FileHandleState(data, backend_result->copy(), normalized_path, false,
                    stream_read)));
        }

        return sendHandle(request_id, handle, xsink);
    }

    int handleBackendOpenWrite(int request_id, const std::string& normalized_path, uint32_t pflags, ExceptionSink* xsink) {
        logDetail("SFTP open-write path=" + normalized_path);
        if (!(pflags & SSH_FXF_WRITE)) {
            return sendStatus(request_id, SSH_FX_PERMISSION_DENIED, "write access was requested without write flags", "en",
                xsink);
        }
        if (!backendHasMethod("openWrite") || !backendHasMethod("closeWrite")) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "write access is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpOpenRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("open-write"), xsink);
        typed_backend_req->setKeyValue("pflags", static_cast<int64>(pflags), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("openWrite", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        bool stream_write = backendHasMethod("write")
            && backend_result->getKeyValue("backend_handle").getType() != NT_NOTHING;

        std::string handle;
        {
            std::lock_guard<std::mutex> lock(m);
            handle = "file-" + std::to_string(next_file_handle_id++);
            file_handles.emplace(handle,
                std::unique_ptr<FileHandleState>(new FileHandleState(std::string(), backend_result->copy(),
                    normalized_path, true, false, stream_write)));
        }

        return sendHandle(request_id, handle, xsink);
    }

    int handleBackendRead(int request_id, const std::string& handle, uint64_t offset, uint32_t length, ExceptionSink* xsink) {
        logDebug("SFTP read handle=" + handle + " offset=" + std::to_string(offset) + " length=" + std::to_string(length));
        std::string chunk;
        bool eof = false;
        bool invalid = false;
        QoreHashNode* metadata = nullptr;
        std::string path;
        bool stream_read = false;
        {
            std::lock_guard<std::mutex> lock(m);
            auto i = file_handles.find(handle);
            if (i == file_handles.end()) {
                invalid = true;
            } else {
                FileHandleState* state = i->second.get();
                if (!state || state->write_mode) {
                    invalid = true;
                } else {
                    stream_read = state->stream_read;
                    if (stream_read) {
                        metadata = state->metadata ? state->metadata->copy() : nullptr;
                        path = state->path;
                    } else {
                        size_t data_size = state->data.size();
                        if (offset >= data_size) {
                            eof = true;
                        } else {
                            size_t chunk_size = std::min(static_cast<size_t>(length), data_size - static_cast<size_t>(offset));
                            chunk.assign(state->data.data() + static_cast<size_t>(offset), chunk_size);
                        }
                    }
                }
            }
        }
        ReferenceHolder<QoreHashNode> open_result(metadata, xsink);

        if (invalid) {
            return sendStatus(request_id, SSH_FX_INVALID_HANDLE, "invalid file handle", "en", xsink);
        }
        if (stream_read) {
            ReferenceHolder<QoreHashNode> req(new QoreHashNode(hashdeclSftpReadRequest, xsink), xsink);
            req->setKeyValue("session_info", getInfo(xsink), xsink);
            req->setKeyValue("path", new QoreStringNode(path.c_str()), xsink);
            req->setKeyValue("operation", new QoreStringNode("read"), xsink);
            if (*xsink) {
                return -1;
            }
            req->setKeyValue("offset", static_cast<int64>(offset), xsink);
            req->setKeyValue("length", static_cast<int64>(length), xsink);
            if (open_result) {
                ReferenceHolder<QoreHashNode> typed_open_result(reinterpret_cast<QoreHashNode*>(
                    hashdeclSftpOpenResult->doRuntimeCast(*open_result, xsink)), xsink);
                if (*xsink) {
                    return -1;
                }
                req->setKeyValue("open_result", typed_open_result.release(), xsink);
                const QoreValue backend_handle = open_result->getKeyValue("backend_handle");
                if (backend_handle.getType() != NT_NOTHING) {
                    req->setKeyValue("backend_handle", backend_handle.refSelf(), xsink);
                }
            }
            if (*xsink) {
                return -1;
            }

            ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("read", *req, xsink), xsink);
            if (*xsink) {
                sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                xsink->clear();
                return -1;
            }
            if (!backend_result) {
                return 0;
            }

            ReferenceHolder<QoreHashNode> typed_result(reinterpret_cast<QoreHashNode*>(
                hashdeclSftpReadResult->doRuntimeCast(*backend_result, xsink)), xsink);
            if (*xsink) {
                xsink->clear();
                return sendStatus(request_id, SSH_FX_FAILURE, "backend read result is invalid", "en", xsink);
            }

            const QoreValue data_v = typed_result->getKeyValue("data");
            if (const BinaryNode* binary = data_v.get<BinaryNode>()) {
                if (binary->size()) {
                    chunk.assign(reinterpret_cast<const char*>(binary->getPtr()), binary->size());
                }
            } else if (data_v.getType() != NT_NOTHING) {
                return sendStatus(request_id, SSH_FX_FAILURE, "backend read result is invalid", "en", xsink);
            }

            eof = ssh_sftp_get_hash_bool(*typed_result, "eof", false, xsink);
            if (*xsink) {
                xsink->clear();
                return sendStatus(request_id, SSH_FX_FAILURE, "backend read result is invalid", "en", xsink);
            }
        }
        if (eof && chunk.empty()) {
            return sendStatus(request_id, SSH_FX_EOF, "end of file", "en", xsink);
        }
        return sendData(request_id, chunk.data(), chunk.size(), xsink);
    }

    int handleBackendWrite(int request_id, const std::string& handle, uint64_t offset, const std::string& data,
            ExceptionSink* xsink) {
        logDebug("SFTP write handle=" + handle + " offset=" + std::to_string(offset) + " length=" + std::to_string(data.size()));
        bool invalid = false;
        bool too_large = false;
        bool stream_write = false;
        QoreHashNode* metadata = nullptr;
        std::string path;
        // resolved before taking the handle lock: getMaxBufferedUploadBytes() locks m itself and
        // std::mutex is not recursive
        const uint64_t max_buffered_bytes = getMaxBufferedUploadBytes();
        {
            std::lock_guard<std::mutex> lock(m);
            auto i = file_handles.find(handle);
            if (i == file_handles.end() || !i->second || !i->second->write_mode) {
                invalid = true;
            } else {
                FileHandleState* state = i->second.get();
                stream_write = state->stream_write;
                if (stream_write) {
                    metadata = state->metadata ? state->metadata->copy() : nullptr;
                    path = state->path;
                } else {
                    // H-3: offset and length are attacker-controlled wire values; reject any
                    // buffered write that would grow the in-memory buffer past the hard cap.
                    // Testing data.size() against (CAP - offset) (offset already <= CAP here)
                    // also prevents the offset + data.size() addition from overflowing.
                    if (offset > max_buffered_bytes
                            || data.size() > max_buffered_bytes - offset) {
                        too_large = true;
                    } else {
                        if (offset > state->data.size()) {
                            state->data.resize(static_cast<size_t>(offset), '\0');
                        }

                        size_t required_size = static_cast<size_t>(offset) + data.size();
                        if (required_size > state->data.size()) {
                            state->data.resize(required_size);
                        }
                        if (!data.empty()) {
                            memcpy(&state->data[static_cast<size_t>(offset)], data.data(), data.size());
                        }
                    }
                }
            }
        }
        ReferenceHolder<QoreHashNode> open_result(metadata, xsink);

        if (invalid) {
            return sendStatus(request_id, SSH_FX_INVALID_HANDLE, "invalid file handle", "en", xsink);
        }
        if (too_large) {
            logWarn("SFTP buffered write rejected: exceeds the " + std::to_string(
                max_buffered_bytes) + "-byte in-memory buffered-upload limit");
            return sendStatus(request_id, SSH_FX_FAILURE,
                "buffered upload exceeds the maximum in-memory size limit", "en", xsink);
        }
        if (stream_write) {
            ReferenceHolder<QoreHashNode> req(new QoreHashNode(hashdeclSftpWriteRequest, xsink), xsink);
            req->setKeyValue("session_info", getInfo(xsink), xsink);
            req->setKeyValue("path", new QoreStringNode(path.c_str()), xsink);
            req->setKeyValue("operation", new QoreStringNode("write"), xsink);
            if (*xsink) {
                return -1;
            }
            req->setKeyValue("offset", static_cast<int64>(offset), xsink);
            SimpleRefHolder<BinaryNode> data_bin(new BinaryNode());
            if (!data.empty()) {
                data_bin->append(data.data(), data.size());
            }
            req->setKeyValue("data", data_bin.release(), xsink);
            if (open_result) {
                ReferenceHolder<QoreHashNode> typed_open_result(reinterpret_cast<QoreHashNode*>(
                    hashdeclSftpOpenResult->doRuntimeCast(*open_result, xsink)), xsink);
                if (*xsink) {
                    return -1;
                }
                req->setKeyValue("open_result", typed_open_result.release(), xsink);
                const QoreValue backend_handle = open_result->getKeyValue("backend_handle");
                if (backend_handle.getType() != NT_NOTHING) {
                    req->setKeyValue("backend_handle", backend_handle.refSelf(), xsink);
                }
            }
            if (*xsink) {
                return -1;
            }

            ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("write", *req, xsink), xsink);
            if (*xsink) {
                sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                xsink->clear();
                return -1;
            }
            if (!backend_result) {
                return 0;
            }
        }
        return sendStatus(request_id, SSH_FX_OK, "written", "en", xsink);
    }

    int finalizeBackendFileState(FileHandleState& file_state, bool send_backend_errors, int request_id,
            ExceptionSink* xsink) {
        if (file_state.write_mode) {
            ReferenceHolder<QoreHashNode> req(new QoreHashNode(hashdeclSftpCloseRequest, xsink), xsink);
            req->setKeyValue("session_info", getInfo(xsink), xsink);
            req->setKeyValue("path", new QoreStringNode(file_state.path.c_str()), xsink);
            req->setKeyValue("operation", new QoreStringNode("close-write"), xsink);
            if (*xsink) {
                return -1;
            }
            if (file_state.metadata) {
                ReferenceHolder<QoreHashNode> typed_open_result(reinterpret_cast<QoreHashNode*>(
                    hashdeclSftpOpenResult->doRuntimeCast(file_state.metadata, xsink)), xsink);
                if (*xsink) {
                    return -1;
                }
                req->setKeyValue("open_result", typed_open_result.release(), xsink);
                const QoreValue backend_handle = file_state.metadata->getKeyValue("backend_handle");
                if (backend_handle.getType() != NT_NOTHING) {
                    req->setKeyValue("backend_handle", backend_handle.refSelf(), xsink);
                }
            }
            if (!file_state.stream_write) {
                SimpleRefHolder<BinaryNode> data(new BinaryNode());
                if (!file_state.data.empty()) {
                    data->append(file_state.data.data(), file_state.data.size());
                }
                req->setKeyValue("data", data.release(), xsink);
            }
            if (*xsink) {
                return -1;
            }
            ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("closeWrite", *req, xsink), xsink);
            if (*xsink) {
                if (send_backend_errors) {
                    sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                    xsink->clear();
                }
                return -1;
            }
            if (!backend_result) {
                return 0;
            }
        } else if (file_state.stream_read && backendHasMethod("closeRead")) {
            ReferenceHolder<QoreHashNode> req(new QoreHashNode(hashdeclSftpCloseRequest, xsink), xsink);
            req->setKeyValue("session_info", getInfo(xsink), xsink);
            req->setKeyValue("path", new QoreStringNode(file_state.path.c_str()), xsink);
            req->setKeyValue("operation", new QoreStringNode("close-read"), xsink);
            if (*xsink) {
                return -1;
            }
            if (file_state.metadata) {
                ReferenceHolder<QoreHashNode> typed_open_result(reinterpret_cast<QoreHashNode*>(
                    hashdeclSftpOpenResult->doRuntimeCast(file_state.metadata, xsink)), xsink);
                if (*xsink) {
                    return -1;
                }
                req->setKeyValue("open_result", typed_open_result.release(), xsink);
                const QoreValue backend_handle = file_state.metadata->getKeyValue("backend_handle");
                if (backend_handle.getType() != NT_NOTHING) {
                    req->setKeyValue("backend_handle", backend_handle.refSelf(), xsink);
                }
            }
            if (*xsink) {
                return -1;
            }
            ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("closeRead", *req, xsink), xsink);
            if (*xsink) {
                if (send_backend_errors) {
                    sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                    xsink->clear();
                }
                return -1;
            }
            if (!backend_result) {
                return 0;
            }
        }

        return 0;
    }

    int handleClose(int request_id, const std::string& handle, ExceptionSink* xsink) {
        std::unique_ptr<FileHandleState> file_state;
        bool erased = false;
        {
            std::lock_guard<std::mutex> lock(m);
            erased = dir_handles.erase(handle) > 0;
            if (!erased) {
                auto i = file_handles.find(handle);
                if (i != file_handles.end()) {
                    file_state = std::move(i->second);
                    file_handles.erase(i);
                    erased = true;
                }
            }
        }
        if (file_state) {
            logDetail("SFTP " + std::string(file_state->write_mode ? "close-write" : "close-read")
                + " path=" + file_state->path);
            if (finalizeBackendFileState(*file_state, true, request_id, xsink)) {
                if (*xsink) {
                    return -1;
                }
                return 0;
            }
        }
        return sendStatus(request_id, erased ? SSH_FX_OK : SSH_FX_INVALID_HANDLE,
            erased ? "closed" : "invalid handle", "en", xsink);
    }

    int handleBackendFstat(int request_id, const std::string& handle, ExceptionSink* xsink) {
        logDetail("SFTP fstat handle=" + handle);
        QoreHashNode* copied_metadata = nullptr;
        bool invalid = false;
        {
            std::lock_guard<std::mutex> lock(m);
            auto i = file_handles.find(handle);
            if (i == file_handles.end()) {
                invalid = true;
            } else if (!i->second || !i->second->metadata) {
                invalid = true;
            } else {
                copied_metadata = i->second->metadata->copy();
            }
        }
        ReferenceHolder<QoreHashNode> metadata(copied_metadata, xsink);

        if (invalid || !metadata) {
            return sendStatus(request_id, SSH_FX_INVALID_HANDLE, "invalid file handle", "en", xsink);
        }
        return sendBackendAttrs(request_id, *metadata, xsink);
    }

    int buildSetstatRequest(QoreHashNode* typed_req, const std::string& operation,
            const unsigned char* attrs_ptr, size_t attrs_size, size_t& attrs_offset, ExceptionSink* xsink) {
        uint32_t flags = 0;
        int64_t file_size = -1;
        uint32_t uid = 0, gid = 0, permissions = 0, atime = 0, mtime = 0;

        if (!ssh_sftp_parse_attrs(attrs_ptr, attrs_size, attrs_offset, flags, file_size, uid, gid,
                permissions, atime, mtime)) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "malformed SFTP attrs block in %s", operation.c_str());
            return -1;
        }

        typed_req->setKeyValue("operation", new QoreStringNode(operation.c_str()), xsink);
        typed_req->setKeyValue("attr_flags", static_cast<int64>(flags), xsink);
        if (flags & SSH_FILEXFER_ATTR_SIZE) {
            typed_req->setKeyValue("size", file_size, xsink);
        }
        if (flags & SSH_FILEXFER_ATTR_UIDGID) {
            typed_req->setKeyValue("uid", static_cast<int64>(uid), xsink);
            typed_req->setKeyValue("gid", static_cast<int64>(gid), xsink);
        }
        if (flags & SSH_FILEXFER_ATTR_PERMISSIONS) {
            typed_req->setKeyValue("permissions", static_cast<int64>(permissions), xsink);
        }
        if (flags & SSH_FILEXFER_ATTR_ACMODTIME) {
            typed_req->setKeyValue("atime", static_cast<int64>(atime), xsink);
            typed_req->setKeyValue("mtime", static_cast<int64>(mtime), xsink);
        }
        return *xsink ? -1 : 0;
    }

    int handleBackendFsetstat(int request_id, const std::string& handle,
            const unsigned char* attrs_ptr, size_t attrs_size, size_t attrs_offset, ExceptionSink* xsink) {
        logDetail("SFTP fsetstat handle=" + handle);
        std::string path;
        bool invalid = false;
        {
            std::lock_guard<std::mutex> lock(m);
            auto i = file_handles.find(handle);
            if (i == file_handles.end() || !i->second) {
                invalid = true;
            } else {
                path = i->second->path;
            }
        }

        if (invalid) {
            return sendStatus(request_id, SSH_FX_INVALID_HANDLE, "invalid file handle", "en", xsink);
        }

        if (!backendHasMethod("setstat")) {
            return sendStatus(request_id, SSH_FX_OK, "attributes updated", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_req(new QoreHashNode(hashdeclSftpSetstatRequest, xsink), xsink);
        typed_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_req->setKeyValue("path", new QoreStringNode(path.c_str()), xsink);
        typed_req->setKeyValue("handle", new QoreStringNode(handle.c_str()), xsink);
        if (buildSetstatRequest(*typed_req, "fsetstat", attrs_ptr, attrs_size, attrs_offset, xsink)) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("setstat", *typed_req, xsink), xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        return sendBackendOperationStatus(request_id, *backend_result, "attributes updated", false, xsink);
    }

    int handleBackendSetstat(int request_id, const std::string& normalized_path,
            const unsigned char* attrs_ptr, size_t attrs_size, size_t attrs_offset, ExceptionSink* xsink) {
        logDetail("SFTP setstat path=" + normalized_path);
        if (!backendHasMethod("setstat")) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "setstat is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_req(new QoreHashNode(hashdeclSftpSetstatRequest, xsink), xsink);
        typed_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        if (buildSetstatRequest(*typed_req, "setstat", attrs_ptr, attrs_size, attrs_offset, xsink)) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("setstat", *typed_req, xsink), xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        return sendBackendOperationStatus(request_id, *backend_result, "attributes updated", false, xsink);
    }

    int handleBackendPathOperation(const char* method, int request_id, const std::string& normalized_path,
            const char* operation, const char* unsupported_message, const char* success_message, bool path_not_found,
            ExceptionSink* xsink) {
        logDetail("SFTP " + std::string(operation) + " path=" + normalized_path);
        if (!backendHasMethod(method)) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, unsupported_message, "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("follow_symlinks", true, xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode(operation), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped(method, *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        return sendBackendOperationStatus(request_id, *backend_result, success_message, path_not_found, xsink);
    }

    int handleBackendRename(int request_id, const std::string& normalized_path, const std::string& target_path,
            ExceptionSink* xsink) {
        logDetail("SFTP rename path=" + normalized_path + " target=" + target_path);
