        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("target_path", new QoreStringNode(target_path.c_str()), xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("rename"), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("rename", *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        return sendBackendOperationStatus(request_id, *backend_result, "renamed", false, xsink);
    }

    int handleBackendSymlink(int request_id, const std::string& link_path, const std::string& target_path,
            ExceptionSink* xsink) {
        logDetail("SFTP symlink link=" + link_path + " target=" + target_path);
        if (!backendHasMethod("symlink")) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "symlink is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpSymlinkRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("link_path", new QoreStringNode(link_path.c_str()), xsink);
        typed_backend_req->setKeyValue("target_path", new QoreStringNode(target_path.c_str()), xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("symlink"), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("symlink", *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        return sendBackendOperationStatus(request_id, *backend_result, "symlink created", false, xsink);
    }

    int handleBackendReadlink(int request_id, const std::string& normalized_path, ExceptionSink* xsink) {
        logDetail("SFTP readlink path=" + normalized_path);
        if (!backendHasMethod("readlink")) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "readlink is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("follow_symlinks", false, xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("readlink"), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("readlink", *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        bool exists = ssh_sftp_get_hash_bool(*backend_result, "exists", true, xsink);
        if (*xsink) {
            xsink->clear();
            return sendStatus(request_id, SSH_FX_FAILURE, "backend result is invalid", "en", xsink);
        }
        if (!exists) {
            return sendStatus(request_id, SSH_FX_NO_SUCH_FILE, "not found", "en", xsink);
        }

        QoreValue target_val = backend_result->getKeyValue("target_path");
        if (target_val.getType() != NT_STRING) {
            return sendStatus(request_id, SSH_FX_FAILURE, "backend did not return target_path", "en", xsink);
        }
        QoreStringValueHelper target_str(target_val);
        std::string target = target_str->c_str();
        return sendName(request_id, target, target, xsink);
    }

    int sendExtendedReply(int request_id, const std::string& payload_data, ExceptionSink* xsink) {
        if (request_id < 0) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "the SFTP request id must be >= 0");
            return -1;
        }

        std::string body;
        body.reserve(1 + 4 + payload_data.size());
        body.push_back(static_cast<char>(SSH_FXP_EXTENDED_REPLY));
        ssh_sftp_write_u32_be(body, static_cast<uint32_t>(request_id));
        body.append(payload_data);

        std::string packet;
        packet.reserve(4 + body.size());
        ssh_sftp_write_u32_be(packet, static_cast<uint32_t>(body.size()));
        packet.append(body);
        return writeChannelAll(packet, xsink, "SSH_FXP_EXTENDED_REPLY");
    }

    int handleBackendStatvfs(int request_id, const std::string& normalized_path, ExceptionSink* xsink) {
        logDetail("SFTP statvfs path=" + normalized_path);
        if (!backendHasMethod("statvfs")) {
            return sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "statvfs is not supported", "en", xsink);
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("follow_symlinks", true, xsink);
        typed_backend_req->setKeyValue("operation", new QoreStringNode("statvfs"), xsink);
        if (*xsink) {
            return -1;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("statvfs", *typed_backend_req, xsink),
            xsink);
        if (*xsink) {
            sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
            xsink->clear();
            return -1;
        }
        if (!backend_result) {
            return 0;
        }

        // Pack the 11 uint64 fields as per the OpenSSH statvfs@openssh.com extension
        std::string reply_data;
        reply_data.reserve(88);
        static const char* statvfs_fields[] = {
            "f_bsize", "f_frsize", "f_blocks", "f_bfree", "f_bavail",
            "f_files", "f_ffree", "f_favail", "f_fsid", "f_flag", "f_namemax"
        };
        for (int i = 0; i < 11; ++i) {
            int64 val = backend_result->getKeyValue(statvfs_fields[i]).getAsBigInt();
            ssh_sftp_write_u64_be(reply_data, static_cast<uint64_t>(val));
        }

        return sendExtendedReply(request_id, reply_data, xsink);
    }

    QoreHashNode* processNextRequest(int timeout_ms, ExceptionSink* xsink) {
        ReferenceHolder<QoreHashNode> msg(waitProtocolMessage(timeout_ms, xsink), xsink);
        if (*xsink || !msg) {
            return nullptr;
        }

        int64 type = msg->getKeyValue("type").getAsBigInt();
        if (*xsink) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                "the decoded SFTP protocol message is missing a valid type");
            return nullptr;
        }

        if (type == SSH_FXP_INIT) {
            const QoreValue version_v = msg->getKeyValue("version");
            int version = version_v.getType() == NT_NOTHING ? 3 : static_cast<int>(version_v.getAsBigInt());
            if (*xsink) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "the decoded SFTP init message is missing a valid version");
                return nullptr;
            }
            if (sendVersion(version > 0 ? version : 3, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        const QoreValue request_id_v = msg->getKeyValue("request_id");
        if (request_id_v.getType() == NT_NOTHING) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                "cannot process an SFTP request without a request id");
            return nullptr;
        }
        int request_id = static_cast<int>(request_id_v.getAsBigInt());
        if (*xsink) {
            xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                "the decoded SFTP protocol message is missing a valid request id");
            return nullptr;
        }

        // H-1: enforce read-only sessions for all unconditionally-mutating SFTP operations before any
        // backend dispatch or local filesystem access.  SSH_FXP_OPEN is conditionally mutating and is
        // gated separately below once its pflags are decoded.
        switch (type) {
            case SSH_FXP_WRITE:
            case SSH_FXP_SETSTAT:
            case SSH_FXP_FSETSTAT:
            case SSH_FXP_REMOVE:
            case SSH_FXP_MKDIR:
            case SSH_FXP_RMDIR:
            case SSH_FXP_RENAME:
            case SSH_FXP_SYMLINK:
                if (isReadOnly()) {
                    logWarn("SFTP write operation denied for read-only session: type="
                        + std::to_string(type));
                    if (sendStatus(request_id, SSH_FX_PERMISSION_DENIED,
                            "read-only SFTP session: write operations are not permitted", "en", xsink)) {
                        return nullptr;
                    }
                    return msg.release();
                }
                break;
            default:
                break;
        }

        if (type == SSH_FXP_REALPATH) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 4) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_REALPATH payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_REALPATH path field");
                return nullptr;
            }

            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
                typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
                typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
                typed_backend_req->setKeyValue("follow_symlinks", true, xsink);
                typed_backend_req->setKeyValue("operation", new QoreStringNode("realpath"), xsink);
                if (*xsink) {
                    return nullptr;
                }

                ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("stat", *typed_backend_req,
                    xsink), xsink);
                if (*xsink) {
                    sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                    xsink->clear();
                    return nullptr;
                }
                if (!backend_result) {
                    return msg.release();
                }

                if (!ssh_sftp_get_hash_bool(*backend_result, "exists", true, xsink)) {
                    if (*xsink) {
                        xsink->clear();
                        if (sendStatus(request_id, SSH_FX_FAILURE, "backend result is invalid", "en", xsink)) {
                            return nullptr;
                        }
                        return msg.release();
                    }
                    if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "not found", "en", xsink)) {
                        return nullptr;
                    }
                    return msg.release();
                }

                std::string final_path = normalized_path;
                QoreValue backend_path = (*backend_result)->getKeyValue("path");
                if (backend_path.getType() == NT_STRING) {
                    QoreStringValueHelper str(backend_path);
                    if (str->strlen()) {
                        final_path = str->c_str();
                    }
                }
                if (sendName(request_id, final_path, final_path, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            if (sendName(request_id, normalized_path, normalized_path, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_STAT || type == SSH_FXP_LSTAT) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 4) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s payload", type == SSH_FXP_STAT ? "STAT" : "LSTAT");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s path field", type == SSH_FXP_STAT ? "STAT" : "LSTAT");
                return nullptr;
            }

            ReferenceHolder<QoreHashNode> current_info(getInfo(xsink), xsink);
            if (*xsink) {
                return nullptr;
            }

            std::string normalized_path;
            std::string real_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
                typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
                typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
                typed_backend_req->setKeyValue("follow_symlinks", type == SSH_FXP_STAT, xsink);
                typed_backend_req->setKeyValue("operation",
                    new QoreStringNode(type == SSH_FXP_STAT ? "stat" : "lstat"), xsink);
                if (*xsink) {
                    return nullptr;
                }

                ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("stat", *typed_backend_req,
                    xsink), xsink);
                if (*xsink) {
                    sendStatus(request_id, SSH_FX_FAILURE, "backend operation failed", "en", xsink);
                    xsink->clear();
                    return nullptr;
                }
                if (!backend_result) {
                    return msg.release();
                }

                if (!ssh_sftp_get_hash_bool(*backend_result, "exists", true, xsink)) {
                    if (*xsink) {
                        xsink->clear();
                        if (sendStatus(request_id, SSH_FX_FAILURE, "backend result is invalid", "en", xsink)) {
                            return nullptr;
                        }
                        return msg.release();
                    }
                    if (sendStatus(request_id, SSH_FX_NO_SUCH_FILE, "not found", "en", xsink)) {
                        return nullptr;
                    }
                    return msg.release();
                }

                if (sendBackendAttrs(request_id, *backend_result, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            std::string root_dir;
            if (!ssh_sftp_get_real_path(*current_info, raw_path, normalized_path, real_path, root_dir)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            // M-4: confine the resolved (symlink-followed) path within the canonical root so a
            // symlinked component cannot leak metadata for files outside the virtual root.
            if (!ssh_sftp_path_within_root(root_dir, real_path, type != SSH_FXP_LSTAT)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            if (ssh_sftp_check_fs_access(real_path, QSEC_READ, xsink)) {
                return nullptr;
            }

            struct stat st;
            int rc = type == SSH_FXP_LSTAT ? ::lstat(real_path.c_str(), &st) : ::stat(real_path.c_str(), &st);
            if (rc) {
                int sftp_status = errno == ENOENT || errno == ENOTDIR ? SSH_FX_NO_SUCH_FILE : SSH_FX_FAILURE;
                if (sendStatus(request_id, sftp_status, strerror(errno), "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            if (sendAttrs(request_id, st, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_OPENDIR) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 4) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_OPENDIR payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_OPENDIR path field");
                return nullptr;
            }

            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                if (handleBackendOpenDir(request_id, normalized_path, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        if (type == SSH_FXP_OPEN) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_OPEN payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_OPEN path field");
                return nullptr;
            }
            if (offset + 4 > payload->size()) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a truncated SSH_FXP_OPEN pflags field");
                return nullptr;
            }

            const unsigned char* payload_ptr = reinterpret_cast<const unsigned char*>(payload->getPtr());
            uint32_t pflags = ssh_sftp_read_u32_be(payload_ptr + offset);
            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            // H-1: an OPEN that requests write/create/append/truncate is a mutating operation; deny it
            // on read-only sessions before resolving the backend.
            if ((pflags & (SSH_FXF_WRITE | SSH_FXF_CREAT | SSH_FXF_APPEND | SSH_FXF_TRUNC)) && isReadOnly()) {
                logWarn("SFTP write-open denied for read-only session");
                if (sendStatus(request_id, SSH_FX_PERMISSION_DENIED,
                        "read-only SFTP session: write operations are not permitted", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                if ((pflags & SSH_FXF_WRITE) ? handleBackendOpenWrite(request_id, normalized_path, pflags, xsink)
                        : handleBackendOpenRead(request_id, normalized_path, pflags, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        if (type == SSH_FXP_READ) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 20) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_READ payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string handle;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, handle)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_READ handle field");
                return nullptr;
            }
            if (offset + 12 > payload->size()) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a truncated SSH_FXP_READ offset/length field");
                return nullptr;
            }

            const unsigned char* payload_ptr = reinterpret_cast<const unsigned char*>(payload->getPtr());
            uint64_t read_offset = ssh_sftp_read_u64_be(payload_ptr + offset);
            offset += 8;
            uint32_t length = ssh_sftp_read_u32_be(payload_ptr + offset);
            if (handleBackendRead(request_id, handle, read_offset, length, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_WRITE) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 20) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_WRITE payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string handle;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, handle)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_WRITE handle field");
                return nullptr;
            }
            if (offset + 12 > payload->size()) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a truncated SSH_FXP_WRITE offset/data field");
                return nullptr;
            }

            const unsigned char* payload_ptr = reinterpret_cast<const unsigned char*>(payload->getPtr());
            uint64_t write_offset = ssh_sftp_read_u64_be(payload_ptr + offset);
            offset += 8;
            std::string write_data;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, write_data)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_WRITE data field");
                return nullptr;
            }

            if (handleBackendWrite(request_id, handle, write_offset, write_data, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_FSTAT) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_FSTAT payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string handle;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, handle)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_FSTAT handle field");
                return nullptr;
            }

            if (handleBackendFstat(request_id, handle, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_FSETSTAT) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_FSETSTAT payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string handle;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, handle)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_FSETSTAT handle field");
                return nullptr;
            }

            if (handleBackendFsetstat(request_id, handle,
                    reinterpret_cast<const unsigned char*>(payload->getPtr()), payload->size(), offset, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_SETSTAT) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_SETSTAT payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_SETSTAT path field");
                return nullptr;
            }

            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            if (handleBackendSetstat(request_id, normalized_path,
                    reinterpret_cast<const unsigned char*>(payload->getPtr()), payload->size(), offset, xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        if (type == SSH_FXP_READDIR || type == SSH_FXP_CLOSE) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s payload", type == SSH_FXP_READDIR ? "READDIR" : "CLOSE");
                return nullptr;
            }

            size_t offset = 4;
            std::string handle;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, handle)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s handle field", type == SSH_FXP_READDIR ? "READDIR" : "CLOSE");
                return nullptr;
            }

            if (type == SSH_FXP_READDIR) {
                if (handleBackendReadDir(request_id, handle, xsink)) {
                    return nullptr;
                }
            } else {
                if (handleClose(request_id, handle, xsink)) {
                    return nullptr;
                }
            }
            return msg.release();
        }

        if (type == SSH_FXP_REMOVE || type == SSH_FXP_MKDIR || type == SSH_FXP_RMDIR) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s payload", type == SSH_FXP_REMOVE ? "REMOVE"
                        : (type == SSH_FXP_MKDIR ? "MKDIR" : "RMDIR"));
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_%s path field", type == SSH_FXP_REMOVE ? "REMOVE"
                        : (type == SSH_FXP_MKDIR ? "MKDIR" : "RMDIR"));
                return nullptr;
            }

            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                int rc = 0;
                if (type == SSH_FXP_REMOVE) {
                    rc = handleBackendPathOperation("removePath", request_id, normalized_path, "remove",
                        "remove is not supported", "removed", false, xsink);
                } else if (type == SSH_FXP_MKDIR) {
                    rc = handleBackendPathOperation("mkdir", request_id, normalized_path, "mkdir",
                        "mkdir is not supported", "directory created", true, xsink);
                } else {
                    rc = handleBackendPathOperation("rmdir", request_id, normalized_path, "rmdir",
                        "rmdir is not supported", "directory removed", true, xsink);
                }

                if (rc) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        if (type == SSH_FXP_RENAME) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 12) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_RENAME payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            std::string raw_target_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_RENAME source path field");
                return nullptr;
            }
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_target_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_RENAME target path field");
                return nullptr;
            }

            std::string normalized_path;
            std::string normalized_target_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)
                    || !ssh_sftp_normalize_virtual_path(raw_target_path, normalized_target_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                if (handleBackendRename(request_id, normalized_path, normalized_target_path, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        // NOTE: OpenSSH reverses the argument order for SSH_FXP_SYMLINK (first=target, second=link)
        if (type == SSH_FXP_SYMLINK) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 12) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_SYMLINK payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_target_path;
            std::string raw_link_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_target_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_SYMLINK target path field");
                return nullptr;
            }
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_link_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_SYMLINK link path field");
                return nullptr;
            }

            std::string normalized_link_path;
            std::string normalized_target_path;
            if (!ssh_sftp_normalize_virtual_path(raw_link_path, normalized_link_path)
                    || !ssh_sftp_normalize_virtual_path(raw_target_path, normalized_target_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                if (handleBackendSymlink(request_id, normalized_link_path, normalized_target_path, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        if (type == SSH_FXP_READLINK) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_READLINK payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string raw_path;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, raw_path)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_READLINK path field");
                return nullptr;
            }

            std::string normalized_path;
            if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH, "path escapes the configured SFTP root", "en", xsink)) {
                    return nullptr;
                }
                return msg.release();
            }

            ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
            if (*xsink) {
                return nullptr;
            }
            if (backend_holder) {
                if (handleBackendReadlink(request_id, normalized_path, xsink)) {
                    return nullptr;
                }
                return msg.release();
            }
        }

        if (type == SSH_FXP_EXTENDED) {
            const BinaryNode* payload = msg->getKeyValue("payload").get<BinaryNode>();
            if (!payload || payload->size() < 8) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_EXTENDED payload");
                return nullptr;
            }

            size_t offset = 4;
            std::string ext_name;
            if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                    offset, ext_name)) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                    "received a malformed SSH_FXP_EXTENDED extension name field");
                return nullptr;
            }

            if (ext_name == "statvfs@openssh.com") {
                std::string raw_path;
                if (!ssh_sftp_read_string_field(reinterpret_cast<const char*>(payload->getPtr()), payload->size(),
                        offset, raw_path)) {
                    xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR",
                        "received a malformed statvfs@openssh.com path field");
                    return nullptr;
                }

                std::string normalized_path;
                if (!ssh_sftp_normalize_virtual_path(raw_path, normalized_path)) {
                    if (sendStatus(request_id, SSH_FX_NO_SUCH_PATH,
                            "path escapes the configured SFTP root", "en", xsink)) {
                        return nullptr;
                    }
                    return msg.release();
                }

                ReferenceHolder<QoreObject> backend_holder(getBackend(), xsink);
                if (*xsink) {
                    return nullptr;
                }
                if (backend_holder) {
                    if (handleBackendStatvfs(request_id, normalized_path, xsink)) {
                        return nullptr;
                    }
                    return msg.release();
                }
            }

            // Unknown extension
            if (sendStatus(request_id, SSH_FX_OP_UNSUPPORTED,
                    "unsupported extension", "en", xsink)) {
                return nullptr;
            }
            return msg.release();
        }

        logWarn("SFTP unsupported operation type=" + std::to_string(type));
        if (sendStatus(request_id, SSH_FX_OP_UNSUPPORTED, "unsupported", "en", xsink)) {
            return nullptr;
        }
        return msg.release();
    }

    int64 processRequests(int timeout_ms, int64 max_batch, ExceptionSink* xsink) {
        int64 processed = 0;

        // First request uses the full timeout
        ReferenceHolder<QoreHashNode> first(processNextRequest(timeout_ms, xsink), xsink);
        if (*xsink || !first) {
            return processed;
        }
        ++processed;

        if (max_batch > 0 && processed >= max_batch) {
            return processed;
        }

        // Read-ahead: process additional requests while data is available on the channel
        while (true) {
            ssh_channel current_channel = nullptr;
            {
                std::lock_guard<std::mutex> lock(m);
                current_channel = channel;
            }
            if (!current_channel) {
                break;
            }

            int avail = ssh_channel_poll(current_channel, 0);
            if (avail <= 0) {
                break;
            }

            ReferenceHolder<QoreHashNode> msg(processNextRequest(1, xsink), xsink);
            if (*xsink || !msg) {
                break;
            }
            ++processed;

            if (max_batch > 0 && processed >= max_batch) {
                break;
            }
        }

        return processed;
    }

    QoreHashNode* listAvailable(const QoreHashNode* q_req, ExceptionSink* xsink) {
        if (!backendHasMethod("listAvailable")) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend objects must implement listAvailable() for atomic retrieval helpers");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_req(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpPathRequest->doRuntimeCast(q_req, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        std::string path;
        if (!ssh_sftp_get_hash_string(*typed_req, "path", path) || path.empty()) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "listAvailable() requires a non-empty request path");
            return nullptr;
        }

        std::string normalized_path;
        if (!ssh_sftp_normalize_virtual_path(path, normalized_path)) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "listAvailable() path '%s' escapes the virtual root", path.c_str());
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_req(buildBackendPathRequest(normalized_path, true, "list-available", xsink),
            xsink);
        if (*xsink) {
            return nullptr;
        }

        backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("metadata")) {
            backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpPathRequest, xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("metadata")) {
            typed_backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("listAvailable", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        return reinterpret_cast<QoreHashNode*>(hashdeclSftpListResult->doRuntimeCast(*backend_result, xsink));
    }

    QoreHashNode* submit(const QoreHashNode* q_req, ExceptionSink* xsink) {
        if (!backendHasMethod("submit")) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend objects must implement submit() for atomic submission helpers");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_req(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpSubmissionRequest->doRuntimeCast(q_req, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        std::string path;
        if (!ssh_sftp_get_hash_string(*typed_req, "path", path) || path.empty()) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "submit() requires a non-empty request path");
            return nullptr;
        }

        std::string normalized_path;
        if (!ssh_sftp_normalize_virtual_path(path, normalized_path)) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "submit() path '%s' escapes the virtual root", path.c_str());
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_req(buildBackendPathRequest(normalized_path, true, "submit", xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const BinaryNode* data_node = typed_req->getKeyValue("data").get<BinaryNode>();
        std::string source_path;
        ssh_sftp_get_hash_string(*typed_req, "source_path", source_path);
        if (data_node) {
            backend_req->setKeyValue("data", data_node->refSelf(), xsink);
            backend_req->setKeyValue("size", static_cast<int64>(data_node->size()), xsink);
        } else if (!source_path.empty()) {
            if (ssh_sftp_check_fs_access(source_path, QSEC_READ, xsink)) {
                return nullptr;
            }
            ReferenceHolder<BinaryNode> source_data(ssh_sftp_read_binary_file(source_path, xsink), xsink);
            if (*xsink) {
                return nullptr;
            }
            int64 source_size = static_cast<int64>(source_data->size());
            backend_req->setKeyValue("source_path", new QoreStringNode(source_path.c_str()), xsink);
            backend_req->setKeyValue("data", source_data.release(), xsink);
            backend_req->setKeyValue("size", source_size, xsink);
        } else {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "submit() requires either binary data or a local source_path");
            return nullptr;
        }

        if (typed_req->existsKey("metadata")) {
            backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (typed_req->existsKey("checksum")) {
            backend_req->setKeyValue("checksum", typed_req->getKeyValue("checksum").refSelf(), xsink);
        }
        if (typed_req->existsKey("move")) {
            backend_req->setKeyValue("move", typed_req->getKeyValue("move").refSelf(), xsink);
        }
        if (typed_req->existsKey("create_parents")) {
            backend_req->setKeyValue("create_parents", typed_req->getKeyValue("create_parents").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpSubmissionRequest, xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (data_node) {
            typed_backend_req->setKeyValue("data", data_node->refSelf(), xsink);
        } else if (!source_path.empty()) {
            typed_backend_req->setKeyValue("source_path", new QoreStringNode(source_path.c_str()), xsink);
            typed_backend_req->setKeyValue("data", backend_req->getKeyValue("data").refSelf(), xsink);
        }
        if (typed_req->existsKey("metadata")) {
            typed_backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (typed_req->existsKey("checksum")) {
            typed_backend_req->setKeyValue("checksum", typed_req->getKeyValue("checksum").refSelf(), xsink);
        }
        if (typed_req->existsKey("move")) {
            typed_backend_req->setKeyValue("move", typed_req->getKeyValue("move").refSelf(), xsink);
        }
        if (typed_req->existsKey("create_parents")) {
            typed_backend_req->setKeyValue("create_parents", typed_req->getKeyValue("create_parents").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("submit", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* transfer_info = backend_result->getKeyValue("transfer_info").get<QoreHashNode>();
        if (transfer_info) {
            if (applyTransferInfo(transfer_info, xsink)) {
                return nullptr;
            }
        }

        {
            std::ostringstream os;
            os << "SftpSession submit path=" << normalized_path;
            logInfo(os.str());
        }

        return reinterpret_cast<QoreHashNode*>(hashdeclSftpOperationResult->doRuntimeCast(*backend_result, xsink));
    }

    QoreHashNode* retrieve(const QoreHashNode* q_req, ExceptionSink* xsink) {
        if (!backendHasMethod("retrieve")) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend objects must implement retrieve() for atomic retrieval helpers");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_req(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpOpenRequest->doRuntimeCast(q_req, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        std::string path;
        if (!ssh_sftp_get_hash_string(*typed_req, "path", path) || path.empty()) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "retrieve() requires a non-empty request path");
            return nullptr;
        }

        std::string normalized_path;
        if (!ssh_sftp_normalize_virtual_path(path, normalized_path)) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "retrieve() path '%s' escapes the virtual root", path.c_str());
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_req(buildBackendPathRequest(normalized_path, true, "retrieve", xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("metadata")) {
            backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (typed_req->existsKey("offset")) {
            backend_req->setKeyValue("offset", typed_req->getKeyValue("offset").refSelf(), xsink);
        }
        if (typed_req->existsKey("length")) {
            backend_req->setKeyValue("length", typed_req->getKeyValue("length").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpOpenRequest, xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("metadata")) {
            typed_backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (typed_req->existsKey("offset")) {
            typed_backend_req->setKeyValue("offset", typed_req->getKeyValue("offset").refSelf(), xsink);
        }
        if (typed_req->existsKey("length")) {
            typed_backend_req->setKeyValue("length", typed_req->getKeyValue("length").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("retrieve", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* transfer_info = backend_result->getKeyValue("transfer_info").get<QoreHashNode>();
        if (transfer_info) {
            if (applyTransferInfo(transfer_info, xsink)) {
                return nullptr;
            }
        }

        {
            std::ostringstream os;
            os << "SftpSession retrieve path=" << normalized_path;
            logInfo(os.str());
        }

        return reinterpret_cast<QoreHashNode*>(hashdeclSftpOpenResult->doRuntimeCast(*backend_result, xsink));
    }

    QoreHashNode* completeRetrieve(const QoreHashNode* q_req, ExceptionSink* xsink) {
        if (!backendHasMethod("completeRetrieve")) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "backend objects must implement completeRetrieve() for atomic retrieval helpers");
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_req(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpOperationRequest->doRuntimeCast(q_req, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        std::string path;
        if (!ssh_sftp_get_hash_string(*typed_req, "path", path) || path.empty()) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "completeRetrieve() requires a non-empty request path");
            return nullptr;
        }

        std::string normalized_path;
        if (!ssh_sftp_normalize_virtual_path(path, normalized_path)) {
            xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
                "completeRetrieve() path '%s' escapes the virtual root", path.c_str());
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_req(buildBackendPathRequest(normalized_path, true, "complete-retrieve", xsink),
            xsink);
        if (*xsink) {
            return nullptr;
        }

        backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("target_path")) {
            backend_req->setKeyValue("target_path", typed_req->getKeyValue("target_path").refSelf(), xsink);
        }
        if (typed_req->existsKey("completion_mode")) {
            backend_req->setKeyValue("completion_mode", typed_req->getKeyValue("completion_mode").refSelf(), xsink);
        }
        if (typed_req->existsKey("metadata")) {
            backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> typed_backend_req(new QoreHashNode(hashdeclSftpOperationRequest, xsink), xsink);
        typed_backend_req->setKeyValue("path", new QoreStringNode(normalized_path.c_str()), xsink);
        typed_backend_req->setKeyValue("session_info", getInfo(xsink), xsink);
        if (typed_req->existsKey("target_path")) {
            typed_backend_req->setKeyValue("target_path", typed_req->getKeyValue("target_path").refSelf(), xsink);
        }
        if (typed_req->existsKey("completion_mode")) {
            typed_backend_req->setKeyValue("completion_mode", typed_req->getKeyValue("completion_mode").refSelf(), xsink);
        }
        if (typed_req->existsKey("metadata")) {
            typed_backend_req->setKeyValue("metadata", typed_req->getKeyValue("metadata").refSelf(), xsink);
        }
        if (*xsink) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> backend_result(callBackendMethodDirectTyped("completeRetrieve", *typed_backend_req,
            xsink), xsink);
        if (*xsink) {
            return nullptr;
        }

        const QoreHashNode* transfer_info = backend_result->getKeyValue("transfer_info").get<QoreHashNode>();
        if (transfer_info) {
            if (applyTransferInfo(transfer_info, xsink)) {
                return nullptr;
            }
        }

        {
            std::ostringstream os;
            os << "SftpSession completeRetrieve path=" << normalized_path;
            std::string completion_mode;
            if (!ssh_sftp_get_hash_string(*typed_req, "completion_mode", completion_mode)) {
                const QoreHashNode* metadata = typed_req->getKeyValue("metadata").get<QoreHashNode>();
                if (metadata) {
                    ssh_sftp_get_hash_string(metadata, "mode", completion_mode);
                }
            }
            if (!completion_mode.empty()) {
                os << " completion_mode=" << completion_mode;
            }
            logInfo(os.str());
        }

        return reinterpret_cast<QoreHashNode*>(hashdeclSftpOperationResult->doRuntimeCast(*backend_result, xsink));
    }

    int applyFactoryResult(const QoreHashNode* result, ExceptionSink* xsink) {
        if (!result) {
            return 0;
        }

        const QoreHashNode* typed_transfer_info = nullptr;
        ReferenceHolder<QoreHashNode> copied_transfer_info(nullptr, xsink);
        {
            std::lock_guard<std::mutex> lock(m);

            if (result->existsKey("root_dir")) {
                info->setKeyValue("root_dir", result->getKeyValue("root_dir").refSelf(), xsink);
                if (*xsink) {
                    return -1;
                }
            }

            if (result->existsKey("read_only")) {
                bool read_only = result->getKeyValue("read_only").getAsBool();
                if (*xsink) {
                    xsink->raiseException("SFTPSESSION-FACTORY-ERROR",
                        "the factory result \"read_only\" key must be a boolean when present");
                    return -1;
                }
                info->setKeyValue("read_only", read_only, xsink);
                if (*xsink) {
                    return -1;
                }
            }

            if (result->existsKey("max_buffered_upload_bytes")) {
                const QoreValue cap_v = result->getKeyValue("max_buffered_upload_bytes");
                if (cap_v.getType() != NT_NOTHING && cap_v.getType() != NT_INT) {
                    xsink->raiseException("SFTPSESSION-FACTORY-ERROR",
                        "the factory result \"max_buffered_upload_bytes\" key must be an integer "
                        "or NOTHING when present");
                    return -1;
                }
                info->setKeyValue("max_buffered_upload_bytes", cap_v.refSelf(), xsink);
                if (*xsink) {
                    return -1;
                }
            }

            if (result->existsKey("session_data")) {
                info->setKeyValue("session_data", result->getKeyValue("session_data").refSelf(), xsink);
                if (*xsink) {
                    return -1;
                }
            }

            if (result->existsKey("transfer_info")) {
                typed_transfer_info = result->getKeyValue("transfer_info").get<QoreHashNode>();
                if (!typed_transfer_info) {
                    xsink->raiseException("SFTPSESSION-FACTORY-ERROR",
                        "the factory result \"transfer_info\" key must be a hash<SftpTransferInfo> when present");
                    return -1;
                }

                QoreHashNode* cast_transfer_info = reinterpret_cast<QoreHashNode*>(
                    hashdeclSftpTransferInfo->doRuntimeCast(typed_transfer_info, xsink));
                copied_transfer_info = cast_transfer_info;
                if (*xsink) {
                    return -1;
                }
            }
        }

        if (copied_transfer_info) {
            QoreHashNode* old_transfer_info = nullptr;
            {
                std::lock_guard<std::mutex> lock(m);
                old_transfer_info = transfer_info;
                transfer_info = copied_transfer_info.release();
            }
            if (old_transfer_info) {
                old_transfer_info->deref(xsink);
            }
        }

        if (result->existsKey("backend")) {
            QoreObject* q_backend = result->getKeyValue("backend").get<QoreObject>();
            if (!q_backend) {
                xsink->raiseException("SFTPSESSION-FACTORY-ERROR",
                    "the factory result \"backend\" key must be an object when present");
                return -1;
            }
            setBackend(q_backend, xsink);
            if (*xsink) {
                return -1;
            }
        }

        logDebug("SftpSession applied factory result");
        return *xsink ? -1 : 0;
    }

    int applyTransferInfo(const QoreHashNode* q_transfer_info, ExceptionSink* xsink) {
        if (!q_transfer_info) {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "transfer info must be a hash<SftpTransferInfo>");
            return -1;
        }

        ReferenceHolder<QoreHashNode> typed_transfer_info(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpTransferInfo->doRuntimeCast(q_transfer_info, xsink)), xsink);
        if (*xsink) {
            return -1;
        }

        QoreHashNode* old_transfer_info = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            old_transfer_info = transfer_info;
            transfer_info = typed_transfer_info.release();
        }
        if (old_transfer_info) {
            old_transfer_info->deref(xsink);
        }

        logDebug("SftpSession applied transfer info");
        return *xsink ? -1 : 0;
    }

    void clearTransferInfo(ExceptionSink* xsink) {
        QoreHashNode* old_transfer_info = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            old_transfer_info = transfer_info;
            transfer_info = nullptr;
        }
        if (old_transfer_info) {
            old_transfer_info->deref(xsink);
        }
        logDebug("SftpSession cleared transfer info");
    }

    void closeIntern() {
        std::map<std::string, std::unique_ptr<FileHandleState>> current_file_handles;
        {
            std::lock_guard<std::mutex> lock(m);
            dir_handles.clear();
            current_file_handles.swap(file_handles);
        }

        for (auto& i : current_file_handles) {
            if (!i.second) {
                continue;
            }
            ExceptionSink xsink;
            if (finalizeBackendFileState(*i.second, false, 0, &xsink) && xsink) {
                std::string msg = "SftpSession backend handle finalization failed during close";
                QoreValue err = xsink.getExceptionErr();
                QoreValue desc = xsink.getExceptionDesc();
                if (err.getType() == NT_STRING || desc.getType() == NT_STRING) {
                    msg += ": ";
                    bool has_err = false;
                    if (err.getType() == NT_STRING) {
                        QoreStringValueHelper str(err);
                        msg += str->c_str();
                        has_err = true;
                    }
                    if (desc.getType() == NT_STRING) {
                        QoreStringValueHelper str(desc);
                        if (has_err) {
                            msg += ": ";
                        }
                        msg += str->c_str();
                    }
                }
                logWarn(msg);
                xsink.clear();
            }
        }

        ssh_channel current_channel = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            current_channel = channel;
            channel = nullptr;
        }

        if (current_channel) {
            ssh_channel_send_eof(current_channel);
            ssh_channel_close(current_channel);
            ssh_channel_free(current_channel);
            logInfo("SftpSession closed");
        }
    }

    QoreHashNode* publishLocalFile(const std::string& source_path, bool move, bool create_parents, ExceptionSink* xsink) {
        ReferenceHolder<QoreHashNode> current_transfer_info(getTransferInfo(xsink), xsink);
        if (*xsink) {
            return nullptr;
        }
        if (!current_transfer_info) {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "cannot publish a local file without active transfer info");
            return nullptr;
        }

        std::string final_path;
        if (!ssh_sftp_get_hash_string(*current_transfer_info, "final_path", final_path) || final_path.empty()) {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "active transfer info must include a non-empty final_path");
            return nullptr;
        }

        std::string temporary_path;
        ssh_sftp_get_hash_string(*current_transfer_info, "temporary_path", temporary_path);
        bool atomic_publish = current_transfer_info->getKeyValue("atomic_publish").getAsBool();
        if (*xsink) {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "active transfer info must include a boolean atomic_publish flag");
            return nullptr;
        }

        std::string staging_path = atomic_publish && !temporary_path.empty() ? temporary_path : final_path;

        if (ssh_sftp_check_fs_access(source_path, move ? QSEC_READ | QSEC_WRITE : QSEC_READ, xsink)) {
            return nullptr;
        }
        if (ssh_sftp_check_fs_access(final_path, QSEC_WRITE, xsink)) {
            return nullptr;
        }
        if (!temporary_path.empty() && ssh_sftp_check_fs_access(temporary_path, QSEC_WRITE, xsink)) {
            return nullptr;
        }

        if (create_parents) {
            if (ssh_sftp_ensure_parent_dirs(staging_path, xsink)) {
                return nullptr;
            }
            if (atomic_publish && staging_path != final_path && ssh_sftp_ensure_parent_dirs(final_path, xsink)) {
                return nullptr;
            }
        }

        if (move) {
            if (::rename(source_path.c_str(), staging_path.c_str())) {
                xsink->raiseErrnoException("SFTP-ATOMIC-PUBLISH-ERROR", errno,
                    "cannot rename local file '%s' to staging path '%s'", source_path.c_str(), staging_path.c_str());
                return nullptr;
            }
        } else if (ssh_sftp_copy_file(source_path, staging_path, xsink)) {
            return nullptr;
        }

        if (atomic_publish && staging_path != final_path) {
            if (qore_check_cancel(xsink, "sftp atomic publish")) {
                return nullptr;
            }

            if (::rename(staging_path.c_str(), final_path.c_str())) {
                xsink->raiseErrnoException("SFTP-ATOMIC-PUBLISH-ERROR", errno,
                    "cannot rename staging file '%s' to final path '%s'", staging_path.c_str(), final_path.c_str());
                return nullptr;
            }
        }

        ReferenceHolder<QoreHashNode> updated_transfer_info(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpTransferInfo->doRuntimeCast(*current_transfer_info, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        updated_transfer_info->setKeyValue("completed", true, xsink);
        if (*xsink) {
            return nullptr;
        }

        if (applyTransferInfo(*updated_transfer_info, xsink)) {
            return nullptr;
        }

        std::string action = atomic_publish ? "published local file atomically" : "published local file";
        logInfo(action);
        return updated_transfer_info.release();
    }

    QoreHashNode* retrieveLocalFile(const std::string& target_path, bool move, bool create_parents, ExceptionSink* xsink) {
        ReferenceHolder<QoreHashNode> current_transfer_info(getTransferInfo(xsink), xsink);
        if (*xsink) {
            return nullptr;
        }
        if (!current_transfer_info) {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "cannot retrieve a local file without active transfer info");
            return nullptr;
        }

        std::string final_path;
        std::string temporary_path;
        std::string path;
        ssh_sftp_get_hash_string(*current_transfer_info, "final_path", final_path);
        ssh_sftp_get_hash_string(*current_transfer_info, "temporary_path", temporary_path);
        ssh_sftp_get_hash_string(*current_transfer_info, "path", path);

        std::string source_path;
        if (!final_path.empty()) {
            source_path = final_path;
        } else if (!temporary_path.empty()) {
            source_path = temporary_path;
        } else if (!path.empty()) {
            source_path = path;
        } else {
            xsink->raiseException("SFTPSESSION-TRANSFER-ERROR",
                "active transfer info must include a readable source path");
            return nullptr;
        }

        if (ssh_sftp_check_fs_access(source_path, move ? QSEC_READ | QSEC_WRITE : QSEC_READ, xsink)
                || ssh_sftp_check_fs_access(target_path, QSEC_WRITE, xsink)) {
            return nullptr;
        }

        if (create_parents && ssh_sftp_ensure_parent_dirs(target_path, xsink)) {
            return nullptr;
        }

        if (move) {
            if (::rename(source_path.c_str(), target_path.c_str())) {
                xsink->raiseErrnoException("SFTPSESSION-FILESYSTEM-ERROR", errno,
                    "cannot rename retrieved file '%s' to local path '%s'", source_path.c_str(), target_path.c_str());
                return nullptr;
            }
        } else if (ssh_sftp_copy_file(source_path, target_path, xsink)) {
            return nullptr;
        }

        ReferenceHolder<QoreHashNode> updated_transfer_info(reinterpret_cast<QoreHashNode*>(
            hashdeclSftpTransferInfo->doRuntimeCast(*current_transfer_info, xsink)), xsink);
        if (*xsink) {
            return nullptr;
        }

        updated_transfer_info->setKeyValue("completed", true, xsink);
        if (*xsink) {
            return nullptr;
        }

        if (applyTransferInfo(*updated_transfer_info, xsink)) {
            return nullptr;
        }

        std::string action = move ? "retrieved local file by rename" : "retrieved local file";
        logInfo(action);
        return updated_transfer_info.release();
    }

private:
    int readChannelExact(ssh_channel current_channel, void* ptr, size_t size, int timeout_ms, ExceptionSink* xsink,
            const char* what) const {
        size_t offset = 0;
        // C1: cap each libssh read wait at QORE_IO_POLL_INTERVAL_MS so an idle SFTP read
        // (the documented timeout_ms==0 "wait indefinitely" default of waitProtocolMessage()/
        // processNextRequest()) re-checks qore_check_cancel() ~every 500ms and is therefore
        // interruptible.  The caller's total timeout is preserved across iterations; the
        // 0 (full read) / 1 (EOF/closed/timeout) / -1 (error or cancel) contract is unchanged.
        int remaining_ms = timeout_ms;
        while (offset < size) {
            if (qore_check_cancel(xsink, "sftp protocol read")) {
                return -1;
            }

            int chunk;
            if (timeout_ms <= 0) {
                chunk = QORE_IO_POLL_INTERVAL_MS;
            } else {
                chunk = remaining_ms < QORE_IO_POLL_INTERVAL_MS ? remaining_ms : QORE_IO_POLL_INTERVAL_MS;
            }

            int rc = ssh_channel_read_timeout(current_channel, reinterpret_cast<char*>(ptr) + offset,
                size - offset, 0, chunk);
            if (rc == SSH_ERROR) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "cannot read %s: %s",
                    what ? what : "SFTP data", ssh_get_error(current_channel));
                return -1;
            }
            if (!rc) {
                // ssh_channel_read_timeout() returns 0 on EOF/closed *or* on a timeout slice;
                // only treat genuine EOF/closed as end-of-stream, otherwise keep polling.
                if (ssh_channel_is_eof(current_channel) || !ssh_channel_is_open(current_channel)) {
                    return 1;
                }
                if (timeout_ms > 0) {
                    remaining_ms -= chunk;
                    if (remaining_ms <= 0) {
                        return 1;
                    }
                }
                continue;
            }
            offset += rc;
        }

        return 0;
    }

    int writeChannelAll(const std::string& packet, ExceptionSink* xsink, const char* what) const {
        ssh_channel current_channel = nullptr;
        {
            std::lock_guard<std::mutex> lock(m);
            current_channel = channel;
        }
        if (!current_channel) {
            xsink->raiseException("SFTPSESSION-STATE-ERROR", "cannot write %s to a closed SFTP session",
                what ? what : "SFTP data");
            return -1;
        }

        size_t offset = 0;
        while (offset < packet.size()) {
            if (qore_check_cancel(xsink, "sftp protocol write")) {
                return -1;
            }

            int rc = ssh_channel_write(current_channel, packet.data() + offset, packet.size() - offset);
            if (rc == SSH_ERROR) {
                xsink->raiseException("SFTPSESSION-PROTOCOL-ERROR", "cannot write %s: %s",
                    what ? what : "SFTP data", ssh_get_error(current_channel));
                return -1;
            }
            offset += rc;
        }

        return 0;
    }

    void logDetail(const std::string& msg) const {
        ReferenceHolder<QoreObject> lh(getLogger(), nullptr);
        if (!lh) {
            return;
        }
        ssh_sftp_log_message(*lh, QORE_LOG_LEVEL_DETAIL, msg);
    }

    void logInfo(const std::string& msg) const {
        ReferenceHolder<QoreObject> lh(getLogger(), nullptr);
        if (!lh) {
            return;
        }
        ssh_sftp_log_message(*lh, QORE_LOG_LEVEL_INFO, msg);
    }

    void logWarn(const std::string& msg) const {
        ReferenceHolder<QoreObject> lh(getLogger(), nullptr);
        if (!lh) {
            return;
        }
        ssh_sftp_log_message(*lh, QORE_LOG_LEVEL_WARN, msg);
    }

    void logDebug(const std::string& msg) const {
        ReferenceHolder<QoreObject> lh(getLogger(), nullptr);
        if (!lh) {
            return;
        }
        ssh_sftp_log_message(*lh, QORE_LOG_LEVEL_DEBUG, msg);
    }

    void logError(const std::string& msg) const {
        ReferenceHolder<QoreObject> lh(getLogger(), nullptr);
        if (!lh) {
            return;
        }
        ssh_sftp_log_message(*lh, QORE_LOG_LEVEL_ERROR, msg);
    }

    QoreHashNode* info;
    QoreHashNode* transfer_info;
    mutable std::mutex m;
    QoreObject* logger;
    QoreObject* backend;
    ssh_channel channel;
    std::map<std::string, std::unique_ptr<DirectoryHandleState>> dir_handles;
    std::map<std::string, std::unique_ptr<FileHandleState>> file_handles;
    uint64_t next_dir_handle_id;
    uint64_t next_file_handle_id;
};

//! SFTP-session wrapper for server-side subsystem sessions
/** This class wraps structured SFTP session metadata and the accepted channel
    for live server-side SFTP subsystem handling.

    @since ssh 0.1
*/
qclass SftpSession [arg=SftpSessionPriv* priv; ns=Qore::Ssh; dom=NETWORK,FILESYSTEM; flags=final];

//! Creates an SFTP session from typed metadata
/** @param info the typed `SftpSessionInfo` hash for the session
 */
SftpSession::constructor(hash<SftpSessionInfo> info) {
    self->setPrivate(CID_SFTPSESSION, new SftpSessionPriv(info));
}

//! Throws an exception; SftpSession objects cannot be copied
/** @throw SFTPSESSION-COPY-ERROR copying SftpSession objects is not supported
 */
SftpSession::copy() {
    xsink->raiseException("SFTPSESSION-COPY-ERROR", "copying SftpSession objects is not supported");
}

//! Destroys the SFTP session object
/** Releases private resources held by the SFTP session.
 */
SftpSession::destructor() {
    priv->deref();
}

//! Returns the typed SFTP session info hash
/** @return the wrapped `SftpSessionInfo` typed hash
 */
hash<SftpSessionInfo> SftpSession::getInfo() [flags=RET_VALUE_ONLY] {
    return priv->getInfo(xsink);
}

//! Returns the current transfer metadata if available
/** @return the wrapped `SftpTransferInfo` typed hash or `NOTHING`
 */
*hash<SftpTransferInfo> SftpSession::getTransferInfo() [flags=RET_VALUE_ONLY] {
    return priv->getTransferInfo(xsink);
}

//! Reads the next raw SFTP protocol message from the subsystem channel
/** Reads a single SFTP packet from the live subsystem channel and returns a
    typed summary of the decoded packet header fields together with the raw
    payload bytes after the packet type byte.

    @param timeout_ms the maximum time in milliseconds to wait for packet data;
    0 means wait indefinitely
    @return the decoded `SftpProtocolMessage` or `NOTHING` on EOF
 */
*hash<SftpProtocolMessage> SftpSession::waitProtocolMessage(int timeout_ms = 0) {
    return priv->waitProtocolMessage(timeout_ms, xsink);
}

//! Sets the logger object used by the SFTP session
/** @param logger an optional logger object
 */
nothing SftpSession::setLogger(*LoggerInterfaceBase logger) {
    priv->setLogger(logger, xsink);
}

//! Sets the backend object used by the SFTP session
/** The backend object represents virtualized path and file semantics for this
    session. The recommended backend contract is to implement typed backend
    verb overloads using `SftpPathRequest`, `SftpOpenRequest`,
    `SftpRenameRequest`, `SftpSubmissionRequest`, and
    `SftpOperationRequest` together with typed results such as
    `SftpPathInfo`, `SftpListResult`, `SftpOpenResult`, and
    `SftpOperationResult`. Loose untyped backend methods remain supported as a
    compatibility path, but typed backend methods are the intended public UX.

    @param backend an optional backend object implementing at least
    `stat()` and `list()`
 */
nothing SftpSession::setBackend(*object backend) {
    priv->setBackend(backend, xsink);
}

//! Applies typed transfer metadata to the live SFTP session
/** @param transfer_info the current transfer metadata
 */
nothing SftpSession::applyTransferInfo(hash<SftpTransferInfo> transfer_info) {
    priv->applyTransferInfo(transfer_info, xsink);
}

//! Clears the current transfer metadata from the live SFTP session
/** Removes any active transfer metadata from the session object.
 */
nothing SftpSession::clearTransferInfo() {
    priv->clearTransferInfo(xsink);
}

//! Sends an `SSH_FXP_VERSION` reply on the live subsystem channel
/** Advertises the \c statvfs\@openssh.com extension in the version reply.

    @param version the server-side SFTP protocol version to advertise
 */
nothing SftpSession::sendVersion(int version = 3) {
    priv->sendVersion(version, xsink);
}

//! Sends an `SSH_FXP_STATUS` reply on the live subsystem channel
/** @param request_id the SFTP request id being answered
    @param status_code the numeric SFTP status code
    @param message an optional human-readable status message
    @param language an optional RFC 3066 language tag
 */
nothing SftpSession::sendStatus(int request_id, int status_code, string message = "", string language = "") {
    priv->sendStatus(request_id, status_code, message->c_str(), language->c_str(), xsink);
}

//! Reads and processes the next SFTP request on the live subsystem channel
/** Handles the initial `SSH_FXP_INIT` handshake by replying with
    `SSH_FXP_VERSION`, handles `SSH_FXP_REALPATH` using the module's virtual
    path normalization rules, handles rooted `SSH_FXP_STAT` / `SSH_FXP_LSTAT`
    lookups with `SSH_FXP_ATTRS` replies, dispatches `SSH_FXP_SYMLINK`,
    `SSH_FXP_READLINK`, `SSH_FXP_SETSTAT`, `SSH_FXP_FSETSTAT`, and
    `SSH_FXP_EXTENDED` (including \c statvfs\@openssh.com) to the backend when
    available, and replies to unsupported requests with `SSH_FXP_STATUS` /
    `SSH_FX_OP_UNSUPPORTED`.

    @param timeout_ms the maximum time in milliseconds to wait for packet data;
    0 means wait indefinitely
    @return the decoded `SftpProtocolMessage` that was handled or
    `NOTHING` on EOF
 */
*hash<SftpProtocolMessage> SftpSession::processNextRequest(int timeout_ms = 0) {
    return priv->processNextRequest(timeout_ms, xsink);
}

//! Processes multiple SFTP requests in a read-ahead batch
/** Processes the first request using the full timeout, then continues
    processing additional requests as long as data is available on the
    channel without blocking. This reduces round-trip latency for clients
    that pipeline multiple requests.

    @param timeout_ms the maximum time in milliseconds to wait for the first
    request; 0 means wait indefinitely
    @param max_batch the maximum number of requests to process in a single
    batch; 0 means no limit (process all available)
    @return the number of requests processed
 */
int SftpSession::processRequests(int timeout_ms = 0, int max_batch = 0) {
    return priv->processRequests(timeout_ms, max_batch, xsink);
}

//! Submits content through the backend atomic-exchange helper
/** Calls backend `submit()` with a typed request. The request may provide
    either in-memory binary `data` or a local `source_path`; when `source_path`
    is provided, the helper reads the file and includes the payload in the
    backend request.

    @param req the typed `SftpSubmissionRequest` describing the submission
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::submit(hash<SftpSubmissionRequest> req) {
    return priv->submit(req, xsink);
}

//! Submits in-memory content through the backend atomic-exchange helper
/** Convenience overload for typed callers that already have a complete
    `SftpSubmissionRequest` prepared.

    @param req the typed `SftpSubmissionRequest`; `data` must be present
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::submitData(hash<SftpSubmissionRequest> req) {
    return priv->submit(req, xsink);
}

//! Submits in-memory content through the backend atomic-exchange helper
/** Builds an `SftpSubmissionRequest` from a path and binary payload and then
    calls `submit(hash<SftpSubmissionRequest>)`.

    @param path the virtual destination path
    @param data the payload to submit
    @param metadata optional backend metadata
    @param checksum optional caller-provided checksum
    @return the typed `SftpOperationResult` returned by the backend

    @par Example:
    @code{.qore}
    hash<SftpOperationResult> result = sftp.submitData("/exchange/inbound.dat", binary("payload\n"));
    @endcode
 */
hash<SftpOperationResult> SftpSession::submitData(string path, binary data, *hash<auto> metadata,
        *string checksum) {
    ReferenceHolder<QoreHashNode> req(new QoreHashNode(autoTypeInfo), xsink);
    req->setKeyValue("path", path->refSelf(), xsink);
    req->setKeyValue("data", data->refSelf(), xsink);
    if (metadata) {
        req->setKeyValue("metadata", metadata->refSelf(), xsink);
    }
    if (checksum) {
        req->setKeyValue("checksum", checksum->refSelf(), xsink);
    }
    return priv->submit(req.operator->(), xsink);
}

//! Submits a local file through the backend atomic-exchange helper
/** Convenience overload for typed callers that already have a complete
    `SftpSubmissionRequest` prepared.

    @param req the typed `SftpSubmissionRequest`; `source_path` must be present
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::submitLocalFile(hash<SftpSubmissionRequest> req) {
    return priv->submit(req, xsink);
}

//! Submits a local file through the backend atomic-exchange helper
/** Builds an `SftpSubmissionRequest` using a local `source_path` and then
    calls `submit(hash<SftpSubmissionRequest>)`.

    @param path the virtual destination path
    @param source_path the local source file to submit
    @param move if set to `True`, the backend receives the intent that the
    local file may be moved rather than copied
    @param create_parents if set to `True`, create parent directories when
    applicable in backend-controlled local helpers
    @param metadata optional backend metadata
    @param checksum optional caller-provided checksum
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::submitLocalFile(string path, string source_path, bool move = False,
        bool create_parents = True, *hash<auto> metadata, *string checksum) {
    ReferenceHolder<QoreHashNode> req(new QoreHashNode(autoTypeInfo), xsink);
    req->setKeyValue("path", path->refSelf(), xsink);
    req->setKeyValue("source_path", source_path->refSelf(), xsink);
    req->setKeyValue("move", move, xsink);
    req->setKeyValue("create_parents", create_parents, xsink);
    if (metadata) {
        req->setKeyValue("metadata", metadata->refSelf(), xsink);
    }
    if (checksum) {
        req->setKeyValue("checksum", checksum->refSelf(), xsink);
    }
    return priv->submit(req.operator->(), xsink);
}

//! Lists backend-managed retrievable objects for atomic exchange
/** Calls backend `listAvailable()` with a typed request.

    @param req the typed `SftpPathRequest` describing the listing scope
    @return the typed `SftpListResult` returned by the backend
 */
hash<SftpListResult> SftpSession::listAvailable(hash<SftpPathRequest> req) {
    return priv->listAvailable(req, xsink);
}

//! Retrieves backend-managed content for atomic exchange
/** Calls backend `retrieve()` with a typed request.

    @param req the typed `SftpOpenRequest` describing the retrieval request
    @return the typed `SftpOpenResult` returned by the backend
 */
hash<SftpOpenResult> SftpSession::retrieve(hash<SftpOpenRequest> req) {
    return priv->retrieve(req, xsink);
}

//! Retrieves backend-managed content as binary data
/** Convenience overload for typed callers that already have a complete
    `SftpOpenRequest` prepared.

    @param req the typed `SftpOpenRequest`
    @return the retrieved binary payload
 */
binary SftpSession::retrieveData(hash<SftpOpenRequest> req) {
    ReferenceHolder<QoreHashNode> result(priv->retrieve(req, xsink), xsink);
    const BinaryNode* data_bin = result ? result->getKeyValue("data").get<BinaryNode>() : nullptr;
    if (!data_bin) {
        std::string path;
        ssh_sftp_get_hash_string(req, "path", path);
        xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
            "retrieveData() requires backend retrieve() to return immediate binary data for path '%s'",
            path.empty() ? "<unknown>" : path.c_str());
        return QoreValue();
    }
    return data_bin->refSelf();
}

//! Retrieves backend-managed content as binary data
/** Builds an `SftpOpenRequest` from a virtual path and returns the payload
    from the backend result. This convenience method is intended for simple
    retrieval flows where the backend returns immediate binary content.

    @param path the virtual source path
    @param metadata optional backend metadata
    @param offset optional byte offset
    @param length optional maximum length; a negative value means backend default
    @return the retrieved binary payload
 */
binary SftpSession::retrieveData(string path, *hash<auto> metadata, int offset = 0, int length = -1) {
    ReferenceHolder<QoreHashNode> req(new QoreHashNode(autoTypeInfo), xsink);
    req->setKeyValue("path", path->refSelf(), xsink);
    req->setKeyValue("offset", static_cast<int64>(offset), xsink);
    if (metadata) {
        req->setKeyValue("metadata", metadata->refSelf(), xsink);
    }
    if (length >= 0) {
        req->setKeyValue("length", static_cast<int64>(length), xsink);
    }
    ReferenceHolder<QoreHashNode> result(priv->retrieve(req.operator->(), xsink), xsink);
    const BinaryNode* data_bin = result ? result->getKeyValue("data").get<BinaryNode>() : nullptr;
    if (!data_bin) {
        xsink->raiseException("SFTPSESSION-BACKEND-ERROR",
            "retrieveData() requires backend retrieve() to return immediate binary data for path '%s'",
            path->c_str());
        return QoreValue();
    }
    return data_bin->refSelf();
}

//! Finalizes an atomic retrieval workflow
/** Calls backend `completeRetrieve()` with a typed request so the backend can
    claim, archive, or delete the retrieved object.

    @param req the typed `SftpOperationRequest` describing the completion action
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::completeRetrieve(hash<SftpOperationRequest> req) {
    return priv->completeRetrieve(req, xsink);
}

//! Finalizes a retrieval with an explicit completion mode
/** Convenience overload for typed callers that already have a
    `SftpOperationRequest` prepared.

    @param req the typed `SftpOperationRequest`
    @param completion_mode the backend completion mode
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::completeRetrieveMode(hash<SftpOperationRequest> req, string completion_mode) {
    ReferenceHolder<QoreHashNode> complete_metadata(
        req->existsKey("metadata") && req->getKeyValue("metadata").getType() != NT_NOTHING
            ? req->getKeyValue("metadata").get<QoreHashNode>()->copy()
            : new QoreHashNode(autoTypeInfo), xsink);

    ReferenceHolder<QoreHashNode> complete_req(req->copy(), xsink);
    if (!complete_req->existsKey("operation") || complete_req->getKeyValue("operation").getType() == NT_NOTHING) {
        complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    }
    complete_req->setKeyValue("completion_mode", completion_mode->refSelf(), xsink);
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

//! Finalizes a retrieval with an explicit completion mode
/** Builds an `SftpOperationRequest` for `completeRetrieve(hash<SftpOperationRequest>)`
    using a simple completion mode name such as `delete`, `claim`, or
    `archive`.

    @param path the virtual source path
    @param completion_mode the backend completion mode
    @param target_path an optional local target path associated with the retrieval
    @param metadata optional backend metadata
    @return the typed `SftpOperationResult` returned by the backend
 */
hash<SftpOperationResult> SftpSession::completeRetrieveMode(string path, string completion_mode,
        *string target_path, *hash<auto> metadata) {
    ReferenceHolder<QoreHashNode> complete_metadata(metadata ? metadata->copy() : new QoreHashNode(autoTypeInfo),
        xsink);

    ReferenceHolder<QoreHashNode> complete_req(new QoreHashNode(autoTypeInfo), xsink);
    complete_req->setKeyValue("path", path->refSelf(), xsink);
    complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    complete_req->setKeyValue("completion_mode", completion_mode->refSelf(), xsink);
    if (target_path) {
        complete_req->setKeyValue("target_path", target_path->refSelf(), xsink);
    }
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

//! Finalizes a retrieval with delete-on-success semantics
/** Convenience wrapper for `completeRetrieveMode(path, "delete", ...)`.
 */
hash<SftpOperationResult> SftpSession::completeRetrieveDelete(hash<SftpOperationRequest> req) {
    ReferenceHolder<QoreStringNode> completion_mode(new QoreStringNode("delete"), xsink);
    ReferenceHolder<QoreHashNode> complete_metadata(
        req->existsKey("metadata") && req->getKeyValue("metadata").getType() != NT_NOTHING
            ? req->getKeyValue("metadata").get<QoreHashNode>()->copy()
            : new QoreHashNode(autoTypeInfo), xsink);

    ReferenceHolder<QoreHashNode> complete_req(req->copy(), xsink);
    if (!complete_req->existsKey("operation") || complete_req->getKeyValue("operation").getType() == NT_NOTHING) {
        complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    }
    complete_req->setKeyValue("completion_mode", completion_mode.release(), xsink);
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

//! Finalizes a retrieval with delete-on-success semantics
/** Convenience wrapper for `completeRetrieveMode(path, "delete", ...)`.
 */
hash<SftpOperationResult> SftpSession::completeRetrieveDelete(string path, *string target_path,
        *hash<auto> metadata) {
    ReferenceHolder<QoreStringNode> completion_mode(new QoreStringNode("delete"), xsink);
    ReferenceHolder<QoreHashNode> complete_metadata(metadata ? metadata->copy() : new QoreHashNode(autoTypeInfo),
        xsink);

    ReferenceHolder<QoreHashNode> complete_req(new QoreHashNode(autoTypeInfo), xsink);
    complete_req->setKeyValue("path", path->refSelf(), xsink);
    complete_req->setKeyValue("operation", new QoreStringNode("complete-retrieve"), xsink);
    complete_req->setKeyValue("completion_mode", completion_mode.release(), xsink);
    if (target_path) {
        complete_req->setKeyValue("target_path", target_path->refSelf(), xsink);
    }
    complete_req->setKeyValue("metadata", complete_metadata.release(), xsink);
    return priv->completeRetrieve(complete_req.operator->(), xsink);
}

