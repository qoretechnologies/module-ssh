DLLLOCAL int ssh_sftp_session_clear_transfer_info(const QoreObject* sftp_obj, ExceptionSink* xsink) {
    if (!sftp_obj) {
        xsink->raiseException("SFTPSESSION-STATE-ERROR",
            "cannot clear transfer info on a null SFTP session object");
        return -1;
    }

    PrivateDataRefHolder<SftpSessionPriv> priv(sftp_obj, CID_SFTPSESSION, xsink);
