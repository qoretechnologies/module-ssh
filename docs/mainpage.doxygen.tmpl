    @section sshtypedhelpercookbook Typed Helper Cookbook

    @subsection sshtypedhelpercookbookexchange Virtual Exchange Retrieve And Archive
    @code
    SftpServerDataProvider::VirtualSftpExchange exchange(
        <SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_filename_glob": "*.dat",
                "max_size": 1048576,
                "allow_overwrite": False,
            },
        }
    );
    exchange.addOutboundData("hello.txt", binary("hello\n"), {"kind": "example"});

    hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_req
        = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/hello.txt"};
    binary payload = exchange.retrieve(retrieve_req).data;

    hash<SftpServerDataProvider::VirtualSftpCompletionRequest> archive_req
        = <SftpServerDataProvider::VirtualSftpCompletionRequest>{
            "path": "/hello.txt",
            "completion_mode": "archive",
        };
    exchange.completeRetrieve(archive_req);
    @endcode

    @subsection sshtypedhelpercookbookrecordstore Typed Record-Store Submission And Claim
    @code
    SftpServerDataProvider::VirtualSftpExchangeRecordStore store(
        <SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        }
    );

    store.addOutboundRecord(<SftpServerDataProvider::VirtualSftpRecordSubmissionRequest>{
        "name": "out-1.dat",
        "data": binary("payload\n"),
        "metadata": {"kind": "report"},
    });

    hash<SftpServerDataProvider::VirtualSftpRecordInfo> claimed
        = store.claimOutboundRecord(<SftpServerDataProvider::VirtualSftpRecordCompletionRequest>{
            "name": "out-1.dat",
            "final_name": "claimed-out-1.dat",
            "completion_mode": "claim",
        });
    @endcode

    @subsection sshtypedhelpercookbookbackend Typed Backend Verb Usage
    @code
    SftpServerDataProvider::VirtualSftpFilesystem vfs();
    vfs.addOutboundText("report.txt", "payload\n");

    hash<Qore::Ssh::SftpPathRequest> list_req
        = <Qore::Ssh::SftpPathRequest>{"path": "/outbound"};
    hash<Qore::Ssh::SftpListResult> listing = vfs.list(list_req);

    hash<Qore::Ssh::SftpOpenRequest> open_req
        = <Qore::Ssh::SftpOpenRequest>{"path": "/outbound/report.txt"};
    hash<Qore::Ssh::SftpOpenResult> open_result = vfs.openRead(open_req);

    hash<Qore::Ssh::SftpRenameRequest> rename_req
        = <Qore::Ssh::SftpRenameRequest>{
            "path": "/outbound/report.txt",
            "target_path": "/outbound/report.done",
        };
    hash<Qore::Ssh::SftpOperationResult> rename_result = vfs.rename(rename_req);
    @endcode

    @subsection sshtypedhelpercookbookstreambackend Typed Stream Backend Usage
    @code
    class TypedStreamBackend {
        hash<Qore::Ssh::SftpOpenResult> openRead(hash<Qore::Ssh::SftpOpenRequest> req) {
            return {
                "path": req.path,
                "type": "file",
                "size": 8,
                "backend_handle": {"kind": "stream", "path": req.path},
            };
        }

        hash<Qore::Ssh::SftpReadResult> read(hash<Qore::Ssh::SftpReadRequest> req) {
            return {
                "data": binary("payload\n"),
                "eof": True,
            };
        }

        hash<Qore::Ssh::SftpOperationResult> closeRead(hash<Qore::Ssh::SftpCloseRequest> req) {
            return {
                "success": True,
                "path": req.path,
            };
        }
    }
    @endcode

    @subsection sshtypedhelpercookbookserver Server-Side Virtual Backend Attachment
    This example uses the raw binary-module
    @ref Qore::Ssh::SshServerConfig "Qore::Ssh::SshServerConfig" /
    @ref Qore::Ssh::SshListenerConfig "Qore::Ssh::SshListenerConfig" hashes
    directly. For the grouped helper-driven configuration surface, prefer the
    @ref sshserverconnectionsintro "SshServerConnections" examples below.

    @code
    SftpServerDataProvider::VirtualSftpExchange exchange(
        <SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        }
    );
    exchange.addOutboundData("hello.txt", binary("hello\n"), {"kind": "example"});

    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        "name": "virtual-example",
        "listeners": (
            <Qore::Ssh::SshListenerConfig>{
                "name": "main",
                "bind_address": "127.0.0.1",
                "port": 0,
                "host_keys": ("test/data/ssh_host_ed25519_key",),
                "enabled_auth_methods": ("none",),
                "allow_command_service": False,
                "allow_sftp_service": True,
            },
        ),
    };

    config.auth_provider = new SshServerAuthProvider::VirtualSshAuthProvider(
        <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
            "methods": ("none",),
            "none": <SshServerAuthProvider::VirtualSshStaticAuthMethodOptions>{
                "success_decision": <SshServerAuthProvider::VirtualSshAuthDecisionTemplate>{
                    "principal": "principal:nobody",
                    "command_policy": {
                        "mode": "subsystem-only",
                        "allowed_subsystems": ("sftp",),
                    },
                    "sftp_policy": {"mode": "enabled"},
                },
            },
        });

    config.sftp_factory_callback = hash<auto> sub(hash<Qore::Ssh::SftpSessionInfo> info) {
        return {
            "backend": exchange,
            "session_data": {"source": "example", "factory": "virtual"},
        };
    };
    @endcode

    @subsection sshtypedhelpercookbookpolicy Policy-Driven Inbound Upload Handling
    This example uses the grouped connection-helper surface through
    @ref SshServerConnections::SftpServerConnection.

    @code
    SftpServerDataProvider::VirtualSftpExchange exchange(
        <SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_filename_glob": "*.dat",
                "max_size": 1048576,
                "validation_callback": hash<SftpServerDataProvider::VirtualSftpInboundValidationResult>
                        sub(hash<SftpServerDataProvider::VirtualSftpInboundValidationRequest> req) {
                    if (req.data.toString("UTF-8").find("tenant=") < 0) {
                        return <SftpServerDataProvider::VirtualSftpInboundValidationResult>{
                            "accepted": False,
                            "reason_code": "missing-tenant-marker",
                            "reason_desc": sprintf("inbound file %y has no tenant marker", req.name),
                        };
                    }
                    return <SftpServerDataProvider::VirtualSftpInboundValidationResult>{
                        "accepted": True,
                    };
                },
                "allow_overwrite": False,
            },
        }
    );

    SshServerConnections::SftpServerConnection conn({
        "name": "policy-example",
        "url": "sftpserver://127.0.0.1:0",
        "opts": {
            "host_keys": ("test/data/ssh_host_ed25519_key",),
            "services": <SshServerConnections::SshServerConnectionServices>{
                "enabled_auth_methods": ("none",),
                "allow_command_service": False,
                "allow_sftp_service": True,
            },
            "auth": <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
                "methods": ("none",),
                "none": <SshServerAuthProvider::VirtualSshStaticAuthMethodOptions>{
                    "success_decision": <SshServerAuthProvider::VirtualSshAuthDecisionTemplate>{
                        "principal": "principal:nobody",
                        "command_policy": {
                            "mode": "subsystem-only",
                            "allowed_subsystems": ("sftp",),
                        },
                        "sftp_policy": {"mode": "enabled"},
                    },
                },
            },
            "backend": exchange,
        },
    });

    AbstractDataProvider provider = conn.getDataProvider();
    AbstractDataProvider event_provider = provider.getChildProviderEx(
        SftpServerDataProvider::EventInboundFileAccepted);
    @endcode

    @subsection sshcommandcookbook Virtual Command Server
    This example uses the grouped connection-helper and command-service
    configuration surfaces.

    @code
    SshServerCommandProvider::VirtualSshCommandService service(
        <SshServerCommandProvider::VirtualSshCommandServiceOptions>{
            "policy": <SshServerCommandProvider::VirtualSshCommandPolicy>{
                "allow_all_commands": True,
                "allow_all_subsystems": True,
            },
            "audit": <SshServerCommandProvider::VirtualSshCommandAuditOptions>{
                "request_history_limit": 2,
                "capture_environment": False,
                "capture_arguments": True,
                "capture_identity": True,
                "captured_string_limit": 64,
            },
            "limits": <SshServerCommandProvider::VirtualSshCommandLimits>{
                "max_concurrent_requests": 8,
                "max_concurrent_requests_per_principal": 1,
            },
        }
    );
    service.setPrincipalPolicy("principal:nobody", <SshServerCommandProvider::VirtualSshCommandPrincipalPolicy>{
        "allow_all_commands": False,
        "allow_all_subsystems": False,
        "allowed_commands": ("status",),
        "allowed_subsystems": ("metrics",),
    });
    service.setAuditOptions(<SshServerCommandProvider::VirtualSshCommandAuditOptions>{
        "capture_arguments": False,
    });
    service.addTextCommand("status", "ok\n", NOTHING, 0, True, {"kind": "example"});
    service.addTextSubsystem("metrics", "metrics:ok\n", NOTHING, 0, True, {"kind": "subsystem"});

    SshServerConnections::SshCommandServerConnection conn({
        "name": "virtual-command-example",
        "url": "sshserver://127.0.0.1:0",
        "opts": {
            "host_keys": ("test/data/ssh_host_ed25519_key",),
            "services": <SshServerConnections::SshServerConnectionServices>{
                "enabled_auth_methods": ("none",),
                "allow_command_service": True,
                "allow_sftp_service": False,
            },
            "limits": <SshServerConnections::SshServerConnectionLimits>{
                "max_sessions": 8,
            },
            "auth": <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
                "methods": ("none",),
                "none": <SshServerAuthProvider::VirtualSshStaticAuthMethodOptions>{
                    "success_decision": <SshServerAuthProvider::VirtualSshAuthDecisionTemplate>{
                        "principal": "principal:nobody",
                        "command_policy": {"mode": "command-only"},
                        "sftp_policy": {"mode": "disabled"},
                    },
                },
            },
            "command_backend": service,
        },
    });

    hash<Qore::Ssh::SshServerConfig> config = conn.getServerConfig();
    hash<Qore::Ssh::SshCommandResult> result = config.command_callback({
        "session_id": "session-1",
        "server_name": "virtual-command-example",
        "listener_name": "virtual-command-example",
        "command": "status",
    });
    hash<Qore::Ssh::SshCommandResult> subsystem_result = service.handle({
        "session_id": "session-2",
        "server_name": "virtual-command-example",
        "listener_name": "virtual-command-example",
        "command": "metrics",
        "environment": {"SECRET": "redacted"},
        "metadata": {
            "request_type": "subsystem",
            "subsystem": "metrics",
        },
    });
    @endcode

    @subsection sshcommandlivecookbook Live Virtual Command Server Example
    See @c examples/VirtualSshCommandLiveServer.qr for a full example that:
    - starts a local SSH server from
      @ref SshServerConnections::SshCommandServerConnection "SshCommandServerConnection"
    - attaches a
      @ref SshServerCommandProvider::VirtualSshCommandService "VirtualSshCommandService"
      through @c command_backend
    - keeps the basic service surface simple, with advanced policy/audit
      behavior enabled only through optional typed options and setters
    - uses grouped
      @ref SshServerCommandProvider::VirtualSshCommandPolicy "policy",
      @ref SshServerCommandProvider::VirtualSshCommandAuditOptions "audit", and
      @ref SshServerCommandProvider::VirtualSshCommandLimits "limits"
      constructor options for advanced behavior
    - keeps grouped runtime configuration deterministic through
      @c setPolicy(), @c setAuditOptions(), and @c setLimits(), with matching
      @c clear...() helpers and typed @c get...() snapshots
    - serves a real OpenSSH exec request end to end
    - shows direct subsystem handling on the same typed virtual service
    - shows exact-name principal-aware allowlist policy for commands and subsystems
    - shows optional global and per-principal concurrency caps
    - demonstrates bounded request capture with environment redaction
    - prints the typed @ref Qore::Ssh::SshCommandResult "SshCommandResult"
      and captured requests
    - can be validated locally together with the broader module sweep through
      @c test/preflight.sh

    @subsection sshtypedhelpercookbookevents Inbound Submission Event Provider
    @code
    SftpServerDataProvider::VirtualSftpExchange exchange();

    AbstractDataProvider provider = DataProvider::getFactory("sftpserver").create({
        "backend": exchange,
    });

    AbstractDataProvider event_provider = provider.getChildProviderEx(
        SftpServerDataProvider::EventInboundFileAccepted);

    class MyObserver inherits DataProvider::Observer {
        update(string event_id, hash<auto> data_) {
            printf("EVENT %s: %y\n", event_id, data_);
        }
    }

    MyObserver observer();
    cast<DataProvider::Observable>(event_provider).registerObserver(
        observer, SftpServerDataProvider::EventInboundFileAccepted);
    cast<DataProvider::Observable>(event_provider).registerObserver(
        observer, SftpServerDataProvider::EventInboundFileRejected);
    cast<DataProvider::DelayedObservable>(event_provider).observersReady();

    # binary payloads are omitted by default; set
    # inbound_event_payload_mode=SftpServerDataProvider::InboundEventPayloadInline
    # on the backend/provider when observers need them.
    # generate_inbound_checksum=True also persists the SHA-256 checksum in
    # virtual file metadata so later stat/list/retrieve calls can surface it.
    # live SFTP uploads also populate session_id, server_name,
    # listener_name, and principal in the typed event payload.
    #
    # VirtualSftpExchangeOptions also supports typed inbound/archive/claim
    # retention policies with max_age_seconds and deterministic cleanup
    # through VirtualSftpExchange::cleanupExpired() or the cleanup-expired
    # DataProvider action, including optional principal-scoped cleanup for
    # shared inbound roots.
    @endcode

