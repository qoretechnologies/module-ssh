    testVirtualExchangeInboundPolicy() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_filename_glob": "*.dat",
                "reject_filename_regex": ".*forbidden.*",
                "min_size": 2,
                "max_size": 6,
                "allow_overwrite": False,
                "allow_hidden_files": False,
            },
        });

        hash<SftpServerDataProvider::VirtualSftpInboundPolicy> policy = exchange.getInboundPolicy();
        assertEq("*.dat", policy.accept_filename_glob);
        assertEq(6, policy.max_size);
        assertEq(False, policy.allow_overwrite);

        exchange.addInboundData("ok.dat", binary("okay"), {"kind": "policy"});
        assertEq("okay", exchange.getInboundData("ok.dat").toString("UTF-8"));

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData("bad.txt", binary("okay"));
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData(".hidden.dat", binary("okay"));
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData("forbidden.dat", binary("okay"));
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData("small.dat", binary("x"));
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData("large.dat", binary("toolong"));
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.addInboundData("ok.dat", binary("again"));
        });

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "submit.txt",
                "data": binary("okay"),
            });
        });
    }

    testVirtualExchangePrincipalAwareInboundPolicy() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "allow_principals": ("principal:allowed",),
                "deny_principals": ("principal:blocked",),
                "principal_routes": (
                    <SftpServerDataProvider::VirtualSftpPrincipalRoute>{
                        "principal": "principal:allowed",
                        "inbound_subdir": "tenant-allowed",
                    },
                ),
            },
        });

        hash<Qore::Ssh::SftpSessionInfo> allowed_info = getSftpInfo();
        allowed_info.principal = "principal:allowed";
        allowed_info.session_info.listener_name = "principal-listener";

        hash<SftpServerDataProvider::VirtualSftpOperationResult> allowed_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/routed.dat",
                "session_info": allowed_info,
                "data": binary("allowed\n"),
            });
        assertTrue(allowed_result.completed);
        assertTrue(exchange.getFilesystem().exists("/inbound/tenant-allowed/routed.dat"));
        assertEq("allowed\n", exchange.getFilesystem().getFileText("/inbound/tenant-allowed/routed.dat"));

        hash<Qore::Ssh::SftpListResult> routed_list = exchange.list(<Qore::Ssh::SftpPathRequest>{
            "path": "/inbound",
            "session_info": allowed_info,
        });
        assertEq("/inbound", routed_list.path);
        assertEq(1, routed_list.entries.size());
        assertEq("routed.dat", routed_list.entries[0].filename);

        hash<Qore::Ssh::SftpSessionInfo> blocked_info = getSftpInfo();
        blocked_info.principal = "principal:blocked";
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/blocked.dat",
                "session_info": blocked_info,
                "data": binary("blocked\n"),
            });
        });

        hash<Qore::Ssh::SftpSessionInfo> unknown_info = getSftpInfo();
        unknown_info.principal = "principal:unknown";
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/unknown.dat",
                "session_info": unknown_info,
                "data": binary("unknown\n"),
            });
        });
    }

    testVirtualExchangePrincipalScopedQuotas() {
        hash<Qore::Ssh::SftpSessionInfo> alpha_info = getSftpInfo();
        alpha_info.principal = "principal:alpha";
        alpha_info.session_info.session_id = "session-alpha";
        hash<Qore::Ssh::SftpSessionInfo> beta_info = getSftpInfo();
        beta_info.principal = "principal:beta";
        beta_info.session_info.session_id = "session-beta";

        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "principal_policies": (
                    <SftpServerDataProvider::VirtualSftpPrincipalPolicy>{
                        "principal": "principal:alpha",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_file_count": 1,
                            "reject_duplicate_name": True,
                        },
                    },
                    <SftpServerDataProvider::VirtualSftpPrincipalPolicy>{
                        "principal": "principal:beta",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_file_count": 1,
                            "reject_duplicate_name": True,
                        },
                    },
                ),
            },
        });

        hash<SftpServerDataProvider::VirtualSftpOperationResult> alpha_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/alpha/shared.dat",
                "data": binary("alpha\n"),
                "session_info": alpha_info,
            });
        assertTrue(alpha_result.completed);

        hash<SftpServerDataProvider::VirtualSftpOperationResult> beta_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/beta/shared.dat",
                "data": binary("beta\n"),
                "session_info": beta_info,
            });
        assertTrue(beta_result.completed);

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/alpha/second.dat",
                "data": binary("second\n"),
                "session_info": alpha_info,
            });
        });

        assertEq("alpha\n", exchange.getFilesystem().getFileText("/inbound/alpha/shared.dat"));
        assertEq("beta\n", exchange.getFilesystem().getFileText("/inbound/beta/shared.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/alpha/second.dat"));
    }

    testVirtualExchangeConcurrentUploadCap() {
        list<hash<auto>> events = ();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_concurrent_uploads": 1,
            },
        });
        exchange.registerInboundEventListener(sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
            events += (event,);
        });

        hash<Qore::Ssh::SftpOpenResult> first_open = exchange.openWrite(<Qore::Ssh::SftpOpenRequest>{
            "path": "/inbound/first.dat",
            "session_info": getSftpInfo(),
        });
        assertEq("/inbound/first.dat", first_open.path);
        assertTrue(first_open.backend_handle.size() > 0);

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.openWrite(<Qore::Ssh::SftpOpenRequest>{
                "path": "/inbound/second.dat",
                "session_info": getSftpInfo(),
            });
        });
        assertEq(1, events.size());
        assertFalse(events[0].accepted);
        assertEq(SftpServerDataProvider::InboundRejectMaxConcurrentUploads, events[0].reason_code);
        assertEq("/inbound/second.dat", events[0].path);

        hash<Qore::Ssh::SftpOperationResult> first_close = exchange.closeWrite(<Qore::Ssh::SftpCloseRequest>{
            "path": "/inbound/first.dat",
            "data": binary("first\n"),
            "session_info": getSftpInfo(),
            "backend_handle": first_open.backend_handle,
        });
        assertTrue(first_close.completed);

        hash<Qore::Ssh::SftpOpenResult> second_open = exchange.openWrite(<Qore::Ssh::SftpOpenRequest>{
            "path": "/inbound/second.dat",
            "session_info": getSftpInfo(),
        });
        assertEq("/inbound/second.dat", second_open.path);
        assertTrue(second_open.backend_handle.size() > 0);
        hash<Qore::Ssh::SftpOperationResult> second_close = exchange.closeWrite(<Qore::Ssh::SftpCloseRequest>{
            "path": "/inbound/second.dat",
            "data": binary("second\n"),
            "session_info": getSftpInfo(),
            "backend_handle": second_open.backend_handle,
        });
        assertTrue(second_close.completed);
        assertEq("second\n", exchange.getFilesystem().getFileText("/inbound/second.dat"));
    }

    testVirtualExchangeRetentionCleanup() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claim",
            "inbound_retention_policy": <SftpServerDataProvider::VirtualSftpRetentionPolicy>{
                "max_age_seconds": 10,
            },
            "archive_retention_policy": <SftpServerDataProvider::VirtualSftpRetentionPolicy>{
                "max_age_seconds": 20,
            },
            "claim_retention_policy": <SftpServerDataProvider::VirtualSftpRetentionPolicy>{
                "max_age_seconds": 30,
            },
        });
        exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
            "path": "/inbound/tenant/inbound.dat",
            "data": binary("inbound\n"),
        });
        exchange.addOutboundText("archive.dat", "archive\n");
        exchange.addOutboundText("claim.dat", "claim\n");
        exchange.archiveOutbound("archive.dat");
        exchange.claimOutbound("claim.dat");

        hash<Qore::Ssh::SftpPathInfo> inbound_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/inbound/tenant/inbound.dat",
        });
        hash<Qore::Ssh::SftpPathInfo> archive_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/archive/archive.dat",
        });
        hash<Qore::Ssh::SftpPathInfo> claim_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/claim/claim.dat",
        });

        assertEq(SftpServerDataProvider::RetentionQueueInbound, inbound_stat.metadata.retention_queue);
        assertEq(inbound_stat.metadata.retained_at + 10, inbound_stat.metadata.expires_at);
        assertEq(SftpServerDataProvider::RetentionQueueArchive, archive_stat.metadata.retention_queue);
        assertEq(archive_stat.metadata.retained_at + 20, archive_stat.metadata.expires_at);
        assertEq(SftpServerDataProvider::RetentionQueueClaim, claim_stat.metadata.retention_queue);
        assertEq(claim_stat.metadata.retained_at + 30, claim_stat.metadata.expires_at);

        hash<SftpServerDataProvider::VirtualSftpRetentionCleanupResult> inbound_cleanup
            = exchange.cleanupExpired(<SftpServerDataProvider::VirtualSftpRetentionCleanupRequest>{
                "queue": SftpServerDataProvider::RetentionQueueInbound,
                "now_s": inbound_stat.metadata.expires_at,
                "remove_empty_directories": True,
            });
        hash<SftpServerDataProvider::VirtualSftpRetentionCleanupResult> archive_cleanup
            = exchange.cleanupExpired(SftpServerDataProvider::RetentionQueueArchive, archive_stat.metadata.expires_at, True);
        hash<SftpServerDataProvider::VirtualSftpRetentionCleanupResult> claim_cleanup
            = exchange.cleanupExpired(SftpServerDataProvider::RetentionQueueClaim, claim_stat.metadata.expires_at, True);

        assertEq(1, inbound_cleanup.removed_count);
        assertEq(("/inbound/tenant/inbound.dat",), inbound_cleanup.removed_paths);
        assertTrue(inlist("/inbound/tenant", inbound_cleanup.removed_directories));
        assertEq(1, archive_cleanup.removed_count);
        assertEq(("/archive/archive.dat",), archive_cleanup.removed_paths);
        assertEq(1, claim_cleanup.removed_count);
        assertEq(("/claim/claim.dat",), claim_cleanup.removed_paths);
        assertFalse(exchange.getFilesystem().exists("/inbound/tenant/inbound.dat"));
        assertFalse(exchange.getFilesystem().exists("/archive/archive.dat"));
        assertFalse(exchange.getFilesystem().exists("/claim/claim.dat"));

        hash<Qore::Ssh::SftpSessionInfo> alpha_info = getSftpInfo();
        alpha_info.principal = "principal:alpha";
        alpha_info.session_info.principal = "principal:alpha";
        hash<Qore::Ssh::SftpSessionInfo> beta_info = getSftpInfo();
        beta_info.principal = "principal:beta";
        beta_info.session_info.principal = "principal:beta";
        exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
            "path": "/inbound/shared/alpha.dat",
            "data": binary("alpha\n"),
            "session_info": alpha_info,
        });
        exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
            "path": "/inbound/shared/beta.dat",
            "data": binary("beta\n"),
            "session_info": beta_info,
        });
        hash<Qore::Ssh::SftpPathInfo> alpha_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/inbound/shared/alpha.dat",
        });
        hash<Qore::Ssh::SftpPathInfo> beta_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/inbound/shared/beta.dat",
        });
        assertEq("principal:alpha", alpha_stat.metadata.retention_principal);
        assertEq("principal:beta", beta_stat.metadata.retention_principal);

        hash<SftpServerDataProvider::VirtualSftpRetentionCleanupResult> alpha_cleanup
            = exchange.cleanupExpired(<SftpServerDataProvider::VirtualSftpRetentionCleanupRequest>{
                "queue": SftpServerDataProvider::RetentionQueueInbound,
                "now_s": alpha_stat.metadata.expires_at,
                "principal": "principal:alpha",
            });

        assertEq("principal:alpha", alpha_cleanup.principal);
        assertEq(1, alpha_cleanup.removed_count);
        assertEq(("/inbound/shared/alpha.dat",), alpha_cleanup.removed_paths);
        assertFalse(exchange.getFilesystem().exists("/inbound/shared/alpha.dat"));
        assertTrue(exchange.getFilesystem().exists("/inbound/shared/beta.dat"));
        assertEq("principal:beta", exchange.stat({"path": "/inbound/shared/beta.dat"}).metadata.retention_principal);
    }

    testVirtualExchangeRejectsDuplicateInboundBasenames() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "reject_duplicate_name": True,
            },
        });

        exchange.getFilesystem().addDirectory("/inbound/existing");
        exchange.getFilesystem().addTextFile("/inbound/existing/dup.dat", "existing\n");

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/dup.dat",
                "data": binary("new\n"),
            });
        });

        hash<Qore::Ssh::SftpSessionInfo> routed_info = getSftpInfo();
        routed_info.principal = "principal:routed";
        SftpServerDataProvider::VirtualSftpExchange routed_exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "reject_duplicate_name": True,
                "principal_routes": (
                    <SftpServerDataProvider::VirtualSftpPrincipalRoute>{
                        "principal": "principal:routed",
                        "inbound_subdir": "tenant-routed",
                    },
                ),
            },
        });
        routed_exchange.getFilesystem().addDirectory("/inbound/tenant-routed/existing");
        routed_exchange.getFilesystem().addTextFile("/inbound/tenant-routed/existing/dup.dat", "existing\n");

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            routed_exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/dup.dat",
                "session_info": routed_info,
                "data": binary("new\n"),
            });
        });
    }

    testVirtualExchangeRejectsDuplicateInboundSizeAndContent() {
        SftpServerDataProvider::VirtualSftpExchange size_exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "reject_duplicate_size": True,
            },
        });
        list<hash<auto>> size_events = ();
        int size_listener_id = size_exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                size_events += (event,);
            });
        on_exit {
            size_exchange.deregisterInboundEventListener(size_listener_id);
        }
        size_exchange.getFilesystem().addTextFile("/inbound/existing-size.dat", "alpha\n");
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            size_exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/new-size.dat",
                "data": binary("omega\n"),
            });
        });
        assertEq(1, size_events.size());
        assertEq(SftpServerDataProvider::InboundRejectDuplicateSize, size_events[0].reason_code);
        assertEq("/inbound/new-size.dat", size_events[0].path);

        SftpServerDataProvider::VirtualSftpExchange hash_exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "reject_duplicate_hash": True,
            },
        });
        list<hash<auto>> hash_events = ();
        int hash_listener_id = hash_exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                hash_events += (event,);
            });
        on_exit {
            hash_exchange.deregisterInboundEventListener(hash_listener_id);
        }
        hash_exchange.getFilesystem().addTextFile("/inbound/existing-hash.dat", "same-content\n");

        string hash_source = getTmpFile(".duplicate-hash-source.dat");
        on_exit {
            cleanupFile(hash_source);
        }
        writeTextFile(hash_source, "same-content\n");

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            hash_exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/new-hash.dat",
                "source_path": hash_source,
            });
        });
        assertEq(1, hash_events.size());
        assertEq(SftpServerDataProvider::InboundRejectDuplicateHash, hash_events[0].reason_code);
        assertEq("/inbound/new-hash.dat", hash_events[0].path);
    }

    testVirtualExchangeInboundQuotas() {
        SftpServerDataProvider::VirtualSftpExchange count_exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_file_count": 1,
            },
        });
        list<hash<auto>> count_events = ();
        int count_listener_id = count_exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                count_events += (event,);
            });
        on_exit {
            count_exchange.deregisterInboundEventListener(count_listener_id);
        }
        count_exchange.getFilesystem().addTextFile("/inbound/existing-count.dat", "one\n");
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            count_exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/overflow-count.dat",
                "data": binary("two\n"),
            });
        });
        assertEq(1, count_events.size());
        assertEq(SftpServerDataProvider::InboundRejectMaxFileCount, count_events[0].reason_code);
        assertEq("/inbound/overflow-count.dat", count_events[0].path);

        SftpServerDataProvider::VirtualSftpExchange size_exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_total_bytes": 8,
            },
        });
        list<hash<auto>> size_events = ();
        int size_listener_id = size_exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                size_events += (event,);
            });
        on_exit {
            size_exchange.deregisterInboundEventListener(size_listener_id);
        }
        size_exchange.getFilesystem().addTextFile("/inbound/existing-bytes.dat", "four\n");
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            size_exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/overflow-bytes.dat",
                "data": binary("again\n"),
            });
        });
        assertEq(1, size_events.size());
        assertEq(SftpServerDataProvider::InboundRejectMaxTotalBytes, size_events[0].reason_code);
        assertEq("/inbound/overflow-bytes.dat", size_events[0].path);
    }

    testVirtualExchangeDirectoryPoliciesAndChecksums() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "generate_inbound_checksum": True,
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_size": 16,
                "directory_policies": (
                    <SftpServerDataProvider::VirtualSftpInboundDirectoryPolicy>{
                        "subdir": "strict",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_size": 4,
                        },
                    },
                ),
            },
        });
        list<hash<auto>> events = ();
        int listener_id = exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                events += (event,);
            });
        on_exit {
            exchange.deregisterInboundEventListener(listener_id);
        }

        hash<SftpServerDataProvider::VirtualSftpOperationResult> ok_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/strict/ok.dat",
                "data": binary("ok\n"),
            });
        assertTrue(ok_result.completed);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, ok_result.checksum_algorithm);
        assertTrue(ok_result.checksum.size() > 0);
        hash<SftpServerDataProvider::VirtualSftpSnapshot> ok_snapshot
            = exchange.getFilesystem().exportSnapshot("/inbound/strict");
        assertEq(ok_result.checksum, ok_snapshot.files{"/inbound/strict/ok.dat"}.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256,
            ok_snapshot.files{"/inbound/strict/ok.dat"}.checksum_algorithm);
        assertEq(ok_result.checksum, ok_snapshot.files{"/inbound/strict/ok.dat"}.metadata.checksum);
        hash<SftpServerDataProvider::VirtualSftpRetrieveResult> ok_retrieve
            = exchange.retrieve(<SftpServerDataProvider::VirtualSftpPathRequest>{
                "path": "/inbound/strict/ok.dat",
            });
        assertEq(ok_result.checksum, ok_retrieve.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, ok_retrieve.checksum_algorithm);

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/strict/too-large.dat",
                "data": binary("oversized\n"),
            });
        });

        hash<SftpServerDataProvider::VirtualSftpOperationResult> relaxed_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/relaxed/allowed.dat",
                "data": binary("oversized\n"),
            });
        assertTrue(relaxed_result.completed);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, relaxed_result.checksum_algorithm);
        assertEq(3, events.size());
        assertEq(SftpServerDataProvider::EventInboundFileAccepted, events[0].event_type);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, events[0].checksum_algorithm);
        assertEq(ok_result.checksum, events[0].checksum);
        assertEq(SftpServerDataProvider::EventInboundFileRejected, events[1].event_type);
        assertEq(SftpServerDataProvider::InboundRejectMaxSize, events[1].reason_code);
        assertEq("/inbound/strict/too-large.dat", events[1].path);
        assertEq(SftpServerDataProvider::EventInboundFileAccepted, events[2].event_type);
        assertEq(relaxed_result.checksum, events[2].checksum);
    }

    testVirtualExchangeContentAwareInboundPolicy() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_content_prefix": binary("PK"),
                "reject_content_prefix": binary("MZ"),
                "accept_content_type_hints": ("application/zip",),
                "reject_content_type_hints": ("application/x-msdownload",),
            },
        });
        list<hash<auto>> events = ();
        int listener_id = exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                events += (event,);
            });
        on_exit {
            exchange.deregisterInboundEventListener(listener_id);
        }

        hash<SftpServerDataProvider::VirtualSftpOperationResult> ok_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/ok.zip",
                "data": binary("PKzip-data\n"),
                "metadata": {"content_type_hint": "application/zip"},
            });
        assertTrue(ok_result.completed);
        assertEq("PKzip-data\n", exchange.getInboundData("ok.zip").toString("UTF-8"));

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/rejected-prefix.exe",
                "data": binary("MZexe-data\n"),
                "metadata": {"content_type_hint": "application/zip"},
            });
        });

        string source_path = getTmpFile(".content-policy.zip");
        on_exit {
            cleanupFile(source_path);
        }
        writeTextFile(source_path, "PKhint-data\n");
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/rejected-hint.zip",
                "source_path": source_path,
                "metadata": {"content_type_hint": "application/x-msdownload"},
            });
        });

        assertEq(3, events.size());
        assertEq(SftpServerDataProvider::EventInboundFileAccepted, events[0].event_type);
        assertEq(SftpServerDataProvider::EventInboundFileRejected, events[1].event_type);
        assertEq(SftpServerDataProvider::InboundRejectContentPrefix, events[1].reason_code);
        assertEq("/inbound/rejected-prefix.exe", events[1].path);
        assertEq(SftpServerDataProvider::EventInboundFileRejected, events[2].event_type);
        assertEq(SftpServerDataProvider::InboundRejectContentTypeHint, events[2].reason_code);
        assertEq("/inbound/rejected-hint.zip", events[2].path);
    }

    testVirtualExchangeCustomInboundValidation() {
        list<hash<auto>> requests = ();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "validation_callback": hash<SftpServerDataProvider::VirtualSftpInboundValidationResult>
                        sub(hash<SftpServerDataProvider::VirtualSftpInboundValidationRequest> req) {
                    requests += (req,);
                    if (req.data.toString("UTF-8").find("ALLOW") >= 0) {
                        return <SftpServerDataProvider::VirtualSftpInboundValidationResult>{
                            "accepted": True,
                        };
                    }
                    return <SftpServerDataProvider::VirtualSftpInboundValidationResult>{
                        "accepted": False,
                        "reason_code": "content-schema-invalid",
                        "reason_desc": sprintf("custom validator rejected %y", req.name),
                    };
                },
            },
        });
        list<hash<auto>> events = ();
        int listener_id = exchange.registerInboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpInboundEventInfo> event) {
                events += (event,);
            });
        on_exit {
            exchange.deregisterInboundEventListener(listener_id);
        }

        string accepted_source_path = getTmpFile(".validator-accepted.source");
        on_exit {
            cleanupFile(accepted_source_path);
        }
        writeTextFile(accepted_source_path, "ALLOW source\n");

        hash<SftpServerDataProvider::VirtualSftpOperationResult> accepted_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/accepted.dat",
                "source_path": accepted_source_path,
                "metadata": {"kind": "accepted"},
            });
        assertTrue(accepted_result.completed);
        assertEq("ALLOW source\n", exchange.getInboundData("accepted.dat").toString("UTF-8"));

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/rejected.dat",
                "data": binary("REJECT helper\n"),
                "metadata": {"kind": "rejected"},
            });
        });

        assertEq(2, requests.size());
        assertEq("/inbound/accepted.dat", requests[0].path);
        assertEq(accepted_source_path, requests[0].source_path);
        assertEq("ALLOW source\n", requests[0].data.toString("UTF-8"));
        assertEq("/inbound/rejected.dat", requests[1].path);
        assertNothing(requests[1].source_path);
        assertEq("REJECT helper\n", requests[1].data.toString("UTF-8"));

        assertEq(2, events.size());
        assertEq(SftpServerDataProvider::EventInboundFileAccepted, events[0].event_type);
        assertEq(SftpServerDataProvider::EventInboundFileRejected, events[1].event_type);
        assertEq("content-schema-invalid", events[1].reason_code);
        assertEq("custom validator rejected \"rejected.dat\"", events[1].reason_desc);
    }

    testVirtualExchangeOutboundCompletionEvents() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claim",
        });
        exchange.addOutboundText("claim.txt", "claim\n", {
            "kind": "claim",
            "checksum": "claim-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        exchange.addOutboundText("archive.txt", "archive\n", {
            "kind": "archive",
            "checksum": "archive-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        exchange.addOutboundText("delete.txt", "delete\n", {
            "kind": "delete",
            "checksum": "delete-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });

        list<hash<auto>> events = ();
        int listener_id = exchange.registerOutboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpOutboundEventInfo> event) {
                events += (event,);
            });
        on_exit {
            exchange.deregisterOutboundEventListener(listener_id);
        }

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> claim_result
            = exchange.claimOutbound("claim.txt", "claimed.txt", {"op": "claim"});
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> archive_result
            = exchange.archiveOutbound("archive.txt", "archived.txt", {"op": "archive"});
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> delete_result
            = exchange.deleteOutbound("delete.txt", {"op": "delete"});

        assertTrue(claim_result.completed);
        assertTrue(archive_result.completed);
        assertTrue(delete_result.completed);
        assertEq(3, events.size());

        assertEq(SftpServerDataProvider::EventOutboundFileClaimed, events[0].event_type);
        assertEq("claim.txt", events[0].name);
        assertEq("/claim/claimed.txt", events[0].path);
        assertEq("claimed.txt", events[0].final_name);
        assertEq("claim", events[0].operation);
        assertEq(6, events[0].size);
        assertEq("helper", events[0].source);
        assertEq("claim-checksum", claim_result.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, claim_result.checksum_algorithm);
        assertEq("claim-checksum", events[0].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, events[0].checksum_algorithm);

        assertEq(SftpServerDataProvider::EventOutboundFileArchived, events[1].event_type);
        assertEq("archive.txt", events[1].name);
        assertEq("/archive/archived.txt", events[1].path);
        assertEq("archived.txt", events[1].final_name);
        assertEq("archive", events[1].operation);
        assertEq(8, events[1].size);
        assertEq("helper", events[1].source);
        assertEq("archive-checksum", archive_result.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, archive_result.checksum_algorithm);
        assertEq("archive-checksum", events[1].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, events[1].checksum_algorithm);

        assertEq(SftpServerDataProvider::EventOutboundFileDeleted, events[2].event_type);
        assertEq("delete.txt", events[2].name);
        assertEq("/outbound/delete.txt", events[2].path);
        assertEq("delete.txt", events[2].final_name);
        assertEq("delete", events[2].operation);
        assertEq(7, events[2].size);
        assertEq("helper", events[2].source);
        assertEq("delete-checksum", delete_result.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, delete_result.checksum_algorithm);
        assertEq("delete-checksum", events[2].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, events[2].checksum_algorithm);
    }

    testVirtualExchangeLoggerLevels() {
        TestLogger logger();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "logger": logger,
            "claim_dir": "/claim",
        });
        exchange.addOutboundText("claim.txt", "claim\n");

        int listener_id = exchange.registerOutboundEventListener(
            sub(hash<SftpServerDataProvider::VirtualSftpOutboundEventInfo> event) {
                throw "TEST-LISTENER-ERROR", sprintf("listener failed for %s", event.name);
            });
        on_exit {
            exchange.deregisterOutboundEventListener(listener_id);
        }

        exchange.claimOutbound("claim.txt", "claimed.txt", {"op": "claim"});

        assertTrue(logger.events.size() >= 2);
        assertEq("detail", logger.events[0].level);
        assertEq("error", logger.events[logger.events.size() - 1].level);
        assertTrue(logger.events[logger.events.size() - 1].message.find("virtual outbound event listener failed") >= 0);
    }

