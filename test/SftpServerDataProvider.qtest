    testVirtualExchangeTypedRequests() {
        SftpServerDataProvider::VirtualSftpExchange exchange();
        hash<SftpServerDataProvider::VirtualSftpSubmissionRequest> submit_req
            = <SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "incoming.dat",
                "data": binary("exchange typed\n"),
                "metadata": {"kind": "typed"},
            };
        hash<SftpServerDataProvider::VirtualSftpOperationResult> submit_result = exchange.submit(submit_req);
        assertTrue(submit_result.completed);
        assertEq("exchange typed\n", exchange.getInboundData("incoming.dat").toString("UTF-8"));

        exchange.addOutboundText("ready.txt", "ready\n");
        hash<SftpServerDataProvider::VirtualSftpPathRequest> list_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/"};
        hash<SftpServerDataProvider::VirtualSftpListResult> list_result = exchange.listAvailable(list_req);
        assertEq("/outbound", list_result.path);

        hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/ready.txt"};
        hash<SftpServerDataProvider::VirtualSftpRetrieveResult> retrieve_result = exchange.retrieve(retrieve_req);
        assertEq(binary("ready\n"), retrieve_result.data);

        hash<SftpServerDataProvider::VirtualSftpCompletionRequest> complete_req
            = <SftpServerDataProvider::VirtualSftpCompletionRequest>{
                "path": "/ready.txt",
                "completion_mode": "delete",
            };
        hash<SftpServerDataProvider::VirtualSftpOperationResult> complete_result = exchange.completeRetrieve(complete_req);
        assertTrue(complete_result.completed);
        assertFalse(exchange.getFilesystem().exists("/outbound/ready.txt"));
    }

    testVirtualExchangeTypedBackendRequests() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });
        exchange.addOutboundText("ready.txt", "ready\n", {"kind": "ready"});

        hash<Qore::Ssh::SftpPathRequest> list_req = <Qore::Ssh::SftpPathRequest>{"path": "/outbound"};
        hash<Qore::Ssh::SftpListResult> list_result = exchange.list(list_req);
        assertEq(1, list_result.entries.size());

        hash<Qore::Ssh::SftpOpenRequest> read_req = <Qore::Ssh::SftpOpenRequest>{"path": "/outbound/ready.txt"};
        hash<Qore::Ssh::SftpOpenResult> read_result = exchange.openRead(read_req);
        assertEq(binary("ready\n"), read_result.data);
        assertEq("/outbound/ready.txt", read_result.path);

        hash<Qore::Ssh::SftpRenameRequest> rename_req = <Qore::Ssh::SftpRenameRequest>{
            "path": "/outbound/ready.txt",
            "target_path": "/outbound/moved.txt",
        };
        hash<Qore::Ssh::SftpOperationResult> rename_result = exchange.rename(rename_req);
        assertTrue(rename_result.completed);
        assertEq("ready\n", exchange.getFilesystem().getFileText("/outbound/moved.txt"));

        hash<Qore::Ssh::SftpPathRequest> remove_req = <Qore::Ssh::SftpPathRequest>{"path": "/outbound/moved.txt"};
        hash<Qore::Ssh::SftpOperationResult> remove_result = exchange.removePath(remove_req);
        assertTrue(remove_result.completed);
        assertFalse(exchange.getFilesystem().exists("/outbound/moved.txt"));
    }

    testVirtualExchangeNewVerbPassthroughs() {
        SftpServerDataProvider::VirtualSftpExchange exchange();
        exchange.addOutboundText("target.txt", "content\n");

        # symlink passthrough
        hash<auto> sym_result = exchange.symlink({
            "link_path": "/outbound/link.txt",
            "target_path": "/outbound/target.txt",
        });
        assertTrue(sym_result.completed);

        # readlink passthrough
        hash<auto> rl_result = exchange.readlink({"path": "/outbound/link.txt"});
        assertTrue(rl_result.exists);
        assertEq("/outbound/target.txt", rl_result.target_path);

        # setstat passthrough
        hash<auto> ss_result = exchange.setstat({
            "path": "/outbound/target.txt",
            "permissions": 0100755,
            "attr_flags": 0x04,
        });
        assertTrue(ss_result.completed);
        hash<auto> stat_result = exchange.stat({"path": "/outbound/target.txt"});
        assertEq(0100755, stat_result.permissions);

        # statvfs passthrough
        hash<auto> vfs_result = exchange.statvfs({"path": "/"});
        assertEq(4096, vfs_result.f_bsize);
        assertTrue(vfs_result.f_files > 0);
    }

    testVirtualExchangeInvalidTypedBackendRequests() {
        SftpServerDataProvider::VirtualSftpExchange exchange();

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"path": 1};
            hash<Qore::Ssh::SftpOpenRequest> bad = cast<hash<Qore::Ssh::SftpOpenRequest>>(raw);
            assertEq(NOTHING, bad);
        });

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"path": "/outbound/a", "target_path": 1};
            hash<Qore::Ssh::SftpRenameRequest> bad = cast<hash<Qore::Ssh::SftpRenameRequest>>(raw);
            assertEq(NOTHING, bad);
        });
    }

    testVirtualExchangeWithSftpSession() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });
        exchange.addOutboundText("ready.txt", "ready\n");

        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(exchange);

        hash<Qore::Ssh::SftpOperationResult> submit_result
            = s.submitData("incoming.dat", binary("payload\n"), {"kind": "upload"});
        assertTrue(submit_result.completed);
        assertEq("payload\n", exchange.getInboundData("incoming.dat").toString("UTF-8"));

        binary data = s.retrieveData("ready.txt");
        assertEq(binary("ready\n"), data);

        hash<Qore::Ssh::SftpOperationResult> claim_result
            = s.completeRetrieveClaim("ready.txt");
        assertTrue(claim_result.completed);
        assertEq("ready\n", exchange.getFilesystem().getFileText("/claimed/ready.txt"));

        hash<Qore::Ssh::SftpListResult> listing = s.listAvailable(<Qore::Ssh::SftpPathRequest>{
            "path": ".",
        });
        assertEq(0, listing.entries.size());
    }

    testVirtualExchangeRecordStoreApi() {
        SftpServerDataProvider::VirtualSftpExchangeRecordStore store(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> inbound
            = store.submitInboundTextRecord("in-1.dat", "payload-1\n", {"tenant": "a"});
        assertEq("inbound", inbound.queue);
        assertEq("in-1.dat", inbound.name);
        assertEq("payload-1\n", store.getExchange().getInboundData("in-1.dat").toString("UTF-8"));
        list<hash<SftpServerDataProvider::VirtualSftpRecordInfo>> inbound_listing = store.listInboundRecords();
        assertEq(1, inbound_listing.size());
        assertEq("in-1.dat", inbound_listing[0].name);
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> inbound_record = store.retrieveInboundRecord("in-1.dat");
        assertEq(binary("payload-1\n"), inbound_record.data);
        assertEq("inbound", inbound_record.queue);

        store.addOutboundTextRecord("out-1.dat", "report-1\n", {
            "kind": "report",
            "checksum": "out-1-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        store.addOutboundTextRecord("out-2.dat", "report-2\n", {
            "checksum": "out-2-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });

        list<hash<SftpServerDataProvider::VirtualSftpRecordInfo>> outbound = store.listOutboundRecords();
        assertEq(2, outbound.size());
        assertEq("out-1.dat", outbound[0].name);
        assertEq("out-1-checksum", outbound[0].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, outbound[0].checksum_algorithm);

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> retrieved = store.retrieveOutboundRecord("out-1.dat");
        assertEq(binary("report-1\n"), retrieved.data);
        assertEq("outbound", retrieved.queue);
        assertEq("out-1-checksum", retrieved.checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, retrieved.checksum_algorithm);

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> claimed = store.claimOutboundRecord("out-1.dat");
        assertTrue(claimed.completed);
        assertEq("claim", claimed.operation);
        assertEq("out-1-checksum", claimed.checksum);
        assertEq("report-1\n", store.getExchange().getFilesystem().getFileText("/claimed/out-1.dat"));

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> archived = store.archiveOutboundRecord("out-2.dat");
        assertTrue(archived.completed);
        assertEq("archive", archived.operation);
        assertEq("out-2-checksum", archived.checksum);
        assertEq("report-2\n", store.getExchange().getFilesystem().getFileText("/archive/out-2.dat"));
    }

    testVirtualExchangeRecordStoreTypedRequests() {
        SftpServerDataProvider::VirtualSftpExchangeRecordStore store(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });

        hash<SftpServerDataProvider::VirtualSftpRecordSubmissionRequest> inbound_req
            = <SftpServerDataProvider::VirtualSftpRecordSubmissionRequest>{
                "name": "typed-in.dat",
                "data": binary("typed-in\n"),
                "metadata": {"kind": "typed-in"},
            };
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> inbound = store.submitInboundRecord(inbound_req);
        assertEq("typed-in.dat", inbound.name);
        assertEq("typed-in\n", store.getExchange().getInboundData("typed-in.dat").toString("UTF-8"));

        hash<SftpServerDataProvider::VirtualSftpRecordSubmissionRequest> outbound_req
            = <SftpServerDataProvider::VirtualSftpRecordSubmissionRequest>{
                "name": "typed-out.dat",
                "data": binary("typed-out\n"),
                "metadata": {"kind": "typed-out"},
            };
        store.addOutboundRecord(outbound_req);

        hash<SftpServerDataProvider::VirtualSftpRecordRequest> retrieve_req
            = <SftpServerDataProvider::VirtualSftpRecordRequest>{"name": "typed-out.dat"};
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> retrieved = store.retrieveOutboundRecord(retrieve_req);
        assertEq(binary("typed-out\n"), retrieved.data);
        assertEq("outbound", retrieved.queue);

        hash<SftpServerDataProvider::VirtualSftpRecordCompletionRequest> claim_req
            = <SftpServerDataProvider::VirtualSftpRecordCompletionRequest>{
                "name": "typed-out.dat",
                "final_name": "claimed-typed-out.dat",
                "completion_mode": "claim",
                "metadata": {"kind": "claim"},
            };
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> claimed = store.claimOutboundRecord(claim_req);
        assertTrue(claimed.completed);
        assertEq("claimed-typed-out.dat", claimed.final_name);
        assertEq("typed-out\n", store.getExchange().getFilesystem().getFileText("/claimed/claimed-typed-out.dat"));

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"name": 1, "data": binary("bad")};
            hash<SftpServerDataProvider::VirtualSftpRecordSubmissionRequest> bad
                = cast<hash<SftpServerDataProvider::VirtualSftpRecordSubmissionRequest>>(raw);
            assertEq(NOTHING, bad);
        });
    }

    testVirtualExchangeRecordStoreRejectsMismatchedCompletionMode() {
        SftpServerDataProvider::VirtualSftpExchangeRecordStore store(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });
        store.addOutboundTextRecord("out-1.dat", "report-1\n");

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            store.claimOutboundRecord(<SftpServerDataProvider::VirtualSftpRecordCompletionRequest>{
                "name": "out-1.dat",
                "completion_mode": "archive",
            });
        });

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            store.archiveOutboundRecord(<SftpServerDataProvider::VirtualSftpRecordCompletionRequest>{
                "name": "out-1.dat",
                "completion_mode": "delete",
            });
        });

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            store.deleteOutboundRecord(<SftpServerDataProvider::VirtualSftpRecordCompletionRequest>{
                "name": "out-1.dat",
                "completion_mode": "claim",
            });
        });
    }

    testVirtualExchangeRecordStoreBackend() {
        SftpServerDataProvider::VirtualSftpExchangeRecordStore store(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });
        store.addOutboundTextRecord("ready-1.dat", "ready-1\n");

        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(store.getBackend());

        binary data = s.retrieveData("ready-1.dat");
        assertEq(binary("ready-1\n"), data);

        hash<Qore::Ssh::SftpOperationResult> delete_result
            = s.completeRetrieveDelete("ready-1.dat");
        assertTrue(delete_result.completed);

        list<hash<SftpServerDataProvider::VirtualSftpRecordInfo>> outbound = store.listOutboundRecords();
        assertEq(0, outbound.size());
    }
}
