%modern
%requires ../qlib/SftpServerDataProvider
%requires ssh
%requires QUnit
%requires ./TestLoggerInterface.qm

%exec-class SftpServerDataProviderTest

class TestLogger inherits RecordingLoggerInterface {
}

class SftpServerDataProviderTest inherits QUnit::Test {
    constructor() : Test("SftpServerDataProviderTest", "0.1", \ARGV) {
        addTestCase("virtual filesystem basic file and directory operations", \testVirtualFilesystemBasic());
        addTestCase("virtual filesystem mutation operations", \testVirtualFilesystemMutations());
        addTestCase("virtual filesystem symlink operations", \testVirtualFilesystemSymlinks());
        addTestCase("virtual filesystem setstat operations", \testVirtualFilesystemSetstat());
        addTestCase("virtual filesystem statvfs", \testVirtualFilesystemStatvfs());
        addTestCase("virtual filesystem persistence", \testVirtualFilesystemPersistence());
        addTestCase("virtual filesystem atomic exchange helpers", \testVirtualFilesystemAtomicExchange());
        addTestCase("virtual filesystem works through SftpSession backend API", \testVirtualFilesystemWithSftpSession());
        addTestCase("virtual filesystem inspection helpers", \testVirtualFilesystemInspectionHelpers());
        addTestCase("virtual filesystem rejects escaping paths", \testVirtualFilesystemRejectsEscapingPaths());
        addTestCase("virtual filesystem logger roundtrip", \testVirtualFilesystemLogger());
        addTestCase("virtual filesystem exposes typed snapshot and listing data", \testVirtualFilesystemTypedResults());
        addTestCase("virtual filesystem typed constructor options reject invalid values", \testVirtualFilesystemTypedOptions());
        addTestCase("virtual filesystem accepts typed request hashes", \testVirtualFilesystemTypedRequests());
        addTestCase("virtual filesystem accepts typed backend request hashes", \testVirtualFilesystemTypedBackendRequests());
        addTestCase("virtual filesystem rejects invalid typed backend request hashes",
            \testVirtualFilesystemInvalidTypedBackendRequests());
        addTestCase("virtual exchange convenience API", \testVirtualExchangeConvenienceApi());
        addTestCase("virtual exchange enforces claim configuration and exported path model", \testVirtualExchangePathModel());
        addTestCase("virtual exchange exposes typed completion results and fallback archive semantics",
            \testVirtualExchangeTypedCompletions());
        addTestCase("virtual exchange rejects invalid entry names and typed options", \testVirtualExchangeInvalidInputs());
        addTestCase("virtual exchange enforces inbound acceptance policy", \testVirtualExchangeInboundPolicy());
        addTestCase("virtual exchange rejects duplicate inbound basenames deterministically",
            \testVirtualExchangeRejectsDuplicateInboundBasenames());
        addTestCase("virtual exchange rejects duplicate inbound size and content deterministically",
            \testVirtualExchangeRejectsDuplicateInboundSizeAndContent());
        addTestCase("virtual exchange enforces inbound file-count and total-byte quotas",
            \testVirtualExchangeInboundQuotas());
        addTestCase("virtual exchange supports directory policy overrides and accepted checksums",
            \testVirtualExchangeDirectoryPoliciesAndChecksums());
        addTestCase("virtual exchange enforces content-aware inbound policy",
            \testVirtualExchangeContentAwareInboundPolicy());
        addTestCase("virtual exchange supports custom inbound validation callbacks",
            \testVirtualExchangeCustomInboundValidation());
        addTestCase("virtual exchange supports principal-aware inbound policy and routing",
            \testVirtualExchangePrincipalAwareInboundPolicy());
        addTestCase("virtual exchange enforces principal-scoped quotas in a shared inbound root",
            \testVirtualExchangePrincipalScopedQuotas());
        addTestCase("virtual exchange enforces concurrent upload caps deterministically",
            \testVirtualExchangeConcurrentUploadCap());
        addTestCase("virtual exchange stamps and cleans up retention metadata deterministically",
            \testVirtualExchangeRetentionCleanup());
        addTestCase("virtual exchange emits typed outbound completion events",
            \testVirtualExchangeOutboundCompletionEvents());
        addTestCase("virtual exchange logs event listener failures at error level",
            \testVirtualExchangeLoggerLevels());
        addTestCase("virtual exchange enforces inbound acceptance policy for source_path submissions",
            \testVirtualExchangeInboundPolicyWithSourcePath());
        addTestCase("virtual exchange accepts typed request hashes", \testVirtualExchangeTypedRequests());
        addTestCase("virtual exchange accepts typed backend request hashes", \testVirtualExchangeTypedBackendRequests());
        addTestCase("virtual exchange passes through symlink, readlink, setstat, statvfs",
            \testVirtualExchangeNewVerbPassthroughs());
        addTestCase("virtual exchange rejects invalid typed backend request hashes",
            \testVirtualExchangeInvalidTypedBackendRequests());
        addTestCase("virtual exchange works through SftpSession backend API", \testVirtualExchangeWithSftpSession());
        addTestCase("virtual exchange record store convenience API", \testVirtualExchangeRecordStoreApi());
        addTestCase("virtual exchange record store accepts typed requests", \testVirtualExchangeRecordStoreTypedRequests());
        addTestCase("virtual exchange record store rejects mismatched typed completion modes",
            \testVirtualExchangeRecordStoreRejectsMismatchedCompletionMode());
        addTestCase("virtual exchange record store works through backend API", \testVirtualExchangeRecordStoreBackend());
        set_return_value(main());
    }

    private hash<Qore::Ssh::SshSessionInfo> getSessionInfo() {
        date ts = now();
        return <Qore::Ssh::SshSessionInfo>{
            "session_id": "provider-1",
            "server_name": "srv",
            "listener_name": "lst",
            "remote_address": "127.0.0.1",
            "remote_port": 22,
            "local_address": "127.0.0.1",
            "local_port": 2222,
            "username": "user",
            "authenticated": True,
            "auth_method": "none",
            "principal": "principal:user",
            "started": ts,
            "last_activity": ts,
        };
    }

    private hash<Qore::Ssh::SftpSessionInfo> getSftpInfo() {
        return <Qore::Ssh::SftpSessionInfo>{
            "session_info": getSessionInfo(),
            "principal": "principal:user",
            "root_dir": "/virtual",
            "read_only": False,
            "session_data": {"tenant": "test"},
        };
    }

    private string getTmpFile(string suffix) {
        return sprintf("/tmp/module-ssh-provider-test-%d-%d%s", getpid(), now_us(), suffix);
    }

    private nothing cleanupFile(string path) {
        if (is_readable(path)) {
            unlink(path);
        }
    }

    private nothing writeTextFile(string path, string data) {
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write(data);
        f.close();
    }

    testVirtualFilesystemBasic() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
            "archive_dir": "/archive",
        });
        vfs.addDirectory("/inbound");
        vfs.addTextFile("/outbound/report.txt", "payload\n", {"kind": "report"});

        hash<auto> root_listing = vfs.list({"path": "/"});
        assertTrue(root_listing.exists);
        assertEq(3, root_listing.entries.size());

        hash<auto> stat = vfs.stat({"path": "/outbound/report.txt"});
        assertTrue(stat.exists);
        assertFalse(stat.directory);
        assertEq(8, stat.size);
        assertEq("payload\n", vfs.getFileText("/outbound/report.txt"));

        hash<auto> read_result = vfs.openRead({"path": "/outbound/report.txt"});
        assertEq(binary("payload\n"), read_result.data);
    }

    testVirtualFilesystemMutations() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.mkdir({"path": "/incoming"});
        vfs.addTextFile("/incoming/a.txt", "a\n");

        hash<auto> rename_result = vfs.rename({
            "path": "/incoming/a.txt",
            "target_path": "/incoming/b.txt",
        });
        assertTrue(rename_result.completed);
        assertEq("a\n", vfs.getFileText("/incoming/b.txt"));

        hash<auto> remove_result = vfs.removePath({"path": "/incoming/b.txt"});
        assertTrue(remove_result.completed);
        assertFalse(vfs.exists("/incoming/b.txt"));

        hash<auto> rmdir_result = vfs.rmdir({"path": "/incoming"});
        assertTrue(rmdir_result.completed);
        assertFalse(vfs.exists("/incoming"));
    }

    testVirtualFilesystemSymlinks() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addTextFile("/data/target.txt", "content\n");

        # create a symlink via addSymlink helper
        vfs.addSymlink("/data/link.txt", "/data/target.txt");
        assertTrue(vfs.exists("/data/link.txt"));

        # stat returns symlink info
        hash<auto> stat_result = vfs.stat({"path": "/data/link.txt"});
        assertTrue(stat_result.exists);
        assertTrue(stat_result.symlink);
        assertEq("/data/target.txt", stat_result.target_path);
        assertFalse(stat_result.directory);

        # readlink returns target path
        hash<auto> readlink_result = vfs.readlink({"path": "/data/link.txt"});
        assertTrue(readlink_result.exists);
        assertEq("/data/target.txt", readlink_result.target_path);

        # readlink on non-existent path
        hash<auto> missing = vfs.readlink({"path": "/data/missing.txt"});
        assertFalse(missing.exists);

        # symlink via backend verb
        hash<auto> symlink_result = vfs.symlink({
            "link_path": "/data/link2.txt",
            "target_path": "/data/target.txt",
        });
        assertTrue(symlink_result.completed);

        # list includes symlinks
        hash<auto> listing = vfs.list({"path": "/data"});
        assertTrue(listing.exists);
        int symlink_count = 0;
        foreach hash<auto> entry in (listing.entries) {
            if (entry.symlink) {
                ++symlink_count;
            }
        }
        assertEq(2, symlink_count);

        # rename a symlink
        hash<auto> rename_result = vfs.rename({
            "path": "/data/link.txt",
            "target_path": "/data/renamed_link.txt",
        });
        assertTrue(rename_result.completed);
        assertFalse(vfs.exists("/data/link.txt"));
        assertTrue(vfs.exists("/data/renamed_link.txt"));
        hash<auto> renamed_readlink = vfs.readlink({"path": "/data/renamed_link.txt"});
        assertEq("/data/target.txt", renamed_readlink.target_path);

        # remove a symlink
        hash<auto> remove_result = vfs.removePath({"path": "/data/renamed_link.txt"});
        assertTrue(remove_result.completed);
        assertFalse(vfs.exists("/data/renamed_link.txt"));

        # symlink on existing path throws
        assertThrows("VIRTUAL-SFTP-FS-ERROR", sub() {
            vfs.symlink({
                "link_path": "/data/target.txt",
                "target_path": "/data/link2.txt",
            });
        });

        # directory rename moves child symlinks
        vfs.addSymlink("/data/child_link.txt", "/data/target.txt");
        vfs.rename({"path": "/data", "target_path": "/moved"});
        assertTrue(vfs.exists("/moved/child_link.txt"));
        hash<auto> moved_readlink = vfs.readlink({"path": "/moved/child_link.txt"});
        assertTrue(moved_readlink.exists);

        # symlink prevents directory from being considered empty
        vfs.mkdir({"path": "/dir_with_link"});
        vfs.addSymlink("/dir_with_link/link", "/moved/target.txt");
        assertThrows("VIRTUAL-SFTP-FS-ERROR", sub() {
            vfs.rmdir({"path": "/dir_with_link"});
        });
    }

    testVirtualFilesystemSetstat() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addTextFile("/data/test.txt", "hello\n");
        vfs.addDirectory("/data/subdir");

        # setstat on a file: update permissions and mtime
        hash<auto> result = vfs.setstat({
            "path": "/data/test.txt",
            "permissions": 0100755,
            "mtime": 1000000,
            "atime": 2000000,
            "attr_flags": 0x0c,
        });
        assertTrue(result.exists);
        assertTrue(result.completed);

        hash<auto> stat_result = vfs.stat({"path": "/data/test.txt"});
        assertEq(0100755, stat_result.permissions);
        assertEq(1000000, stat_result.mtime);
        assertEq(2000000, stat_result.atime);

        # setstat on a directory: update permissions
        hash<auto> dir_result = vfs.setstat({
            "path": "/data/subdir",
            "permissions": 0040700,
            "attr_flags": 0x04,
        });
        assertTrue(dir_result.completed);
        hash<auto> dir_stat = vfs.stat({"path": "/data/subdir"});
        assertEq(0040700, dir_stat.permissions);

        # setstat on a symlink
        vfs.addSymlink("/data/link.txt", "/data/test.txt");
        hash<auto> link_result = vfs.setstat({
            "path": "/data/link.txt",
            "mtime": 3000000,
            "attr_flags": 0x08,
        });
        assertTrue(link_result.completed);
        hash<auto> link_stat = vfs.stat({"path": "/data/link.txt"});
        assertEq(3000000, link_stat.mtime);

        # setstat on non-existent path
        hash<auto> missing = vfs.setstat({"path": "/data/missing.txt", "attr_flags": 0});
        assertFalse(missing.exists);
    }

    testVirtualFilesystemStatvfs() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addTextFile("/data/file1.txt", "hello\n");
        vfs.addTextFile("/data/file2.txt", "world\n");
        vfs.addDirectory("/data/subdir");

        hash<auto> result = vfs.statvfs({"path": "/"});
        assertEq(4096, result.f_bsize);
        assertEq(4096, result.f_frsize);
        assertEq(255, result.f_namemax);
        # 2 files + 3 directories (/, /data, /data/subdir)
        assertEq(5, result.f_files);
        assertTrue(result.f_blocks > 0);
        assertTrue(result.f_bfree > 0);
        assertTrue(result.f_bavail > 0);
        assertTrue(result.f_ffree > 0);
    }

    testVirtualFilesystemPersistence() {
        string tmp_dir = getTmpFile("vfs-persist-test");
        on_exit {
            cleanupFile(tmp_dir + "/vfs-snapshot.json");
            cleanupFile(tmp_dir + "/vfs-snapshot.json.tmp");
            cleanupFile(tmp_dir);
        }

        # Create filesystem with write-through persistence
        {
            SftpServerDataProvider::VirtualSftpFilesystem vfs(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
                "persistence": <SftpServerDataProvider::VirtualSftpPersistenceOptions>{
                    "persistence_dir": tmp_dir,
                    "persistence_mode": "write-through",
                    "restore_on_construct": False,
                },
            });
            vfs.addTextFile("/data/file1.txt", "content-1\n");
            vfs.addDirectory("/data/subdir");
            # write-through should have persisted after closeWrite (via addTextFile → makeFileEntry path)
            # but addFile uses direct assignment not closeWrite, so let's use the backend verb
            vfs.closeWrite({"path": "/data/file2.txt", "data": binary("content-2\n")});
        }

        # Create a new filesystem that restores from the persisted snapshot
        {
            SftpServerDataProvider::VirtualSftpFilesystem vfs2(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
                "persistence": <SftpServerDataProvider::VirtualSftpPersistenceOptions>{
                    "persistence_dir": tmp_dir,
                    "persistence_mode": "snapshot",
                    "restore_on_construct": True,
                },
            });
            assertTrue(vfs2.exists("/data/file2.txt"));
            assertEq("content-2\n", vfs2.getFileText("/data/file2.txt"));
        }

        # saveSnapshot works
        {
            SftpServerDataProvider::VirtualSftpFilesystem vfs3(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
                "persistence": <SftpServerDataProvider::VirtualSftpPersistenceOptions>{
                    "persistence_dir": tmp_dir,
                    "persistence_mode": "snapshot",
                    "restore_on_construct": False,
                },
            });
            vfs3.addTextFile("/fresh/file.txt", "fresh\n");
            vfs3.saveSnapshot();

            SftpServerDataProvider::VirtualSftpFilesystem vfs4(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
                "persistence": <SftpServerDataProvider::VirtualSftpPersistenceOptions>{
                    "persistence_dir": tmp_dir,
                    "persistence_mode": "snapshot",
                    "restore_on_construct": True,
                },
            });
            assertTrue(vfs4.exists("/fresh/file.txt"));
            assertEq("fresh\n", vfs4.getFileText("/fresh/file.txt"));
        }
    }

    testVirtualFilesystemAtomicExchange() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
            "archive_dir": "/archive",
        });
        vfs.submit({
            "path": "/exchange/input.dat",
            "data": binary("input\n"),
            "metadata": {"kind": "inbound"},
        });

        hash<SftpServerDataProvider::VirtualSftpPathRequest> list_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/exchange"};
        hash<SftpServerDataProvider::VirtualSftpListResult> listing = vfs.listAvailable(list_req);
        assertEq(1, listing.entries.size());

        hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/exchange/input.dat"};
        hash<SftpServerDataProvider::VirtualSftpRetrieveResult> retrieve = vfs.retrieve(retrieve_req);
        assertEq(binary("input\n"), retrieve.data);
        assertFalse(retrieve.transfer_info.completed);

        hash<SftpServerDataProvider::VirtualSftpCompletionRequest> complete_req
            = <SftpServerDataProvider::VirtualSftpCompletionRequest>{
                "path": "/exchange/input.dat",
                "completion_mode": "archive",
            };
        hash<SftpServerDataProvider::VirtualSftpOperationResult> complete = vfs.completeRetrieve(complete_req);
        assertTrue(complete.completed);
        assertFalse(vfs.exists("/exchange/input.dat"));
        assertEq("input\n", vfs.getFileText("/archive/input.dat"));
    }

    testVirtualFilesystemWithSftpSession() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addTextFile("/outbound/report.dat", "report\n");

        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(vfs);

        binary data = s.retrieveData("/outbound/report.dat", {"kind": "test"});
        assertEq(binary("report\n"), data);

        hash<Qore::Ssh::SftpOperationResult> submit_result
            = s.submitData("/inbound/upload.dat", binary("upload\n"), {"kind": "upload"});
        assertTrue(submit_result.completed);
        assertEq("upload\n", vfs.getFileText("/inbound/upload.dat"));

        hash<Qore::Ssh::SftpOperationResult> delete_result
            = s.completeRetrieveDelete("/outbound/report.dat");
        assertTrue(delete_result.completed);
        assertFalse(vfs.exists("/outbound/report.dat"));
    }

    testVirtualFilesystemInspectionHelpers() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addDirectory("/tree/branch");
        vfs.addTextFile("/tree/root.txt", "root\n");
        vfs.addTextFile("/tree/branch/leaf.txt", "leaf\n", {"kind": "leaf"});

        list<string> dirs = vfs.listDirectoryPaths("/tree");
        assertEq(2, dirs.size());
        assertEq("/tree", dirs[0]);
        assertEq("/tree/branch", dirs[1]);

        list<string> files = vfs.listFilePaths("/tree");
        assertEq(2, files.size());
        assertEq("/tree/branch/leaf.txt", files[0]);
        assertEq("/tree/root.txt", files[1]);

        hash<SftpServerDataProvider::VirtualSftpSnapshot> snapshot = vfs.exportSnapshot("/tree");
        assertEq("/tree", snapshot.root_path);
        assertEq(2, snapshot.file_paths.size());
        assertEq(binary("leaf\n"), snapshot.files{"/tree/branch/leaf.txt"}.data);
        assertEq("leaf", snapshot.files{"/tree/branch/leaf.txt"}.metadata.kind);
        assertEq(NOTHING, snapshot.files{"/tree/branch/leaf.txt"}.state);
    }

    testVirtualFilesystemRejectsEscapingPaths() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        assertThrows("VIRTUAL-SFTP-FS-ERROR", sub() { vfs.addTextFile("/../../bad.txt", "bad"); });
        assertThrows("VIRTUAL-SFTP-FS-ERROR", sub() { vfs.stat({"path": "relative.txt"}); });
    }

    testVirtualFilesystemLogger() {
        TestLogger logger();
        SftpServerDataProvider::VirtualSftpFilesystem vfs(<SftpServerDataProvider::VirtualSftpFilesystemOptions>{
            "logger": logger,
        });
        assertEq(logger, vfs.getLogger());
        vfs.addTextFile("/logged.txt", "log me\n");
        vfs.rename({"path": "/logged.txt", "target_path": "/renamed.txt"});
        vfs.removePath({"path": "/renamed.txt"});
        assertTrue(logger.events.size() >= 3);
        for (int i = 0; i < logger.events.size(); ++i) {
            assertEq("detail", logger.events[i].level);
        }
    }

    testVirtualFilesystemTypedResults() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addDirectory("/typed");
        vfs.addTextFile("/typed/file.txt", "typed\n", {"kind": "typed"});

        hash<SftpServerDataProvider::VirtualSftpSnapshot> snapshot = vfs.exportSnapshot("/typed");
        assertEq("/typed", snapshot.root_path);
        assertEq(1, snapshot.file_paths.size());
        hash<SftpServerDataProvider::VirtualSftpFileSnapshot> file_snapshot = snapshot.files{"/typed/file.txt"};
        assertEq(6, file_snapshot.size);
        assertEq(binary("typed\n"), file_snapshot.data);
        assertEq("typed", file_snapshot.metadata.kind);
        assertEq(NOTHING, file_snapshot.state);

        list<hash<SftpServerDataProvider::VirtualSftpEntryInfo>> listing = vfs.list({"path": "/typed"}).entries;
        assertEq(1, listing.size());
        assertEq("file.txt", listing[0].filename);
        assertFalse(listing[0].directory);
        assertEq(6, listing[0].size);
        assertEq(NOTHING, listing[0].state);
    }

    testVirtualFilesystemTypedOptions() {
        hash<SftpServerDataProvider::VirtualSftpFilesystemOptions> options
            = <SftpServerDataProvider::VirtualSftpFilesystemOptions>{
                "archive_dir": "/archive",
                "default_file_permissions": 0100600,
            };
        SftpServerDataProvider::VirtualSftpFilesystem vfs(options);
        vfs.addTextFile("/typed.txt", "typed options\n");
        hash<SftpServerDataProvider::VirtualSftpSnapshot> snapshot = vfs.exportSnapshot("/");
        assertEq(0100600, snapshot.files{"/typed.txt"}.permissions);

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {
                "archive_dir": 1,
            };
            hash<SftpServerDataProvider::VirtualSftpFilesystemOptions> bad
                = cast<hash<SftpServerDataProvider::VirtualSftpFilesystemOptions>>(raw);
            assertEq(NOTHING, bad);
        });
    }

    testVirtualFilesystemTypedRequests() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        hash<SftpServerDataProvider::VirtualSftpSubmissionRequest> submit_req
            = <SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/typed/request.txt",
                "data": binary("typed request\n"),
                "metadata": {"kind": "typed"},
            };
        hash<SftpServerDataProvider::VirtualSftpOperationResult> submit_result = vfs.submit(submit_req);
        assertTrue(submit_result.completed);

        hash<SftpServerDataProvider::VirtualSftpPathRequest> list_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/typed"};
        hash<SftpServerDataProvider::VirtualSftpListResult> list_result = vfs.listAvailable(list_req);
        assertEq(1, list_result.entries.size());

        hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/typed/request.txt"};
        hash<SftpServerDataProvider::VirtualSftpRetrieveResult> retrieve_result = vfs.retrieve(retrieve_req);
        assertEq(binary("typed request\n"), retrieve_result.data);

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"path": 1};
            hash<SftpServerDataProvider::VirtualSftpPathRequest> bad
                = cast<hash<SftpServerDataProvider::VirtualSftpPathRequest>>(raw);
            assertEq(NOTHING, bad);
        });
    }

    testVirtualFilesystemTypedBackendRequests() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();
        vfs.addTextFile("/backend/report.txt", "backend\n", {"kind": "backend"});

        hash<Qore::Ssh::SftpPathRequest> stat_req = <Qore::Ssh::SftpPathRequest>{"path": "/backend/report.txt"};
        hash<Qore::Ssh::SftpPathInfo> stat_result = vfs.stat(stat_req);
        assertTrue(stat_result.exists);
        assertFalse(stat_result.directory);
        assertEq(8, stat_result.size);

        hash<Qore::Ssh::SftpPathRequest> list_req = <Qore::Ssh::SftpPathRequest>{"path": "/backend"};
        hash<Qore::Ssh::SftpListResult> list_result = vfs.list(list_req);
        assertEq(1, list_result.entries.size());

        hash<Qore::Ssh::SftpOpenRequest> open_req = <Qore::Ssh::SftpOpenRequest>{"path": "/backend/report.txt"};
        hash<Qore::Ssh::SftpOpenResult> open_result = vfs.openRead(open_req);
        assertEq(binary("backend\n"), open_result.data);

        hash<Qore::Ssh::SftpRenameRequest> rename_req = <Qore::Ssh::SftpRenameRequest>{
            "path": "/backend/report.txt",
            "target_path": "/backend/renamed.txt",
        };
        hash<Qore::Ssh::SftpOperationResult> rename_result = vfs.rename(rename_req);
        assertTrue(rename_result.completed);
        assertEq("/backend/renamed.txt", rename_result.path);

        hash<Qore::Ssh::SftpSubmissionRequest> write_req = <Qore::Ssh::SftpSubmissionRequest>{
            "path": "/backend/written.txt",
            "data": binary("written\n"),
            "metadata": {"kind": "write"},
        };
        hash<Qore::Ssh::SftpOpenResult> open_write_result = vfs.openWrite(<Qore::Ssh::SftpOpenRequest>{
            "path": "/backend/written.txt",
        });
        assertTrue(open_write_result.exists);
        hash<Qore::Ssh::SftpOperationResult> close_write_result = vfs.closeWrite(write_req);
        assertTrue(close_write_result.completed);
        assertEq("written\n", vfs.getFileText("/backend/written.txt"));
    }

    testVirtualFilesystemInvalidTypedBackendRequests() {
        SftpServerDataProvider::VirtualSftpFilesystem vfs();

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"path": 1};
            hash<Qore::Ssh::SftpPathRequest> bad = cast<hash<Qore::Ssh::SftpPathRequest>>(raw);
            assertEq(NOTHING, bad);
        });

        assertThrows("RUNTIME-TYPE-ERROR", sub() {
            hash<auto> raw = {"path": "/ok", "target_path": 1};
            hash<Qore::Ssh::SftpRenameRequest> bad = cast<hash<Qore::Ssh::SftpRenameRequest>>(raw);
            assertEq(NOTHING, bad);
        });
    }

    testVirtualExchangeConvenienceApi() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
        });
        exchange.addOutboundText("report.txt", "report\n", {"kind": "report"});
        exchange.addInboundText("seed.txt", "seed\n");

        assertEq("/inbound", exchange.getInboundDir());
        assertEq("/outbound", exchange.getOutboundDir());
        assertEq("report\n", exchange.getOutboundData("report.txt").toString("UTF-8"));
        assertEq("seed\n", exchange.getInboundData("seed.txt").toString("UTF-8"));
        assertEq(1, exchange.listOutbound().size());
        assertEq(1, exchange.listInbound().size());

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> claim_result = exchange.claimOutbound("report.txt");
        assertTrue(claim_result.completed);
        assertEq("claim", claim_result.operation);
        assertEq("report\n", exchange.getFilesystem().getFileText("/claimed/report.txt"));

        exchange.addOutboundText("archive.txt", "archive\n");
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> archive_result = exchange.archiveOutbound("archive.txt");
        assertTrue(archive_result.completed);
        assertEq("archive", archive_result.operation);
        assertEq("archive\n", exchange.getFilesystem().getFileText("/archive/archive.txt"));

        exchange.addOutboundText("delete.txt", "delete\n");
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> delete_result = exchange.deleteOutbound("delete.txt");
        assertTrue(delete_result.completed);
        assertEq("delete", delete_result.operation);
        assertFalse(exchange.getFilesystem().exists("/outbound/delete.txt"));
    }

    testVirtualExchangePathModel() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
        });
        exchange.addOutboundText("ready.txt", "ready\n", {"kind": "ready"});

        hash<SftpServerDataProvider::VirtualSftpPathRequest> list_root_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/"};
        hash<SftpServerDataProvider::VirtualSftpListResult> list_root = exchange.listAvailable(list_root_req);
        assertEq("/outbound", list_root.path);
        assertEq(1, list_root.entries.size());
        hash<SftpServerDataProvider::VirtualSftpEntryInfo> root_entry = list_root.entries[0];
        assertEq("ready.txt", root_entry.filename);

        hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_simple_req
            = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/ready.txt"};
        hash<SftpServerDataProvider::VirtualSftpRetrieveResult> retrieve_simple = exchange.retrieve(retrieve_simple_req);
        assertEq(binary("ready\n"), retrieve_simple.data);
        assertEq("/outbound/ready.txt", retrieve_simple.path);

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> claim_result = exchange.claimOutbound("ready.txt");
        assertTrue(claim_result.completed);
        assertEq("/outbound/ready.txt", claim_result.path);
        hash<SftpServerDataProvider::VirtualSftpSnapshot> claimed_snapshot
            = exchange.getFilesystem().exportSnapshot("/outbound");
        assertTrue(claimed_snapshot.files{"/outbound/ready.txt"}.state.claimed);
    }

    testVirtualExchangeTypedCompletions() {
        SftpServerDataProvider::VirtualSftpExchange exchange();
        exchange.addOutboundText("archive-me.txt", "archive me\n", {"kind": "archive"});

        hash<SftpServerDataProvider::VirtualSftpRecordInfo> archive_result = exchange.archiveOutbound("archive-me.txt");
        assertTrue(archive_result.completed);
        assertEq("outbound", archive_result.queue);
        assertEq("archive", archive_result.operation);
        assertEq("archive-me.txt", archive_result.final_name);
        assertEq("/outbound/archive-me.txt", archive_result.path);

        hash<SftpServerDataProvider::VirtualSftpSnapshot> archived_snapshot
            = exchange.getFilesystem().exportSnapshot("/outbound");
        assertTrue(archived_snapshot.files{"/outbound/archive-me.txt"}.state.archived);

        exchange.addOutboundText("delete-me.txt", "delete me\n");
        hash<SftpServerDataProvider::VirtualSftpRecordInfo> delete_result = exchange.deleteOutbound("delete-me.txt");
        assertTrue(delete_result.completed);
        assertEq("delete", delete_result.operation);
        assertEq("delete-me.txt", delete_result.final_name);
        assertEq(NOTHING, delete_result.path);
    }

