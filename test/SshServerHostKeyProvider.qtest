%modern
%requires qore >= 2.3
%requires ssh
%requires sshutil
%requires QUnit

%exec-class SshServerHostKeyProviderTest

class TestServerHostKeyProvider inherits SshUtil::AbstractSshServerHostKeyProvider {
    public {
        string mode;
        string path;
        int calls;
        list<hash<auto>> contexts;
    }

    constructor(string mode, string path = "") {
        self.mode = mode;
        self.path = path;
        calls = 0;
        contexts = ();
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        ++calls;
        contexts += (ctxt,);
        if (mode == "empty") {
            return ();
        }
        if (mode == "missing-path") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                "kind": SshUtil::SshPrivateKeyMaterialKind::File,
            },);
        }
        if (mode == "text") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                "kind": SshUtil::SshPrivateKeyMaterialKind::Text,
                "private_key_text": ReadOnlyFile::readTextFile(path),
            },);
        }
        if (mode == "data") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                "kind": SshUtil::SshPrivateKeyMaterialKind::Data,
                "private_key_data": binary(ReadOnlyFile::readTextFile(path)),
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            "kind": SshUtil::SshPrivateKeyMaterialKind::File,
            "path": path,
        },);
    }
}

class InvalidServerHostKeyProvider {
}

class SshServerHostKeyProviderTest inherits QUnit::Test {
    constructor() : Test("SshServerHostKeyProviderTest", "0.1", \ARGV) {
        addTestCase("provider file material starts listener", \testFileMaterial());
        addTestCase("provider text material starts listener", \testTextMaterial());
        addTestCase("provider data material starts listener", \testDataMaterial());
        addTestCase("provider malformed responses fail closed", \testMalformedResponses());
        set_return_value(main());
    }

    private string getHostKeyPath() {
        return get_script_dir() + "data/ssh_host_ed25519_key";
    }

    private hash<SshServerConfig> getProviderHostKeyConfig(
            *SshUtil::AbstractSshServerHostKeyProvider provider) {
        return <SshServerConfig>{
            "name": "test-server",
            "listeners": (<SshListenerConfig>{
                "name": "provider-listener",
                "bind_address": "127.0.0.1",
                "port": 0,
                "server_host_key_provider": provider,
            },),
        };
    }

    private hash<SshServerConfig> getInvalidProviderHostKeyConfig() {
        object invalid_provider = new InvalidServerHostKeyProvider();
        return <SshServerConfig>{
            "name": "test-server",
            "listeners": (<SshListenerConfig>{
                "name": "provider-listener",
                "bind_address": "127.0.0.1",
                "port": 0,
                "server_host_key_provider": invalid_provider,
            },),
        };
    }

    private nothing assertProviderHostKeyServerStarts(TestServerHostKeyProvider provider) {
        Qore::Ssh::SshServer server(getProviderHostKeyConfig(provider));
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        assertTrue(status.running);
        assertTrue(status.listeners[0].running);
        assertGt(0, status.listeners[0].bound_port);
        server.stop();

        assertEq(1, provider.calls);
        assertEq(1, provider.contexts.size());
        hash<auto> ctxt = provider.contexts[0];
        assertEq("server-host-key", ctxt.purpose);
        assertEq("provider-listener", ctxt.listener_name);
        assertEq("127.0.0.1", ctxt.original_host);
        assertEq("127.0.0.1", ctxt.normalized_host);
        assertEq(0, ctxt.port);
        assertEq(0, ctxt.deadline_ns);
        assertEq(0, ctxt.remaining_ns);
    }

    testFileMaterial() {
        assertProviderHostKeyServerStarts(new TestServerHostKeyProvider("file", getHostKeyPath()));
    }

    testTextMaterial() {
        assertProviderHostKeyServerStarts(new TestServerHostKeyProvider("text", getHostKeyPath()));
    }

    testDataMaterial() {
        assertProviderHostKeyServerStarts(new TestServerHostKeyProvider("data", getHostKeyPath()));
    }

    testMalformedResponses() {
        assertThrows("RUNTIME-TYPE-ERROR", \getInvalidProviderHostKeyConfig());

        TestServerHostKeyProvider empty_provider("empty", getHostKeyPath());
        Qore::Ssh::SshServer empty_server(getProviderHostKeyConfig(empty_provider));
        assertThrows("SSHLISTENER-START-ERROR", sub() { empty_server.start(); });
        assertFalse(empty_server.running());
        assertEq(1, empty_provider.calls);

        TestServerHostKeyProvider missing_path_provider("missing-path", getHostKeyPath());
        Qore::Ssh::SshServer missing_path_server(getProviderHostKeyConfig(missing_path_provider));
        assertThrows("SSH-HOSTKEY-INVALID-RESPONSE", sub() { missing_path_server.start(); });
        assertFalse(missing_path_server.running());
        assertEq(1, missing_path_provider.calls);
    }
}
