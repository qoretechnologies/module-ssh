%modern
%requires ../qlib/SftpServerDataProvider
%requires ../qlib/SshServerConnections
%requires ssh
%requires DataProvider
%requires QUnit

%exec-class VirtualSftpInboundPolicyServerTest

class EventObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data_) {
        events += ((data_ + ("event_id": event_id)),);
    }
}

class VirtualSftpInboundPolicyServerTest inherits QUnit::Test {
    constructor() : Test("VirtualSftpInboundPolicyServerTest", "0.1", \ARGV) {
        addTestCase("connection-driven SFTP server enforces inbound policy and emits events",
            \testInboundPolicyServer());
        set_return_value(main());
    }

    private string getTmpFile(string suffix) {
        return "/tmp/module-ssh-policy-test-" + string(getpid()) + "-" + string(now_us()) + suffix;
    }

    private nothing cleanupFile(string path) {
        if (is_readable(path)) {
            unlink(path);
        }
    }

    private nothing writeTextFile(string path, string data) {
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write(data);
        f.close();
    }

    private string makeSftpClientCommand(int port, string batch_path, string stdout_path, string stderr_path) {
        return sprintf("/usr/bin/sftp"
            + " -b %s"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=none"
            + " -o PubkeyAuthentication=no"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -P %d"
            + " nobody@127.0.0.1"
            + " >%s 2>%s", batch_path, port, stdout_path, stderr_path);
    }

    private hash<auto> runBatch(Qore::Ssh::SshServer server, int port, string batch_data) {
        string batch_path = getTmpFile(".batch");
        string stdout_path = getTmpFile(".out");
        string stderr_path = getTmpFile(".err");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        writeTextFile(batch_path, batch_data);
        int sftp_rc = 0;
        Counter done(1);
        background sub() {
            try {
                sftp_rc = system(makeSftpClientCommand(port, batch_path, stdout_path, stderr_path));
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<Qore::Ssh::SshAuthDecision> auth = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        sftp.close();
        service_done.waitForZero(5s);
        session.disconnect();

        return {
            "rc": sftp_rc,
            "auth": auth,
            "stdout": is_file(stdout_path) ? ReadOnlyFile::readTextFile(stdout_path) : "",
            "stderr": is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "",
        };
    }

    testInboundPolicyServer() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_filename_glob": "*.dat",
                "max_size": 16,
                "allow_overwrite": False,
            },
        });

        SshServerConnections::SftpServerConnection conn({
            "name": "policy-test",
            "url": "sftpserver://127.0.0.1:0",
            "opts": {
                "host_keys": (get_script_dir() + "data/ssh_host_ed25519_key",),
                "services": <SshServerConnections::SshServerConnectionServices>{
                    "enabled_auth_methods": ("none",),
                },
                "backend": exchange,
            },
        });

        AbstractDataProvider provider = conn.getDataProvider();
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            observer, SftpServerDataProvider::EventInboundFileAccepted);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<Qore::Ssh::SshServerConfig> config = conn.getServerConfig();
        config.auth_callback = hash<Qore::Ssh::SshAuthDecision> sub(hash<Qore::Ssh::SshAuthContextInfo> ctx) {
            return <Qore::Ssh::SshAuthDecision>{
                "accepted": True,
                "principal": "principal:" + ctx.username,
                "command_policy": {
                    "mode": "subsystem-only",
                    "allowed_subsystems": ("sftp",),
                },
                "sftp_policy": {"mode": "enabled"},
            };
        };

        Qore::Ssh::SshServer server(config);
        server.start();
        int port = server.getStatus().listeners[0].bound_port;

        string ok_source = getTmpFile(".accepted.source");
        string rejected_source = getTmpFile(".rejected.source");

        on_exit {
            cleanupFile(ok_source);
            cleanupFile(rejected_source);
        }

        writeTextFile(ok_source, "accepted\n");
        writeTextFile(rejected_source, "rejected-by-policy\n");

        hash<auto> ok_result = runBatch(server, port,
            sprintf("put %s /inbound/accepted.dat\nquit\n", ok_source));
        hash<auto> rejected_result = runBatch(server, port,
            sprintf("put %s /inbound/rejected.txt\nquit\n", rejected_source));
        server.stop();

        assertTrue(ok_result.auth.accepted);
        assertTrue(rejected_result.auth.accepted);
        assertEq(1, observer.events.size());
        assertEq("accepted.dat", observer.events[0].name);
        assertEq(NOTHING, observer.events[0].data);
        assertEq(1, exchange.listInbound().size());
        assertEq("accepted.dat", exchange.listInbound()[0].filename);
        assertEq("accepted\n", exchange.getInboundData("accepted.dat").toString("UTF-8"));
        assertFalse(exchange.getFilesystem().exists("/inbound/rejected.txt"));
    }
}
