%modern
%requires QUnit

%exec-class ScaffoldTest

class ScaffoldTest inherits QUnit::Test {
    constructor() : Test("ScaffoldTest", "0.1", \ARGV) {
        addTestCase("Repository scaffold files exist", \scaffoldFilesExist());
        addTestCase("Phase 1 design files exist", \phase1DesignFilesExist());
        addTestCase("Phase 6 provider design files exist", \phase6DesignFilesExist());
        addTestCase("Phase 6 provider tests exist", \phase6ProviderTestsExist());
        addTestCase("API spec contains CamelCase contracts", \apiSpecContainsContracts());
        addTestCase("Phase 2 binary module files exist", \phase2FilesExist());
        set_return_value(main());
    }

    private string repoPath(string rel) {
        return get_script_dir() + "../" + rel;
    }

    scaffoldFilesExist() {
        assertTrue(is_file(repoPath("README")));
        assertTrue(is_file(repoPath("design/api-spec.md")));
        assertTrue(is_dir(repoPath("qlib/SshServerConnections")));
        assertTrue(is_file(repoPath("qlib/SshServerConnections/SshServerConnections.qm")));
        assertTrue(is_dir(repoPath("qlib/SftpServerDataProvider")));
        assertTrue(is_file(repoPath("qlib/SftpServerDataProvider/SftpServerDataProvider.qm")));
        assertTrue(is_dir(repoPath("qlib/SshServerCommandProvider")));
        assertTrue(is_file(repoPath("qlib/SshServerCommandProvider/SshServerCommandProvider.qm")));
        assertTrue(is_dir(repoPath("qlib/QorusSshIntegration")));
        assertTrue(is_file(repoPath("qlib/QorusSshIntegration/QorusSshIntegration.qm")));
    }

    phase1DesignFilesExist() {
        assertTrue(is_file(repoPath("design/callback-contracts.md")));
        assertTrue(is_file(repoPath("design/error-taxonomy.md")));
    }

    phase6DesignFilesExist() {
        assertTrue(is_file(repoPath("design/data-provider-infrastructure.md")));
    }

    phase6ProviderTestsExist() {
        assertTrue(is_file(repoPath("test/SshServerConnections.qtest")));
        assertTrue(is_file(repoPath("test/SftpServerDataProviderDataProvider.qtest")));
        assertTrue(is_file(repoPath("test/SshServerCommandProvider.qtest")));
        assertTrue(is_file(repoPath("test/VirtualSftpInboundPolicyServer.qtest")));
    }

    apiSpecContainsContracts() {
        ReadOnlyFile f(repoPath("design/api-spec.md"));
        string spec = f.read(-1);
        assertTrue(spec.regex("Qore::Ssh"));
        assertTrue(spec.regex("SshServer"));
        assertTrue(spec.regex("SftpServer"));
        assertTrue(spec.regex("SshAuthDecision"));
        assertTrue(spec.regex("SftpAtomicPublishPolicy"));
        assertTrue(spec.regex("SSH-AUTH-DENIED"));
    }

    phase2FilesExist() {
        assertTrue(is_file(repoPath("src/ssh.qpp")));
        assertTrue(is_file(repoPath("src/QC_SshServer.qpp")));
        assertTrue(is_file(repoPath("src/ssh-module.h")));
    }
}
