%modern
%requires ssh
%requires QUnit
%requires DataProvider
%requires ../qlib/SftpServerDataProvider
%requires ../qlib/SshServerAuthProvider
%requires ../qlib/SshServerCommandProvider
%requires ./TestLoggerInterface.qm

%exec-class SshServerTest

class TestLogger inherits RecordingLoggerInterface {
}

class EventObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data_) {
        events += ((data_ + ("event_id": event_id)),);
    }
}

class TestSftpBackend {
    public {
        string name;
        list<hash<auto>> calls;
        list<hash<auto>> submissions;
        binary streamed_payload;
        binary streamed_submission;
        hash<auto> files;
        hash<auto> directories;
    }

    constructor(string name = "backend") {
        self.name = name;
        calls = ();
        submissions = ();
        streamed_payload = binary("streamed virtual payload\n");
        streamed_submission = binary();
        files = (
            "/backend-entry.txt": binary("hello world\n"),
            "/streamed.txt": streamed_payload,
        );
        directories = (
            "/": True,
        );
    }

    private nothing ensureParentDirectories(string path) {
        int pos = path.rfind("/");
        while (pos > 0) {
            string dir_path = path.substr(0, pos);
            directories{dir_path} = True;
            pos = dir_path.rfind("/");
        }
    }

    hash<auto> stat(hash<auto> req) {
        calls += ({"method": "stat", "path": req.path, "operation": req.operation},);
        if (directories{req.path} != NOTHING && directories{req.path}) {
            return {"backend": name, "path": req.path, "directory": True, "permissions": 0040755};
        }
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            return {
                "backend": name,
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "directory": False,
            };
        }
        return {"backend": name, "path": req.path, "exists": False};
    }

    hash<auto> list(hash<auto> req) {
        calls += ({"method": "list", "path": req.path, "operation": req.operation},);
        list<hash<auto>> entries = ();
        string prefix = req.path == "/" ? "/" : req.path + "/";
        list<string> directory_keys = keys(directories);
        list<string> file_keys = keys(files);

        for (int i = 0; i < directory_keys.size(); ++i) {
            string path = directory_keys[i];
            if (path == "/" || !directories{path}) {
                continue;
            }
            if (path.substr(0, prefix.size()) == prefix && path.find("/", prefix.size()) < 0) {
                string name = path.substr(prefix.size());
                entries += ({
                    "filename": name,
                    "long_name": name,
                    "size": 0,
                    "permissions": 0040755,
                    "directory": True,
                },);
            }
        }

        for (int i = 0; i < file_keys.size(); ++i) {
            string path = file_keys[i];
            if (path.substr(0, prefix.size()) == prefix && path.find("/", prefix.size()) < 0) {
                binary data = files{path};
                string name = path.substr(prefix.size());
                entries += ({
                    "filename": name,
                    "long_name": name,
                    "size": data.size(),
                    "permissions": 0100644,
                    "directory": False,
                },);
            }
        }
        return {
            "backend": name,
            "path": req.path,
            "entries": entries,
        };
    }

    hash<auto> openRead(hash<auto> req) {
        calls += ({"method": "openRead", "path": req.path, "operation": req.operation},);
        if (req.path == "/streamed.txt") {
            binary data = streamed_payload;
            return {
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "backend_handle": "stream:streamed.txt",
            };
        }
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            return {
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "data": data,
            };
        }
        return {"path": req.path, "exists": False};
    }

    hash<auto> read(hash<auto> req) {
        calls += ({
            "method": "read",
            "path": req.path,
            "operation": req.operation,
            "offset": req.offset,
            "length": req.length,
        },);
        if (req.backend_handle == "stream:streamed.txt") {
            binary data = streamed_payload;
            int offset = req.offset;
            int length = req.length;
            if (offset >= data.size()) {
                return {"eof": True};
            }
            int remaining = data.size() - offset;
            int chunk_size = remaining < length ? remaining : length;
            return {
                "data": data.substr(offset, chunk_size),
                "eof": offset + chunk_size >= data.size(),
            };
        }
        return {"eof": True};
    }

    hash<auto> closeRead(hash<auto> req) {
        calls += ({"method": "closeRead", "path": req.path, "operation": req.operation},);
        return {"path": req.path, "completed": True};
    }

    hash<auto> openWrite(hash<auto> req) {
        calls += ({"method": "openWrite", "path": req.path, "operation": req.operation, "pflags": req.pflags},);
        if (req.path == "/stream-submit.txt") {
            streamed_submission = binary();
            return {
                "path": req.path,
                "permissions": 0100644,
                "backend_handle": "write:stream-submit.txt",
            };
        }
        return {
            "path": req.path,
            "permissions": 0100644,
        };
    }

    hash<auto> write(hash<auto> req) {
        calls += ({
            "method": "write",
            "path": req.path,
            "operation": req.operation,
            "offset": req.offset,
            "size": req.data.size(),
        },);
        if (req.backend_handle == "write:stream-submit.txt") {
            if (!req.offset) {
                streamed_submission = binary();
            }
            streamed_submission += req.data;
        }
        return {"written": req.data.size()};
    }

    hash<auto> closeWrite(hash<auto> req) {
        binary data = binary();
        if (req.data != NOTHING) {
            data = req.data;
        }
        if (req.path == "/stream-submit.txt") {
            data = streamed_submission;
        }
        files{req.path} = data;
        submissions += ({"path": req.path, "data": data, "operation": req.operation},);
        calls += ({"method": "closeWrite", "path": req.path, "operation": req.operation},);
        return {
            "path": req.path,
            "size": data.size(),
            "completed": True,
        };
    }

    hash<auto> submit(hash<auto> req) {
        binary data = req.data;
        calls += ({
            "method": "submit",
            "path": req.path,
            "operation": req.operation,
            "size": data.size(),
        },);
        files{req.path} = data;
        return {
            "path": req.path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "submit",
                "path": req.path,
                "final_path": req.path,
                "size": data.size(),
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<auto> listAvailable(hash<auto> req) {
        calls += ({"method": "listAvailable", "path": req.path, "operation": req.operation},);
        hash<auto> result = list(req);
        return {
            "path": req.path,
            "entries": result.entries,
        };
    }

    hash<auto> retrieve(hash<auto> req) {
        calls += ({"method": "retrieve", "path": req.path, "operation": req.operation},);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        binary data = files{req.path};
        return {
            "path": req.path,
            "data": data,
            "size": data.size(),
            "permissions": 0100644,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "retrieve",
                "path": req.path,
                "final_path": req.path,
                "size": data.size(),
                "atomic_publish": False,
                "completed": False,
            },
        };
    }

    hash<auto> completeRetrieve(hash<auto> req) {
        calls += ({
            "method": "completeRetrieve",
            "path": req.path,
            "target_path": req.target_path,
            "operation": req.operation,
        },);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        string mode = req.completion_mode ?? "";
        *string final_path = req.path;
        if (mode == "delete") {
            delete files{req.path};
        } else if (mode == "archive" || mode == "claim") {
            string default_dir = mode == "archive" ? "/archive/" : "/claim/";
            int pos = req.path.rfind("/");
            string basename = pos < 0 ? req.path : req.path.substr(pos + 1);
            final_path = req.target_path ?? (default_dir + basename);
            if (final_path != req.path) {
                ensureParentDirectories(final_path);
                binary data = files{req.path};
                delete files{req.path};
                files{final_path} = data;
            }
        }
        return {
            "path": final_path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "retrieve",
                "path": req.path,
                "final_path": final_path,
                "size": 0,
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<auto> removePath(hash<auto> req) {
        calls += ({"method": "removePath", "path": req.path, "operation": req.operation},);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        delete files{req.path};
        return {"path": req.path, "completed": True};
    }

    hash<auto> rename(hash<auto> req) {
        calls += ({"method": "rename", "path": req.path, "target_path": req.target_path, "operation": req.operation},);
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            delete files{req.path};
            files{req.target_path} = data;
            return {"path": req.target_path, "completed": True};
        }
        if (directories{req.path} != NOTHING && directories{req.path}) {
            delete directories{req.path};
            directories{req.target_path} = True;
            return {"path": req.target_path, "completed": True};
        }
        return {"path": req.path, "exists": False};
    }

    hash<auto> mkdir(hash<auto> req) {
        calls += ({"method": "mkdir", "path": req.path, "operation": req.operation},);
        directories{req.path} = True;
        return {"path": req.path, "completed": True};
    }

    hash<auto> rmdir(hash<auto> req) {
        calls += ({"method": "rmdir", "path": req.path, "operation": req.operation},);
        if (directories{req.path} == NOTHING || !directories{req.path}) {
            return {"path": req.path, "exists": False};
        }
        delete directories{req.path};
        return {"path": req.path, "completed": True};
    }
}

class TypedTestSftpBackend {
    public {
        TestSftpBackend impl;
    }

    constructor(string name = "typed-backend") {
        impl = new TestSftpBackend(name);
    }

    hash<Qore::Ssh::SftpPathInfo> stat(hash<Qore::Ssh::SftpPathRequest> req) {
        hash<auto> result = impl.stat(req);
        return <Qore::Ssh::SftpPathInfo>{
            "path": result.path,
            "exists": result.exists,
            "directory": result.directory,
            "size": result.size,
            "permissions": result.permissions,
            "metadata": result.metadata,
        };
    }

    hash<Qore::Ssh::SftpListResult> list(hash<Qore::Ssh::SftpPathRequest> req) {
        hash<auto> result = impl.list(req);
        return <Qore::Ssh::SftpListResult>{
            "path": result.path,
            "entries": result.entries,
            "metadata": result.metadata,
        };
    }

    hash<Qore::Ssh::SftpOpenResult> openRead(hash<Qore::Ssh::SftpOpenRequest> req) {
        hash<auto> result = impl.openRead(req);
        return <Qore::Ssh::SftpOpenResult>{
            "path": result.path,
            "exists": result.exists,
            "data": result.data,
            "backend_handle": result.backend_handle,
            "size": result.size,
            "permissions": result.permissions,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOpenResult> openWrite(hash<Qore::Ssh::SftpOpenRequest> req) {
        hash<auto> result = impl.openWrite(req);
        return <Qore::Ssh::SftpOpenResult>{
            "path": result.path,
            "exists": result.exists,
            "data": result.data,
            "backend_handle": result.backend_handle,
            "size": result.size,
            "permissions": result.permissions,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpReadResult> read(hash<Qore::Ssh::SftpReadRequest> req) {
        hash<auto> result = impl.read(req);
        return <Qore::Ssh::SftpReadResult>{
            "data": result.data,
            "eof": result.eof,
            "metadata": result.metadata,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> closeRead(hash<Qore::Ssh::SftpCloseRequest> req) {
        hash<auto> result = impl.closeRead(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> write(hash<Qore::Ssh::SftpWriteRequest> req) {
        hash<auto> result = impl.write(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> closeWrite(hash<Qore::Ssh::SftpCloseRequest> req) {
        hash<auto> result = impl.closeWrite(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> removePath(hash<Qore::Ssh::SftpPathRequest> req) {
        hash<auto> result = impl.removePath(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> rename(hash<Qore::Ssh::SftpRenameRequest> req) {
        hash<auto> result = impl.rename(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> mkdir(hash<Qore::Ssh::SftpPathRequest> req) {
        hash<auto> result = impl.mkdir(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> rmdir(hash<Qore::Ssh::SftpPathRequest> req) {
        hash<auto> result = impl.rmdir(req);
        return <Qore::Ssh::SftpOperationResult>{
            "path": result.path,
            "exists": result.exists,
            "completed": result.completed,
            "message": result.message,
            "metadata": result.metadata,
            "transfer_info": result.transfer_info,
        };
    }
}

class MissingEntriesListBackend inherits TestSftpBackend {
    constructor(string name = "missing-entries") : TestSftpBackend(name) {
    }

    hash<auto> list(hash<auto> req) {
        calls += ({"method": "list", "path": req.path, "operation": req.operation},);
        return {
            "backend": name,
            "path": req.path,
        };
    }
}

class MissingOpenReadDataBackend inherits TestSftpBackend {
    constructor(string name = "missing-open-read-data") : TestSftpBackend(name) {
    }

    hash<auto> openRead(hash<auto> req) {
        calls += ({"method": "openRead", "path": req.path, "operation": req.operation},);
        return {
            "path": req.path,
            "size": 5,
            "permissions": 0100644,
        };
    }
}

class SshServerTest inherits QUnit::Test {
    constructor() : Test("SshServerTest", "0.1", \ARGV) {
        addTestCase("constructor with valid config", \testConstructor());
        addTestCase("constructor rejects invalid config", \testInvalidConfig());
        addTestCase("server logger roundtrip", \testServerLogger());
        addTestCase("acceptSessionInfo rejects stopped server", \testAcceptStoppedServer());
        addTestCase("acceptSessionInfo times out with no client", \testAcceptTimeout());
        addTestCase("acceptSessionInfo accepts real ssh client", \testAcceptSessionInfo());
        addTestCase("acceptSession rejects stopped server", \testAcceptSessionStoppedServer());
        addTestCase("acceptSession times out with no client", \testAcceptSessionTimeout());
        addTestCase("acceptSession returns live session", \testAcceptSession());
        addTestCase("acceptSession enforces max listener sessions", \testAcceptSessionMaxSessions());
        addTestCase("waitAuthContext returns and rejects none auth request", \testWaitAuthContextReject());
        addTestCase("waitAuthContext auto-rejects disabled auth methods", \testWaitAuthContextRejectsDisabledAuthMethod());
        addTestCase("waitAuthContext returns publickey auth details", \testWaitAuthContextPublickey());
        addTestCase("waitAuthContext auto-rejects disabled publickey auth", \testWaitAuthContextRejectsDisabledPublickey());
        addTestCase("authenticateSession uses configured auth provider", \testAuthenticateSessionAuthProvider());
        addTestCase("authenticateSession uses configured public-key auth provider",
            \testAuthenticateSessionPublickeyAuthProvider());
        addTestCase("authenticateSession uses configured auth callback", \testAuthenticateSessionCallback());
        addTestCase("dispatchCommandSession handles allowed exec request", \testDispatchCommandSession());
        addTestCase("dispatchCommandSession handles virtual command service", \testDispatchVirtualCommandSession());
        addTestCase("dispatchCommandSession denies exec by default", \testDispatchCommandSessionDenied());
        addTestCase("dispatchCommandSession handles allowed subsystem request", \testDispatchSubsystemSession());
        addTestCase("dispatchCommandSession denies disallowed subsystem request", \testDispatchSubsystemSessionDenied());
        addTestCase("dispatchCommandSession denies exec when listener disables commands", \testDispatchCommandSessionListenerDenied());
        addTestCase("dispatchCommandSession denies subsystem when listener disables commands", \testDispatchSubsystemSessionListenerDenied());
        addTestCase("dispatchCommandSession denies sftp subsystem when listener disables sftp", \testDispatchSftpSubsystemListenerDenied());
        addTestCase("dispatchSftpSession applies factory callback", \testDispatchSftpSession());
        addTestCase("SftpSession handles protocol init and status", \testSftpProtocolInitAndStatus());
        addTestCase("SftpSession handles backend virtual file retrieval", \testSftpProtocolGetVirtualFile());
        addTestCase("SftpSession handles typed backend virtual protocol operations",
            \testSftpProtocolTypedBackendVirtualOperations());
        addTestCase("SftpSession handles typed backend streamed protocol operations",
            \testSftpProtocolTypedBackendStreamOperations());
        addTestCase("SftpSession handles backend streamed file retrieval", \testSftpProtocolGetStreamedVirtualFile());
        addTestCase("SftpSession handles malformed backend list result", \testSftpProtocolRejectsMalformedListResult());
        addTestCase("SftpSession handles malformed backend openRead result",
            \testSftpProtocolRejectsMalformedOpenReadResult());
        addTestCase("SftpSession handles backend virtual file submission", \testSftpProtocolPutVirtualFile());
        addTestCase("SftpSession handles backend streamed file submission", \testSftpProtocolPutStreamedVirtualFile());
        addTestCase("SftpSession handles backend virtual mutations", \testSftpProtocolVirtualMutations());
        addTestCase("SftpSession atomic exchange helpers use factory backend", \testSftpAtomicExchangeHelpers());
        addTestCase("SftpSession atomic exchange helpers use VirtualSftpExchange backend",
            \testSftpAtomicExchangeHelpersWithVirtualExchange());
        addTestCase("SftpSession inbound event provider observes live uploads",
            \testSftpInboundSubmittedEventProvider());
        addTestCase("SftpSession inbound upload policy rejects disallowed live uploads",
            \testSftpInboundUploadPolicy());
        addTestCase("SftpSession inbound upload policy rejects duplicate live basenames",
            \testSftpInboundDuplicateNamePolicy());
        addTestCase("SftpSession inbound upload policy rejects duplicate live size and content",
            \testSftpInboundDuplicateContentPolicies());
        addTestCase("SftpSession inbound upload policy enforces live quotas",
            \testSftpInboundQuotaPolicies());
        addTestCase("SftpSession inbound upload supports directory overrides and accepted checksums",
            \testSftpInboundDirectoryPoliciesAndChecksums());
        addTestCase("SftpSession inbound upload enforces live content-prefix policy",
            \testSftpInboundContentPolicyEvents());
        addTestCase("SftpSession inbound upload supports custom validation callbacks",
            \testSftpInboundValidationCallbackEvents());
        addTestCase("SftpSession applies principal-aware inbound routing",
            \testSftpPrincipalAwareInboundRouting());
        addTestCase("SftpSession enforces principal-scoped shared-root quotas",
            \testSftpPrincipalScopedSharedRootQuotas());
        addTestCase("SftpSession stamps and cleans inbound retention metadata",
            \testSftpInboundRetentionCleanup());
        addTestCase("SftpSession outbound completion event providers observe live helper completions",
            \testSftpOutboundCompletionEventProviders());
        addTestCase("SftpSession atomic exchange helpers reject explicit archive and claim targets without configured dirs",
            \testSftpAtomicExchangeHelpersRejectMissingDefaultTargets());
        addTestCase("evaluateSftpTransferRequest applies path policy callback", \testEvaluateSftpTransferRequest());
        addTestCase("evaluateSftpTransferRequest handles denied transfer", \testEvaluateSftpTransferRequestDenied());
        addTestCase("evaluateSftpTransferRequest denies write for read-only session",
            \testEvaluateSftpTransferRequestReadOnlyDenied());
        addTestCase("evaluateSftpTransferRequest denies traversal paths", \testEvaluateSftpTransferRequestTraversalDenied());
        addTestCase("evaluateSftpTransferRequest plans atomic publish defaults",
            \testEvaluateSftpTransferRequestAtomicPublishDefaults());
        addTestCase("start and stop lifecycle", \testStartStop());
        addTestCase("start rejects invalid host key", \testInvalidStart());
        addTestCase("running reflects lifecycle state", \testRunning());
        addTestCase("getStatus returns typed hash", \testGetStatus());
        addTestCase("getStatus reflects config name", \testGetStatusName());
        addTestCase("getStatus reflects listener count", \testGetStatusListenerCount());
        addTestCase("getStatus includes listener entries", \testGetStatusListeners());
        addTestCase("copy throws exception", \testCopyDenied());
        set_return_value(main());
    }

    private string getHostKeyPath() {
        return get_script_dir() + "data/ssh_host_ed25519_key";
    }

    private hash<SshServerConfig> getTestConfig() {
        return <SshServerConfig>{
            "name": "test-server",
            "listeners": (<SshListenerConfig>{
                "name": "test-listener",
                "bind_address": "127.0.0.1",
                "port": 0,
                "host_keys": (getHostKeyPath(),),
            },),
        };
    }

    private hash<SshServerConfig> getMaxSessionsConfig(int max_sessions) {
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].max_sessions = max_sessions;
        return config;
    }

    private hash<SshServerConfig> getAuthCallbackConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            return <SshAuthDecision>{
                "accepted": True,
                "principal": sprintf("principal:%s", ctx.username),
                "command_policy": {"mode": "command-only"},
                "sftp_policy": {"mode": "disabled"},
                "session_data": {"listener": ctx.listener_name},
            };
        };
        return config;
    }

    private hash<SshServerConfig> getAuthProviderConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.auth_provider = new SshServerAuthProvider::VirtualSshAuthProvider(
            <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
                "methods": ("none",),
                "none": <SshServerAuthProvider::VirtualSshStaticAuthMethodOptions>{
                    "success_decision": <SshServerAuthProvider::VirtualSshAuthDecisionTemplate>{
                        "principal": "provider:nobody",
                        "command_policy": {"mode": "command-only"},
                        "sftp_policy": {"mode": "disabled"},
                        "session_data": {"listener": "provider"},
                    },
                },
            });
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 0,
                "message": "auth-only-command-ok",
            };
        };
        return config;
    }

    private hash<SshServerConfig> getPublickeyAuthProviderConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].enabled_auth_methods = ("publickey",);
        config.auth_provider = new SshServerAuthProvider::VirtualSshAuthProvider(
            <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
                "methods": ("publickey",),
                "publickey": <SshServerAuthProvider::VirtualSshPublicKeyAuthOptions>{
                    "validator": hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
                        assertEq("publickey", ctx.auth_method);
                        assertEq("ssh-ed25519", ctx.public_key_type);
                        assertEq(NOTHING, ctx.password);
                        assertEq(True, ctx.public_key != NOTHING);
                        return <SshAuthDecision>{
                            "accepted": True,
                            "principal": sprintf("provider-publickey:%s", ctx.username),
                            "command_policy": {"mode": "command-only"},
                            "sftp_policy": {"mode": "disabled"},
                        };
                    },
                },
            });
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 0,
                "message": "auth-only-command-ok",
            };
        };
        return config;
    }

    private hash<SshServerConfig> getNoneAuthDisabledConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].enabled_auth_methods = ("password", "publickey");
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            throw "TEST-ERROR", "auth callback should not be reached when none auth is disabled";
        };
        return config;
    }

    private hash<SshServerConfig> getPublickeyDisabledConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].enabled_auth_methods = ("none", "password");
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            throw "TEST-ERROR", "auth callback should not be reached when publickey auth is disabled";
        };
        return config;
    }

    private hash<SshServerConfig> getCommandCallbackConfig() {
        hash<SshServerConfig> config = getAuthCallbackConfig();
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 23,
                "message": "handled",
                "stdout": binary(sprintf("stdout:%s\n", req.command)),
                "stderr": binary(sprintf("stderr:%s\n", req.command)),
                "result_data": {"request_type": req.metadata.request_type},
            };
        };
        return config;
    }

    private hash<SshServerConfig> getVirtualCommandCallbackConfig() {
        SshServerCommandProvider::VirtualSshCommandService service();
        service.addTextCommand("virtual-status", "virtual-out\n", "virtual-err\n", 29, True,
            {"provider": "virtual-command"}, "handled-virtual");

        hash<SshServerConfig> config = getAuthCallbackConfig();
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return service.handle(req);
        };
        return config;
    }

    private hash<SshServerConfig> getSubsystemCallbackConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            return <SshAuthDecision>{
                "accepted": True,
                "principal": sprintf("principal:%s", ctx.username),
                "command_policy": {
                    "mode": "command-and-subsystem",
                    "allowed_subsystems": ("qorus-test",),
                },
                "sftp_policy": {"mode": "disabled"},
            };
        };
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 37,
                "message": "handled-subsystem",
                "stdout": binary(sprintf("stdout:%s:%s\n", req.metadata.request_type, req.command)),
                "stderr": binary(sprintf("stderr:%s:%s\n", req.metadata.request_type, req.command)),
                "result_data": {
                    "request_type": req.metadata.request_type,
                    "subsystem": req.metadata.subsystem,
                },
            };
        };
        return config;
    }

    private hash<SshServerConfig> getListenerCommandDisabledConfig() {
        hash<SshServerConfig> config = getSubsystemCallbackConfig();
        config.listeners[0].allow_command_service = False;
        return config;
    }

    private hash<SshServerConfig> getListenerSftpDisabledConfig() {
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].allow_command_service = True;
        config.listeners[0].allow_sftp_service = False;
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            return <SshAuthDecision>{
                "accepted": True,
                "principal": sprintf("principal:%s", ctx.username),
                "command_policy": {
                    "mode": "command-and-subsystem",
                    "allowed_subsystems": ("sftp",),
                },
                "sftp_policy": {"mode": "enabled"},
            };
        };
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 41,
                "message": "handled-sftp-subsystem",
                "stdout": binary(sprintf("stdout:%s:%s\n", req.metadata.request_type, req.command)),
                "stderr": binary(sprintf("stderr:%s:%s\n", req.metadata.request_type, req.command)),
                "result_data": {
                    "request_type": req.metadata.request_type,
                    "subsystem": req.metadata.subsystem,
                },
            };
        };
        return config;
    }

    private hash<SshServerConfig> getSftpEnabledConfig() {
        TestSftpBackend backend("factory-backend");
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].allow_command_service = True;
        config.listeners[0].allow_sftp_service = True;
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            return <SshAuthDecision>{
                "accepted": True,
                "principal": sprintf("principal:%s", ctx.username),
                "command_policy": {"mode": "disabled"},
                "sftp_policy": {
                    "mode": "enabled",
                    "root_dir": "/tmp/module-ssh-sftp-root",
                },
                "session_data": {
                    "tenant": "test",
                    "source": "sftp",
                },
            };
        };
        config.sftp_factory_callback = hash<auto> sub(hash<Qore::Ssh::SftpSessionInfo> info) {
            return {
                "root_dir": sprintf("%s/%s", info.root_dir, info.principal),
                "read_only": True,
                "session_data": {
                    "tenant": info.session_data.tenant,
                    "source": info.session_data.source,
                    "factory": "applied",
                },
                "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                    "operation": "session-open",
                    "path": "/",
                    "atomic_publish": False,
                    "completed": False,
                },
                "backend": backend,
            };
        };
        return config;
    }

    private hash<SshServerConfig> getSftpEnabledConfigWithBackend(object backend) {
        hash<SshServerConfig> config = getSftpEnabledConfig();
        config.sftp_factory_callback = hash<auto> sub(hash<Qore::Ssh::SftpSessionInfo> info) {
            return {
                "root_dir": sprintf("%s/%s", info.root_dir, info.principal),
                "read_only": True,
                "session_data": {
                    "tenant": info.session_data.tenant,
                    "source": info.session_data.source,
                    "factory": "applied",
                },
                "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                    "operation": "session-open",
                    "path": "/",
                    "atomic_publish": False,
                    "completed": False,
                },
                "backend": backend,
            };
        };
        return config;
    }

    private hash<SshServerConfig> getSftpPathPolicyConfig(bool allow = True) {
        hash<SshServerConfig> config = getSftpEnabledConfig();
        config.sftp_factory_callback = hash<auto> sub(hash<Qore::Ssh::SftpSessionInfo> info) {
            return {
                "root_dir": sprintf("%s/%s", info.root_dir, info.principal),
                "read_only": False,
                "session_data": {
                    "tenant": info.session_data.tenant,
                    "source": info.session_data.source,
                    "factory": "applied",
                },
                "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                    "operation": "session-open",
                    "path": "/",
                    "atomic_publish": False,
                    "completed": False,
                },
            };
        };
        config.sftp_config = {
            "path_policy_callback": hash<Qore::Ssh::SftpTransferDecision> sub(hash<Qore::Ssh::SftpTransferRequest> req) {
                if (!allow) {
                    return <Qore::Ssh::SftpTransferDecision>{
                        "allowed": False,
                        "message": sprintf("transfer denied for %s", req.path),
                        "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                            "operation": req.operation,
                            "path": req.path,
                            "temporary_path": req.temporary_path,
                            "final_path": req.target_path,
                            "size": req.size,
                            "atomic_publish": False,
                            "completed": False,
                        },
                    };
                }

                return <Qore::Ssh::SftpTransferDecision>{
                    "allowed": True,
                    "message": "policy-applied",
                    "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                        "operation": req.operation,
                        "path": req.path,
                        "temporary_path": req.temporary_path,
                        "final_path": sprintf("/published%s", req.path),
                        "size": req.size,
                        "checksum": "policy-checksum",
                        "atomic_publish": True,
                        "completed": False,
                    },
                };
            },
        };
        return config;
    }

    private hash<SshServerConfig> getSftpMutableConfig() {
        hash<SshServerConfig> config = getSftpEnabledConfig();
        config.sftp_factory_callback = hash<auto> sub(hash<Qore::Ssh::SftpSessionInfo> info) {
            return {
                "root_dir": sprintf("%s/%s", info.root_dir, info.principal),
                "read_only": False,
                "session_data": {
                    "tenant": info.session_data.tenant,
                    "source": info.session_data.source,
                    "factory": "mutable",
                },
            };
        };
        return config;
    }

    private hash<SshServerConfig> getSftpAtomicPublishConfig() {
        hash<SshServerConfig> config = getSftpMutableConfig();
        config.sftp_config = {
            "atomic_publish_policy": {
                "enabled": True,
                "temporary_suffix": ".uploading",
                "publish_by_rename": True,
                "overwrite": False,
                "fsync_before_publish": True,
                "preserve_partial_on_error": True,
            },
        };
        return config;
    }

    private string makeSshClientCommand(int port) {
        return sprintf("/usr/bin/ssh"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=none"
            + " -o PubkeyAuthentication=no"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -p %d"
            + " nobody@127.0.0.1 true"
            + " >/dev/null 2>&1", port);
    }

    private string prepareClientPrivateKeyFile() {
        string path = getTmpFile(".client-key");
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write(File::readTextFile(get_script_dir() + "data/ssh_client_ed25519_key"));
        chmod(path, 0600);
        return path;
    }

    private string getTmpFile(string suffix) {
        return "/tmp/module-ssh-test-" + string(getpid()) + "-" + string(now_us()) + suffix;
    }

    private nothing cleanupFile(string path) {
        if (is_readable(path)) {
            unlink(path);
        }
    }

    private nothing writeTextFile(string path, string data) {
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write(data);
        f.close();
    }

    private string makeSshExecClientCommand(int port, string remote_command, string stdout_path, string stderr_path) {
        return sprintf("/usr/bin/ssh"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=none"
            + " -o PubkeyAuthentication=no"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -p %d"
            + " nobody@127.0.0.1 %s"
            + " >%s 2>%s", port, remote_command, stdout_path, stderr_path);
    }

    private string makeSshPublickeyClientCommand(int port, string private_key_path, string remote_command = "true") {
        return sprintf("/usr/bin/ssh"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=publickey"
            + " -o PubkeyAuthentication=yes"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o IdentitiesOnly=yes"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -i %s"
            + " -p %d"
            + " nobody@127.0.0.1 %s"
            + " >/dev/null 2>&1", private_key_path, port, remote_command);
    }

    private string makeSshSubsystemClientCommand(int port, string subsystem, string stdout_path, string stderr_path) {
        return sprintf("/usr/bin/ssh"
            + " -s"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=none"
            + " -o PubkeyAuthentication=no"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -p %d"
            + " nobody@127.0.0.1 %s"
            + " >%s 2>%s", port, subsystem, stdout_path, stderr_path);
    }

    private string makeSftpClientCommand(int port, string batch_path, string stdout_path, string stderr_path) {
        return sprintf("/usr/bin/sftp"
            + " -b %s"
            + " -o BatchMode=yes"
            + " -o PreferredAuthentications=none"
            + " -o PubkeyAuthentication=no"
            + " -o PasswordAuthentication=no"
            + " -o KbdInteractiveAuthentication=no"
            + " -o NumberOfPasswordPrompts=0"
            + " -o StrictHostKeyChecking=no"
            + " -o UserKnownHostsFile=/dev/null"
            + " -o LogLevel=ERROR"
            + " -o ConnectTimeout=5"
            + " -P %d"
            + " nobody@127.0.0.1"
            + " >%s 2>%s", batch_path, port, stdout_path, stderr_path);
    }

    testConstructor() {
        Qore::Ssh::SshServer server(getTestConfig());
        assertFalse(server.running());
    }

    testServerLogger() {
        TestLogger logger();
        hash<SshServerConfig> config = getTestConfig();
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        assertEq(logger, server.getLogger());
        server.setLogger(NOTHING);
        assertEq(NOTHING, server.getLogger());
        server.setLogger(logger);
        assertEq(logger, server.getLogger());
    }

    testInvalidConfig() {
        assertThrows("SSHSERVER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "",
                "listeners": (),
            };
            Qore::Ssh::SshServer server(config);
        });

        assertThrows("SSHSERVER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "no-listeners",
                "listeners": (),
            };
            Qore::Ssh::SshServer server(config);
        });

        assertThrows("SSHLISTENER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "bad-port",
                "listeners": (<SshListenerConfig>{
                    "name": "listener-1",
                    "bind_address": "127.0.0.1",
                    "port": -1,
                    "host_keys": (getHostKeyPath(),),
                },),
            };
            Qore::Ssh::SshServer server(config);
        });

        assertThrows("SSHLISTENER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "no-host-keys",
                "listeners": (<SshListenerConfig>{
                    "name": "listener-1",
                    "bind_address": "127.0.0.1",
                    "port": 2222,
                    "host_keys": (),
                },),
            };
            Qore::Ssh::SshServer server(config);
        });

        assertThrows("SSHLISTENER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "duplicate-listeners",
                "listeners": (
                    <SshListenerConfig>{
                        "name": "listener-1",
                        "bind_address": "127.0.0.1",
                        "port": 2222,
                        "host_keys": (getHostKeyPath(),),
                    },
                    <SshListenerConfig>{
                        "name": "listener-1",
                        "bind_address": "127.0.0.1",
                        "port": 2223,
                        "host_keys": (getHostKeyPath(),),
                    },
                ),
            };
            Qore::Ssh::SshServer server(config);
        });

        assertThrows("SSHLISTENER-CONFIG-ERROR", sub() {
            hash<SshServerConfig> config = <SshServerConfig>{
                "name": "negative-max-sessions",
                "listeners": (<SshListenerConfig>{
                    "name": "listener-1",
                    "bind_address": "127.0.0.1",
                    "port": 2222,
                    "host_keys": (getHostKeyPath(),),
                    "max_sessions": -1,
                },),
            };
            Qore::Ssh::SshServer server(config);
        });
    }

    testAcceptStoppedServer() {
        Qore::Ssh::SshServer server(getTestConfig());
        assertThrows("SSHSERVER-STATE-ERROR", sub() { server.acceptSessionInfo(1); });
    }

    testAcceptTimeout() {
        Qore::Ssh::SshServer server(getTestConfig());
        server.start();
        assertEq(NOTHING, server.acceptSessionInfo(50));
        server.stop();
    }

    testAcceptSessionInfo() {
        Qore::Ssh::SshServer server(getTestConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshClientCommand(port);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        hash<SshSessionInfo> info = server.acceptSessionInfo(5000);
        done.waitForZero(10s);
        server.stop();

        assertEq("test-server", info.server_name);
        assertEq("test-listener", info.listener_name);
        assertEq("127.0.0.1", info.local_address);
        assertEq(port, info.local_port);
        assertEq("127.0.0.1", info.remote_address);
        assertGt(0, info.remote_port);
        assertFalse(info.authenticated);
        assertEq(NOTHING, info.username);
        assertEq(NOTHING, info.auth_method);
        assertNeq(NOTHING, info.started);
        assertNeq(NOTHING, info.last_activity);
        assertNeq("", info.session_id);
        assertNeq(0, ssh_rc);
    }

    testAcceptSessionStoppedServer() {
        Qore::Ssh::SshServer server(getTestConfig());
        assertThrows("SSHSERVER-STATE-ERROR", sub() { server.acceptSession(1); });
    }

    testAcceptSessionTimeout() {
        Qore::Ssh::SshServer server(getTestConfig());
        server.start();
        assertEq(NOTHING, server.acceptSession(50));
        server.stop();
    }

    testAcceptSession() {
        Qore::Ssh::SshServer server(getTestConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshClientCommand(port);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshSessionInfo> info = session.getInfo();
        hash<SshServerStatus> running_status = server.getStatus();
        assertTrue(session.connected());
        assertEq(1, running_status.active_session_count);
        assertEq(1, running_status.listeners[0].active_session_count);
        session.disconnect();
        assertFalse(session.connected());
        hash<SshServerStatus> disconnected_status = server.getStatus();
        assertEq(0, disconnected_status.active_session_count);
        assertEq(0, disconnected_status.listeners[0].active_session_count);
        done.waitForZero(10s);
        server.stop();

        assertEq("test-server", info.server_name);
        assertEq("test-listener", info.listener_name);
        assertEq("127.0.0.1", info.remote_address);
        assertGt(0, info.remote_port);
        assertEq(NOTHING, info.username);
        assertFalse(info.authenticated);
        assertNeq(0, ssh_rc);
    }

    testAcceptSessionMaxSessions() {
        Qore::Ssh::SshServer server(getMaxSessionsConfig(1));
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc1 = 0;
        Counter done1(1);
        background sub() {
            try {
                ssh_rc1 = system(makeSshClientCommand(port));
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc1 = -1;
            }
            done1.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshServerStatus> running_status = server.getStatus();
        assertTrue(session.connected());
        assertEq(1, running_status.active_session_count);
        assertEq(1, running_status.listeners[0].active_session_count);

        int ssh_rc2 = 0;
        Counter done2(1);
        background sub() {
            try {
                ssh_rc2 = system(makeSshClientCommand(port));
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc2 = -1;
            }
            done2.dec();
        }();

        assertEq(NOTHING, server.acceptSessionInfo(1000));
        done2.waitForZero(10s);
        hash<SshServerStatus> rejected_status = server.getStatus();
        assertEq(1, rejected_status.active_session_count);
        assertEq(1, rejected_status.listeners[0].active_session_count);

        session.disconnect();
        done1.waitForZero(10s);
        hash<SshServerStatus> disconnected_status = server.getStatus();
        assertEq(0, disconnected_status.active_session_count);
        assertEq(0, disconnected_status.listeners[0].active_session_count);

        int ssh_rc3 = 0;
        Counter done3(1);
        background sub() {
            try {
                ssh_rc3 = system(makeSshClientCommand(port));
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc3 = -1;
            }
            done3.dec();
        }();

        hash<SshSessionInfo> info = server.acceptSessionInfo(5000);
        done3.waitForZero(10s);
        server.stop();

        assertEq("test-listener", info.listener_name);
        assertNeq("", info.session_id);
        assertNeq(0, ssh_rc1);
        assertNeq(0, ssh_rc2);
        assertNeq(0, ssh_rc3);
    }

    testWaitAuthContextReject() {
        Qore::Ssh::SshServer server(getTestConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshClientCommand(port);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        Qore::Ssh::SshAuthContext auth = session.waitAuthContext(5000);
        hash<SshAuthContextInfo> info = auth.getInfo();
        assertEq("nobody", info.username);
        assertEq("none", info.auth_method);
        assertEq("ssh-userauth", info.service);
        auth.reject(("password", "publickey"));
        assertThrows("SSHAUTHCONTEXT-STATE-ERROR", sub() { auth.reject(("password",)); });
        done.waitForZero(10s);
        session.disconnect();
        server.stop();
    }

