        writeTextFile(batch_path, sprintf("get /streamed.txt %s\nput %s /stream-submit.txt\nquit\n",
            target_path, source_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TypedTestSftpBackend backend = sftp.getBackend();
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        service_done.waitForZero(5s);
        if (sftp.connected()) {
            sftp.close();
        }
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        string target_data = is_file(target_path) ? ReadOnlyFile::readTextFile(target_path) : "";
        session.disconnect();
        server.stop();

        bool saw_read = False;
        bool saw_close_read = False;
        bool saw_write = False;
        bool saw_close_write = False;
        for (int i = 0; i < backend.impl.calls.size(); ++i) {
            if (backend.impl.calls[i].method == "read" && backend.impl.calls[i].path == "/streamed.txt") {
                saw_read = True;
            } else if (backend.impl.calls[i].method == "closeRead" && backend.impl.calls[i].path == "/streamed.txt") {
                saw_close_read = True;
            } else if (backend.impl.calls[i].method == "write" && backend.impl.calls[i].path == "/stream-submit.txt") {
                saw_write = True;
            } else if (backend.impl.calls[i].method == "closeWrite" && backend.impl.calls[i].path == "/stream-submit.txt") {
                saw_close_write = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertEq("", stderr_data);
        assertEq("streamed virtual payload\n", target_data);
        assertTrue(saw_read);
        assertTrue(saw_close_read);
        assertTrue(saw_write);
        assertTrue(saw_close_write);
        assertEq(binary("typed streamed upload\n"), backend.impl.files{"/stream-submit.txt"});
    }

