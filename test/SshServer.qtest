        assertEq("/inbound/tenant-nobody/routed.dat", observer.events[0].path);
        assertEq("principal:nobody", observer.events[0].principal);
        assertEq("test-server", observer.events[0].server_name);
        assertEq("test-listener", observer.events[0].listener_name);
        assertEq("sftp", observer.events[0].source);
    }

    testSftpPrincipalScopedSharedRootQuotas() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "principal_policies": (
                    <SftpServerDataProvider::VirtualSftpPrincipalPolicy>{
                        "principal": "principal:nobody",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_file_count": 1,
                        },
                    },
                    <SftpServerDataProvider::VirtualSftpPrincipalPolicy>{
                        "principal": "principal:other",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_file_count": 1,
                        },
                    },
                ),
            },
        });
        hash<Qore::Ssh::SftpSessionInfo> other_info = <Qore::Ssh::SftpSessionInfo>{
            "session_info": <Qore::Ssh::SshSessionInfo>{
                "session_id": "helper-other",
                "server_name": "helper-server",
                "listener_name": "helper-listener",
                "remote_address": "127.0.0.1",
                "remote_port": 22,
                "local_address": "127.0.0.1",
                "local_port": 2222,
                "username": "other",
                "authenticated": True,
                "auth_method": "none",
                "principal": "principal:other",
                "started": now(),
                "last_activity": now(),
            },
            "principal": "principal:other",
            "root_dir": "/virtual",
            "read_only": False,
            "session_data": {},
        };
        hash<SftpServerDataProvider::VirtualSftpOperationResult> seeded_result
            = exchange.submit(<SftpServerDataProvider::VirtualSftpSubmissionRequest>{
                "path": "/inbound/other/seed.dat",
                "data": binary("seed\n"),
                "session_info": other_info,
            });
        assertTrue(seeded_result.completed);

        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver rejected_observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            rejected_observer, SftpServerDataProvider::EventInboundFileRejected);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string ok_batch_path = getTmpFile(".sftp-principal-quota-ok.batch");
        string ok_stdout_path = getTmpFile(".sftp-principal-quota-ok.out");
        string ok_stderr_path = getTmpFile(".sftp-principal-quota-ok.err");
        string ok_source_path = getTmpFile(".sftp-principal-quota-ok.source");
        string reject_batch_path = getTmpFile(".sftp-principal-quota-reject.batch");
        string reject_stdout_path = getTmpFile(".sftp-principal-quota-reject.out");
        string reject_stderr_path = getTmpFile(".sftp-principal-quota-reject.err");
        string reject_source_path = getTmpFile(".sftp-principal-quota-reject.source");

        on_exit {
            cleanupFile(ok_batch_path);
            cleanupFile(ok_stdout_path);
            cleanupFile(ok_stderr_path);
            cleanupFile(ok_source_path);
            cleanupFile(reject_batch_path);
            cleanupFile(reject_stdout_path);
            cleanupFile(reject_stderr_path);
            cleanupFile(reject_source_path);
        }

        writeTextFile(ok_source_path, "first\n");
        writeTextFile(reject_source_path, "second\n");
        writeTextFile(ok_batch_path, sprintf("put %s /inbound/nobody/first.dat\nquit\n", ok_source_path));
        writeTextFile(reject_batch_path, sprintf("put %s /inbound/nobody/second.dat\nquit\n", reject_source_path));
        int ok_sftp_rc = 0;
        int reject_sftp_rc = 0;

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, ok_batch_path, ok_stdout_path, ok_stderr_path);
            background sub() {
                try {
                    ok_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    ok_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, ok_sftp_rc);
        }

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, reject_batch_path, reject_stdout_path, reject_stderr_path);
            background sub() {
                try {
                    reject_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    reject_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, reject_sftp_rc);
        }
        server.stop();

        assertEq("seed\n", exchange.getFilesystem().getFileText("/inbound/other/seed.dat"));
        assertEq("first\n", exchange.getFilesystem().getFileText("/inbound/nobody/first.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/nobody/second.dat"));
        assertEq(1, rejected_observer.events.size());
        assertEq(SftpServerDataProvider::InboundRejectMaxFileCount, rejected_observer.events[0].reason_code);
        assertEq("/inbound/nobody/second.dat", rejected_observer.events[0].path);
        assertEq("principal:nobody", rejected_observer.events[0].principal);
    }

    testSftpInboundRetentionCleanup() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_retention_policy": <SftpServerDataProvider::VirtualSftpRetentionPolicy>{
                "max_age_seconds": 10,
            },
        });

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-retention.batch");
        string stdout_path = getTmpFile(".sftp-retention.out");
        string stderr_path = getTmpFile(".sftp-retention.err");
        string source_path = getTmpFile(".sftp-retention.source");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
        }

        writeTextFile(source_path, "retained\n");
        writeTextFile(batch_path, sprintf("put %s /inbound/tenant/retained.dat\nquit\n", source_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        sftp.close();
        service_done.waitForZero(5s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        hash<Qore::Ssh::SftpPathInfo> retained_stat = exchange.stat(<Qore::Ssh::SftpPathRequest>{
            "path": "/inbound/tenant/retained.dat",
        });
        assertEq(SftpServerDataProvider::RetentionQueueInbound, retained_stat.metadata.retention_queue);
        assertEq(retained_stat.metadata.retained_at + 10, retained_stat.metadata.expires_at);

        hash<SftpServerDataProvider::VirtualSftpRetentionCleanupResult> cleanup_result
            = exchange.cleanupExpired(SftpServerDataProvider::RetentionQueueInbound, retained_stat.metadata.expires_at, True);
        assertEq(1, cleanup_result.removed_count);
        assertEq(("/inbound/tenant/retained.dat",), cleanup_result.removed_paths);
        assertTrue(inlist("/inbound/tenant", cleanup_result.removed_directories));
        assertFalse(exchange.getFilesystem().exists("/inbound/tenant/retained.dat"));
    }

    testSftpInboundDuplicateNamePolicy() {
