    testDispatchCommandSession() {
        Qore::Ssh::SshServer server(getCommandCallbackConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".out");
        string stderr_path = getTmpFile(".err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshExecClientCommand(port, "phase3-command", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        hash<SshCommandResult> result = server.dispatchCommandSession(session, 15000);
        done.waitForZero(10s);
        string stdout_data = File::readTextFile(stdout_path);
        string stderr_data = File::readTextFile(stderr_path);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertTrue(result.accepted);
        assertEq(23, result.exit_status);
        assertEq("exec", result.result_data.request_type);
        assertEq("stdout:phase3-command\n", stdout_data);
        assertEq("stderr:phase3-command\n", stderr_data);
        assertEq(23, ssh_rc);
    }

