                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, reject_sftp_rc);
        }
        server.stop();

        assertEq(1, accepted_observer.events.size());
        assertEq("/inbound/ok.zip", accepted_observer.events[0].path);
        assertEq(1, rejected_observer.events.size());
        assertEq(SftpServerDataProvider::InboundRejectContentPrefix, rejected_observer.events[0].reason_code);
        assertEq("/inbound/rejected.exe", rejected_observer.events[0].path);
        assertEq("PKzip-data\n", exchange.getFilesystem().getFileText("/inbound/ok.zip"));
        assertFalse(exchange.getFilesystem().exists("/inbound/rejected.exe"));
    }

    testSftpInboundValidationCallbackEvents() {
        list<hash<auto>> requests = ();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "validation_callback": hash<SftpServerDataProvider::VirtualSftpInboundValidationResult>
                        sub(hash<SftpServerDataProvider::VirtualSftpInboundValidationRequest> req) {
                    requests += (req,);
                    return <SftpServerDataProvider::VirtualSftpInboundValidationResult>{
                        "accepted": req.data.toString("UTF-8").find("ALLOW") >= 0,
                        "reason_code": "live-validation-failed",
                        "reason_desc": sprintf("live validator rejected %y", req.name),
                    };
                },
            },
        });
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver accepted_observer();
        EventObserver rejected_observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            accepted_observer, SftpServerDataProvider::EventInboundFileAccepted);
        cast<DataProvider::Observable>(event_provider).registerObserver(
            rejected_observer, SftpServerDataProvider::EventInboundFileRejected);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string ok_batch_path = getTmpFile(".sftp-validation-ok.batch");
        string ok_stdout_path = getTmpFile(".sftp-validation-ok.out");
        string ok_stderr_path = getTmpFile(".sftp-validation-ok.err");
        string ok_source_path = getTmpFile(".sftp-validation-ok.source");
        string reject_batch_path = getTmpFile(".sftp-validation-reject.batch");
        string reject_stdout_path = getTmpFile(".sftp-validation-reject.out");
        string reject_stderr_path = getTmpFile(".sftp-validation-reject.err");
        string reject_source_path = getTmpFile(".sftp-validation-reject.source");

        on_exit {
            cleanupFile(ok_batch_path);
            cleanupFile(ok_stdout_path);
            cleanupFile(ok_stderr_path);
            cleanupFile(ok_source_path);
            cleanupFile(reject_batch_path);
            cleanupFile(reject_stdout_path);
            cleanupFile(reject_stderr_path);
            cleanupFile(reject_source_path);
        }

        writeTextFile(ok_source_path, "ALLOW live\n");
        writeTextFile(reject_source_path, "REJECT live\n");
        writeTextFile(ok_batch_path, sprintf("put %s /inbound/ok.dat\nquit\n", ok_source_path));
        writeTextFile(reject_batch_path, sprintf("put %s /inbound/rejected.dat\nquit\n", reject_source_path));
        int ok_sftp_rc = 0;
        int reject_sftp_rc = 0;

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, ok_batch_path, ok_stdout_path, ok_stderr_path);
            background sub() {
                try {
                    ok_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    ok_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, ok_sftp_rc);
        }

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, reject_batch_path, reject_stdout_path, reject_stderr_path);
            background sub() {
                try {
                    reject_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    reject_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, reject_sftp_rc);
        }
        server.stop();

        assertEq(2, requests.size());
        assertEq("/inbound/ok.dat", requests[0].path);
        assertEq("ALLOW live\n", requests[0].data.toString("UTF-8"));
        assertEq("/inbound/rejected.dat", requests[1].path);
        assertEq("REJECT live\n", requests[1].data.toString("UTF-8"));
        assertEq(1, accepted_observer.events.size());
        assertEq("/inbound/ok.dat", accepted_observer.events[0].path);
        assertEq(1, rejected_observer.events.size());
        assertEq("live-validation-failed", rejected_observer.events[0].reason_code);
        assertEq("/inbound/rejected.dat", rejected_observer.events[0].path);
        assertEq("ALLOW live\n", exchange.getFilesystem().getFileText("/inbound/ok.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/rejected.dat"));
    }

    testSftpOutboundCompletionEventProviders() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claim",
        });
        exchange.addOutboundText("archive.txt", "archive\n", {
            "checksum": "archive-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        exchange.addOutboundText("claim.txt", "claim\n", {
            "checksum": "claim-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        exchange.addOutboundText("delete.txt", "delete\n", {
            "checksum": "delete-checksum",
            "checksum_algorithm": SftpServerDataProvider::ChecksumAlgorithmSha256,
        });
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        EventObserver archive_observer();
        EventObserver claim_observer();
        EventObserver delete_observer();
        AbstractDataProvider archive_provider = provider.getChildProviderEx(SftpServerDataProvider::EventOutboundFileArchived);
        AbstractDataProvider claim_provider = provider.getChildProviderEx(SftpServerDataProvider::EventOutboundFileClaimed);
        AbstractDataProvider delete_provider = provider.getChildProviderEx(SftpServerDataProvider::EventOutboundFileDeleted);
        cast<DataProvider::Observable>(archive_provider).registerObserver(
            archive_observer, SftpServerDataProvider::EventOutboundFileArchived);
        cast<DataProvider::Observable>(claim_provider).registerObserver(
            claim_observer, SftpServerDataProvider::EventOutboundFileClaimed);
        cast<DataProvider::Observable>(delete_provider).registerObserver(
            delete_observer, SftpServerDataProvider::EventOutboundFileDeleted);
        cast<DataProvider::DelayedObservable>(archive_provider).observersReady();
        cast<DataProvider::DelayedObservable>(claim_provider).observersReady();
        cast<DataProvider::DelayedObservable>(delete_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-outbound-events.batch");
        string stdout_path = getTmpFile(".sftp-outbound-events.out");
        string stderr_path = getTmpFile(".sftp-outbound-events.err");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        writeTextFile(batch_path, "pwd\nquit\n");
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        hash<Qore::Ssh::SftpOperationResult> archive_result = sftp.completeRetrieveArchive("archive.txt");
        hash<Qore::Ssh::SftpOperationResult> claim_result = sftp.completeRetrieveClaim("claim.txt");
        hash<Qore::Ssh::SftpOperationResult> delete_result = sftp.completeRetrieveDelete("delete.txt");

        done.waitForZero(10s);
        sftp.close();
        service_done.waitForZero(5s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertTrue(archive_result.completed);
        assertTrue(claim_result.completed);
        assertTrue(delete_result.completed);

        assertEq(1, archive_observer.events.size());
        assertEq(SftpServerDataProvider::EventOutboundFileArchived, archive_observer.events[0].event_id);
        assertEq("archive.txt", archive_observer.events[0].name);
        assertEq("/archive/archive.txt", archive_observer.events[0].path);
        assertEq("archive.txt", archive_observer.events[0].final_name);
        assertEq("principal:nobody", archive_observer.events[0].principal);
        assertEq("test-server", archive_observer.events[0].server_name);
        assertEq("test-listener", archive_observer.events[0].listener_name);
        assertEq("sftp", archive_observer.events[0].source);
        assertEq("archive-checksum", archive_observer.events[0].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, archive_observer.events[0].checksum_algorithm);

        assertEq(1, claim_observer.events.size());
        assertEq(SftpServerDataProvider::EventOutboundFileClaimed, claim_observer.events[0].event_id);
        assertEq("claim.txt", claim_observer.events[0].name);
        assertEq("/claim/claim.txt", claim_observer.events[0].path);
        assertEq("claim.txt", claim_observer.events[0].final_name);
        assertEq("principal:nobody", claim_observer.events[0].principal);
        assertEq("sftp", claim_observer.events[0].source);
        assertEq("claim-checksum", claim_observer.events[0].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, claim_observer.events[0].checksum_algorithm);

        assertEq(1, delete_observer.events.size());
        assertEq(SftpServerDataProvider::EventOutboundFileDeleted, delete_observer.events[0].event_id);
        assertEq("delete.txt", delete_observer.events[0].name);
        assertEq("/outbound/delete.txt", delete_observer.events[0].path);
        assertEq("delete", delete_observer.events[0].operation);
        assertEq("principal:nobody", delete_observer.events[0].principal);
        assertEq("sftp", delete_observer.events[0].source);
        assertEq("delete-checksum", delete_observer.events[0].checksum);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, delete_observer.events[0].checksum_algorithm);
    }

    testSftpAtomicExchangeHelpersWithVirtualExchange() {
        TestLogger logger();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "archive_dir": "/archive",
            "claim_dir": "/claimed",
            "logger": logger,
        });
        exchange.addOutboundText("ready.txt", "ready\n", {"kind": "ready"});
        exchange.addOutboundText("archive.txt", "archive\n", {"kind": "archive"});
        exchange.addOutboundText("claim.txt", "claim\n", {"kind": "claim"});
        exchange.addOutboundText("delete.txt", "delete\n", {"kind": "delete"});

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-virtual-exchange.out");
        string stderr_path = getTmpFile(".sftp-virtual-exchange.err");
        string target_path = getTmpFile(".sftp-virtual-exchange.target");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(target_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);

        hash<Qore::Ssh::SftpListResult> initial_listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/"});
        binary ready_data = sftp.retrieveData("ready.txt");
        hash<Qore::Ssh::SftpOperationResult> archive_result = sftp.completeRetrieveArchive("archive.txt");
        hash<Qore::Ssh::SftpOperationResult> claim_result = sftp.completeRetrieveClaim("claim.txt");
        hash<Qore::Ssh::SftpOperationResult> delete_result = sftp.retrieveToLocalFile("delete.txt", target_path, "delete");
        hash<Qore::Ssh::SftpListResult> final_listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/"});

        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        bool saw_ready = False;
        bool saw_archive = False;
        bool saw_claim = False;
        bool saw_delete = False;
        for (int i = 0; i < initial_listing.entries.size(); ++i) {
            if (initial_listing.entries[i].filename == "ready.txt") {
                saw_ready = True;
            } else if (initial_listing.entries[i].filename == "archive.txt") {
                saw_archive = True;
            } else if (initial_listing.entries[i].filename == "claim.txt") {
                saw_claim = True;
            } else if (initial_listing.entries[i].filename == "delete.txt") {
                saw_delete = True;
            }
        }

        bool saw_final_archive = False;
        bool saw_final_claim = False;
        bool saw_final_ready = False;
        bool saw_final_delete = False;
        for (int i = 0; i < final_listing.entries.size(); ++i) {
            if (final_listing.entries[i].filename == "archive.txt") {
                saw_final_archive = True;
            } else if (final_listing.entries[i].filename == "claim.txt") {
                saw_final_claim = True;
            } else if (final_listing.entries[i].filename == "ready.txt") {
                saw_final_ready = True;
            } else if (final_listing.entries[i].filename == "delete.txt") {
                saw_final_delete = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq(binary("ready\n"), ready_data);
        assertTrue(archive_result.completed);
        assertTrue(claim_result.completed);
        assertTrue(delete_result.completed);
        assertEq("/archive/archive.txt", archive_result.path);
        assertEq("/claimed/claim.txt", claim_result.path);
        assertEq("delete\n", ReadOnlyFile::readTextFile(target_path));
        assertTrue(saw_ready);
        assertTrue(saw_archive);
        assertTrue(saw_claim);
        assertTrue(saw_delete);
        assertTrue(saw_final_ready);
        assertFalse(saw_final_archive);
        assertFalse(saw_final_claim);
        assertFalse(saw_final_delete);
        assertEq("archive\n", exchange.getFilesystem().getFileText("/archive/archive.txt"));
        assertEq("claim\n", exchange.getFilesystem().getFileText("/claimed/claim.txt"));
        assertEq("ready\n", exchange.getOutboundData("ready.txt").toString("UTF-8"));
        assertEq(NOTHING, exchange.getFilesystem().exportSnapshot("/outbound").files{"/outbound/archive.txt"});
        assertEq(NOTHING, exchange.getFilesystem().exportSnapshot("/outbound").files{"/outbound/claim.txt"});
        assertEq(NOTHING, exchange.getFilesystem().exportSnapshot("/outbound").files{"/outbound/delete.txt"});
        assertNeq(0, ssh_rc);

        bool saw_dispatch_log = False;
        bool saw_retrieve_log = False;
        bool saw_archive_complete_log = False;
        bool saw_claim_complete_log = False;
        bool saw_delete_complete_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer dispatchSftpSession") >= 0) {
                saw_dispatch_log = True;
            } else if (logger.events[i].message.find("SftpSession retrieve path=") >= 0
                    && logger.events[i].message.find("ready.txt") >= 0) {
                saw_retrieve_log = True;
            } else if (logger.events[i].message.find("SftpSession completeRetrieve path=") >= 0
                    && logger.events[i].message.find("archive.txt") >= 0
                    && logger.events[i].message.find("completion_mode=archive") >= 0) {
                saw_archive_complete_log = True;
            } else if (logger.events[i].message.find("SftpSession completeRetrieve path=") >= 0
                    && logger.events[i].message.find("claim.txt") >= 0
                    && logger.events[i].message.find("completion_mode=claim") >= 0) {
                saw_claim_complete_log = True;
            } else if (logger.events[i].message.find("SftpSession completeRetrieve path=") >= 0
                    && logger.events[i].message.find("delete.txt") >= 0
                    && logger.events[i].message.find("completion_mode=delete") >= 0) {
                saw_delete_complete_log = True;
            }
        }
        assertTrue(saw_dispatch_log);
        assertTrue(saw_retrieve_log);
        assertTrue(saw_archive_complete_log);
        assertTrue(saw_claim_complete_log);
        assertTrue(saw_delete_complete_log);
    }

    testEvaluateSftpTransferRequest() {
        Qore::Ssh::SshServer server(getSftpPathPolicyConfig(True));
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-policy.out");
        string stderr_path = getTmpFile(".sftp-policy.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        hash<Qore::Ssh::SftpTransferDecision> decision = server.evaluateSftpTransferRequest(sftp,
            <Qore::Ssh::SftpTransferRequest>{
                "session_info": sftp.getInfo(),
                "operation": "upload",
                "path": "/incoming/file.dat",
                "target_path": "/target/file.dat",
                "temporary_path": "/incoming/.file.dat.part",
                "size": 99,
                "metadata": {"scenario": "allow"},
            });
        hash<Qore::Ssh::SftpTransferInfo> transfer_info = sftp.getTransferInfo();
        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertTrue(decision.allowed);
        assertEq("policy-applied", decision.message);
        assertEq("/published/incoming/file.dat", decision.transfer_info.final_path);
        assertEq("policy-checksum", decision.transfer_info.checksum);
        assertTrue(decision.transfer_info.atomic_publish);
        assertEq("/published/incoming/file.dat", transfer_info.final_path);
        assertEq("policy-checksum", transfer_info.checksum);
        assertTrue(transfer_info.atomic_publish);
        assertFalse(transfer_info.completed);
        assertNeq(0, ssh_rc);
    }

    testEvaluateSftpTransferRequestDenied() {
        TestLogger logger();
        hash<SshServerConfig> config = getSftpPathPolicyConfig(False);
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-policy-deny.out");
        string stderr_path = getTmpFile(".sftp-policy-deny.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        hash<Qore::Ssh::SftpTransferDecision> decision = server.evaluateSftpTransferRequest(sftp,
            <Qore::Ssh::SftpTransferRequest>{
                "session_info": sftp.getInfo(),
                "operation": "download",
                "path": "/restricted/file.dat",
                "size": 11,
                "metadata": {"scenario": "deny"},
            });
        *hash<Qore::Ssh::SftpTransferInfo> transfer_info = sftp.getTransferInfo();
        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertFalse(decision.allowed);
        assertEq("transfer denied for /restricted/file.dat", decision.message);
        assertEq(NOTHING, transfer_info);
        assertNeq(0, ssh_rc);
        bool saw_denied_transfer_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer evaluateSftpTransferRequest path=/restricted/file.dat allowed=false")
                    >= 0) {
                saw_denied_transfer_log = True;
                break;
            }
        }
        assertTrue(saw_denied_transfer_log);
    }

