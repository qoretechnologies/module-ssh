        assertEq(SftpServerDataProvider::InboundRejectDuplicateName, observer.events[0].reason_code);
        assertEq("/inbound/rejected.dat", observer.events[0].path);
        assertEq("sftp", observer.events[0].source);
        assertEq("existing\n", exchange.getFilesystem().getFileText("/inbound/existing/rejected.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/rejected.dat"));
    }

    testSftpInboundDuplicateContentPolicies() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "reject_duplicate_size": True,
                "reject_duplicate_hash": True,
            },
        });
        exchange.getFilesystem().addTextFile("/inbound/existing-size.dat", "alpha\n");
        exchange.getFilesystem().addTextFile("/inbound/existing-hash.dat", "same-content\n");
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            observer, SftpServerDataProvider::EventInboundFileRejected);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string size_batch_path = getTmpFile(".sftp-duplicate-size.batch");
        string size_stdout_path = getTmpFile(".sftp-duplicate-size.out");
        string size_stderr_path = getTmpFile(".sftp-duplicate-size.err");
        string size_source_path = getTmpFile(".sftp-duplicate-size.source");
        string hash_batch_path = getTmpFile(".sftp-duplicate-hash.batch");
        string hash_stdout_path = getTmpFile(".sftp-duplicate-hash.out");
        string hash_stderr_path = getTmpFile(".sftp-duplicate-hash.err");
        string hash_source_path = getTmpFile(".sftp-duplicate-hash.source");

        on_exit {
            cleanupFile(size_batch_path);
            cleanupFile(size_stdout_path);
            cleanupFile(size_stderr_path);
            cleanupFile(size_source_path);
            cleanupFile(hash_batch_path);
            cleanupFile(hash_stdout_path);
            cleanupFile(hash_stderr_path);
            cleanupFile(hash_source_path);
        }

        writeTextFile(size_source_path, "omega\n");
        writeTextFile(hash_source_path, "same-content\n");
        writeTextFile(size_batch_path, sprintf("put %s /inbound/new-size.dat\nquit\n", size_source_path));
        writeTextFile(hash_batch_path, sprintf("put %s /inbound/new-hash.dat\nquit\n", hash_source_path));
        int size_sftp_rc = 0;
        int hash_sftp_rc = 0;
        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, size_batch_path, size_stdout_path, size_stderr_path);
            background sub() {
                try {
                    size_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    size_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, size_sftp_rc);
        }

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, hash_batch_path, hash_stdout_path, hash_stderr_path);
            background sub() {
                try {
                    hash_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    hash_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, hash_sftp_rc);
        }
        server.stop();

        assertEq(2, observer.events.size());
        assertEq(SftpServerDataProvider::InboundRejectDuplicateSize, observer.events[0].reason_code);
        assertEq("/inbound/new-size.dat", observer.events[0].path);
        assertEq(SftpServerDataProvider::InboundRejectDuplicateHash, observer.events[1].reason_code);
        assertEq("/inbound/new-hash.dat", observer.events[1].path);
        assertFalse(exchange.getFilesystem().exists("/inbound/new-size.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/new-hash.dat"));
        assertEq("alpha\n", exchange.getFilesystem().getFileText("/inbound/existing-size.dat"));
        assertEq("same-content\n", exchange.getFilesystem().getFileText("/inbound/existing-hash.dat"));
    }

    testSftpInboundQuotaPolicies() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_file_count": 2,
                "max_total_bytes": 12,
            },
        });
        exchange.getFilesystem().addTextFile("/inbound/existing-count.dat", "one\n");
        exchange.getFilesystem().addTextFile("/inbound/existing-bytes.dat", "four\n");
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            observer, SftpServerDataProvider::EventInboundFileRejected);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string count_batch_path = getTmpFile(".sftp-quota-count.batch");
        string count_stdout_path = getTmpFile(".sftp-quota-count.out");
        string count_stderr_path = getTmpFile(".sftp-quota-count.err");
        string count_source_path = getTmpFile(".sftp-quota-count.source");
        string bytes_batch_path = getTmpFile(".sftp-quota-bytes.batch");
        string bytes_stdout_path = getTmpFile(".sftp-quota-bytes.out");
        string bytes_stderr_path = getTmpFile(".sftp-quota-bytes.err");
        string bytes_source_path = getTmpFile(".sftp-quota-bytes.source");

        on_exit {
            cleanupFile(count_batch_path);
            cleanupFile(count_stdout_path);
            cleanupFile(count_stderr_path);
            cleanupFile(count_source_path);
            cleanupFile(bytes_batch_path);
            cleanupFile(bytes_stdout_path);
            cleanupFile(bytes_stderr_path);
            cleanupFile(bytes_source_path);
        }

        writeTextFile(count_source_path, "x\n");
        writeTextFile(bytes_source_path, "0123456789\n");
        writeTextFile(count_batch_path, sprintf("put %s /inbound/count-reject.dat\nquit\n", count_source_path));
        writeTextFile(bytes_batch_path, sprintf("put %s /inbound/existing-bytes.dat\nquit\n", bytes_source_path));
        int count_sftp_rc = 0;
        int bytes_sftp_rc = 0;

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, count_batch_path, count_stdout_path, count_stderr_path);
            background sub() {
                try {
                    count_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    count_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, count_sftp_rc);
        }

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, bytes_batch_path, bytes_stdout_path, bytes_stderr_path);
            background sub() {
                try {
                    bytes_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    bytes_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, bytes_sftp_rc);
        }
        server.stop();

        assertEq(2, observer.events.size());
        assertEq(SftpServerDataProvider::InboundRejectMaxFileCount, observer.events[0].reason_code);
        assertEq("/inbound/count-reject.dat", observer.events[0].path);
        assertEq(SftpServerDataProvider::InboundRejectMaxTotalBytes, observer.events[1].reason_code);
        assertEq("/inbound/existing-bytes.dat", observer.events[1].path);
        assertFalse(exchange.getFilesystem().exists("/inbound/count-reject.dat"));
        assertEq("four\n", exchange.getFilesystem().getFileText("/inbound/existing-bytes.dat"));
    }

    testSftpInboundDirectoryPoliciesAndChecksums() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "generate_inbound_checksum": True,
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "max_size": 16,
                "directory_policies": (
                    <SftpServerDataProvider::VirtualSftpInboundDirectoryPolicy>{
                        "subdir": "strict",
                        "policy": <SftpServerDataProvider::VirtualSftpInboundPolicyRule>{
                            "max_size": 4,
                        },
                    },
                ),
            },
        });
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver accepted_observer();
        EventObserver rejected_observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            accepted_observer, SftpServerDataProvider::EventInboundFileAccepted);
        cast<DataProvider::Observable>(event_provider).registerObserver(
            rejected_observer, SftpServerDataProvider::EventInboundFileRejected);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string ok_batch_path = getTmpFile(".sftp-dir-policy-ok.batch");
        string ok_stdout_path = getTmpFile(".sftp-dir-policy-ok.out");
        string ok_stderr_path = getTmpFile(".sftp-dir-policy-ok.err");
        string ok_source_path = getTmpFile(".sftp-dir-policy-ok.source");
        string reject_batch_path = getTmpFile(".sftp-dir-policy-reject.batch");
        string reject_stdout_path = getTmpFile(".sftp-dir-policy-reject.out");
        string reject_stderr_path = getTmpFile(".sftp-dir-policy-reject.err");
        string reject_source_path = getTmpFile(".sftp-dir-policy-reject.source");

        on_exit {
            cleanupFile(ok_batch_path);
            cleanupFile(ok_stdout_path);
            cleanupFile(ok_stderr_path);
            cleanupFile(ok_source_path);
            cleanupFile(reject_batch_path);
            cleanupFile(reject_stdout_path);
            cleanupFile(reject_stderr_path);
            cleanupFile(reject_source_path);
        }

        writeTextFile(ok_source_path, "ok\n");
        writeTextFile(reject_source_path, "oversized\n");
        writeTextFile(ok_batch_path, sprintf("put %s /inbound/strict/ok.dat\nquit\n", ok_source_path));
        writeTextFile(reject_batch_path, sprintf("put %s /inbound/strict/rejected.dat\nquit\n", reject_source_path));
        int ok_sftp_rc = 0;
        int reject_sftp_rc = 0;

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, ok_batch_path, ok_stdout_path, ok_stderr_path);
            background sub() {
                try {
                    ok_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    ok_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, ok_sftp_rc);
        }

        {
            Counter done(1);
            string cmd = makeSftpClientCommand(port, reject_batch_path, reject_stdout_path, reject_stderr_path);
            background sub() {
                try {
                    reject_sftp_rc = system(cmd);
                } catch (hash<ExceptionInfo> ex) {
                    reject_sftp_rc = -1;
                }
                done.dec();
            }();

            Qore::Ssh::SshSession session = server.acceptSession(5000);
            hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
            Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
            Counter service_done(1);
            background sub() {
                try {
                    while (True) {
                        auto msg = sftp.processNextRequest(15000);
                        if (msg == NOTHING) {
                            break;
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "SFTPSESSION-STATE-ERROR") {
                        throw ex;
                    }
                }
                service_done.dec();
            }();

            done.waitForZero(10s);
            sftp.close();
            service_done.waitForZero(5s);
            session.disconnect();
            assertTrue(auth_decision.accepted);
            assertEq(0, reject_sftp_rc);
        }
        server.stop();

        assertEq(1, accepted_observer.events.size());
        assertEq("/inbound/strict/ok.dat", accepted_observer.events[0].path);
        assertEq(SftpServerDataProvider::ChecksumAlgorithmSha256, accepted_observer.events[0].checksum_algorithm);
        assertTrue(accepted_observer.events[0].checksum.size() > 0);
        assertEq(1, rejected_observer.events.size());
        assertEq(SftpServerDataProvider::InboundRejectMaxSize, rejected_observer.events[0].reason_code);
        assertEq("/inbound/strict/rejected.dat", rejected_observer.events[0].path);
        assertEq("ok\n", exchange.getFilesystem().getFileText("/inbound/strict/ok.dat"));
        assertFalse(exchange.getFilesystem().exists("/inbound/strict/rejected.dat"));
    }

    testSftpInboundContentPolicyEvents() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
