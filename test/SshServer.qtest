    testSftpProtocolPutVirtualFile() {
        Qore::Ssh::SshServer server(getSftpEnabledConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-put.batch");
        string stdout_path = getTmpFile(".sftp-put.out");
        string stderr_path = getTmpFile(".sftp-put.err");
        string source_path = getTmpFile(".sftp-put.source");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
        }

        writeTextFile(source_path, "virtual upload\n");
        writeTextFile(batch_path, sprintf("put %s /submitted.txt\nquit\n", source_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TestSftpBackend backend = sftp.getBackend();
        list<string> names = ();
        Counter service_done(1);
        background sub() {
            try {
                while (names.size() < 64) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                    names += (msg.name,);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        service_done.waitForZero(5s);
        if (sftp.connected()) {
            sftp.close();
        }
        string stdout_data = is_file(stdout_path) ? ReadOnlyFile::readTextFile(stdout_path) : "";
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        session.disconnect();
        server.stop();

        bool saw_open = False;
        bool saw_write = False;
        bool saw_backend_open_write = False;
        bool saw_backend_close_write = False;
        for (int i = 0; i < names.size(); ++i) {
            string name = names[i];
            if (name == "open") {
                saw_open = True;
            } else if (name == "write") {
                saw_write = True;
            }
        }
        for (int i = 0; i < backend.calls.size(); ++i) {
            if (backend.calls[i].method == "openWrite" && backend.calls[i].path == "/submitted.txt") {
                saw_backend_open_write = True;
            } else if (backend.calls[i].method == "closeWrite" && backend.calls[i].path == "/submitted.txt") {
                saw_backend_close_write = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq("init", names[0]);
        assertTrue(saw_open);
        assertTrue(saw_backend_open_write);
        assertTrue(saw_backend_close_write);
        assertEq(1, backend.submissions.size());
        assertEq("/submitted.txt", backend.submissions[0].path);
        assertEq("close-write", backend.submissions[0].operation);
        assertEq(binary("virtual upload\n"), backend.submissions[0].data);
        assertEq(0, sftp_rc);
        assertEq("", stderr_data);
        assertTrue(stdout_data.find("Uploading") >= 0 || stdout_data.find("submitted.txt") >= 0);
    }

    testSftpProtocolTypedBackendVirtualOperations() {
        object typed_backend = new TypedTestSftpBackend();
        Qore::Ssh::SshServer server(getSftpEnabledConfigWithBackend(typed_backend));
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-typed.batch");
        string stdout_path = getTmpFile(".sftp-typed.out");
        string stderr_path = getTmpFile(".sftp-typed.err");
        string source_path = getTmpFile(".sftp-typed.source");
        string target_path = getTmpFile(".sftp-typed.target");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
            cleanupFile(target_path);
        }

        writeTextFile(source_path, "typed protocol upload\n");
        writeTextFile(batch_path, sprintf("mkdir /exchange\nput %s /submitted.txt\nrename /submitted.txt /renamed.txt\nget /renamed.txt %s\nrm /renamed.txt\nrmdir /exchange\nquit\n",
            source_path, target_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TypedTestSftpBackend backend = sftp.getBackend();
        list<string> names = ();
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                    names += (msg.name,);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        service_done.waitForZero(5s);
        if (sftp.connected()) {
            sftp.close();
        }
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        string target_data = is_file(target_path) ? ReadOnlyFile::readTextFile(target_path) : "";
        session.disconnect();
        server.stop();

        bool saw_mkdir = False;
        bool saw_rename = False;
        bool saw_remove = False;
        bool saw_rmdir = False;
        bool saw_open_write = False;
        bool saw_open_read = False;
        for (int i = 0; i < backend.impl.calls.size(); ++i) {
            if (backend.impl.calls[i].method == "mkdir" && backend.impl.calls[i].path == "/exchange") {
                saw_mkdir = True;
            } else if (backend.impl.calls[i].method == "rename" && backend.impl.calls[i].path == "/submitted.txt"
                    && backend.impl.calls[i].target_path == "/renamed.txt") {
                saw_rename = True;
            } else if (backend.impl.calls[i].method == "removePath" && backend.impl.calls[i].path == "/renamed.txt") {
                saw_remove = True;
            } else if (backend.impl.calls[i].method == "rmdir" && backend.impl.calls[i].path == "/exchange") {
                saw_rmdir = True;
            } else if (backend.impl.calls[i].method == "openWrite" && backend.impl.calls[i].path == "/submitted.txt") {
                saw_open_write = True;
            } else if (backend.impl.calls[i].method == "openRead" && backend.impl.calls[i].path == "/renamed.txt") {
                saw_open_read = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertEq("", stderr_data);
        assertEq("typed protocol upload\n", target_data);
        assertTrue(saw_mkdir);
        assertTrue(saw_rename);
        assertTrue(saw_remove);
        assertTrue(saw_rmdir);
        assertTrue(saw_open_write);
        assertTrue(saw_open_read);
        assertEq(NOTHING, backend.impl.files{"/submitted.txt"});
        assertEq(NOTHING, backend.impl.files{"/renamed.txt"});
        assertEq(NOTHING, backend.impl.directories{"/exchange"});
    }

