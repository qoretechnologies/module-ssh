    testDispatchCommandSessionDenied() {
        TestLogger logger();
        hash<SshServerConfig> config = getAuthCallbackConfig();
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".deny.out");
        string stderr_path = getTmpFile(".deny.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshExecClientCommand(port, "denied-command", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        hash<SshCommandResult> result = server.dispatchCommandSession(session, 15000);
        done.waitForZero(10s);
        string stderr_data = File::readTextFile(stderr_path);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertFalse(result.accepted);
        assertEq("no command callback configured", result.message);
        assertNeq(0, ssh_rc);
        assertTrue(stderr_data.find("exec request") >= 0);
        bool saw_denied_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer dispatchCommandSession") >= 0
                    && logger.events[i].message.find("accepted=false") >= 0) {
                saw_denied_log = True;
                break;
            }
        }
        assertTrue(saw_denied_log);
    }

