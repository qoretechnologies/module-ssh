    testWaitAuthContextPublickey() {
        string private_key_path = prepareClientPrivateKeyFile();
        on_exit {
            cleanupFile(private_key_path);
        }
        list<string> public_key_states = ();
        hash<SshServerConfig> config = getTestConfig();
        config.listeners[0].enabled_auth_methods = ("publickey",);
        config.auth_callback = hash<SshAuthDecision> sub(hash<SshAuthContextInfo> ctx) {
            assertEq("publickey", ctx.auth_method);
            assertEq("ssh-ed25519", ctx.public_key_type);
            assertEq("AAAAC3NzaC1lZDI1NTE5AAAAIAZkBGIhchs2c0+gzHzfXPP46L5RaZkLaCl2iFCRuNd1",
                ctx.public_key.toBase64());
            assertEq(NOTHING, ctx.password);
            public_key_states += (ctx.metadata.public_key_state,);
            return <SshAuthDecision>{
                "accepted": True,
                "principal": sprintf("publickey:%s", ctx.username),
                "command_policy": {"mode": "command-only"},
                "sftp_policy": {"mode": "disabled"},
            };
        };
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 0,
                "message": "auth-only-command-ok",
            };
        };
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshPublickeyClientCommand(port, private_key_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> decision = server.authenticateSession(session, 5000);
        hash<SshCommandResult> result = server.dispatchCommandSession(session, 5000);
        hash<SshAuthContextInfo> auth_info = session.getAuthContextInfo();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(decision.accepted);
        assertTrue(result.accepted);
        assertEq(0, result.exit_status);
        assertEq("publickey:nobody", decision.principal);
        assertEq("publickey", auth_info.auth_method);
        assertEq("nobody", auth_info.username);
        assertEq("ssh-ed25519", auth_info.public_key_type);
        assertEq("AAAAC3NzaC1lZDI1NTE5AAAAIAZkBGIhchs2c0+gzHzfXPP46L5RaZkLaCl2iFCRuNd1",
            auth_info.public_key.toBase64());
        assertEq("valid", auth_info.metadata.public_key_state);
        assertEq(NOTHING, auth_info.password);
        assertEq(("none", "valid"), public_key_states);
        assertEq(0, ssh_rc);
    }

