    testDispatchSftpSession() {
        Qore::Ssh::SshServer server(getSftpEnabledConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp.out");
        string stderr_path = getTmpFile(".sftp.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        hash<Qore::Ssh::SftpSessionInfo> info = sftp.getInfo();
        hash<Qore::Ssh::SftpTransferInfo> transfer_info = sftp.getTransferInfo();
        TestSftpBackend backend = sftp.getBackend();
        assertTrue(sftp.connected());
        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertEq("principal:nobody", info.principal);
        assertEq("/tmp/module-ssh-sftp-root/principal:nobody", info.root_dir);
        assertTrue(info.read_only);
        assertEq("test", info.session_data.tenant);
        assertEq("sftp", info.session_data.source);
        assertEq("applied", info.session_data.factory);
        assertEq("nobody", info.session_info.username);
        assertTrue(info.session_info.authenticated);
        assertEq("session-open", transfer_info.operation);
        assertEq("/", transfer_info.path);
        assertFalse(transfer_info.atomic_publish);
        assertFalse(transfer_info.completed);
        assertEq("factory-backend", backend.name);
        assertFalse(sftp.connected());
        assertNeq(0, ssh_rc);
    }

    testSftpProtocolInitAndStatus() {
        Qore::Ssh::SshServer server(getSftpEnabledConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-protocol.batch");
        string stdout_path = getTmpFile(".sftp-protocol.out");
        string stderr_path = getTmpFile(".sftp-protocol.err");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        writeTextFile(batch_path, "pwd\nls\nquit\n");
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TestSftpBackend backend = sftp.getBackend();
        list<hash<auto>> messages = ();
        Counter service_done(1);
        background sub() {
            while (messages.size() < 16) {
                auto msg = sftp.processNextRequest(15000);
                if (msg == NOTHING) {
                    break;
                }
                messages += (msg,);
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        sftp.close();
        service_done.waitForZero(5s);
        string stdout_data = is_file(stdout_path) ? ReadOnlyFile::readTextFile(stdout_path) : "";
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        session.disconnect();
        server.stop();

        bool saw_realpath = False;
        bool saw_opendir = False;
        for (int i = 0; i < messages.size(); ++i) {
            if (messages[i].name == "realpath") {
                saw_realpath = True;
            } else if (messages[i].name == "opendir") {
                saw_opendir = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq("init", messages[0].name);
        assertEq(3, messages[0].version);
        assertTrue(saw_realpath);
        assertTrue(saw_opendir);
        assertEq("factory-backend", backend.name);
        assertEq(0, sftp_rc);
        assertTrue(stdout_data.find("Remote working directory: /") >= 0);
        assertTrue(stdout_data.find("backend-entry.txt") >= 0);
        assertEq("", stderr_data);
    }

