    testEvaluateSftpTransferRequestAtomicPublishDefaults() {
        Qore::Ssh::SshServer server(getSftpAtomicPublishConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-atomic-defaults.out");
        string stderr_path = getTmpFile(".sftp-atomic-defaults.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        hash<Qore::Ssh::SftpTransferDecision> decision = server.evaluateSftpTransferRequest(sftp,
            <Qore::Ssh::SftpTransferRequest>{
                "session_info": sftp.getInfo(),
                "operation": "upload",
                "path": "incoming/./nested/../file.dat",
                "size": 123,
            });
        hash<Qore::Ssh::SftpTransferInfo> transfer_info = sftp.getTransferInfo();
        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertTrue(decision.allowed);
        assertEq("/incoming/file.dat", decision.transfer_info.path);
        assertEq("/tmp/module-ssh-sftp-root/principal:nobody/incoming/file.dat", decision.transfer_info.final_path);
        assertEq("/tmp/module-ssh-sftp-root/principal:nobody/incoming/file.dat.uploading",
            decision.transfer_info.temporary_path);
        assertTrue(decision.transfer_info.atomic_publish);
        assertEq("/incoming/file.dat", transfer_info.path);
        assertEq("/tmp/module-ssh-sftp-root/principal:nobody/incoming/file.dat", transfer_info.final_path);
        assertEq("/tmp/module-ssh-sftp-root/principal:nobody/incoming/file.dat.uploading",
            transfer_info.temporary_path);
        assertTrue(transfer_info.atomic_publish);
        assertFalse(transfer_info.completed);
        assertNeq(0, ssh_rc);
    }

    testStartStop() {
        Qore::Ssh::SshServer server(getTestConfig());
        assertFalse(server.running());
        server.start();
        assertTrue(server.running());
        server.stop();
        assertFalse(server.running());
    }

    testInvalidStart() {
        hash<SshServerConfig> config = <SshServerConfig>{
            "name": "invalid-key-server",
            "listeners": (<SshListenerConfig>{
                "name": "invalid-key-listener",
                "bind_address": "127.0.0.1",
                "port": 0,
                "host_keys": ("/dev/null",),
            },),
        };
        Qore::Ssh::SshServer server(config);
        assertThrows("SSHLISTENER-START-ERROR", sub() { server.start(); });
        assertFalse(server.running());
        hash<SshServerStatus> status = server.getStatus();
        assertFalse(status.listeners[0].running);
        assertEq(NOTHING, status.listeners[0].bound_port);
        assertNeq(NOTHING, status.listeners[0].last_error);
    }

    testRunning() {
        Qore::Ssh::SshServer server(getTestConfig());
        # initial state is not running
        assertFalse(server.running());
        # start sets running
        server.start();
        assertTrue(server.running());
        # multiple starts are idempotent
        server.start();
        assertTrue(server.running());
        # stop clears running
        server.stop();
        assertFalse(server.running());
        # multiple stops are idempotent
        server.stop();
        assertFalse(server.running());
    }

    testGetStatus() {
        Qore::Ssh::SshServer server(getTestConfig());
        hash<SshServerStatus> status = server.getStatus();
        assertEq(Type::String, status.name.type());
        assertEq(Type::Boolean, status.running.type());
        assertEq(Type::Int, status.listener_count.type());
        assertEq(Type::Int, status.active_session_count.type());
        assertEq(Type::List, status.listeners.type());
    }

    testGetStatusName() {
        Qore::Ssh::SshServer server(getTestConfig());
        hash<SshServerStatus> status = server.getStatus();
        assertEq("test-server", status.name);
    }

    testGetStatusListenerCount() {
        Qore::Ssh::SshServer server(getTestConfig());
        hash<SshServerStatus> status = server.getStatus();
        assertEq(1, status.listener_count);

        # not-running status
        assertFalse(status.running);

        # after start, status reflects running state
        server.start();
        hash<SshServerStatus> running_status = server.getStatus();
        assertTrue(running_status.running);
        assertEq(1, running_status.listener_count);
        assertNeq(NOTHING, running_status.started);
    }

    testGetStatusListeners() {
        Qore::Ssh::SshServer server(getTestConfig());
        hash<SshServerStatus> status = server.getStatus();
        assertEq(1, status.listeners.size());
        hash<SshListenerStatus> listener_status = status.listeners[0];
        assertEq("test-listener", listener_status.name);
        assertEq("127.0.0.1", listener_status.bind_address);
        assertEq(0, listener_status.port);
        assertFalse(listener_status.running);

        server.start();
        hash<SshServerStatus> running_status = server.getStatus();
        hash<SshListenerStatus> running_listener_status = running_status.listeners[0];
        assertTrue(running_listener_status.running);
        assertEq(0, running_listener_status.active_session_count);
        assertGt(0, running_listener_status.bound_port);

        server.stop();
        hash<SshServerStatus> stopped_status = server.getStatus();
        hash<SshListenerStatus> stopped_listener_status = stopped_status.listeners[0];
        assertFalse(stopped_listener_status.running);
        assertEq(NOTHING, stopped_listener_status.bound_port);
    }

    testCopyDenied() {
        Qore::Ssh::SshServer server(getTestConfig());
        assertThrows("SSHSERVER-COPY-ERROR", sub() { server.copy(); });
    }
}
