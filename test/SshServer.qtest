    testSftpProtocolPutStreamedVirtualFile() {
        Qore::Ssh::SshServer server(getSftpEnabledConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-stream-put.batch");
        string stdout_path = getTmpFile(".sftp-stream-put.out");
        string stderr_path = getTmpFile(".sftp-stream-put.err");
        string source_path = getTmpFile(".sftp-stream-put.source");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
        }

        writeTextFile(source_path, "streamed upload\n");
        writeTextFile(batch_path, sprintf("put %s /stream-submit.txt\nquit\n", source_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TestSftpBackend backend = sftp.getBackend();
        list<string> names = ();
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                    names += (msg.name,);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        service_done.waitForZero(5s);
        if (sftp.connected()) {
            sftp.close();
        }
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        session.disconnect();
        server.stop();

        bool saw_write = False;
        bool saw_protocol_write = False;
        bool saw_close_write = False;
        for (int i = 0; i < names.size(); ++i) {
            if (names[i] == "write") {
                saw_protocol_write = True;
            }
        }
        for (int i = 0; i < backend.calls.size(); ++i) {
            if (backend.calls[i].method == "write" && backend.calls[i].path == "/stream-submit.txt") {
                saw_write = True;
            } else if (backend.calls[i].method == "closeWrite" && backend.calls[i].path == "/stream-submit.txt") {
                saw_close_write = True;
            }
        }

        hash<auto> submission;
        for (int i = 0; i < backend.submissions.size(); ++i) {
            if (backend.submissions[i].path == "/stream-submit.txt") {
                submission = backend.submissions[i];
                break;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertEq("", stderr_data);
        assertTrue(saw_protocol_write);
        assertTrue(saw_write);
        assertTrue(saw_close_write);
        assertEq("/stream-submit.txt", submission.path);
        assertEq(binary("streamed upload\n"), submission.data);
    }

    testSftpProtocolVirtualMutations() {
        Qore::Ssh::SshServer server(getSftpEnabledConfig());
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-mutate.batch");
        string stdout_path = getTmpFile(".sftp-mutate.out");
        string stderr_path = getTmpFile(".sftp-mutate.err");
        string source_path = getTmpFile(".sftp-mutate.source");
        string target_path = getTmpFile(".sftp-mutate.target");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
            cleanupFile(target_path);
        }

        writeTextFile(source_path, "mutation upload\n");
        writeTextFile(batch_path, sprintf("mkdir /exchange\nput %s /submitted.txt\nrename /submitted.txt /renamed.txt\nget /renamed.txt %s\nrm /renamed.txt\nrmdir /exchange\nquit\n",
            source_path, target_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TestSftpBackend backend = sftp.getBackend();
        list<string> names = ();
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                    names += (msg.name,);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        service_done.waitForZero(5s);
        if (sftp.connected()) {
            sftp.close();
        }
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        string target_data = is_file(target_path) ? ReadOnlyFile::readTextFile(target_path) : "";
        session.disconnect();
        server.stop();

        bool saw_mkdir = False;
        bool saw_rename = False;
        bool saw_remove = False;
        bool saw_rmdir = False;
        for (int i = 0; i < names.size(); ++i) {
            if (names[i] == "mkdir") {
                saw_mkdir = True;
            } else if (names[i] == "rename") {
                saw_rename = True;
            } else if (names[i] == "remove") {
                saw_remove = True;
            } else if (names[i] == "rmdir") {
                saw_rmdir = True;
            }
        }

        bool saw_backend_mkdir = False;
        bool saw_backend_rename = False;
        bool saw_backend_remove = False;
        bool saw_backend_rmdir = False;
        for (int i = 0; i < backend.calls.size(); ++i) {
            if (backend.calls[i].method == "mkdir" && backend.calls[i].path == "/exchange") {
                saw_backend_mkdir = True;
            } else if (backend.calls[i].method == "rename" && backend.calls[i].path == "/submitted.txt"
                    && backend.calls[i].target_path == "/renamed.txt") {
                saw_backend_rename = True;
            } else if (backend.calls[i].method == "removePath" && backend.calls[i].path == "/renamed.txt") {
                saw_backend_remove = True;
            } else if (backend.calls[i].method == "rmdir" && backend.calls[i].path == "/exchange") {
                saw_backend_rmdir = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertEq("", stderr_data);
        assertTrue(saw_mkdir);
        assertTrue(saw_rename);
        assertTrue(saw_remove);
        assertTrue(saw_rmdir);
        assertTrue(saw_backend_mkdir);
        assertTrue(saw_backend_rename);
        assertTrue(saw_backend_remove);
        assertTrue(saw_backend_rmdir);
        assertEq("mutation upload\n", target_data);
        assertEq(NOTHING, backend.files{"/submitted.txt"});
        assertEq(NOTHING, backend.files{"/renamed.txt"});
        assertEq(NOTHING, backend.directories{"/exchange"});
    }

    testSftpAtomicExchangeHelpers() {
        hash<SshServerConfig> config = getSftpEnabledConfig();
        TestLogger logger();
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-helper.out");
        string stderr_path = getTmpFile(".sftp-helper.err");
        string source_path = getTmpFile(".sftp-helper.source");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stdout_path + ".copy");
            cleanupFile(stderr_path);
            cleanupFile(source_path);
        }

        writeTextFile(source_path, "helper payload\n");
        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        TestSftpBackend backend = sftp.getBackend();

        hash<Qore::Ssh::SftpOperationResult> submit_archive_result
            = sftp.submitLocalFile("/exchange/helper-archive.dat", source_path, False, True, {"kind": "helper"});
        hash<Qore::Ssh::SftpOperationResult> submit_claim_result
            = sftp.submitLocalFile("/exchange/helper-claim.dat", source_path, False, True, {"kind": "helper"});
        hash<Qore::Ssh::SftpOperationResult> submit_default_archive_result
            = sftp.submitLocalFile("/exchange/helper-archive-default.dat", source_path, False, True, {"kind": "helper"});
        hash<Qore::Ssh::SftpOperationResult> submit_default_claim_result
            = sftp.submitLocalFile("/exchange/helper-claim-default.dat", source_path, False, True, {"kind": "helper"});
        hash<Qore::Ssh::SftpOperationResult> submit_delete_result
            = sftp.submitLocalFile("/exchange/helper-delete.dat", source_path, False, True, {"kind": "helper"});
        hash<Qore::Ssh::SftpListResult> listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/"});
        binary retrieve_archive_result = sftp.retrieveData("/exchange/helper-archive.dat");
        binary retrieve_claim_result = sftp.retrieveData("/exchange/helper-claim.dat");
        hash<Qore::Ssh::SftpOperationResult> complete_archive_result
            = sftp.completeRetrieveArchive("/exchange/helper-archive.dat", "/archive/helper-archive.done");
        hash<Qore::Ssh::SftpOperationResult> complete_claim_result
            = sftp.completeRetrieveClaim("/exchange/helper-claim.dat", "/claim/helper-claim.done");
        hash<Qore::Ssh::SftpOperationResult> complete_default_archive_result
            = sftp.completeRetrieveArchive("/exchange/helper-archive-default.dat");
        hash<Qore::Ssh::SftpOperationResult> complete_default_claim_result
            = sftp.completeRetrieveClaim("/exchange/helper-claim-default.dat");
        hash<Qore::Ssh::SftpOperationResult> delete_result
            = sftp.retrieveToLocalFile("/exchange/helper-delete.dat", stdout_path + ".copy", "delete");
        hash<Qore::Ssh::SftpListResult> root_listing_after = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/"});
        hash<Qore::Ssh::SftpListResult> exchange_listing_after = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/exchange"});
        hash<Qore::Ssh::SftpListResult> archive_listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/archive"});
        hash<Qore::Ssh::SftpListResult> claim_listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/claim"});

        sftp.close();
        done.waitForZero(10s);
        string stderr_data = is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "";
        session.disconnect();
        server.stop();

        bool saw_submit = False;
        bool saw_list_available = False;
        bool saw_retrieve_archive = False;
        bool saw_retrieve_claim = False;
        bool saw_complete_archive = False;
        bool saw_complete_claim = False;
        bool saw_complete_delete = False;
        for (int i = 0; i < backend.calls.size(); ++i) {
            if (backend.calls[i].method == "submit" && backend.calls[i].path == "/exchange/helper-archive.dat") {
                saw_submit = True;
            } else if (backend.calls[i].method == "submit" && backend.calls[i].path == "/exchange/helper-claim.dat") {
                saw_submit = True;
            } else if (backend.calls[i].method == "submit" && backend.calls[i].path == "/exchange/helper-archive-default.dat") {
                saw_submit = True;
            } else if (backend.calls[i].method == "submit" && backend.calls[i].path == "/exchange/helper-claim-default.dat") {
                saw_submit = True;
            } else if (backend.calls[i].method == "submit" && backend.calls[i].path == "/exchange/helper-delete.dat") {
                saw_submit = True;
            } else if (backend.calls[i].method == "listAvailable") {
                saw_list_available = True;
            } else if (backend.calls[i].method == "retrieve" && backend.calls[i].path == "/exchange/helper-archive.dat") {
                saw_retrieve_archive = True;
            } else if (backend.calls[i].method == "retrieve" && backend.calls[i].path == "/exchange/helper-claim.dat") {
                saw_retrieve_claim = True;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/exchange/helper-archive.dat"
                    && backend.calls[i].target_path == "/archive/helper-archive.done") {
                saw_complete_archive = True;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/exchange/helper-claim.dat"
                    && backend.calls[i].target_path == "/claim/helper-claim.done") {
                saw_complete_claim = True;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/exchange/helper-archive-default.dat"
                    && backend.calls[i].target_path == NOTHING) {
                saw_complete_archive = True;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/exchange/helper-claim-default.dat"
                    && backend.calls[i].target_path == NOTHING) {
                saw_complete_claim = True;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/exchange/helper-delete.dat") {
                saw_complete_delete = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertTrue(submit_archive_result.completed);
        assertTrue(submit_claim_result.completed);
        assertTrue(submit_default_archive_result.completed);
        assertTrue(submit_default_claim_result.completed);
        assertTrue(submit_delete_result.completed);
        assertEq("/exchange/helper-archive.dat", submit_archive_result.path);
        assertEq("/exchange/helper-claim.dat", submit_claim_result.path);
        assertEq("/exchange/helper-archive-default.dat", submit_default_archive_result.path);
        assertEq("/exchange/helper-claim-default.dat", submit_default_claim_result.path);
        assertEq("/exchange/helper-delete.dat", submit_delete_result.path);
        assertTrue(listing.entries.size() > 0);
        assertEq(binary("helper payload\n"), retrieve_archive_result);
        assertEq(binary("helper payload\n"), retrieve_claim_result);
        assertTrue(complete_archive_result.completed);
        assertTrue(complete_claim_result.completed);
        assertTrue(complete_default_archive_result.completed);
        assertTrue(complete_default_claim_result.completed);
        assertTrue(delete_result.completed);
        assertEq("/archive/helper-archive.done", complete_archive_result.path);
        assertEq("/claim/helper-claim.done", complete_claim_result.path);
        assertEq("/archive/helper-archive-default.dat", complete_default_archive_result.path);
        assertEq("/claim/helper-claim-default.dat", complete_default_claim_result.path);
        assertTrue(is_file(stdout_path + ".copy"));
        assertEq("helper payload\n", ReadOnlyFile::readTextFile(stdout_path + ".copy"));
        assertTrue(saw_submit);
        assertTrue(saw_list_available);
        assertTrue(saw_retrieve_archive);
        assertTrue(saw_retrieve_claim);
        assertTrue(saw_complete_archive);
        assertTrue(saw_complete_claim);
        assertTrue(saw_complete_delete);
        assertEq(binary("helper payload\n"), backend.files{"/archive/helper-archive.done"});
        assertEq(binary("helper payload\n"), backend.files{"/archive/helper-archive-default.dat"});
        assertEq(binary("helper payload\n"), backend.files{"/claim/helper-claim.done"});
        assertEq(binary("helper payload\n"), backend.files{"/claim/helper-claim-default.dat"});
        assertEq(NOTHING, backend.files{"/exchange/helper-archive.dat"});
        assertEq(NOTHING, backend.files{"/exchange/helper-archive-default.dat"});
        assertEq(NOTHING, backend.files{"/exchange/helper-claim.dat"});
        assertEq(NOTHING, backend.files{"/exchange/helper-claim-default.dat"});
        assertEq(NOTHING, backend.files{"/exchange/helper-delete.dat"});
        assertNeq(0, ssh_rc);
        assertTrue(stderr_data.find("subsystem") >= 0 || stderr_data.find("Connection to 127.0.0.1 closed") >= 0
            || stderr_data == "");

        bool saw_root_archive = False;
        bool saw_root_claim = False;
        for (int i = 0; i < root_listing_after.entries.size(); ++i) {
            if (root_listing_after.entries[i].filename == "archive") {
                saw_root_archive = True;
            } else if (root_listing_after.entries[i].filename == "claim") {
                saw_root_claim = True;
            }
        }
        bool saw_exchange_entry = False;
        for (int i = 0; i < exchange_listing_after.entries.size(); ++i) {
            if (exchange_listing_after.entries[i].filename.find("helper-") == 0) {
                saw_exchange_entry = True;
            }
        }
        bool saw_archive_entry = False;
        for (int i = 0; i < archive_listing.entries.size(); ++i) {
            if (archive_listing.entries[i].filename == "helper-archive.done"
                    || archive_listing.entries[i].filename == "helper-archive-default.dat") {
                saw_archive_entry = True;
            }
        }
        bool saw_claim_entry = False;
        for (int i = 0; i < claim_listing.entries.size(); ++i) {
            if (claim_listing.entries[i].filename == "helper-claim.done"
                    || claim_listing.entries[i].filename == "helper-claim-default.dat") {
                saw_claim_entry = True;
            }
        }
        assertTrue(saw_root_archive);
        assertTrue(saw_root_claim);
        assertFalse(saw_exchange_entry);
        assertTrue(saw_archive_entry);
        assertTrue(saw_claim_entry);

        bool saw_dispatch_log = False;
        bool saw_submit_archive_log = False;
        bool saw_submit_claim_log = False;
        bool saw_submit_delete_log = False;
        bool saw_retrieve_archive_log = False;
        bool saw_retrieve_claim_log = False;
        bool saw_retrieve_delete_log = False;
        bool saw_complete_archive_log = False;
        bool saw_complete_claim_log = False;
        bool saw_complete_delete_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer dispatchSftpSession") >= 0) {
                saw_dispatch_log = True;
            } else if (logger.events[i].message.find("SftpSession submit path=/exchange/helper-archive.dat") >= 0) {
                saw_submit_archive_log = True;
            } else if (logger.events[i].message.find("SftpSession submit path=/exchange/helper-claim.dat") >= 0) {
                saw_submit_claim_log = True;
            } else if (logger.events[i].message.find("SftpSession submit path=/exchange/helper-delete.dat") >= 0) {
                saw_submit_delete_log = True;
            } else if (logger.events[i].message.find("SftpSession retrieve path=/exchange/helper-archive.dat") >= 0) {
                saw_retrieve_archive_log = True;
            } else if (logger.events[i].message.find("SftpSession retrieve path=/exchange/helper-claim.dat") >= 0) {
                saw_retrieve_claim_log = True;
            } else if (logger.events[i].message.find("SftpSession retrieve path=/exchange/helper-delete.dat") >= 0) {
                saw_retrieve_delete_log = True;
            } else if (logger.events[i].message.find(
                    "SftpSession completeRetrieve path=/exchange/helper-archive.dat completion_mode=archive") >= 0) {
                saw_complete_archive_log = True;
            } else if (logger.events[i].message.find(
                    "SftpSession completeRetrieve path=/exchange/helper-claim.dat completion_mode=claim") >= 0) {
                saw_complete_claim_log = True;
            } else if (logger.events[i].message.find(
                    "SftpSession completeRetrieve path=/exchange/helper-delete.dat completion_mode=delete") >= 0) {
                saw_complete_delete_log = True;
            }
        }
        assertTrue(saw_dispatch_log);
        assertTrue(saw_submit_archive_log);
        assertTrue(saw_submit_claim_log);
        assertTrue(saw_submit_delete_log);
        assertTrue(saw_retrieve_archive_log);
        assertTrue(saw_retrieve_claim_log);
        assertTrue(saw_retrieve_delete_log);
        assertTrue(saw_complete_archive_log);
        assertTrue(saw_complete_claim_log);
        assertTrue(saw_complete_delete_log);
    }

    testSftpAtomicExchangeHelpersRejectMissingDefaultTargets() {
        TestLogger logger();
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "logger": logger,
        });
        exchange.addOutboundText("default-archive.txt", "archive-default\n");
        exchange.addOutboundText("default-claim.txt", "claim-default\n");

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string stdout_path = getTmpFile(".sftp-helper-default-targets.out");
        string stderr_path = getTmpFile(".sftp-helper-default-targets.err");

        on_exit {
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshSubsystemClientCommand(port, "sftp", stdout_path, stderr_path);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);

        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            sftp.completeRetrieveArchive("default-archive.txt", "archived-default.txt");
        });
        assertThrows("VIRTUAL-SFTP-EXCHANGE-ERROR", sub() {
            sftp.completeRetrieveClaim("default-claim.txt", "claimed-default.txt");
        });

        hash<Qore::Ssh::SftpListResult> listing = sftp.listAvailable(<Qore::Ssh::SftpPathRequest>{"path": "/"});
        sftp.close();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        bool saw_archive_entry = False;
        bool saw_claim_entry = False;
        for (int i = 0; i < listing.entries.size(); ++i) {
            if (listing.entries[i].filename == "default-archive.txt") {
                saw_archive_entry = True;
            } else if (listing.entries[i].filename == "default-claim.txt") {
                saw_claim_entry = True;
            }
        }

        assertTrue(auth_decision.accepted);
        assertTrue(saw_archive_entry);
        assertTrue(saw_claim_entry);
        assertEq("archive-default\n", exchange.getOutboundData("default-archive.txt").toString("UTF-8"));
        assertEq("claim-default\n", exchange.getOutboundData("default-claim.txt").toString("UTF-8"));
        assertNeq(0, ssh_rc);

        bool saw_dispatch_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer dispatchSftpSession") >= 0) {
                saw_dispatch_log = True;
                break;
            }
        }
        assertTrue(saw_dispatch_log);
    }

    testSftpInboundSubmittedEventProvider() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "logger": new TestLogger(),
        });
        AbstractDataProvider provider = DataProvider::getFactory(SftpServerDataProvider::FactoryName).create({
            "backend": exchange,
        });
        AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
        EventObserver observer();
        cast<DataProvider::Observable>(event_provider).registerObserver(
            observer, SftpServerDataProvider::EventInboundFileAccepted);
        cast<DataProvider::DelayedObservable>(event_provider).observersReady();

        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(exchange);
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-event-put.batch");
        string stdout_path = getTmpFile(".sftp-event-put.out");
        string stderr_path = getTmpFile(".sftp-event-put.err");
        string source_path = getTmpFile(".sftp-event-put.source");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
            cleanupFile(source_path);
        }

        writeTextFile(source_path, "event upload\n");
        writeTextFile(batch_path, sprintf("put %s /inbound/live-event.txt\nquit\n", source_path));
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        Counter service_done(1);
        background sub() {
            try {
                while (True) {
                    auto msg = sftp.processNextRequest(15000);
                    if (msg == NOTHING) {
                        break;
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "SFTPSESSION-STATE-ERROR") {
                    throw ex;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        sftp.close();
        service_done.waitForZero(5s);
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        assertEq(0, sftp_rc);
        assertEq(1, observer.events.size());
        assertEq(SftpServerDataProvider::EventInboundFileAccepted, observer.events[0].event_id);
        assertEq("live-event.txt", observer.events[0].name);
        assertEq("/inbound/live-event.txt", observer.events[0].path);
        assertEq(NOTHING, observer.events[0].data);
        assertEq("sftp", observer.events[0].source);
        assertEq("event upload\n", exchange.getInboundData("live-event.txt").toString("UTF-8"));
    }

    testSftpInboundUploadPolicy() {
        SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
            "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
                "accept_filename_glob": "*.dat",
                "max_size": 8,
