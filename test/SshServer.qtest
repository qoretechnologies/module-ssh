            cleanupFile(reject_stderr_path);
            cleanupFile(reject_source_path);
        }

        writeTextFile(ok_source_path, "PKzip-data\n");
        writeTextFile(reject_source_path, "MZexe-data\n");
        writeTextFile(ok_batch_path, sprintf("put %s /inbound/ok.zip\nquit\n", ok_source_path));
        writeTextFile(reject_batch_path, sprintf("put %s /inbound/rejected.exe\nquit\n", reject_source_path));
        int ok_sftp_rc = 0;
        int reject_sftp_rc = 0;

        {
            Counter done(1);
