    testSftpProtocolRejectsMalformedListResult() {
        object malformed_backend = new MissingEntriesListBackend();
        TestLogger logger();
        hash<SshServerConfig> config = getSftpEnabledConfigWithBackend(malformed_backend);
        config.logger = logger;
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        string batch_path = getTmpFile(".sftp-bad-list.batch");
        string stdout_path = getTmpFile(".sftp-bad-list.out");
        string stderr_path = getTmpFile(".sftp-bad-list.err");

        on_exit {
            cleanupFile(batch_path);
            cleanupFile(stdout_path);
            cleanupFile(stderr_path);
        }

        writeTextFile(batch_path, "ls\nquit\n");
        int sftp_rc = 0;
        Counter done(1);
        string cmd = makeSftpClientCommand(port, batch_path, stdout_path, stderr_path);
        background sub() {
            try {
                sftp_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                sftp_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> auth_decision = server.authenticateSession(session, 15000);
        Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
        Counter service_done(1);
        background sub() {
            while (True) {
                auto msg = sftp.processNextRequest(15000);
                if (msg == NOTHING) {
                    break;
                }
            }
            service_done.dec();
        }();

        done.waitForZero(10s);
        if (sftp.connected()) {
            sftp.close();
        }
        service_done.waitForZero(5s);
        string stdout_data = is_file(stdout_path) ? ReadOnlyFile::readTextFile(stdout_path) : "";
        session.disconnect();
        server.stop();

        assertTrue(auth_decision.accepted);
        bool saw_backend_list = False;
        for (int i = 0; i < malformed_backend.calls.size(); ++i) {
            if (malformed_backend.calls[i].method == "list") {
                saw_backend_list = True;
                break;
            }
        }

        assertEq(0, sftp_rc);
        assertTrue(stdout_data.find("sftp>") >= 0);
        assertFalse(stdout_data.find("backend-entry.txt") >= 0);
        assertTrue(saw_backend_list);
        bool saw_dispatch_log = False;
        bool saw_status_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("SshServer dispatchSftpSession") >= 0) {
                saw_dispatch_log = True;
            } else if (logger.events[i].message.find("SftpSession sent status request_id=") >= 0) {
                saw_status_log = True;
            }
        }
        assertTrue(saw_dispatch_log);
        assertTrue(saw_status_log);
    }

