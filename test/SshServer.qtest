    testAuthenticateSessionCallback() {
        hash<SshServerConfig> config = getAuthCallbackConfig();
        config.command_callback = hash<SshCommandResult> sub(hash<SshCommandRequest> req) {
            return <SshCommandResult>{
                "accepted": True,
                "exit_status": 0,
                "message": "auth-only-command-ok",
            };
        };
        Qore::Ssh::SshServer server(config);
        server.start();
        hash<SshServerStatus> status = server.getStatus();
        int port = status.listeners[0].bound_port;
        assertGt(0, port);

        int ssh_rc = 0;
        Counter done(1);
        string cmd = makeSshClientCommand(port);
        background sub() {
            try {
                ssh_rc = system(cmd);
            } catch (hash<ExceptionInfo> ex) {
                ssh_rc = -1;
            }
            done.dec();
        }();

        Qore::Ssh::SshSession session = server.acceptSession(5000);
        hash<SshAuthDecision> decision = server.authenticateSession(session, 5000);
        hash<SshCommandResult> result = server.dispatchCommandSession(session, 5000);
        hash<SshSessionInfo> info = session.getInfo();
        hash<SshAuthContextInfo> auth_info = session.getAuthContextInfo();
        done.waitForZero(10s);
        session.disconnect();
        server.stop();

        assertTrue(decision.accepted);
        assertTrue(result.accepted);
        assertEq(0, result.exit_status);
        assertEq("principal:nobody", decision.principal);
        assertTrue(info.authenticated);
        assertEq("nobody", info.username);
        assertEq("none", info.auth_method);
        assertEq("principal:nobody", info.principal);
        assertEq("test-listener", info.session_data.listener);
        assertEq("command-only", info.command_policy.mode);
        assertEq("disabled", info.sftp_policy.mode);
        assertEq("none", auth_info.auth_method);
        assertEq("nobody", auth_info.username);
        assertEq(0, ssh_rc);
    }

