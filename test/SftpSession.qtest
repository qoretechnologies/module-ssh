%modern
%requires ssh
%requires QUnit
%requires ./TestLoggerInterface.qm

%exec-class SftpSessionTest

class TestLogger inherits RecordingLoggerInterface {
}

class TestSftpBackend {
    public {
        string name;
        list<hash<auto>> calls;
        list<hash<auto>> submissions;
        binary streamed_payload;
        binary streamed_submission;
        hash<auto> files;
        hash<auto> directories;
    }

    constructor(string name = "backend") {
        self.name = name;
        calls = ();
        submissions = ();
        streamed_payload = binary("streamed virtual payload\n");
        streamed_submission = binary();
        files = (
            "/backend-entry.txt": binary("hello world\n"),
            "/streamed.txt": streamed_payload,
        );
        directories = (
            "/": True,
        );
    }

    hash<auto> stat(hash<auto> req) {
        calls += ({"method": "stat", "path": req.path, "operation": req.operation},);
        if (directories{req.path} != NOTHING && directories{req.path}) {
            return {"backend": name, "path": req.path, "directory": True, "permissions": 0040755};
        }
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            return {
                "backend": name,
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "directory": False,
            };
        }
        return {"backend": name, "path": req.path, "exists": False};
    }

    hash<auto> list(hash<auto> req) {
        calls += ({"method": "list", "path": req.path, "operation": req.operation},);
        list<hash<auto>> entries = ();
        string prefix = req.path == "/" ? "/" : req.path + "/";
        list<string> directory_keys = keys(directories);
        list<string> file_keys = keys(files);

        for (int i = 0; i < directory_keys.size(); ++i) {
            string path = directory_keys[i];
            if (path == "/" || !directories{path}) {
                continue;
            }
            if (path.substr(0, prefix.size()) == prefix && path.find("/", prefix.size()) < 0) {
                string name = path.substr(prefix.size());
                entries += ({
                    "filename": name,
                    "long_name": name,
                    "size": 0,
                    "permissions": 0040755,
                    "directory": True,
                },);
            }
        }

        for (int i = 0; i < file_keys.size(); ++i) {
            string path = file_keys[i];
            if (path.substr(0, prefix.size()) == prefix && path.find("/", prefix.size()) < 0) {
                binary data = files{path};
                string name = path.substr(prefix.size());
                entries += ({
                    "filename": name,
                    "long_name": name,
                    "size": data.size(),
                    "permissions": 0100644,
                    "directory": False,
                },);
            }
        }
        return {
            "backend": name,
            "path": req.path,
            "entries": entries,
        };
    }

    hash<auto> openRead(hash<auto> req) {
        calls += ({"method": "openRead", "path": req.path, "operation": req.operation},);
        if (req.path == "/streamed.txt") {
            binary data = streamed_payload;
            return {
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "backend_handle": "stream:streamed.txt",
            };
        }
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            return {
                "path": req.path,
                "size": data.size(),
                "permissions": 0100644,
                "data": data,
            };
        }
        return {"path": req.path, "exists": False};
    }

    hash<auto> openWrite(hash<auto> req) {
        calls += ({"method": "openWrite", "path": req.path, "operation": req.operation, "pflags": req.pflags},);
        if (req.path == "/stream-submit.txt") {
            streamed_submission = binary();
            return {
                "path": req.path,
                "permissions": 0100644,
                "backend_handle": "write:stream-submit.txt",
            };
        }
        return {"path": req.path, "permissions": 0100644};
    }

    hash<auto> read(hash<auto> req) {
        calls += ({
            "method": "read",
            "path": req.path,
            "operation": req.operation,
            "offset": req.offset,
            "length": req.length,
        },);
        if (req.backend_handle == "stream:streamed.txt") {
            binary data = streamed_payload;
            int offset = req.offset;
            int length = req.length;
            if (offset >= data.size()) {
                return {"eof": True};
            }
            int remaining = data.size() - offset;
            int chunk_size = remaining < length ? remaining : length;
            return {
                "data": data.substr(offset, chunk_size),
                "eof": offset + chunk_size >= data.size(),
            };
        }
        return {"eof": True};
    }

    hash<auto> write(hash<auto> req) {
        calls += ({
            "method": "write",
            "path": req.path,
            "operation": req.operation,
            "offset": req.offset,
            "size": req.data.size(),
        },);
        if (req.backend_handle == "write:stream-submit.txt") {
            if (!req.offset) {
                streamed_submission = binary();
            }
            streamed_submission += req.data;
        }
        return {"written": req.data.size()};
    }

    hash<auto> closeRead(hash<auto> req) {
        calls += ({"method": "closeRead", "path": req.path, "operation": req.operation},);
        return {"path": req.path, "completed": True};
    }

    hash<auto> closeWrite(hash<auto> req) {
        binary data = binary();
        if (req.data != NOTHING) {
            data = req.data;
        }
        if (req.path == "/stream-submit.txt") {
            data = streamed_submission;
        }
        files{req.path} = data;
        submissions += ({"path": req.path, "data": data, "operation": req.operation},);
        calls += ({"method": "closeWrite", "path": req.path, "operation": req.operation},);
        return {"path": req.path, "completed": True};
    }

    hash<auto> submit(hash<auto> req) {
        binary data = req.data;
        calls += ({
            "method": "submit",
            "path": req.path,
            "operation": req.operation,
            "size": data.size(),
        },);
        files{req.path} = data;
        return {
            "path": req.path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "submit",
                "path": req.path,
                "final_path": req.path,
                "size": data.size(),
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<auto> listAvailable(hash<auto> req) {
        calls += ({"method": "listAvailable", "path": req.path, "operation": req.operation},);
        hash<auto> result = list(req);
        return {
            "path": req.path,
            "entries": result.entries,
        };
    }

    hash<auto> retrieve(hash<auto> req) {
        calls += ({"method": "retrieve", "path": req.path, "operation": req.operation},);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        binary data = files{req.path};
        return {
            "path": req.path,
            "data": data,
            "size": data.size(),
            "permissions": 0100644,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "retrieve",
                "path": req.path,
                "final_path": req.path,
                "size": data.size(),
                "atomic_publish": False,
                "completed": False,
            },
        };
    }

    hash<auto> completeRetrieve(hash<auto> req) {
        string mode = req.completion_mode ?? "";
        calls += ({"method": "completeRetrieve", "path": req.path, "operation": req.operation, "mode": mode},);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        if (mode == "delete") {
            delete files{req.path};
        }
        return {
            "path": req.path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "retrieve",
                "path": req.path,
                "final_path": req.path,
                "size": 0,
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<auto> removePath(hash<auto> req) {
        calls += ({"method": "removePath", "path": req.path, "operation": req.operation},);
        if (files{req.path} == NOTHING) {
            return {"path": req.path, "exists": False};
        }
        delete files{req.path};
        return {"path": req.path, "completed": True};
    }

    hash<auto> rename(hash<auto> req) {
        calls += ({"method": "rename", "path": req.path, "target_path": req.target_path, "operation": req.operation},);
        if (files{req.path} != NOTHING) {
            binary data = files{req.path};
            delete files{req.path};
            files{req.target_path} = data;
            return {"path": req.target_path, "completed": True};
        }
        if (directories{req.path} != NOTHING && directories{req.path}) {
            delete directories{req.path};
            directories{req.target_path} = True;
            return {"path": req.target_path, "completed": True};
        }
        return {"path": req.path, "exists": False};
    }

    hash<auto> mkdir(hash<auto> req) {
        calls += ({"method": "mkdir", "path": req.path, "operation": req.operation},);
        directories{req.path} = True;
        return {"path": req.path, "completed": True};
    }

    hash<auto> rmdir(hash<auto> req) {
        calls += ({"method": "rmdir", "path": req.path, "operation": req.operation},);
        if (directories{req.path} == NOTHING || !directories{req.path}) {
            return {"path": req.path, "exists": False};
        }
        delete directories{req.path};
        return {"path": req.path, "completed": True};
    }
}

class InvalidBackend {
    ping() {
    }
}

class MissingDataRetrieveBackend {
    hash<auto> stat(hash<auto> req) {
        return {
            "path": req.path,
            "exists": True,
            "directory": False,
            "size": 0,
            "permissions": 0100644,
        };
    }

    hash<auto> list(hash<auto> req) {
        return {"path": req.path, "entries": ()};
    }

    hash<auto> retrieve(hash<auto> req) {
        return {
            "path": req.path,
            "exists": True,
            "size": 0,
            "permissions": 0100644,
        };
    }
}

class TypedBackend {
    public {
        hash<auto> files;
        hash<Qore::Ssh::SftpSubmissionRequest> last_submit_req;
        hash<Qore::Ssh::SftpOperationRequest> last_complete_req;
    }

    constructor() {
        files = (
            "/typed-backend.txt": binary("typed backend\n"),
        );
    }

    hash<Qore::Ssh::SftpPathInfo> stat(hash<Qore::Ssh::SftpPathRequest> req) {
        if (files{req.path} == NOTHING) {
            return <Qore::Ssh::SftpPathInfo>{"path": req.path, "exists": False};
        }
        binary data = files{req.path};
        return <Qore::Ssh::SftpPathInfo>{
            "path": req.path,
            "exists": True,
            "directory": False,
            "size": data.size(),
            "permissions": 0100644,
        };
    }

    hash<Qore::Ssh::SftpListResult> list(hash<Qore::Ssh::SftpPathRequest> req) {
        list<hash<auto>> entries = ();
        foreach string path in (keys(files)) {
            if (req.path == "/" && path.find("/", 1) < 0) {
                entries += ({
                    "filename": path.substr(1),
                    "long_name": path.substr(1),
                    "size": files{path}.size(),
                    "permissions": 0100644,
                    "directory": False,
                },);
            }
        }
        return <Qore::Ssh::SftpListResult>{
            "path": req.path,
            "entries": entries,
        };
    }

    hash<Qore::Ssh::SftpOpenResult> retrieve(hash<Qore::Ssh::SftpOpenRequest> req) {
        if (files{req.path} == NOTHING) {
            return <Qore::Ssh::SftpOpenResult>{"path": req.path, "exists": False};
        }
        binary data = files{req.path};
        return <Qore::Ssh::SftpOpenResult>{
            "path": req.path,
            "exists": True,
            "data": data,
            "size": data.size(),
            "permissions": 0100644,
        };
    }

    hash<Qore::Ssh::SftpOperationResult> submit(hash<Qore::Ssh::SftpSubmissionRequest> req) {
        last_submit_req = req;
        binary data = req.data;
        files{req.path} = data;
        return <Qore::Ssh::SftpOperationResult>{
            "path": req.path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "submit",
                "path": req.path,
                "final_path": req.path,
                "size": data.size(),
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<Qore::Ssh::SftpOperationResult> completeRetrieve(hash<Qore::Ssh::SftpOperationRequest> req) {
        last_complete_req = req;
        if (files{req.path} == NOTHING) {
            return <Qore::Ssh::SftpOperationResult>{"path": req.path, "exists": False};
        }
        string mode = req.completion_mode ?? "";
        if (mode == "delete") {
            delete files{req.path};
        }
        return <Qore::Ssh::SftpOperationResult>{
            "path": req.path,
            "completed": True,
            "transfer_info": <Qore::Ssh::SftpTransferInfo>{
                "operation": "retrieve",
                "path": req.path,
                "final_path": req.path,
                "size": 0,
                "atomic_publish": False,
                "completed": True,
            },
        };
    }

    hash<Qore::Ssh::SftpListResult> listAvailable(hash<Qore::Ssh::SftpPathRequest> req) {
        return list(req);
    }
}

class SftpSessionTest inherits QUnit::Test {
    constructor() : Test("SftpSessionTest", "0.1", \ARGV) {
        addTestCase("info roundtrip", \testInfoRoundtrip());
        addTestCase("transfer info defaults to nothing", \testTransferInfoDefault());
        addTestCase("applyTransferInfo updates transfer state", \testApplyTransferInfo());
        addTestCase("clearTransferInfo resets transfer state", \testClearTransferInfo());
        addTestCase("waitProtocolMessage rejects disconnected sessions", \testWaitProtocolMessageDisconnected());
        addTestCase("processNextRequest rejects disconnected sessions", \testProcessNextRequestDisconnected());
        addTestCase("sendVersion rejects disconnected sessions", \testSendVersionDisconnected());
        addTestCase("sendStatus rejects disconnected sessions", \testSendStatusDisconnected());
        addTestCase("publishLocalFile copies staged file", \testPublishLocalFileCopy());
        addTestCase("publishLocalFile renames staged file atomically", \testPublishLocalFileMoveAtomic());
        addTestCase("publishLocalFile rejects missing transfer info", \testPublishLocalFileMissingTransferInfo());
        addTestCase("retrieveLocalFile copies planned file", \testRetrieveLocalFileCopy());
        addTestCase("retrieveLocalFile renames planned file", \testRetrieveLocalFileMove());
        addTestCase("retrieveLocalFile rejects missing transfer info", \testRetrieveLocalFileMissingTransferInfo());
        addTestCase("backend roundtrip", \testBackendRoundtrip());
        addTestCase("stream backend roundtrip", \testStreamBackendRoundtrip());
        addTestCase("stream write backend roundtrip", \testStreamWriteBackendRoundtrip());
        addTestCase("mutation backend roundtrip", \testMutationBackendRoundtrip());
        addTestCase("atomic exchange submit helper", \testAtomicExchangeSubmit());
        addTestCase("atomic exchange convenience submit helpers", \testAtomicExchangeConvenienceSubmit());
        addTestCase("atomic exchange retrieve helpers", \testAtomicExchangeRetrieve());
        addTestCase("atomic exchange convenience retrieve helpers", \testAtomicExchangeConvenienceRetrieve());
        addTestCase("atomic exchange completion mode helpers", \testAtomicExchangeCompletionModeHelpers());
        addTestCase("retrieve helpers reject missing backend data", \testRetrieveHelpersRejectMissingBackendData());
        addTestCase("atomic exchange helpers support deterministic concurrent calls", \testAtomicExchangeConcurrentHelpers());
        addTestCase("invalid backend is rejected", \testInvalidBackendRejected());
        addTestCase("typed backend is accepted and works through SftpSession", \testTypedBackendRoundtrip());
        addTestCase("logger roundtrip", \testLoggerRoundtrip());
        addTestCase("close updates connected state", \testCloseLifecycle());
        addTestCase("copy is denied", \testCopyDenied());
        set_return_value(main());
    }

    private hash<Qore::Ssh::SshSessionInfo> getSessionInfo() {
        date ts = now();
        return <Qore::Ssh::SshSessionInfo>{
            "session_id": "sftp-1",
            "server_name": "srv",
            "listener_name": "lst",
            "remote_address": "127.0.0.1",
            "remote_port": 22,
            "local_address": "127.0.0.1",
            "local_port": 2222,
            "username": "user",
            "authenticated": True,
            "auth_method": "none",
            "principal": "principal:user",
            "started": ts,
            "last_activity": ts,
        };
    }

    private hash<Qore::Ssh::SftpSessionInfo> getSftpInfo() {
        return <Qore::Ssh::SftpSessionInfo>{
            "session_info": getSessionInfo(),
            "principal": "principal:user",
            "root_dir": "/tmp/integration-inbound",
            "read_only": False,
            "session_data": {"tenant": "test"},
        };
    }

    private hash<Qore::Ssh::SftpTransferInfo> getTransferInfo() {
        return <Qore::Ssh::SftpTransferInfo>{
            "operation": "upload",
            "path": "/inbound/file.dat",
            "temporary_path": "/tmp/module-ssh-sftp-test/.file.dat.part",
            "final_path": "/tmp/module-ssh-sftp-test/file.dat",
            "size": 42,
            "checksum": "abc123",
            "atomic_publish": True,
            "completed": False,
        };
    }

    private string getTmpPath(string suffix) {
        return sprintf("/tmp/module-ssh-sftp-test-%d-%d%s", getpid(), now_us(), suffix);
    }

    private nothing writeTestFile(string path, string data) {
        File f();
        f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        f.write(data);
        f.close();
    }

    testInfoRoundtrip() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        hash<Qore::Ssh::SftpSessionInfo> info = s.getInfo();
        assertEq("principal:user", info.principal);
        assertEq("/tmp/integration-inbound", info.root_dir);
        assertEq("sftp-1", info.session_info.session_id);
    }

    testTransferInfoDefault() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertEq(NOTHING, s.getTransferInfo());
    }

    testApplyTransferInfo() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.applyTransferInfo(getTransferInfo());
        hash<Qore::Ssh::SftpTransferInfo> info = s.getTransferInfo();
        assertEq("upload", info.operation);
        assertEq("/inbound/file.dat", info.path);
        assertTrue(info.atomic_publish);
    }

    testClearTransferInfo() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.applyTransferInfo(getTransferInfo());
        assertNeq(NOTHING, s.getTransferInfo());
        s.clearTransferInfo();
        assertEq(NOTHING, s.getTransferInfo());
    }

    testWaitProtocolMessageDisconnected() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-STATE-ERROR", sub() { s.waitProtocolMessage(1); });
    }

    testProcessNextRequestDisconnected() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-STATE-ERROR", sub() { s.processNextRequest(1); });
    }

    testSendVersionDisconnected() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-STATE-ERROR", sub() { s.sendVersion(3); });
    }

    testSendStatusDisconnected() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-STATE-ERROR", sub() { s.sendStatus(1, 8, "unsupported", "en"); });
    }

    testPublishLocalFileCopy() {
        string root = getTmpPath(".copy-root");
        string source = getTmpPath(".copy-source");
        string final_path = root + "/published/file.dat";
        string temp_path = root + "/published/.file.dat.part";

        on_exit {
            if (is_file(source)) {
                unlink(source);
            }
            if (is_file(temp_path)) {
                unlink(temp_path);
            }
            if (is_file(final_path)) {
                unlink(final_path);
            }
        }

        writeTestFile(source, "COPY-DATA");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.applyTransferInfo(<Qore::Ssh::SftpTransferInfo>{
            "operation": "upload",
            "path": "/published/file.dat",
            "temporary_path": temp_path,
            "final_path": final_path,
            "size": 9,
            "atomic_publish": False,
            "completed": False,
        });

        hash<Qore::Ssh::SftpTransferInfo> info = s.publishLocalFile(source, False, True);
        assertTrue(is_file(source));
        assertTrue(is_file(final_path));
        assertEq("COPY-DATA", ReadOnlyFile::readTextFile(final_path));
        assertTrue(info.completed);
        assertEq(final_path, info.final_path);
        assertEq(info, s.getTransferInfo());
    }

    testPublishLocalFileMoveAtomic() {
        string root = getTmpPath(".move-root");
        string source = getTmpPath(".move-source");
        string final_path = root + "/archive/final.dat";
        string temp_path = root + "/archive/.final.dat.uploading";

        on_exit {
            if (is_file(source)) {
                unlink(source);
            }
            if (is_file(temp_path)) {
                unlink(temp_path);
            }
            if (is_file(final_path)) {
                unlink(final_path);
            }
        }

        writeTestFile(source, "MOVE-DATA");
        TestLogger logger();
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setLogger(logger);
        s.applyTransferInfo(<Qore::Ssh::SftpTransferInfo>{
            "operation": "upload",
            "path": "/archive/final.dat",
            "temporary_path": temp_path,
            "final_path": final_path,
            "size": 9,
            "atomic_publish": True,
            "completed": False,
        });

        hash<Qore::Ssh::SftpTransferInfo> info = s.publishLocalFile(source, True, True);
        assertFalse(is_file(source));
        assertFalse(is_file(temp_path));
        assertTrue(is_file(final_path));
        assertEq("MOVE-DATA", ReadOnlyFile::readTextFile(final_path));
        assertTrue(info.completed);
        assertTrue(info.atomic_publish);
        assertEq(final_path, info.final_path);
        assertTrue(logger.events.size() >= 2);
        assertEq("info", logger.events[logger.events.size() - 1].level);
        bool saw_publish_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("published local file atomically") >= 0) {
                saw_publish_log = True;
                break;
            }
        }
        assertTrue(saw_publish_log);
    }

    testPublishLocalFileMissingTransferInfo() {
        string source = getTmpPath(".missing-transfer-source");
        on_exit if (is_file(source)) { unlink(source); }
        writeTestFile(source, "MISSING");

        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-TRANSFER-ERROR", sub() { s.publishLocalFile(source, False, True); });
    }

    testRetrieveLocalFileCopy() {
        string root = getTmpPath(".retrieve-copy-root");
        string source = root + "/outbound/source.dat";
        string target = getTmpPath(".retrieve-copy-target");

        on_exit {
            if (is_file(source)) {
                unlink(source);
            }
            if (is_file(target)) {
                unlink(target);
            }
        }

        mkdir(root + "/outbound", 0700, True);
        writeTestFile(source, "RETRIEVE-COPY");
        TestLogger logger();
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setLogger(logger);
        s.applyTransferInfo(<Qore::Ssh::SftpTransferInfo>{
            "operation": "download",
            "path": "/outbound/source.dat",
            "final_path": source,
            "size": 13,
            "atomic_publish": False,
            "completed": False,
        });

        hash<Qore::Ssh::SftpTransferInfo> info = s.retrieveLocalFile(target, False, True);
        assertTrue(is_file(source));
        assertTrue(is_file(target));
        assertEq("RETRIEVE-COPY", ReadOnlyFile::readTextFile(target));
        assertTrue(info.completed);
        bool saw_retrieve_log = False;
        for (int i = 0; i < logger.events.size(); ++i) {
            if (logger.events[i].message.find("retrieved local file") >= 0) {
                saw_retrieve_log = True;
                break;
            }
        }
        assertTrue(saw_retrieve_log);
        assertEq(info, s.getTransferInfo());
    }

    testRetrieveLocalFileMove() {
        string root = getTmpPath(".retrieve-move-root");
        string source = root + "/outbound/source.dat";
        string target = getTmpPath(".retrieve-move-target");

        on_exit {
            if (is_file(source)) {
                unlink(source);
            }
            if (is_file(target)) {
                unlink(target);
            }
        }

        mkdir(root + "/outbound", 0700, True);
        writeTestFile(source, "RETRIEVE-MOVE");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.applyTransferInfo(<Qore::Ssh::SftpTransferInfo>{
            "operation": "download",
            "path": "/outbound/source.dat",
            "final_path": source,
            "size": 13,
            "atomic_publish": False,
            "completed": False,
        });

        hash<Qore::Ssh::SftpTransferInfo> info = s.retrieveLocalFile(target, True, True);
        assertFalse(is_file(source));
        assertTrue(is_file(target));
        assertEq("RETRIEVE-MOVE", ReadOnlyFile::readTextFile(target));
        assertTrue(info.completed);
        assertEq(info, s.getTransferInfo());
    }

