    testBackendRoundtrip() {
        TestSftpBackend backend("virtual");
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertEq(NOTHING, s.getBackend());
        s.setBackend(backend);
        assertEq(backend, s.getBackend());
        s.setBackend(NOTHING);
        assertEq(NOTHING, s.getBackend());
    }

    testStreamBackendRoundtrip() {
        TestSftpBackend backend("virtual");
        hash<auto> open_result = backend.openRead({"path": "/streamed.txt", "operation": "open-read"});
        assertEq("stream:streamed.txt", open_result.backend_handle);
        hash<auto> read_result = backend.read({
            "path": "/streamed.txt",
            "operation": "read",
            "backend_handle": open_result.backend_handle,
            "offset": 0,
            "length": 8,
        });
        assertEq(binary("streamed"), read_result.data);
        assertFalse(read_result.eof);
        hash<auto> close_result = backend.closeRead({
            "path": "/streamed.txt",
            "operation": "close-read",
            "backend_handle": open_result.backend_handle,
        });
        assertTrue(close_result.completed);
    }

    testStreamWriteBackendRoundtrip() {
        TestSftpBackend backend("virtual");
        hash<auto> open_result = backend.openWrite({
            "path": "/stream-submit.txt",
            "operation": "open-write",
            "pflags": 10,
        });
        assertEq("write:stream-submit.txt", open_result.backend_handle);
        hash<auto> write_result = backend.write({
            "path": "/stream-submit.txt",
            "operation": "write",
            "backend_handle": open_result.backend_handle,
            "offset": 0,
            "data": binary("streamed upload\n"),
        });
        assertEq(16, write_result.written);
        hash<auto> close_result = backend.closeWrite({
            "path": "/stream-submit.txt",
            "operation": "close-write",
            "backend_handle": open_result.backend_handle,
        });
        assertTrue(close_result.completed);
        assertEq(binary("streamed upload\n"), backend.submissions[0].data);
    }

    testMutationBackendRoundtrip() {
        TestSftpBackend backend("virtual");
        hash<auto> mkdir_result = backend.mkdir({"path": "/inbound", "operation": "mkdir"});
        assertTrue(mkdir_result.completed);
        assertTrue(backend.stat({"path": "/inbound", "operation": "stat"}).directory);

        hash<auto> rename_result = backend.rename({
            "path": "/backend-entry.txt",
            "target_path": "/renamed.txt",
            "operation": "rename",
        });
        assertTrue(rename_result.completed);
        assertFalse(backend.stat({"path": "/backend-entry.txt", "operation": "stat"}).exists);
        assertEq(12, backend.stat({"path": "/renamed.txt", "operation": "stat"}).size);

        hash<auto> remove_result = backend.removePath({"path": "/renamed.txt", "operation": "remove"});
        assertTrue(remove_result.completed);
        assertFalse(backend.stat({"path": "/renamed.txt", "operation": "stat"}).exists);

        hash<auto> rmdir_result = backend.rmdir({"path": "/inbound", "operation": "rmdir"});
        assertTrue(rmdir_result.completed);
        assertFalse(backend.stat({"path": "/inbound", "operation": "stat"}).exists);
    }

    testAtomicExchangeSubmit() {
        string source = getTmpPath(".atomic-submit-source");
        on_exit if (is_file(source)) { unlink(source); }

        writeTestFile(source, "atomic submit payload\n");
        TestSftpBackend backend("virtual");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);
        hash<Qore::Ssh::SftpOperationResult> result = s.submit(<Qore::Ssh::SftpSubmissionRequest>{
            "path": "/exchange/inbound.dat",
            "source_path": source,
            "metadata": {"kind": "inbound"},
        });

        assertTrue(result.completed);
        assertEq("/exchange/inbound.dat", result.path);
        assertEq(binary("atomic submit payload\n"), backend.files{"/exchange/inbound.dat"});
        assertEq("submit", s.getTransferInfo().operation);
        assertTrue(s.getTransferInfo().completed);
    }

    testAtomicExchangeConvenienceSubmit() {
        string source = getTmpPath(".atomic-submit-convenience-source");
        on_exit if (is_file(source)) { unlink(source); }

        writeTestFile(source, "convenience submit payload\n");
        TestSftpBackend backend("virtual");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        hash<Qore::Ssh::SftpOperationResult> data_result
            = s.submitData("/exchange/data.dat", binary("inline payload\n"), {"kind": "inline"});
        assertTrue(data_result.completed);
        assertEq(binary("inline payload\n"), backend.files{"/exchange/data.dat"});

        hash<Qore::Ssh::SftpOperationResult> typed_data_result = s.submitData(
            <Qore::Ssh::SftpSubmissionRequest>{
                "path": "/exchange/typed-data.dat",
                "data": binary("typed inline payload\n"),
                "metadata": {"kind": "typed-inline"},
            }
        );
        assertTrue(typed_data_result.completed);
        assertEq(binary("typed inline payload\n"), backend.files{"/exchange/typed-data.dat"});

        hash<Qore::Ssh::SftpOperationResult> file_result
            = s.submitLocalFile("/exchange/file.dat", source, False, True, {"kind": "local"});
        assertTrue(file_result.completed);
        assertEq(binary("convenience submit payload\n"), backend.files{"/exchange/file.dat"});

        hash<Qore::Ssh::SftpOperationResult> typed_file_result = s.submitLocalFile(
            <Qore::Ssh::SftpSubmissionRequest>{
                "path": "/exchange/typed-file.dat",
                "source_path": source,
                "metadata": {"kind": "typed-local"},
            }
        );
        assertTrue(typed_file_result.completed);
        assertEq(binary("convenience submit payload\n"), backend.files{"/exchange/typed-file.dat"});
        assertEq("submit", s.getTransferInfo().operation);
        assertTrue(s.getTransferInfo().completed);
    }

    testAtomicExchangeRetrieve() {
        TestSftpBackend backend("virtual");
        backend.files{"/outbound/report.dat"} = binary("atomic retrieve payload\n");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        hash<Qore::Ssh::SftpListResult> listing = s.listAvailable(<Qore::Ssh::SftpPathRequest>{
            "path": "/",
        });
        assertTrue(listing.entries.size() > 0);

        hash<Qore::Ssh::SftpOpenResult> open_result = s.retrieve(<Qore::Ssh::SftpOpenRequest>{
            "path": "/outbound/report.dat",
        });
        assertEq(binary("atomic retrieve payload\n"), open_result.data);
        assertEq("retrieve", s.getTransferInfo().operation);
        assertFalse(s.getTransferInfo().completed);

        hash<Qore::Ssh::SftpOperationResult> complete = s.completeRetrieve(<Qore::Ssh::SftpOperationRequest>{
            "path": "/outbound/report.dat",
            "completion_mode": "delete",
        });
        assertTrue(complete.completed);
        assertEq(NOTHING, backend.files{"/outbound/report.dat"});
        assertTrue(s.getTransferInfo().completed);
    }

    testAtomicExchangeConvenienceRetrieve() {
        string target = getTmpPath(".atomic-retrieve-convenience-target");
        on_exit if (is_file(target)) { unlink(target); }

        TestSftpBackend backend("virtual");
        backend.files{"/outbound/simple.dat"} = binary("simple retrieve payload\n");
        backend.files{"/outbound/delete.dat"} = binary("delete retrieve payload\n");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        binary data = s.retrieveData("/outbound/simple.dat", {"kind": "simple"});
        assertEq(binary("simple retrieve payload\n"), data);

        binary typed_data = s.retrieveData(<Qore::Ssh::SftpOpenRequest>{
            "path": "/outbound/simple.dat",
            "metadata": {"kind": "typed-simple"},
        });
        assertEq(binary("simple retrieve payload\n"), typed_data);

        hash<Qore::Ssh::SftpOperationResult> result
            = s.retrieveToLocalFile("/outbound/delete.dat", target, "delete");
        assertTrue(result.completed);
        assertEq("delete retrieve payload\n", ReadOnlyFile::readTextFile(target));
        assertEq(NOTHING, backend.files{"/outbound/delete.dat"});
        assertEq("retrieve", s.getTransferInfo().operation);
        assertTrue(s.getTransferInfo().completed);

        backend.files{"/outbound/delete-typed.dat"} = binary("typed delete retrieve payload\n");
        string typed_target = getTmpPath(".atomic-retrieve-convenience-typed-target");
        on_exit if (is_file(typed_target)) { unlink(typed_target); }
        hash<Qore::Ssh::SftpOperationResult> typed_result = s.retrieveToLocalFile(
            <Qore::Ssh::SftpOpenRequest>{
                "path": "/outbound/delete-typed.dat",
                "metadata": {"kind": "typed-delete"},
            },
            typed_target,
            "delete"
        );
        assertTrue(typed_result.completed);
        assertEq("typed delete retrieve payload\n", ReadOnlyFile::readTextFile(typed_target));
        assertEq(NOTHING, backend.files{"/outbound/delete-typed.dat"});
    }

    testAtomicExchangeCompletionModeHelpers() {
        TestSftpBackend backend("virtual");
        backend.files{"/outbound/delete.dat"} = binary("delete\n");
        backend.files{"/outbound/claim.dat"} = binary("claim\n");
        backend.files{"/outbound/archive.dat"} = binary("archive\n");
        backend.files{"/outbound/delete-typed.dat"} = binary("delete typed\n");
        backend.files{"/outbound/claim-typed.dat"} = binary("claim typed\n");
        backend.files{"/outbound/archive-typed.dat"} = binary("archive typed\n");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        hash<Qore::Ssh::SftpOperationResult> delete_result
            = s.completeRetrieveDelete("/outbound/delete.dat");
        hash<Qore::Ssh::SftpOperationResult> claim_result
            = s.completeRetrieveClaim("/outbound/claim.dat", NOTHING, {"ticket": "123"});
        hash<Qore::Ssh::SftpOperationResult> archive_result
            = s.completeRetrieveArchive("/outbound/archive.dat");
        hash<Qore::Ssh::SftpOperationResult> typed_delete_result = s.completeRetrieveDelete(
            <Qore::Ssh::SftpOperationRequest>{
                "path": "/outbound/delete-typed.dat",
            }
        );
        hash<Qore::Ssh::SftpOperationResult> typed_claim_result = s.completeRetrieveClaim(
            <Qore::Ssh::SftpOperationRequest>{
                "path": "/outbound/claim-typed.dat",
                "metadata": {"ticket": "typed-123"},
            }
        );
        hash<Qore::Ssh::SftpOperationResult> typed_archive_result = s.completeRetrieveArchive(
            <Qore::Ssh::SftpOperationRequest>{
                "path": "/outbound/archive-typed.dat",
            }
        );

        assertTrue(delete_result.completed);
        assertTrue(claim_result.completed);
        assertTrue(archive_result.completed);
        assertTrue(typed_delete_result.completed);
        assertTrue(typed_claim_result.completed);
        assertTrue(typed_archive_result.completed);
        assertEq(NOTHING, backend.files{"/outbound/delete.dat"});
        assertEq(NOTHING, backend.files{"/outbound/delete-typed.dat"});

        int claim_calls = 0;
        int archive_calls = 0;
        for (int i = 0; i < backend.calls.size(); ++i) {
            if (backend.calls[i].method == "completeRetrieve" && backend.calls[i].path == "/outbound/claim.dat"
                    && backend.calls[i].mode == "claim") {
                ++claim_calls;
            } else if (backend.calls[i].method == "completeRetrieve"
                    && backend.calls[i].path == "/outbound/archive.dat"
                    && backend.calls[i].mode == "archive") {
                ++archive_calls;
            }
        }
        assertEq(1, claim_calls);
        assertEq(1, archive_calls);
    }

    testRetrieveHelpersRejectMissingBackendData() {
        string target = getTmpPath(".missing-backend-data-target");
        on_exit if (is_file(target)) { unlink(target); }

        MissingDataRetrieveBackend backend();
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        assertThrows("SFTPSESSION-BACKEND-ERROR", sub() { s.retrieveData("/outbound/missing.dat"); });
        assertThrows("SFTPSESSION-BACKEND-ERROR", sub() {
            s.retrieveToLocalFile("/outbound/missing.dat", target);
        });
    }

    testAtomicExchangeConcurrentHelpers() {
        TestSftpBackend backend("virtual");
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);

        int workers = 4;
        Counter start(1);
        Counter done(workers);
        for (int i = 0; i < workers; ++i) {
            int idx = i;
            background sub() {
                start.waitForZero(5s);
                string path = sprintf("/exchange/concurrent-%d.dat", idx);
                string payload = sprintf("payload-%d\n", idx);
                s.submitData(path, binary(payload), {"worker": idx});
                binary data = s.retrieveData(path);
                assertEq(binary(payload), data);
                hash<Qore::Ssh::SftpOperationResult> result = s.completeRetrieveDelete(path);
                assertTrue(result.completed);
                done.dec();
            }();
        }

        start.dec();
        done.waitForZero(10s);
        for (int i = 0; i < workers; ++i) {
            assertEq(NOTHING, backend.files{sprintf("/exchange/concurrent-%d.dat", i)});
        }
    }

