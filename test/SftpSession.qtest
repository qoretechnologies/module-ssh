    testTypedBackendRoundtrip() {
        TypedBackend backend();
        Qore::Ssh::SftpSession s(getSftpInfo());
        s.setBackend(backend);
        assertEq(backend, s.getBackend());

        hash<Qore::Ssh::SftpListResult> listing = s.listAvailable(<Qore::Ssh::SftpPathRequest>{
            "path": "/",
        });
        assertEq(1, listing.entries.size());

        hash<Qore::Ssh::SftpOpenResult> open_result = s.retrieve(<Qore::Ssh::SftpOpenRequest>{
            "path": "/typed-backend.txt",
        });
        assertEq(binary("typed backend\n"), open_result.data);

        hash<Qore::Ssh::SftpOperationResult> submit_result = s.submitData("/submitted.txt", binary("submitted\n"));
        assertTrue(submit_result.completed);
        assertEq(binary("submitted\n"), backend.files{"/submitted.txt"});

        hash<Qore::Ssh::SftpOperationResult> complete_result = s.completeRetrieveDelete("/typed-backend.txt");
        assertTrue(complete_result.completed);
        assertEq(NOTHING, backend.files{"/typed-backend.txt"});
    }

    testLoggerRoundtrip() {
        TestLogger logger();
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertEq(NOTHING, s.getLogger());
        s.setLogger(logger);
        assertEq(logger, s.getLogger());
    }

    testCloseLifecycle() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertFalse(s.connected());
        s.close();
        assertFalse(s.connected());
    }

    testCopyDenied() {
        Qore::Ssh::SftpSession s(getSftpInfo());
        assertThrows("SFTPSESSION-COPY-ERROR", sub() { s.copy(); });
    }
