%modern
%no-child-restrictions
%requires qore >= 2.3
%requires ssh
%requires sshutil
%requires QUnit

%exec-class SshSandboxTest

#! Trusted code that acts for sandboxed code within a policy barrier (SandboxManager::callWithSystemPolicy())
/** An object of this class is passed to the sandboxed programs of the tests; its methods run in this (unsandboxed)
    program.  The barrier masks the policy of the sandboxed caller, but not the sandbox in which an object or a
    closure was created (see Qore's design/sandbox-provenance.md), so the code that the barrier runs is created
    when the helper is, before the sandboxed code runs, and not while serving the sandboxed call.
*/
class TrustedSshHelper {
    private {
        code read_key = string sub (string path) {
            return Qore::Ssh::SshKey::readPrivateKeyFile(path).isPrivate() ? "ok" : "bad";
        };

        code start_server = string sub (string host_key) {
            hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
                "name": "sandbox-barrier",
                "listeners": (
                    <Qore::Ssh::SshListenerConfig>{
                        "name": "main",
                        "bind_address": "127.0.0.1",
                        "port": 0,
                        "host_keys": (host_key,),
                        "enabled_auth_methods": ("none",),
                    },
                ),
            };
            Qore::Ssh::SshServer server(config);
            server.start();
            server.stop();
            return "ok";
        };

        code publish_file = string sub (Qore::Ssh::SftpSession session, string source) {
            return session.publishLocalFile(source, False, True).completed ? "ok" : "bad";
        };
    }

    string readKey(string path) {
        return SandboxManager::callWithSystemPolicy(read_key, path);
    }

    string startServer(string host_key) {
        return SandboxManager::callWithSystemPolicy(start_server, host_key);
    }

    string publish(Qore::Ssh::SftpSession session, string source) {
        return SandboxManager::callWithSystemPolicy(publish_file, (session, source));
    }

    #! runs code supplied by the caller within the barrier: a closure created by sandboxed code keeps its sandbox
    auto run(code c) {
        return SandboxManager::callWithSystemPolicy(c);
    }
}

# Verifies that the ssh module honours the program filesystem sandbox for SSH key and
# host-key file I/O (P1), and that blocking server waits are cooperatively interruptible
# via the sandbox interrupt (P2).
class SshSandboxTest inherits QUnit::Test {
    private {
        string host_key = get_script_dir() + "/data/ssh_host_ed25519_key";
    }

    constructor() : Test("SshSandboxTest", "1.0", \ARGV) {
        addTestCase("SSH key file I/O is denied under a filesystem-deny sandbox", \testKeyFsDenied());
        addTestCase("SSH key file I/O is allowed for an allow-listed sandbox path", \testKeyFsAllowed());
        addTestCase("host key load is denied under a filesystem-deny sandbox", \testHostKeyDenied());
        addTestCase("host key load is denied under PO_NO_FILESYSTEM", \testHostKeyNoFilesystemDenied());
        addTestCase("provider file host key is denied under a filesystem-deny sandbox",
            \testProviderHostKeyFileDenied());
        addTestCase("provider text host key works under a filesystem-deny sandbox",
            \testProviderHostKeyTextAllowed());
        addTestCase("provider file host key is denied under PO_NO_FILESYSTEM",
            \testProviderHostKeyFileNoFilesystemDenied());
        addTestCase("provider text host key works under PO_NO_FILESYSTEM",
            \testProviderHostKeyTextNoFilesystemAllowed());
        addTestCase("listener bind is denied under a network-deny sandbox (S6)", \testBindNetworkDenied());
        addTestCase("listener bind is allowed for an allow-listed sandbox host (S6)",
            \testBindNetworkAllowed());
        addTestCase("a blocking accept wait is interruptible via the sandbox interrupt",
            \testAcceptInterruptible());
        addTestCase("an SSH key file is read for sandboxed code within a policy barrier", \testKeyPolicyBarrier());
        addTestCase("a host key file is read for sandboxed code within a policy barrier",
            \testHostKeyPolicyBarrier());
        addTestCase("a listener is bound for sandboxed code within a policy barrier", \testBindPolicyBarrier());
        addTestCase("an SFTP session file is published for sandboxed code within a policy barrier",
            \testSftpPolicyBarrier());
        set_return_value(main());
    }

    private string tmpPath(string suffix) {
        return sprintf("/tmp/module-ssh-sandbox-%d-%d%s", getpid(), now_us(), suffix);
    }

    # builds a child Program whose code uses the ssh module; the sandbox is attached AFTER
    # parsing so loading the binary module itself is not filesystem-restricted
    private Program makeChildProgram(string code) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(code, "sandbox-child");
        return p;
    }

    private Program makeNoFilesystemChildProgram(string code, bool load_sshutil = False) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS | PO_NO_FILESYSTEM | PO_NEW_STYLE | PO_STRICT_ARGS
            | PO_REQUIRE_TYPES);
        p.loadModule("ssh");
        if (load_sshutil) {
            p.loadModule("sshutil");
        }
        p.parse(code, "sandbox-nofs-child");
        return p;
    }

    testKeyFsDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub writeKey(string path) {
    Qore::Ssh::SshKey k = Qore::Ssh::SshKey::generate(Qore::Ssh::SSH_KEYTYPE_ED25519);
    k.writePrivateKeyFile(path);
    return \"ok\";
}
string sub readKey(string path) {
    Qore::Ssh::SshKey::readPrivateKeyFile(path);
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);   # deny all filesystem access
        p.setSandboxManager(sm);

        string wpath = tmpPath(".key");
        on_exit if (is_file(wpath)) { unlink(wpath); }
        # write of a private key file must be blocked by the sandbox (S1/S2)
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("writeKey", wpath); });
        assertFalse(is_file(wpath), "denied key write must not create the file");
        # read of an existing key file must also be blocked
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("readKey", host_key); });
    }

    testKeyFsAllowed() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub roundtrip(string path) {
    Qore::Ssh::SshKey k = Qore::Ssh::SshKey::generate(Qore::Ssh::SSH_KEYTYPE_ED25519);
    k.writePrivateKeyFile(path);
    Qore::Ssh::SshKey imported = Qore::Ssh::SshKey::readPrivateKeyFile(path);
    return imported.isPrivate() ? \"ok\" : \"bad\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.addFilesystemAllowedPath("/tmp", QSEC_READ | QSEC_WRITE | QSEC_CREATE);
        p.setSandboxManager(sm);

        string wpath = tmpPath(".key");
        on_exit if (is_file(wpath)) { unlink(wpath); }
        # the same operations succeed when the path is allow-listed (the gate is policy-scoped,
        # not a blanket block)
        assertEq("ok", p.callFunction("roundtrip", wpath));
        assertTrue(is_file(wpath), "allowed key write must create the file");
    }

    testHostKeyDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);   # deny all filesystem access
        p.setSandboxManager(sm);
        # loading the host key file during start() must be blocked by the sandbox (S3)
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("startServer", host_key); });
    }

    testHostKeyNoFilesystemDenied() {
        Program p = makeNoFilesystemChildProgram("
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        assertThrows("ILLEGAL-FILESYSTEM-ACCESS", "PO_NO_FILESYSTEM",
            sub() { p.callFunction("startServer", host_key); });
    }

    testProviderHostKeyFileDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
%requires sshutil
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED",
            sub() { p.callFunction("startProviderServer", "file", host_key); });
    }

    testProviderHostKeyTextAllowed() {
        string key_text = ReadOnlyFile::readTextFile(host_key);
        Program p = makeChildProgram("%modern
%requires ssh
%requires sshutil
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        p.setSandboxManager(sm);
        assertEq("ok", p.callFunction("startProviderServer", "text", key_text));
    }

    testProviderHostKeyFileNoFilesystemDenied() {
        Program p = makeNoFilesystemChildProgram("
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}", True);
        assertThrows("ILLEGAL-FILESYSTEM-ACCESS", "PO_NO_FILESYSTEM",
            sub() { p.callFunction("startProviderServer", "file", host_key); });
    }

    testProviderHostKeyTextNoFilesystemAllowed() {
        string key_text = ReadOnlyFile::readTextFile(host_key);
        Program p = makeNoFilesystemChildProgram("
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}", True);
        assertEq("ok", p.callFunction("startProviderServer", "text", key_text));
    }

    # S6: an explicit denial must override an allowed address, after the filesystem
    # permits loading the host key. Default-deny alone must not make this test pass
    # without exercising the denied IP range.  The listener binds all interfaces: since
    # Qore a95c6190e, denied ranges do not apply to a bind to a loopback address, which
    # can only be reached from the local host.
    testBindNetworkDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-net-deny\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"0.0.0.0\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);    # allow FS so the host key loads
        sm.addNetworkAllowedIPRange("0.0.0.0/32");
        sm.addNetworkDeniedIPRange("0.0.0.0/32");   # the denial overrides the allowed address
        p.setSandboxManager(sm);
        assertThrows("NETWORK-ACCESS-DENIED", "denied by security policy \\(private/blocked network\\)",
            sub() { p.callFunction("startServer", host_key); });
    }

    # S6 positive control: explicitly allow the listener address. A denied IP range
    # that does NOT cover that address must leave the bind permitted, proving the gate
    # evaluates the denied ranges (rather than blanket-allowing or blanket-denying).  Paired with
    # testBindNetworkDenied (same setup but loopback denied) this deterministically
    # exercises both sides of the S6 pre-bind network gate.
    testBindNetworkAllowed() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-net-allow\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkDeniedIPRange("10.0.0.0/8");   # denies a range that excludes 127.0.0.1
        p.setSandboxManager(sm);
        assertEq("ok", p.callFunction("startServer", host_key),
            "a denied range not covering the bind address must let the listener start");
    }

    testAcceptInterruptible() {
        # filesystem must be permitted so the server can load its host key and start; the
        # point of this test is that the blocking accept wait honours the sandbox interrupt
        Program p = makeChildProgram("%modern
%requires ssh
string sub acceptBlock(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-int\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    # no client ever connects: this blocks until interrupted
    server.acceptSession(60000);
    return \"returned\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);    # allow FS so the server can start
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        p.setSandboxManager(sm);

        string err = "";
        Counter done(1);
        background sub() {
            try {
                p.callFunction("acceptBlock", host_key);
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            done.dec();
        }();

        # give the worker time to start the server and enter the blocking accept wait,
        # then request the program interrupt
        sleep(2s);
        sm.requestInterrupt();

        # with the 500ms-capped poll loop the accept wait must unblock promptly;
        # Counter::waitForZero() returns 0 when the counter reaches zero (worker finished)
        assertEq(0, done.waitForZero(15s), "interrupted accept wait must return");
        assertEq("PROGRAM-INTERRUPTED", err,
            "a blocking accept wait must raise PROGRAM-INTERRUPTED when the sandbox is interrupted");
    }

    #! the code of the sandboxed programs of the policy barrier tests
    private Program makeBarrierChildProgram() {
        return makeChildProgram("%modern
%requires ssh
string sub readKey(string path) {
    return Qore::Ssh::SshKey::readPrivateKeyFile(path).isPrivate() ? \"ok\" : \"bad\";
}
string sub readKeyTrusted(object trusted, string path) {
    return trusted.readKey(path);
}
string sub startServer(string host_key) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-no-barrier\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (host_key,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}
string sub startServerTrusted(object trusted, string host_key) {
    return trusted.startServer(host_key);
}
string sub publish(Qore::Ssh::SftpSession session, string source) {
    return session.publishLocalFile(source, False, True).completed ? \"ok\" : \"bad\";
}
string sub publishTrusted(object trusted, Qore::Ssh::SftpSession session, string source) {
    return trusted.publish(session, source);
}
string sub readKeyOwnClosure(object trusted, string path) {
    return trusted.run(string sub () {
        return Qore::Ssh::SshKey::readPrivateKeyFile(path).isPrivate() ? \"ok\" : \"bad\";
    });
}");
    }

    testKeyPolicyBarrier() {
        Program p = makeBarrierChildProgram();
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("readKey", host_key));
        assertEq("ok", p.callFunction("readKeyTrusted", new TrustedSshHelper(), host_key),
            "trusted code reads the key file for the sandboxed code within its policy barrier");
        # the barrier does not remove the sandbox of the code that created the closure it runs
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("readKeyOwnClosure", new TrustedSshHelper(),
            host_key));
    }

    testHostKeyPolicyBarrier() {
        Program p = makeBarrierChildProgram();
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("startServer", host_key));
        assertEq("ok", p.callFunction("startServerTrusted", new TrustedSshHelper(), host_key),
            "trusted code reads the host key file for the sandboxed code within its policy barrier");
    }

    testBindPolicyBarrier() {
        Program p = makeBarrierChildProgram();
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertThrows("NETWORK-ACCESS-DENIED", \p.callFunction(), ("startServer", host_key));
        assertEq("ok", p.callFunction("startServerTrusted", new TrustedSshHelper(), host_key),
            "trusted code binds the listener for the sandboxed code within its policy barrier");
    }

    testSftpPolicyBarrier() {
        string source = tmpPath(".source");
        string final_path = tmpPath(".published");
        on_exit {
            if (is_file(source)) {
                unlink(source);
            }
            if (is_file(final_path)) {
                unlink(final_path);
            }
        }
        {
            File f();
            f.open2(source, O_CREAT | O_EXCL | O_WRONLY, 0600);
            f.write("BARRIER-DATA");
        }

        date ts = now();
        Qore::Ssh::SftpSession session(<Qore::Ssh::SftpSessionInfo>{
            "session_info": <Qore::Ssh::SshSessionInfo>{
                "session_id": "sftp-barrier",
                "server_name": "srv",
                "listener_name": "lst",
                "remote_address": "127.0.0.1",
                "remote_port": 22,
                "local_address": "127.0.0.1",
                "local_port": 2222,
                "username": "user",
                "authenticated": True,
                "auth_method": "none",
                "principal": "principal:user",
                "started": ts,
                "last_activity": ts,
            },
            "principal": "principal:user",
            "root_dir": "/tmp",
            "read_only": False,
        });
        session.applyTransferInfo(<Qore::Ssh::SftpTransferInfo>{
            "operation": "upload",
            "path": "/published.dat",
            "final_path": final_path,
            "size": 12,
            "atomic_publish": False,
            "completed": False,
        });

        Program p = makeBarrierChildProgram();
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("publish", session, source));
        assertFalse(is_file(final_path), "the denied publication does not create the file");
        assertEq("ok", p.callFunction("publishTrusted", new TrustedSshHelper(), session, source),
            "trusted code publishes the file for the sandboxed code within its policy barrier");
        assertEq("BARRIER-DATA", ReadOnlyFile::readTextFile(final_path));
    }
}
