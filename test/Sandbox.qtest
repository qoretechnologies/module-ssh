%modern
%no-child-restrictions
%requires qore >= 2.3
%requires ssh
%requires sshutil
%requires QUnit

%exec-class SshSandboxTest

# Verifies that the ssh module honours the program filesystem sandbox for SSH key and
# host-key file I/O (P1), and that blocking server waits are cooperatively interruptible
# via the sandbox interrupt (P2).
class SshSandboxTest inherits QUnit::Test {
    private {
        string host_key = get_script_dir() + "/data/ssh_host_ed25519_key";
    }

    constructor() : Test("SshSandboxTest", "1.0", \ARGV) {
        addTestCase("SSH key file I/O is denied under a filesystem-deny sandbox", \testKeyFsDenied());
        addTestCase("SSH key file I/O is allowed for an allow-listed sandbox path", \testKeyFsAllowed());
        addTestCase("host key load is denied under a filesystem-deny sandbox", \testHostKeyDenied());
        addTestCase("host key load is denied under PO_NO_FILESYSTEM", \testHostKeyNoFilesystemDenied());
        addTestCase("provider file host key is denied under a filesystem-deny sandbox",
            \testProviderHostKeyFileDenied());
        addTestCase("provider text host key works under a filesystem-deny sandbox",
            \testProviderHostKeyTextAllowed());
        addTestCase("provider file host key is denied under PO_NO_FILESYSTEM",
            \testProviderHostKeyFileNoFilesystemDenied());
        addTestCase("provider text host key works under PO_NO_FILESYSTEM",
            \testProviderHostKeyTextNoFilesystemAllowed());
        addTestCase("listener bind is denied under a network-deny sandbox (S6)", \testBindNetworkDenied());
        addTestCase("listener bind is allowed for an allow-listed sandbox host (S6)",
            \testBindNetworkAllowed());
        addTestCase("a blocking accept wait is interruptible via the sandbox interrupt",
            \testAcceptInterruptible());
        set_return_value(main());
    }

    private string tmpPath(string suffix) {
        return sprintf("/tmp/module-ssh-sandbox-%d-%d%s", getpid(), now_us(), suffix);
    }

    # builds a child Program whose code uses the ssh module; the sandbox is attached AFTER
    # parsing so loading the binary module itself is not filesystem-restricted
    private Program makeChildProgram(string code) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(code, "sandbox-child");
        return p;
    }

    private Program makeNoFilesystemChildProgram(string code, bool load_sshutil = False) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS | PO_NO_FILESYSTEM | PO_NEW_STYLE | PO_STRICT_ARGS
            | PO_REQUIRE_TYPES);
        p.loadModule("ssh");
        if (load_sshutil) {
            p.loadModule("sshutil");
        }
        p.parse(code, "sandbox-nofs-child");
        return p;
    }

    testKeyFsDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub writeKey(string path) {
    Qore::Ssh::SshKey k = Qore::Ssh::SshKey::generate(Qore::Ssh::SSH_KEYTYPE_ED25519);
    k.writePrivateKeyFile(path);
    return \"ok\";
}
string sub readKey(string path) {
    Qore::Ssh::SshKey::readPrivateKeyFile(path);
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);   # deny all filesystem access
        p.setSandboxManager(sm);

        string wpath = tmpPath(".key");
        on_exit if (is_file(wpath)) { unlink(wpath); }
        # write of a private key file must be blocked by the sandbox (S1/S2)
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("writeKey", wpath); });
        assertFalse(is_file(wpath), "denied key write must not create the file");
        # read of an existing key file must also be blocked
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("readKey", host_key); });
    }

    testKeyFsAllowed() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub roundtrip(string path) {
    Qore::Ssh::SshKey k = Qore::Ssh::SshKey::generate(Qore::Ssh::SSH_KEYTYPE_ED25519);
    k.writePrivateKeyFile(path);
    Qore::Ssh::SshKey imported = Qore::Ssh::SshKey::readPrivateKeyFile(path);
    return imported.isPrivate() ? \"ok\" : \"bad\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.addFilesystemAllowedPath("/tmp", QSEC_READ | QSEC_WRITE | QSEC_CREATE);
        p.setSandboxManager(sm);

        string wpath = tmpPath(".key");
        on_exit if (is_file(wpath)) { unlink(wpath); }
        # the same operations succeed when the path is allow-listed (the gate is policy-scoped,
        # not a blanket block)
        assertEq("ok", p.callFunction("roundtrip", wpath));
        assertTrue(is_file(wpath), "allowed key write must create the file");
    }

    testHostKeyDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);   # deny all filesystem access
        p.setSandboxManager(sm);
        # loading the host key file during start() must be blocked by the sandbox (S3)
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub() { p.callFunction("startServer", host_key); });
    }

    testHostKeyNoFilesystemDenied() {
        Program p = makeNoFilesystemChildProgram("
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        assertThrows("ILLEGAL-FILESYSTEM-ACCESS", "PO_NO_FILESYSTEM",
            sub() { p.callFunction("startServer", host_key); });
    }

    testProviderHostKeyFileDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
%requires sshutil
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED",
            sub() { p.callFunction("startProviderServer", "file", host_key); });
    }

    testProviderHostKeyTextAllowed() {
        string key_text = ReadOnlyFile::readTextFile(host_key);
        Program p = makeChildProgram("%modern
%requires ssh
%requires sshutil
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        assertEq("ok", p.callFunction("startProviderServer", "text", key_text));
    }

    testProviderHostKeyFileNoFilesystemDenied() {
        Program p = makeNoFilesystemChildProgram("
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}", True);
        assertThrows("ILLEGAL-FILESYSTEM-ACCESS", "PO_NO_FILESYSTEM",
            sub() { p.callFunction("startProviderServer", "file", host_key); });
    }

    testProviderHostKeyTextNoFilesystemAllowed() {
        string key_text = ReadOnlyFile::readTextFile(host_key);
        Program p = makeNoFilesystemChildProgram("
class Provider inherits SshUtil::AbstractSshServerHostKeyProvider {
    private {
        string mode;
        string value;
    }

    constructor(string mode, string value) {
        self.mode = mode;
        self.value = value;
    }

    list<hash<SshUtil::SshPrivateKeyMaterial>> getServerHostKeyMaterial(hash<auto> ctxt) {
        if (mode == \"file\") {
            return (<SshUtil::SshPrivateKeyMaterial>{
                \"kind\": SshUtil::SshPrivateKeyMaterialKind::File,
                \"path\": value,
            },);
        }
        return (<SshUtil::SshPrivateKeyMaterial>{
            \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
            \"private_key_text\": value,
        },);
    }
}

string sub startProviderServer(string mode, string value) {
    Provider provider(mode, value);
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-provider-nofs-test\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"server_host_key_provider\": provider,
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    server.stop();
    return \"ok\";
}", True);
        assertEq("ok", p.callFunction("startProviderServer", "text", key_text));
    }

    # S6: with the filesystem permitted (so the host key loads and execution reaches the
    # pre-bind gate), an explicitly denied IP range covering the bind address must block
    # the listener bind before libssh opens the listening socket.  (checkBind() is
    # permissive by design -- it ignores the default policy/allow-list and only denies on
    # a denied IP range or a restricted port -- so blockLocalhost(), which adds
    # 127.0.0.0/8 to the denied ranges, is the deterministic deny trigger here.)
    testBindNetworkDenied() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-net-deny\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);    # allow FS so the host key loads
        sm.blockLocalhost();                    # adds 127.0.0.0/8 + ::1/128 to denied ranges
        p.setSandboxManager(sm);
        assertThrows("NETWORK-ACCESS-DENIED", sub() { p.callFunction("startServer", host_key); });
    }

    # S6 positive control: a denied IP range that does NOT cover the bind address must
    # leave the listener bind permitted, proving the gate actually evaluates the denied
    # ranges (rather than blanket-allowing or blanket-denying).  Paired with
    # testBindNetworkDenied (same setup but loopback denied) this deterministically
    # exercises both sides of the S6 pre-bind network gate.
    testBindNetworkAllowed() {
        Program p = makeChildProgram("%modern
%requires ssh
string sub startServer(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-net-allow\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    return \"ok\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.addNetworkDeniedIPRange("10.0.0.0/8");   # denies a range that excludes 127.0.0.1
        p.setSandboxManager(sm);
        assertEq("ok", p.callFunction("startServer", host_key),
            "a denied range not covering the bind address must let the listener start");
    }

    testAcceptInterruptible() {
        # filesystem must be permitted so the server can load its host key and start; the
        # point of this test is that the blocking accept wait honours the sandbox interrupt
        Program p = makeChildProgram("%modern
%requires ssh
string sub acceptBlock(string hk) {
    hash<Qore::Ssh::SshServerConfig> config = <Qore::Ssh::SshServerConfig>{
        \"name\": \"sandbox-int\",
        \"listeners\": (
            <Qore::Ssh::SshListenerConfig>{
                \"name\": \"main\",
                \"bind_address\": \"127.0.0.1\",
                \"port\": 0,
                \"host_keys\": (hk,),
                \"enabled_auth_methods\": (\"none\",),
            },
        ),
    };
    Qore::Ssh::SshServer server(config);
    server.start();
    on_exit server.stop();
    # no client ever connects: this blocks until interrupted
    server.acceptSession(60000);
    return \"returned\";
}");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);    # allow FS so the server can start
        p.setSandboxManager(sm);

        string err = "";
        Counter done(1);
        background sub() {
            try {
                p.callFunction("acceptBlock", host_key);
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            done.dec();
        }();

        # give the worker time to start the server and enter the blocking accept wait,
        # then request the program interrupt
        sleep(2s);
        sm.requestInterrupt();

        # with the 500ms-capped poll loop the accept wait must unblock promptly;
        # Counter::waitForZero() returns 0 when the counter reaches zero (worker finished)
        assertEq(0, done.waitForZero(15s), "interrupted accept wait must return");
        assertEq("PROGRAM-INTERRUPTED", err,
            "a blocking accept wait must raise PROGRAM-INTERRUPTED when the sandbox is interrupted");
    }
}
