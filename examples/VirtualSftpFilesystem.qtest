%modern
%requires ../qlib/SftpServerDataProvider
%requires ssh

hash<Qore::Ssh::SftpSessionInfo> sub getExampleInfo() {
    date ts = now();
    return <Qore::Ssh::SftpSessionInfo>{
        "session_info": <Qore::Ssh::SshSessionInfo>{
            "session_id": "example-1",
            "server_name": "example",
            "listener_name": "example-listener",
            "remote_address": "127.0.0.1",
            "remote_port": 22,
            "local_address": "127.0.0.1",
            "local_port": 2222,
            "username": "example",
            "authenticated": True,
            "auth_method": "none",
            "principal": "principal:example",
            "started": ts,
            "last_activity": ts,
        },
        "principal": "principal:example",
        "root_dir": "/",
        "read_only": False,
        "session_data": {"tenant": "example"},
    };
}

SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
    "archive_dir": "/archive",
    "claim_dir": "/claimed",
});

exchange.addOutboundText("hello.txt", "hello from a virtual filesystem\n", {"kind": "example"});
exchange.addInboundText("seed.txt", "seed payload\n");

Qore::Ssh::SftpSession session(getExampleInfo());
session.setBackend(exchange);

printf("Outbound listing before retrieve:\n");
foreach hash<SftpServerDataProvider::VirtualSftpEntryInfo> record in (exchange.listOutbound()) {
    printf("  %s (%d bytes)\n", record.filename, record.size);
}

hash<SftpServerDataProvider::VirtualSftpPathRequest> retrieve_req
    = <SftpServerDataProvider::VirtualSftpPathRequest>{"path": "/hello.txt"};
binary payload = exchange.retrieve(retrieve_req).data;
printf("\nRetrieved payload:\n%s", payload.toString("UTF-8"));

hash<SftpServerDataProvider::VirtualSftpCompletionRequest> archive_req
    = <SftpServerDataProvider::VirtualSftpCompletionRequest>{
        "path": "/hello.txt",
        "completion_mode": "archive",
    };
hash<SftpServerDataProvider::VirtualSftpOperationResult> archive_result = exchange.completeRetrieve(archive_req);
printf("\nArchived path: %y\n", archive_result.path);

hash<SftpServerDataProvider::VirtualSftpSnapshot> snapshot = exchange.getFilesystem().exportSnapshot("/");
printf("\nSnapshot after archive:\n");
printf("  Directories: %y\n", snapshot.directory_paths);
printf("  Files: %y\n", snapshot.file_paths);
