%requires ../qlib/SftpServerDataProvider
%requires ../qlib/SshServerConnections
%requires ../qlib/SshServerAuthProvider
%requires ssh
%requires DataProvider

class ExampleObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data_) {
        events += ((data_ + ("event_id": event_id)),);
    }
}

string sub getTmpFile(string suffix) {
    return "/tmp/module-ssh-policy-example-" + string(getpid()) + "-" + string(now_us()) + suffix;
}

nothing sub cleanupFile(string path) {
    if (is_readable(path)) {
        unlink(path);
    }
}

nothing sub writeTextFile(string path, string data) {
    File f();
    f.open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    f.write(data);
    f.close();
}

string sub makeSftpClientCommand(int port, string batch_path, string stdout_path, string stderr_path) {
    return sprintf("/usr/bin/sftp"
        + " -b %s"
        + " -o BatchMode=yes"
        + " -o PreferredAuthentications=none"
        + " -o PubkeyAuthentication=no"
        + " -o PasswordAuthentication=no"
        + " -o KbdInteractiveAuthentication=no"
        + " -o NumberOfPasswordPrompts=0"
        + " -o StrictHostKeyChecking=no"
        + " -o UserKnownHostsFile=/dev/null"
        + " -o LogLevel=ERROR"
        + " -o ConnectTimeout=5"
        + " -P %d"
        + " nobody@127.0.0.1"
        + " >%s 2>%s", batch_path, port, stdout_path, stderr_path);
}

nothing sub runBatch(Qore::Ssh::SshServer server, int port, string batch_data, *string source_path) {
    string batch_path = getTmpFile(".batch");
    string stdout_path = getTmpFile(".out");
    string stderr_path = getTmpFile(".err");

    on_exit {
        cleanupFile(batch_path);
        cleanupFile(stdout_path);
        cleanupFile(stderr_path);
    }

    writeTextFile(batch_path, batch_data);
    int sftp_rc = 0;
    Counter done(1);
    background sub() {
        try {
            sftp_rc = system(makeSftpClientCommand(port, batch_path, stdout_path, stderr_path));
        } catch (hash<ExceptionInfo> ex) {
            sftp_rc = -1;
        }
        done.dec();
    }();

    Qore::Ssh::SshSession session = server.acceptSession(5000);
    hash<Qore::Ssh::SshAuthDecision> auth = server.authenticateSession(session, 15000);
    Qore::Ssh::SftpSession sftp = server.dispatchSftpSession(session, 15000);
    Counter service_done(1);
    background sub() {
        try {
            while (True) {
                auto msg = sftp.processNextRequest(15000);
                if (msg == NOTHING) {
                    break;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "SFTPSESSION-STATE-ERROR") {
                throw ex;
            }
        }
        service_done.dec();
    }();

    done.waitForZero(10s);
    sftp.close();
    service_done.waitForZero(5s);
    session.disconnect();

    printf("Client exit=%d auth=%y stderr=%y\n", sftp_rc, auth.accepted,
        is_file(stderr_path) ? ReadOnlyFile::readTextFile(stderr_path) : "");
}

SftpServerDataProvider::VirtualSftpExchange exchange(<SftpServerDataProvider::VirtualSftpExchangeOptions>{
    "inbound_policy": <SftpServerDataProvider::VirtualSftpInboundPolicy>{
        "accept_filename_glob": "*.dat",
        "max_size": 16,
        "allow_overwrite": False,
    },
});

SshServerConnections::SftpServerConnection conn({
    "name": "policy-example",
    "url": "sftpserver://127.0.0.1:0",
    "opts": {
        "host_keys": (get_script_dir() + "../test/data/ssh_host_ed25519_key",),
        "services": <SshServerConnections::SshServerConnectionServices>{
            "enabled_auth_methods": ("none",),
            "allow_command_service": False,
            "allow_sftp_service": True,
        },
        "auth": <SshServerAuthProvider::VirtualSshAuthProviderOptions>{
            "methods": ("none",),
            "none": <SshServerAuthProvider::VirtualSshStaticAuthMethodOptions>{
                "success_decision": <SshServerAuthProvider::VirtualSshAuthDecisionTemplate>{
                    "principal": "principal:nobody",
                    "command_policy": {
                        "mode": "subsystem-only",
                        "allowed_subsystems": ("sftp",),
                    },
                    "sftp_policy": {"mode": "enabled"},
                },
            },
        },
        "backend": exchange,
    },
});

AbstractDataProvider provider = conn.getDataProvider();
AbstractDataProvider event_provider = provider.getChildProviderEx(SftpServerDataProvider::EventInboundFileAccepted);
ExampleObserver observer();
cast<DataProvider::Observable>(event_provider).registerObserver(
    observer, SftpServerDataProvider::EventInboundFileAccepted);
cast<DataProvider::DelayedObservable>(event_provider).observersReady();

hash<Qore::Ssh::SshServerConfig> config = conn.getServerConfig();
Qore::Ssh::SshServer server(config);
server.start();
int port = server.getStatus().listeners[0].bound_port;

string ok_source = getTmpFile(".accepted.source");
string rejected_source = getTmpFile(".rejected.source");
on_exit {
    cleanupFile(ok_source);
    cleanupFile(rejected_source);
}

writeTextFile(ok_source, "accepted\n");
writeTextFile(rejected_source, "rejected-by-policy\n");

printf("Running accepted upload...\n");
runBatch(server, port, sprintf("put %s /inbound/accepted.dat\nquit\n", ok_source));
printf("Running rejected upload...\n");
runBatch(server, port, sprintf("put %s /inbound/rejected.txt\nquit\n", rejected_source));

server.stop();

printf("Observed events: %d\n", observer.events.size());
printf("Inbound files: %y\n", exchange.listInbound());
if (observer.events.size()) {
    printf("First event: %y\n", observer.events[0]);
}
